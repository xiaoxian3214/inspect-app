import { API_BASE_URL } from '../config/appConfig.uts'

const FAB_ACTIONS = {
  merge: { key: 'merge', label: '合并验货', icon: 'merge' },
  scan: { key: 'scan', label: '通过扫描条码来搜索验货', icon: 'scan' },
  search: { key: 'search', label: '开始验货', icon: 'search' },
  quick: { key: 'quick', label: '创建快速验货', icon: 'plus' }
}

const CARD_ACTIONS = {
  download: { key: 'download', label: '下载' },
  'view-inspector': { key: 'view-inspector', label: '查看当前验货员' },
  unlock: { key: 'unlock', label: '解锁' },
  reset: { key: 'reset', label: '重置' },
  copy: { key: 'copy', label: '复制当前验货' },
  'copy-merged': { key: 'copy-merged', label: '复制合并验货' },
  'ready-quantity': { key: 'ready-quantity', label: '设置备货数量' },
  report: { key: 'report', label: '显示报告' },
  split: { key: 'split', label: '拆分验货' }
}

/**
 * 生成计划在 PC 报告页的浏览地址，供【显示报告】调起系统浏览器。
 * planId 为空时返回空串，调用方应提示计划 ID 缺失而不是打开无效链接。
 * H5 站基地址从 API_BASE_URL 自动推导：
 *   测试环境 (含 'test') → https://inspecttest.letright.com.cn/qcm/#/pages/report/detail-pc?planId=xxx
 *   正式环境             → https://inspect.letright.com.cn/#/pages/report/detail-pc?planId=xxx
 */
export function buildReportPcUrl(planId: string): string {
  const normalized = planId.trim()
  if (normalized === '') return ''
  const apiBase = String(API_BASE_URL ?? '').trim()
  // API_BASE_URL 含 'test' 判为测试环境
  let base: string
  if (apiBase !== '' && apiBase.includes('test')) {
    base = 'https://inspecttest.letright.com.cn/qcm'
  } else {
    base = 'https://inspect.letright.com.cn'
  }
  return `${base}/#/pages/report/detail-pc?planId=${encodeURIComponent(normalized)}`
}

/**
 * 根据当前列表页签返回与 H5 顺序一致的浮动菜单操作。
 * statusKey 为当前页签标识（planned/report）；返回对应浮动菜单项数组，其他页签返回空数组。
 */
export function buildFabActions(statusKey: string): UTSJSONObject[] {
  if (statusKey === 'planned') {
    return [FAB_ACTIONS.merge, FAB_ACTIONS.scan, FAB_ACTIONS.search, FAB_ACTIONS.quick]
  }
  if (statusKey === 'report') {
    return [FAB_ACTIONS.scan, FAB_ACTIONS.search]
  }
  return [] as UTSJSONObject[]
}

/**
 * 根据本机缓存、锁状态和当前用户计算下载状态，忽略线上下载时间。
 * options 含 isLocalDownloaded、lockFlag、inspectorId、currentUserId；返回 downloaded/locked/available。
 */
export function resolveDownloadState(options: any = {}): string {
  if (options?.isLocalDownloaded === true) return 'downloaded'
  if (parseInt(String(options?.lockFlag ?? 0)) !== 1) return 'available'

  const inspectorId = String(options?.inspectorId ?? '').trim()
  const currentUserId = String(options?.currentUserId ?? '').trim()
  if (inspectorId !== '' && currentUserId !== '' && inspectorId === currentUserId) return 'downloaded'
  if (inspectorId !== '' && currentUserId !== '' && inspectorId !== currentUserId) return 'locked'
  return 'available'
}

/**
 * 按 H5 的可见性与顺序生成卡片右侧“更多”菜单操作。
 * options 含 downloadState、statusKey、manageActionsInCard 等；返回按顺序排列的卡片操作项数组。
 */
export function buildCardActions(options: any = {}): UTSJSONObject[] {
  const actions: UTSJSONObject[] = []
  const downloadState = String(options?.downloadState ?? 'available')
  const statusKey = String(options?.statusKey ?? 'planned')
  const manageActionsInCard = options?.manageActionsInCard === true
  const isPlannedOrProgress = statusKey === 'planned' || statusKey === 'progress'

  if (downloadState === 'available') actions.push(CARD_ACTIONS.download)
  if (downloadState === 'locked') actions.push(CARD_ACTIONS['view-inspector'])
  if (downloadState === 'downloaded' && isPlannedOrProgress) {
    actions.push(CARD_ACTIONS.unlock)
    actions.push(CARD_ACTIONS.reset)
  }
  if (manageActionsInCard) actions.push(CARD_ACTIONS.copy)
  if (manageActionsInCard && options?.isMerged === true) actions.push(CARD_ACTIONS['copy-merged'])
  actions.push(CARD_ACTIONS['ready-quantity'])
  if (statusKey === 'report' || downloadState === 'locked') actions.push(CARD_ACTIONS.report)
  if (options?.showSplit === true) actions.push(CARD_ACTIONS.split)
  return actions
}

/**
 * 优先处理合并和报告；非本机下载的任务不得绕过下载确认进入详情。
 * options 含 selectionMode、status、downloadState、isLocalDownloaded、manageActionsInCard；返回点击动作标识。
 */
export function resolveCardClickAction(options: any = {}): string {
  if (options?.selectionMode === true) return 'toggle-merge'
  if (parseInt(String(options?.status ?? 0)) === 3) return 'open-actions'
  const downloadState = String(options?.downloadState ?? 'available')
  if (options?.isLocalDownloaded !== true) {
    if (downloadState === 'locked') return 'open-actions'
    return options?.manageActionsInCard === true ? 'open-download' : 'request-download'
  }
  return 'open-detail'
}

/**
 * 判断当前状态是否允许启动一次新的离线数据同步。
 * options 含 isSyncing、isOnline、pendingCount；返回联网且有待同步项时为 true。
 */
export function canStartSync(options: any = {}): boolean {
  return options?.isSyncing !== true
    && options?.isOnline === true
    && parseInt(String(options?.pendingCount ?? 0)) > 0
}
