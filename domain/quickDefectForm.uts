import type { DefectCategoryPath } from './defectCategoryPath.uts'

/**
 * 从服务端或本地疵点恢复编辑草稿，保留检查项和合并验货关联。
 * 服务端记录只带三级编码时（defectCode 有值、defectDesc 为空），以 tier3Code 兜底，
 * 保证编辑弹层仍能按编码反查并展示完整类别名称。
 * @param defect 服务端或本地疵点记录
 * @returns 归一化后的疵点编辑草稿
 */
/**
 * 生成前端本地的疵点 ID（对齐 H5 createDefectId）：
 * crypto.randomUUID 可用时直接使用，否则用 毫秒时间戳+随机串 兜底，
 * 保证同一毫秒内反复"新建疵点"也不会产生相同 ID 导致照片错挂。
 * @returns 带缺陷前缀的全局唯一本地疵点 ID
 */
export function createDefectId(): string {
  const random = Math.random().toString(16).slice(2, 8)
  return `defect-${Date.now()}-${random}`
}

export function createDefectDraft(defect: UTSJSONObject): UTSJSONObject {
  const commonFlag = parseInt(String(defect?.commonFlag ?? (defect?.isCommon ? 1 : 0))) === 1 ? 1 : 0
  const quantity = parseFloat(String(defect?.quantity === 'other' ? defect?.customQuantity : (defect?.quantity ?? defect?.defectCount ?? 1)))
  const usesOtherQuantity = defect?.quantity === 'other' || quantity > 19
  const defectCode = String(defect?.defectCode ?? defect?.tier3Code ?? '')
  return {
    ...defect,
    id: defect?.id ?? defect?.defectId ?? '',
    defectId: defect?.defectId ?? defect?.id ?? '',
    type: String(defect?.type ?? defect?.defectType ?? 'MINOR').toUpperCase(),
    tier1Code: defect?.tier1Code ?? '', tier2Code: defect?.tier2Code ?? '', tier3Code: defect?.tier3Code ?? defectCode,
    defectCode,
    defectDesc: defect?.defectDesc ?? '',
    quantity: commonFlag === 1 ? null : (usesOtherQuantity ? 'other' : (quantity > 0 ? quantity : 1)),
    customQuantity: commonFlag === 1 ? '' : (usesOtherQuantity ? String(defect?.customQuantity ?? quantity) : ''),
    commonFlag,
    description: defect?.description ?? defect?.remark ?? '',
    checkItemId: defect?.checkItemId ?? '', checkItemName: defect?.checkItemName ?? '',
    checkItemResultId: defect?.checkItemResultId ?? defect?.itemResultId ?? '',
    sonPlanId: defect?.sonPlanId ?? null,
    photos: Array.isArray(defect?.photos) ? [...defect.photos] : ([] as UTSJSONObject[])
  }
}

/**
 * 历史疵点只保存三级编码但缺少描述时，使用分类树里的三级名称补齐编辑草稿。
 * 分类树不可用或未命中时不伪造类别名称，保留原草稿供用户重新选择。
 * @param draft 从现有疵点建立的编辑草稿
 * @param categoryTree 已下载或离线缓存的分类树
 * @param resolvePath 从分类树按编码反查三级路径的纯函数
 * @returns 保留原身份及输入、仅补齐缺失分类名称的草稿
 */
export function restoreDefectDraftCategory(draft: UTSJSONObject, categoryTree: UTSJSONObject[], resolvePath: (tree: UTSJSONObject[], stored: UTSJSONObject) => DefectCategoryPath): UTSJSONObject {
  const code = String(draft?.defectCode ?? draft?.tier3Code ?? '').trim()
  if (code === '' || String(draft?.defectDesc ?? '').trim() !== '') return draft
  const path = resolvePath(categoryTree, draft)
  const name = String(path?.tier3Name ?? '').trim()
  if (path?.tier3Code !== code || name === '') return draft
  return { ...draft, defectCode: code, defectDesc: name,
    tier1Code: String(draft?.tier1Code ?? '').trim() !== '' ? draft.tier1Code : path.tier1Code,
    tier2Code: String(draft?.tier2Code ?? '').trim() !== '' ? draft.tier2Code : path.tier2Code,
    tier3Code: code }
}

/**
 * 编辑时父页面可能因拍照或同步生成新疵点对象：只取媒体更新，保留用户正在编辑的类别与备注。
 * @param draft 当前弹层尚未保存的表单
 * @param refreshed 同一个疵点的父页面最新记录
 * @returns 保留编辑内容且更新媒体列表的草稿
 */
export function mergeDefectDraftPhotos(draft: UTSJSONObject, refreshed: UTSJSONObject): UTSJSONObject {
  const previousId = String(draft?.defectId ?? draft?.id ?? '').trim()
  const nextId = String(refreshed?.defectId ?? refreshed?.id ?? '').trim()
  if (previousId !== nextId && (previousId !== '' || nextId !== '')) return draft
  return { ...draft, photos: Array.isArray(refreshed?.photos) ? refreshed.photos : draft?.photos }
}

/**
 * 选择 1–19 或其他数量；选择数量时退出普遍性疵点状态。
 * @param draft 当前疵点草稿（组件内 type 对象，只有 UTSObject 能同时满足展开与字段读取）
 * @param quantity 新选择的数量，'other' 表示自定义数量
 * @returns 更新数量后的新草稿对象
 */
export function selectDefectQuantity(draft: UTSObject, quantity: number | string): UTSJSONObject {
  return { ...draft, quantity, customQuantity: quantity === 'other' ? draft.customQuantity ?? '' : '', commonFlag: 0 }
}

/**
 * 切换普遍性疵点，开启时清空数量，关闭时恢复默认数量。
 * @param draft 当前疵点草稿（组件内 type 对象）
 * @param checked 是否勾选普遍性疵点
 * @returns 更新普遍性状态后的新草稿对象
 */
export function setDefectCommon(draft: UTSObject, checked: boolean): UTSJSONObject {
  return { ...draft, commonFlag: checked ? 1 : 0, quantity: checked ? null : (draft.quantity ?? 1), customQuantity: checked ? '' : draft.customQuantity }
}

/**
 * 获取实际受影响数量，普遍性疵点返回 null。
 * @param draft 当前疵点草稿（组件内 type 对象）
 * @returns 受影响数量，普遍性疵点或非法数量返回 null
 */
export function getDefectQuantity(draft: UTSObject): number | null {
  if (parseInt(String(draft?.commonFlag ?? 0)) === 1) return null
  return parseInt(String(draft?.quantity === 'other' ? draft?.customQuantity : draft?.quantity))
}

/**
 * 校验必选疵点类别及受影响数量，返回空字符串表示可保存。
 * @param draft 当前疵点草稿（组件内 type 对象）
 * @returns 阻断保存的提示文案，校验通过为空串
 */
export function validateDefectDraft(draft: UTSObject): string {
  if (!draft?.defectCode) return '请选择完整疵点类别（三级）'
  if (!draft?.defectDesc) return '请选择完整疵点类别（三级）'
  const quantity = getDefectQuantity(draft)
  if (quantity !== null && (!Number.isFinite(quantity) || quantity < 1 || !Number.isInteger(quantity))) return '请输入有效的受影响数量'
  return ''
}