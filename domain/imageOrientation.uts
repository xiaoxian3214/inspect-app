/**
 * 根据加速度计重力方向返回缩略图需要施加的反向旋转角度；姿态不明确时保持上一次角度。
 * @param x 加速度计水平方向重力分量
 * @param y 加速度计垂直方向重力分量
 * @param currentRotation 上一次生效的旋转角度
 * @returns 缩略图应施加的旋转角度
 */
export function resolveMediaPreviewRotation(x: number, y: number, currentRotation: number = 0): number {
  const horizontalGravity = parseInt(String(x ?? 0))
  const verticalGravity = parseInt(String(y ?? 0))
  const horizontalStrength = Math.abs(horizontalGravity)
  const verticalStrength = Math.abs(verticalGravity)
  if (horizontalStrength < 0.55 && verticalStrength < 0.55) return currentRotation
  if (Math.abs(horizontalStrength - verticalStrength) < 0.12) return currentRotation
  if (horizontalStrength > verticalStrength) return horizontalGravity > 0 ? -90 : 90
  return verticalGravity > 0 ? 180 : 0
}

/**
 * 返回手机当前姿态相对照片拍摄姿态的最短旋转差值，避免横拍照片初次显示时被再次旋转。
 * @param currentRotation 手机当前姿态对应的旋转角度
 * @param captureRotation 照片拍摄时记录的旋转角度
 * @returns 介于 -180 与 180 之间的最短旋转差值
 */
export function resolveMediaPreviewRotationDelta(currentRotation: number, captureRotation: number): number {
  let rotationDelta = (parseInt(String(currentRotation ?? 0)) - parseInt(String(captureRotation ?? 0))) % 360
  if (rotationDelta > 180) rotationDelta -= 360
  if (rotationDelta < -180) rotationDelta += 360
  return rotationDelta
}