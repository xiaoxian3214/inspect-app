import { openSchema } from '@/uni_modules/uts-openSchema'

/**
 * 校验网页 scheme 后通过跨平台 UTS 插件交给系统浏览器，不直接调用原生 SDK。
 * @param url 需要打开的 http/https 链接
 * @returns 地址非法或插件抛错返回 false；true 表示打开请求已提交，iOS 最终打开结果为异步
 */
export function openUrlInSystemBrowser(url: string): boolean {
	const target = url.trim()
	if (!target.startsWith('http://') && !target.startsWith('https://')) return false
	try {
		openSchema(target)
		return true
	} catch (error) {
		console.warn('[openUrlInSystemBrowser] 系统未能打开外部链接', { url: target, error })
		return false
	}
}
