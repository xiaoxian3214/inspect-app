/**
 * 返回计划对象中用于远程操作和本地匹配的稳定计划 ID。
 */
export function getPlanOperationId(item) {
  const candidates = [
    item?.plan?.id,
    item?.plan?.planId,
    item?.planId,
    item?.id,
    item?.raw?.planId,
    item?.raw?.id,
    item?.reportId
  ]
  const found = candidates.find((value) => value !== undefined && value !== null && String(value).trim() !== '')
  return found === undefined ? '' : String(found).trim()
}

/**
 * 将页面状态值归一化为 H5 使用的数字状态。
 */
export function normalizeSearchStatus(status) {
  if (typeof status === 'number') return status
  const text = String(status ?? '').trim()
  if (text === '0' || text === 'planned' || text === 'NEW' || text === 'DOWNLOADED') return 0
  if (text === '1' || text === '2' || text === 'progress' || text === 'DRAFT' || text === 'IN_PROGRESS') return 1
  if (text === '3' || text === 'report' || text === 'DONE' || text === 'COMPLETED') return 3
  return -1
}

/**
 * 把 yyyy-MM-dd 日期转换为本地当天边界对应的 ISO 字符串。
 */
export function toDateBoundaryIso(value, endOfDay: boolean = false) {
  const dateText = String(value ?? '').trim()
  if (dateText === '') return ''
  const timeText = endOfDay ? '23:59:59.999' : '00:00:00.000'
  const date = new Date(`${dateText}T${timeText}`)
  if (Number.isNaN(date.getTime())) return ''
  return date.toISOString()
}

/**
 * 根据关键字和筛选值构建与 H5 一致的搜索请求参数。
 */
export function buildSearchParams(keyword, filters: any = {}) {
  const params = { keyword: String(keyword ?? '').trim() }
  const normalizedStatus = normalizeSearchStatus(filters?.status)
  const inspectType = String(filters?.inspectType ?? '').trim()
  const startDate = toDateBoundaryIso(filters?.startDate, false)
  const endDate = toDateBoundaryIso(filters?.endDate, true)
  if (normalizedStatus >= 0) params.status = normalizedStatus
  if (inspectType !== '') params.inspectType = inspectType
  if (startDate !== '') params.startDate = startDate
  if (endDate !== '') params.endDate = endDate
  return params
}

/**
 * 使用同 ID 的完整本地记录覆盖远程搜索记录，保留离线编辑状态。
 */
export function mergeRemoteWithLocal(remoteRecords, localPlans) {
  const localById = new Map()
  for (const localPlan of Array.isArray(localPlans) ? localPlans : []) {
    const planId = getPlanOperationId(localPlan)
    if (planId !== '') localById.set(planId, localPlan)
  }
  return (Array.isArray(remoteRecords) ? remoteRecords : []).map((record) => {
    return localById.get(getPlanOperationId(record)) || record
  })
}

/**
 * 返回计划的检查类型编码，兼容远程、本地和 raw 包装结构。
 */
export function getItemInspectType(item) {
  return firstNonEmptyText([
    item?.plan?.inspectType, item?.inspectType, item?.raw?.inspectType,
    item?.plan?.inspectTypeName, item?.inspectTypeName, item?.raw?.inspectTypeName
  ], '').trim()
}

/** 为卡片显示验货类型名称；拆分生成的 plan 缺少类型时保留原卡片的名称或编码。 */
export function getPlanInspectTypeLabel(item) {
  return firstNonEmptyText([
    item?.plan?.inspectTypeName, item?.plan?.inspectType,
    item?.inspectTypeName, item?.inspectType,
    item?.raw?.inspectTypeName, item?.raw?.inspectType
  ], '验货')
}

/**
 * 返回计划的工厂号，供合并选择兼容性判断使用。
 */
export function getItemFactoryNo(item) {
  return String(item?.plan?.factoryNo ?? item?.factoryNo ?? item?.raw?.factoryNo ?? '').trim()
}

/**
 * 返回计划的货类，供合并选择兼容性判断使用。
 */
export function getItemGoodsClass(item) {
  return String(item?.plan?.goodsClass ?? item?.goodsClass ?? item?.raw?.goodsClass ?? '').trim()
}

/**
 * 判断计划是否满足 H5 合并流程的基础资格。
 */
export function isBaseMergeEligible(item, inspectType) {
  const lockFlag = parseInt(String(item?.plan?.lockFlag ?? item?.lockFlag ?? item?.raw?.lockFlag ?? 0))
  const status = normalizeSearchStatus(item?.status ?? item?.plan?.status ?? item?.raw?.status)
  const mergeType = parseInt(String(item?.plan?.mergeType ?? item?.mergeType ?? item?.raw?.mergeType ?? 0))
  const targetInspectType = String(inspectType ?? '').trim()
  return lockFlag === 0
    && status === 0
    && mergeType !== 2
    && targetInspectType !== ''
    && getItemInspectType(item) === targetInspectType
}

/**
 * 判断计划是否与已选合并锚点保持工厂号、货类和检查类型一致。
 */
export function isMergeSelectable(item, inspectType, anchorItem: any | null = null) {
  if (!isBaseMergeEligible(item, inspectType)) return false
  if (anchorItem == null) return true
  return getItemFactoryNo(item) === getItemFactoryNo(anchorItem)
    && getItemGoodsClass(item) === getItemGoodsClass(anchorItem)
    && getItemInspectType(item) === getItemInspectType(anchorItem)
}

/** 返回 H5 分组全选目标：未选时取最大兼容组，已有锚点时只取同条件计划。 */
export function getMergeGroupTargets(group, inspectType, selectedItems: any[] = []) {
  const items = Array.isArray(group?.items) ? group.items : []
  if (selectedItems.length > 0) {
    const anchor = selectedItems[0]
    return items.filter((item) => getPlanOperationId(item) !== '' && isMergeSelectable(item, inspectType, anchor))
  }
  const buckets = new Map()
  for (const item of items) {
    if (getPlanOperationId(item) === '' || !isBaseMergeEligible(item, inspectType)) continue
    const key = `${getItemFactoryNo(item)}||${getItemGoodsClass(item)}||${getItemInspectType(item)}`
    if (!buckets.has(key)) buckets.set(key, [])
    buckets.get(key).push(item)
  }
  let largest = []
  for (const bucket of buckets.values()) {
    if (bucket.length > largest.length) largest = bucket
  }
  return largest
}

/** 按 H5 合并响应结构提取用于后续下载的父计划 ID，兼容直接返回 ID。 */
export function getMergedPlanId(result) {
  if (typeof result === 'string' || typeof result === 'number') return String(result).trim()
  const data = result?.data
  const candidates = [
    result?.id, result?.planId, result?.reportId,
    typeof data === 'string' || typeof data === 'number' ? data : null,
    data?.id, data?.planId, data?.reportId, result?.parentPlanId
  ]
  const found = candidates.find((value) => value !== undefined && value !== null && String(value).trim() !== '')
  return found === undefined ? '' : String(found).trim()
}

/** 从候选字段中取第一个非空文本，避免接口空字符串覆盖后备展示值。 */
export function firstNonEmptyText(values: (any | null)[], fallback: string): string {
  const found = values.find((value) => value !== undefined && value !== null && String(value).trim() !== '')
  return found == null ? fallback : found.toString()
}

/** 生成 H5 合并确认表格的单号、款号#批次和产品名称三列。 */
export function getMergePreviewRow(item) {
  const plan = item?.plan ?? item ?? {}
  const orderNo = firstNonEmptyText([plan?.clientOrderNo, item?.clientOrderNo, plan?.domeNo, item?.domeNo, item?.planNo], '未分组')
  const itemNo = firstNonEmptyText([plan?.subGoodsNo, item?.subGoodsNo], '-')
  const batchNo = firstNonEmptyText([plan?.batchNo, item?.batchNo], '-')
  const productName = firstNonEmptyText([plan?.goodsName, item?.goodsName, plan?.goodsCname, item?.goodsCname, item?.productName], '-')
  return { orderNo, itemBatch: `${itemNo}#${batchNo}`, productName }
}

/** 合并成功后仅更新来源卡片的合并标记和父计划 ID，不修改未参与的列表记录。 */
export function markMergedSourcePlans(items, sourcePlanIds, mergedPlanId) {
  const sourceIds = new Set(sourcePlanIds.map((id) => String(id)))
  return items.map((item) => {
    if (!sourceIds.has(getPlanOperationId(item))) return item
    return {
      ...item,
      mergeType: 2,
      parentPlanId: mergedPlanId,
      plan: { ...(item?.plan ?? {}), mergeType: 2, parentPlanId: mergedPlanId },
      raw: { ...(item?.raw ?? {}), mergeType: 2, parentPlanId: mergedPlanId }
    }
  })
}

/** 仅允许未锁定、已定计划且已合并的成员执行拆分。 */
export function isSplitAvailable(item) {
  const lockFlag = parseInt(String(item?.plan?.lockFlag ?? item?.lockFlag ?? item?.raw?.lockFlag ?? 0))
  const mergeType = parseInt(String(item?.plan?.mergeType ?? item?.mergeType ?? item?.raw?.mergeType ?? 0))
  const status = normalizeSearchStatus(item?.status ?? item?.plan?.status ?? item?.raw?.status)
  return mergeType === 2 && lockFlag === 0 && status === 0
}

/** 拆分成功后同步来源卡片的合并类型，保持其他计划对象不变。 */
export function markSplitSourcePlans(items, sourcePlanIds) {
  const sourceIds = new Set(sourcePlanIds.map((id) => String(id)))
  return items.map((item) => {
    if (!sourceIds.has(getPlanOperationId(item))) return item
    return {
      ...item,
      mergeType: 1,
      plan: { ...(item?.plan ?? {}), mergeType: 1 },
      raw: { ...(item?.raw ?? {}), mergeType: 1 }
    }
  })
}

/** 搜索结果中将已释放的计划及同一合并组成员一起恢复为未锁定状态。 */
export function markReleasedGroupPlans(items, releasedIds, parentPlanId) {
  const ids = new Set((releasedIds ?? []).map((id) => String(id)))
  const parentId = String(parentPlanId ?? '').trim()
  return items.map((item) => {
    if (!ids.has(getPlanOperationId(item)) && (parentId === '' || getItemParentPlanId(item) !== parentId)) return item
    return {
      ...item,
      lockFlag: 0,
      downloadedAt: '',
      lockStatus: '',
      plan: { ...(item?.plan ?? {}), lockFlag: 0 },
      raw: { ...(item?.raw ?? {}), lockFlag: 0 }
    }
  })
}

/**
 * 返回计划所属的合并父计划 ID；嵌套字段为空时回退到平铺或原始字段。
 */
export function getItemParentPlanId(item) {
  return firstNonEmptyText([item?.plan?.parentPlanId, item?.parentPlanId, item?.raw?.parentPlanId], '').trim()
}

/**
 * 合并远程和本地拆分预览记录，按计划 ID 去重并优先使用本地版本。
 */
export function buildSplitPreview(remoteRecords, localPlans, parentPlanId) {
  const targetParentId = String(parentPlanId ?? '').trim()
  const localById = new Map()
  for (const localPlan of Array.isArray(localPlans) ? localPlans : []) {
    const planId = getPlanOperationId(localPlan)
    if (planId !== '') localById.set(planId, localPlan)
  }
  const result = []
  const seenIds = new Set()
  for (const item of [...(Array.isArray(remoteRecords) ? remoteRecords : []), ...(Array.isArray(localPlans) ? localPlans : [])]) {
    if (getItemParentPlanId(item) !== targetParentId) continue
    const planId = getPlanOperationId(item)
    if (planId === '' || seenIds.has(planId)) continue
    seenIds.add(planId)
    result.push(localById.get(planId) || item)
  }
  return result
}

/**
 * 从复制接口的不同返回结构中提取新计划 ID。
 */
export function extractCopiedPlanId(result) {
  const candidates = [
    result?.id,
    result?.planId,
    result?.reportId,
    result?.plan?.id,
    result?.plan?.planId,
    result?.plan?.reportId,
    result?.report?.id,
    result?.report?.planId
  ]
  const found = candidates.find((value) => value !== undefined && value !== null && String(value).trim() !== '')
  return found === undefined ? '' : String(found).trim()
}
