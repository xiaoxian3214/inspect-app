/** 清单侧滑手势的落点结果：偏移量（像素）与最终停留在左侧、右侧或关闭状态。 */
type SwipeTarget = { offset: number, position: string }

/**
 * 根据触摸位移锁定手势方向；纵向手势交还页面滚动，横向手势用于清单侧滑。
 * @param deltaX 水平方向触摸位移
 * @param deltaY 垂直方向触摸位移
 * @param threshold 判定为有效手势的最小位移
 * @returns 'pending'、'horizontal' 或 'vertical'
 */
export function resolveGestureAxis(deltaX: number, deltaY: number, threshold: number = 10): string {
  const safeDeltaX = Math.abs(parseInt(String(deltaX ?? 0)))
  const safeDeltaY = Math.abs(parseInt(String(deltaY ?? 0)))
  const safeThreshold = Math.max(1, parseInt(String(threshold ?? 10)))
  if (Math.max(safeDeltaX, safeDeltaY) < safeThreshold) return 'pending'
  return safeDeltaX > safeDeltaY ? 'horizontal' : 'vertical'
}

/**
 * 将清单滑动位移限制在 H5 左右操作区宽度内。
 * @param offset 当前滑动位移
 * @param leftWidth 左侧快捷操作区宽度
 * @param rightWidth 右侧结果操作区宽度
 * @returns 收敛到左右操作区宽度范围内的位移
 */
export function clampSwipeOffset(offset: number, leftWidth: number, rightWidth: number): number {
  const safeLeftWidth = Math.max(0, parseInt(String(leftWidth ?? 0)))
  const safeRightWidth = Math.max(0, parseInt(String(rightWidth ?? 0)))
  return Math.max(-safeRightWidth, Math.min(safeLeftWidth, parseInt(String(offset ?? 0))))
}

/**
 * 根据手指起始位置与横向移动距离计算当前清单滑动位移。
 * @param startOffset 手指按下时的滑动位移
 * @param deltaX 本次横向触摸位移
 * @param leftWidth 左侧快捷操作区宽度
 * @param rightWidth 右侧结果操作区宽度
 * @returns 当前应呈现的滑动位移
 */
export function resolveSwipeMove(startOffset: number, deltaX: number, leftWidth: number, rightWidth: number): number {
  return clampSwipeOffset(parseInt(String(startOffset ?? 0)) + parseInt(String(deltaX ?? 0)), leftWidth, rightWidth)
}

/**
 * 根据松手位移决定打开左侧快捷状态、右侧四种结果操作或回到关闭状态。
 * @param offset 松手时的滑动位移
 * @param leftWidth 左侧快捷操作区宽度
 * @param rightWidth 右侧结果操作区宽度
 * @param threshold 触发打开操作区的最小位移
 * @returns 松手后停留状态的偏移量与位置
 */
export function resolveSwipeTarget(offset: number, leftWidth: number, rightWidth: number, threshold: number = 48): SwipeTarget {
  const safeOffset = parseInt(String(offset ?? 0))
  const safeThreshold = Math.max(1, parseInt(String(threshold ?? 48)))
  if (safeOffset >= safeThreshold) return { offset: Math.max(0, parseInt(String(leftWidth ?? 0))), position: 'left' }
  if (safeOffset <= -safeThreshold) return { offset: -Math.max(0, parseInt(String(rightWidth ?? 0))), position: 'right' }
  return { offset: 0, position: 'closed' }
}

/**
 * 根据手势起始展开状态和反向拖动距离决定松手结果，使已展开操作可短距离拖回关闭。
 * @param offset 松手时的滑动位移
 * @param startOffset 手指按下时的滑动位移
 * @param deltaX 本次横向触摸位移
 * @param leftWidth 左侧快捷操作区宽度
 * @param rightWidth 右侧结果操作区宽度
 * @param threshold 判定为反向拖回的最小位移
 * @returns 松手后停留状态的偏移量与位置
 */
export function resolveSwipeRelease(offset: number, startOffset: number, deltaX: number, leftWidth: number, rightWidth: number, threshold: number = 48): SwipeTarget {
  const safeStartOffset = parseInt(String(startOffset ?? 0))
  const safeDeltaX = parseInt(String(deltaX ?? 0))
  const safeThreshold = Math.max(1, parseInt(String(threshold ?? 48)))
  if (safeStartOffset < 0) {
    if (safeDeltaX >= safeThreshold) return { offset: 0, position: 'closed' }
    return { offset: -Math.max(0, parseInt(String(rightWidth ?? 0))), position: 'right' }
  }
  if (safeStartOffset > 0) {
    if (safeDeltaX <= -safeThreshold) return { offset: 0, position: 'closed' }
    return { offset: Math.max(0, parseInt(String(leftWidth ?? 0))), position: 'left' }
  }
  return resolveSwipeTarget(offset, leftWidth, rightWidth, threshold)
}
/**
 * 将手势位移换算成与样式表一致的 rpx 展示位移。
 *
 * 说明：`uni.rpx2px` 在 Android 上按 `scaledDensity`（含系统字体缩放）把 rpx 换算成像素，
 * 系统字体放大时会小于 CSS 中真实的 rpx 宽度；若直接把像素位移写进 transform，
 * 右滑展开距离会短一截，最左侧【合格】结果就被清单内容遮住。
 * 这里先按操作区像素宽度归一化，再乘以样式里声明的 rpx 宽度，
 * 保证完全展开时位移与操作区宽度严格相等（-480rpx / 120rpx）。
 *
 * @param offsetPx 当前手势位移（像素，负值展开右侧结果，正值展开左侧快捷状态）
 * @param actionWidthPx 操作区运行时像素宽度（与手势阈值同源的换算结果）
 * @param actionWidthRpx 操作区在样式中声明的 rpx 设计宽度
 * @returns 与操作区 rpx 宽度严格对齐的展示位移（rpx）
 */
export function resolveSwipeVisualOffsetRpx(offsetPx: number, actionWidthPx: number, actionWidthRpx: number): number {
  const safeOffset = parseInt(String(offsetPx ?? 0))
  const safeWidthPx = Math.max(0, parseInt(String(actionWidthPx ?? 0)))
  const safeWidthRpx = Math.max(0, parseInt(String(actionWidthRpx ?? 0)))
  if (safeOffset === 0) return 0
  if (safeWidthPx <= 0) return safeOffset < 0 ? -safeWidthRpx : safeWidthRpx
  const ratio = Math.max(-1, Math.min(1, safeOffset / safeWidthPx))
  return Math.round(ratio * safeWidthRpx * 100) / 100
}
