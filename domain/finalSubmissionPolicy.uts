/**
 * 判断照片记录是否包含能够参与提交校验的本地或服务端媒体信息。
 * @param photo 单条照片记录
 * @returns 是否为有效照片记录（已删除记录直接视为无效）
 */
function isPhotoRecord(photo: UTSJSONObject | null): boolean {
  if (photo == null || typeof photo !== 'object' || photo?.deleted === true) return false
  return Boolean(
    photo?.photoId
    || photo?.id
    || photo?.localPath
    || photo?.fileId
    || photo?.filePath
    || photo?.thumbnailPath
    || photo?.uploadStatus
  )
}

/**
 * 判断照片是否已经具备服务端文件标识或明确的上传成功状态。
 * @param photo 单条照片记录
 * @returns 已上传（或无需上传）返回 true，仍需上传返回 false
 */
export function isPhotoUploaded(photo: UTSJSONObject | null): boolean {
  if (!isPhotoRecord(photo)) return true
  if (String(photo?.fileId ?? '').trim() !== '') return true
  const status = String(photo?.uploadStatus ?? '').trim().toLowerCase()
  return status === 'done' || status === 'success' || status === 'uploaded'
}

/**
 * 判断 draft 照片是否仍被某个已保存的疵点持有：
 * 疵点编辑中暂存的 draft 照片在“保存疵点”时才激活上传、“取消编辑”时删除；
 * 一旦没有任何存活疵点持有它（如中途杀进程残留），它既不会被上传也无法由用户处理，
 * 属于可丢弃残留，不应永远阻断最终提交。
 * @param photo 单条照片记录
 * @param defects 当前报告的全部疵点记录
 * @returns 是否仍被存活疵点持有
 */
function isDraftHeldByLiveDefect(photo: UTSJSONObject | null, defects: UTSJSONObject[] | null): boolean {
  if (String(photo?.ownerType ?? '').trim().toLowerCase() !== 'defect') return false
  const ownerIds = new Set<string>()
  ;(Array.isArray(defects) ? defects : ([] as UTSJSONObject[])).forEach((defect) => {
    const defectId = String(defect?.defectId ?? defect?.id ?? '').trim()
    if (defectId !== '') ownerIds.add(defectId)
  })
  if (ownerIds.size === 0) return false
  const ownerId = String(photo?.ownerId ?? photo?.defectId ?? '').trim()
  return ownerId !== '' && ownerIds.has(ownerId)
}

/**
 * 汇总最终提交前的图片状态，并返回可直接展示给用户的阻断原因。
 * defects 为当前报告的疵点列表：仍被存活疵点持有的 draft 照片照常阻断（等待用户保存/取消疵点），
 * 无人持有的孤儿 draft 视为残留直接忽略。
 * @param photos 当前报告的全部图片记录
 * @param defects 当前报告的全部疵点记录，缺省时按空列表处理
 * @returns 含 ready、数量统计和阻断提示文案的结果对象
 */
export function evaluateFinalSubmissionPhotos(photos: UTSJSONObject[] | null, defects: UTSJSONObject[] | null = null): UTSJSONObject {
  const source = Array.isArray(photos) ? photos.filter(isPhotoRecord) : ([] as UTSJSONObject[])
  const unfinished = source.filter((photo) => {
    if (isPhotoUploaded(photo)) return false
    const status = String(photo?.uploadStatus ?? '').trim().toLowerCase()
    return !(status === 'draft' && !isDraftHeldByLiveDefect(photo, defects))
  })
  const failedStatuses = new Set(['failed', 'error', 'needs_attention'])
  const failedCount = unfinished.filter((photo) => {
    return failedStatuses.has(String(photo?.uploadStatus ?? '').trim().toLowerCase())
  }).length
  const pendingCount = unfinished.length
  const draftCount = source.filter((photo) => {
    if (isPhotoUploaded(photo)) return false
    const status = String(photo?.uploadStatus ?? '').trim().toLowerCase()
    return status === 'draft' && !isDraftHeldByLiveDefect(photo, defects)
  }).length

  return {
    ready: pendingCount === 0,
    totalCount: source.length,
    uploadedCount: source.length - pendingCount,
    pendingCount,
    failedCount,
    draftCount,
    message: pendingCount > 0
      ? `仍有 ${pendingCount} 张图片未上传完成，请联网后重试`
      : ''
  }
}

/**
 * 按 H5 规则确认本次提交的计划已经成为报告；合并组其他成员由本地共享报告一并更新。
 * @param detail 报告详情对象
 * @param currentPlanId 当前提交的计划标识
 * @returns 当前计划是否已进入已报告状态
 */
export function isCurrentPlanReported(detail: UTSJSONObject | null, currentPlanId: string): boolean {
  /**
   * 将服务端状态值归一为是否已报告。
   * @param status 服务端返回的计划状态原始值
   * @returns 是否为已完成/已报告状态
   */
  const reported = (status: string | number | null) => {
    const raw = String(status ?? '').trim()
    if (raw === '3') return true
    const text = raw.toUpperCase()
    return text === 'COMPLETED' || text === 'DONE' || text === 'SUBMITTED' || text === 'REPORTED'
  }
  const plans = Array.isArray(detail?.inspectionPlans) ? detail.inspectionPlans : ([] as UTSJSONObject[])
  const planId = String(currentPlanId ?? '').trim()
  const current = plans.find((plan) => String(plan?.id ?? plan?.planId ?? plan?.reportId ?? '').trim() === planId)
    ?? plans[0] ?? detail?.plan ?? detail?.report
  return reported(current?.status) || reported(detail?.plan?.status)
}

/**
 * 最终生成后有限次重查当前计划状态，允许服务端短暂延迟但绝不重复调用报告生成接口。
 * @param loadDetail 重新拉取报告详情的函数
 * @param currentPlanId 当前提交的计划标识
 * @param attempts 最大重查次数
 * @param delayMs 每次重查之间的等待毫秒数
 * @returns 重查期间计划是否进入已报告状态
 */
export async function waitForCurrentPlanReported(loadDetail: (planId: string) => Promise<UTSJSONObject>, currentPlanId: string, attempts: number = 3, delayMs: number = 500): Promise<boolean> {
  for (let attempt = 0; attempt < attempts; attempt += 1) {
    const detail = await loadDetail(currentPlanId)
    if (isCurrentPlanReported(detail, currentPlanId)) return true
    if (attempt + 1 < attempts) await new Promise((resolve) => setTimeout(resolve, delayMs))
  }
  return false
}