/**
 * 判断照片记录是否包含能够参与提交校验的本地或服务端媒体信息。
 */
function isPhotoRecord(photo) {
  if (photo == null || typeof photo !== 'object' || photo?.deleted === true) return false
  return Boolean(
    photo?.photoId
    || photo?.id
    || photo?.localPath
    || photo?.fileId
    || photo?.filePath
    || photo?.thumbnailPath
    || photo?.uploadStatus
  )
}

/**
 * 判断照片是否已经具备服务端文件标识或明确的上传成功状态。
 */
export function isPhotoUploaded(photo) {
  if (!isPhotoRecord(photo)) return true
  if (String(photo?.fileId ?? '').trim() !== '') return true
  const status = String(photo?.uploadStatus ?? '').trim().toLowerCase()
  return status === 'done' || status === 'success' || status === 'uploaded'
}

/**
 * 汇总最终提交前的图片状态，并返回可直接展示给用户的阻断原因。
 */
export function evaluateFinalSubmissionPhotos(photos) {
  const source = Array.isArray(photos) ? photos.filter(isPhotoRecord) : []
  const unfinished = source.filter((photo) => !isPhotoUploaded(photo))
  const failedStatuses = new Set(['failed', 'error', 'needs_attention'])
  const failedCount = unfinished.filter((photo) => {
    return failedStatuses.has(String(photo?.uploadStatus ?? '').trim().toLowerCase())
  }).length
  const pendingCount = unfinished.length

  return {
    ready: pendingCount === 0,
    totalCount: source.length,
    uploadedCount: source.length - pendingCount,
    pendingCount,
    failedCount,
    message: pendingCount > 0
      ? `仍有 ${pendingCount} 张图片未上传完成，请联网后重试`
      : ''
  }
}

/** 按 H5 规则确认本次提交的计划已经成为报告；合并组其他成员由本地共享报告一并更新。 */
export function isCurrentPlanReported(detail, currentPlanId) {
  const reported = (status) => {
    const raw = String(status ?? '').trim()
    if (raw === '3') return true
    const text = raw.toUpperCase()
    return text === 'COMPLETED' || text === 'DONE' || text === 'SUBMITTED' || text === 'REPORTED'
  }
  const plans = Array.isArray(detail?.inspectionPlans) ? detail.inspectionPlans : []
  const planId = String(currentPlanId ?? '').trim()
  const current = plans.find((plan) => String(plan?.id ?? plan?.planId ?? plan?.reportId ?? '').trim() === planId)
    ?? plans[0] ?? detail?.plan ?? detail?.report
  return reported(current?.status) || reported(detail?.plan?.status)
}

/** 最终生成后有限次重查当前计划状态，允许服务端短暂延迟但绝不重复调用报告生成接口。 */
export async function waitForCurrentPlanReported(loadDetail, currentPlanId, attempts: number = 3, delayMs: number = 500) {
  for (let attempt = 0; attempt < attempts; attempt += 1) {
    const detail = await loadDetail(currentPlanId)
    if (isCurrentPlanReported(detail, currentPlanId)) return true
    if (attempt + 1 < attempts) await new Promise((resolve) => setTimeout(resolve, delayMs))
  }
  return false
}
