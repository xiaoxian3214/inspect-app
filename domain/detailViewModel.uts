/**
 * 检查项定位结果：本地数据键、命中的检查项行与服务端业务 ID。
 */
type ChecklistTarget = { key: string, item: UTSJSONObject | null, bizId: string }

/**
 * 安全解析可能来自服务端字符串字段的 JSON 数组。
 * value 为服务端多态字段（JSON 字符串、对象或数组）；返回解析出的动态行数组，无法解析时返回空数组。
 */
function parseRows(value: any): any[] {
  if (Array.isArray(value)) return value
  if (value != null && typeof value === 'object') return [value]
  if (typeof value !== 'string' || value.trim() === '') return [] as any[]
  try {
    const parsed = JSON.parse(value)
    if (Array.isArray(parsed)) return parsed
    return parsed != null && typeof parsed === 'object' ? [parsed] : ([] as any[])
  } catch (_) {
    return [] as any[]
  }
}

/**
 * 按 H5 的条码结果格式还原名称、码值与扫码格式，供本地和在线详情统一回显。
 * value 为服务端 barcodeValue 字段（JSON 字符串、数组或对象）；返回过滤空行后的条码项数组。
 */
function parseBarcodeItems(value: any): UTSJSONObject[] {
  let rows = value
  if (typeof value === 'string' && value.trim() !== '') {
    try { rows = JSON.parse(value) }
    catch (_) { rows = [{ code: value }] }
  }
  return (Array.isArray(rows) ? rows : ([] as any[])).map((row) => typeof row === 'string'
    ? { name: '', code: row.trim(), format: '' }
    : { name: String(row?.name ?? row?.label ?? ''), code: String(row?.code ?? row?.value ?? row?.barcode ?? '').trim(), format: String(row?.format ?? row?.scanType ?? '') })
    .filter((row) => row.name !== '' || row.code !== '' || row.format !== '')
}

/**
 * 从服务端多语言字段中选择当前详情页可展示的文本。
 * value 为字符串或含 zh/en/vi 的多语言对象；返回首个可用文案，缺省返回空串。
 */
function pickLocalizedText(value: any): string {
  if (!value) return ''
  if (typeof value === 'string') return value
  if (typeof value === 'object') return (value?.zh || value?.en || value?.vi) ?? ''
  return ''
}

/**
 * 将 H5 检查项规格属性转换为弹层统一使用的 attrId、attrName 结构。
 * specAttributes 为服务端规格属性数组；返回补齐 attrId、attrName 的新数组，非数组时返回空数组。
 */
function normalizeSpecAttributes(specAttributes: any): UTSJSONObject[] {
  if (!Array.isArray(specAttributes)) return [] as UTSJSONObject[]
  return specAttributes.map((attribute) => ({
    ...attribute,
    attrId: attribute?.attrId ?? '',
    attrName: (attribute?.displayName || pickLocalizedText(attribute?.attrKey) || attribute?.attrName || attribute?.attrId) ?? ''
  }))
}

/**
 * 按服务端 sortOrder 对检查项节点排序。
 * left、right 为待比较的检查项节点；返回两者 sortOrder 的升序差值，缺省按 0 处理。
 */
function sortByOrder(left: UTSJSONObject, right: UTSJSONObject): number {
  return parseInt(String(left?.sortOrder ?? 0)) - parseInt(String(right?.sortOrder ?? 0))
}

/**
 * 按 H5 规则从 itemResults 重建章节树，兼容 parentItemId 指向行 ID 或 standardItemId。
 * itemResults 为服务端检查结果行；返回按 sortOrder 排序的章节树，无有效行时返回空数组。
 */
export function buildStandardItemsFromItemResults(itemResults: UTSJSONObject[] = []): UTSJSONObject[] {
  const rows = (Array.isArray(itemResults) ? itemResults : ([] as UTSJSONObject[])).filter((row) => !row?.sonPlanId)
  if (rows.length === 0) return [] as UTSJSONObject[]
  const nodeMap = new Map<string, any>()
  const nodeByStandardItemId = new Map<string, any>()
  rows.forEach((row) => {
    const rowId = String(row?.id ?? row?.itemResultId ?? '')
    const standardItemId = String(row?.standardItemId ?? row?.itemId ?? row?.standardId ?? '')
    const nodeId = rowId || standardItemId
    if (nodeId === '' || nodeMap.has(nodeId)) return
    const node = {
      ...row,
      id: nodeId,
      standardItemId,
      parentItemId: row?.parentItemId ? String(row.parentItemId) : '',
      itemName: (row?.localizedItemName || pickLocalizedText(row?.itemName)) ?? '',
      itemDescription: (row?.localizedItemDescription || pickLocalizedText(row?.itemDescription)) ?? '',
      itemType: row?.itemType ?? 'Standard',
      isRequired: parseInt(String(row?.isRequired ?? 0)),
      isPhotoRequired: parseInt(String(row?.isPhotoRequired ?? 0)),
      sortOrder: parseInt(String(row?.sortOrder ?? 0)),
      specAttributes: normalizeSpecAttributes(row?.specAttributes),
      children: [] as UTSJSONObject[]
    }
    nodeMap.set(nodeId, node)
    if (standardItemId !== '' && !nodeByStandardItemId.has(standardItemId)) nodeByStandardItemId.set(standardItemId, node)
  })
  const roots: UTSJSONObject[] = []
  nodeMap.forEach((node) => {
    const parentId = String(node?.parentItemId ?? '')
    if (parentId === '') { roots.push(node); return }
    const parent = nodeMap.get(parentId) || nodeByStandardItemId.get(parentId)
    if (parent && parent.id !== node.id) parent.children.push(node)
    else roots.push(node)
  })
  /** 递归排序章节及其检查项，保持 H5 服务端顺序；nodes 为待排序的章节或检查项数组。 */
  function sortNodes(nodes: UTSJSONObject[]): void {
    nodes.sort(sortByOrder)
    nodes.forEach((node) => { if (Array.isArray(node?.children) && node.children.length > 0) sortNodes(node.children) })
  }
  sortNodes(roots)
  return roots
}

/**
 * 将模板树中的检查点 ID 对齐到结果行主键，保留章节和模板展示字段。
 * standardItems 为模板章节树，itemResults 为服务端结果行；返回对齐后的章节树数组。
 */
function alignStandardItemsWithResults(standardItems: UTSJSONObject[], itemResults: UTSJSONObject[]): UTSJSONObject[] {
  const rows = (Array.isArray(itemResults) ? itemResults : ([] as UTSJSONObject[])).filter((row) => !row?.sonPlanId)
  const byId = new Map(rows.map((row) => [String(row?.id ?? row?.itemResultId ?? ''), row]))
  const byTemplate = new Map(rows.filter((row) => String(row?.standardItemId ?? '') !== '')
    .map((row) => [String(row.standardItemId), row]))
  /** 章节保留原 ID；模板检查点才需要映射到结果 ID；node 为待对齐的章节或检查点。 */
  function alignNode(node: UTSJSONObject): UTSJSONObject {
    if (Array.isArray(node?.children) && node.children.length > 0) return { ...node, children: node.children.map(alignNode) }
    const nodeId = String(node?.id ?? node?.itemId ?? '')
    if (byId.has(nodeId)) return node
    const result = byTemplate.get(String(node?.standardItemId ?? nodeId))
    if (result == null) return node
    return {
      ...node, id: String(result?.id ?? result?.itemResultId), standardItemId: String(result.standardItemId),
      itemType: node?.itemType ?? result?.itemType,
      specAttributes: node?.specAttributes ?? normalizeSpecAttributes(result?.specAttributes)
    }
  }
  return (Array.isArray(standardItems) ? standardItems : ([] as UTSJSONObject[])).map(alignNode)
}

/**
 * 将本地检查结果转换为 H5 使用的服务端状态枚举。
 * result 为本地检查结果值（pass/fail/pending/na）；返回对应服务端枚举，无法识别时返回 null。
 */
export function mapResultStatus(result: string): string | null {
  if (result === 'pass') return 'APPROVED'
  if (result === 'fail') return 'REJECTED'
  if (result === 'pending') return 'PENDING'
  if (result === 'na') return 'NA'
  return null
}

/**
 * 将服务端结果状态转换为详情页本地编辑值。
 * resultStatus 为服务端状态文本（兼容历史 PASS/FAIL 写法）；返回 pass/fail/pending/na，无法识别时返回空串。
 */
export function parseResultStatus(resultStatus: string): string {
  const status = String(resultStatus ?? '').toUpperCase()
  if (status === 'APPROVED' || status === 'PASS') return 'pass'
  if (status === 'REJECTED' || status === 'FAIL') return 'fail'
  if (status === 'PENDING') return 'pending'
  if (status === 'NA' || status === 'N/A') return 'na'
  return ''
}

/**
 * 生成 H5 清单本地数据键；合并验货子行使用双下划线隔离子计划。
 * itemId 为检查项或结果行 ID，sonPlanId 为合并子计划 ID；返回本地数据键。
 */
export function makeChecklistDataKey(itemId: string, sonPlanId: string = ''): string {
  const baseId = String(itemId ?? '').trim()
  const childPlanId = String(sonPlanId ?? '').trim()
  return childPlanId === '' ? baseId : `${baseId}__${childPlanId}`
}

/**
 * 生成 H5 提交到服务端的 itemResult 行 ID；合并子行使用单下划线。
 * itemId 为检查项或结果行 ID，sonPlanId 为合并子计划 ID；返回服务端行 ID。
 */
export function makeItemResultId(itemId: string, sonPlanId: string = ''): string {
  const baseId = String(itemId ?? '').trim()
  const childPlanId = String(sonPlanId ?? '').trim()
  return childPlanId === '' ? baseId : `${baseId}_${childPlanId}`
}

/**
 * 将服务端或中文严重等级统一为 H5 使用的 CRITICAL、MAJOR、MINOR。
 * rawValue 为等级编码，rawLabel 为等级中文或英文名；返回归一化等级，无法识别时回退 MINOR。
 */
export function normalizeDefectSeverity(rawValue: any, rawLabel: string = ''): string {
  const text = `${String(rawValue ?? '').toLowerCase()} ${String(rawLabel ?? '').toLowerCase()}`
  if (text.includes('critical') || text.includes('致命') || text.includes('极严重')) return 'CRITICAL'
  if (text.includes('major') || text.includes('主要') || text.includes('严重') || text.includes('大')) return 'MAJOR'
  if (text.includes('minor') || text.includes('次要') || text.includes('轻微') || text.includes('小')) return 'MINOR'
  const fallback = String(rawValue ?? 'MINOR').toUpperCase()
  return fallback === 'CRITICAL' || fallback === 'MAJOR' || fallback === 'MINOR' ? fallback : 'MINOR'
}

/**
 * 构建 H5 疵点页使用的等级数量和按配置顺序排列的分组。
 * defects 为疵点行，severityOptions 为服务端等级字典；返回 counts 计数与 groups 分组视图。
 */
export function buildDefectViewModel(defects: UTSJSONObject[], severityOptions: UTSJSONObject[] = []): UTSJSONObject {
  const rows = Array.isArray(defects) ? defects : ([] as UTSJSONObject[])
  const optionRows = Array.isArray(severityOptions) ? severityOptions : ([] as UTSJSONObject[])
  const defaultLabels = { CRITICAL: '致命缺陷', MAJOR: '主要缺陷', MINOR: '次要缺陷' }
  const groupMap = new Map<string, any>()
  optionRows.forEach((option) => {
    const key = normalizeDefectSeverity(option?.value, option?.label)
    groupMap.set(key, {
      key,
      label: option?.label || defaultLabels[key],
      order: parseInt(String(option?.sortOrder ?? 999)),
      affectedTotal: 0,
      items: [] as UTSJSONObject[]
    })
  })
  const counts = { critical: 0, major: 0, minor: 0 }
  rows.forEach((defect) => {
    const key = normalizeDefectSeverity(defect?.type || defect?.defectType || defect?.defectLevel, defect?.typeLabel || defect?.defectLevel)
    counts[key.toLowerCase()] += 1
    if (!groupMap.has(key)) {
      groupMap.set(key, { key, label: defaultLabels[key], order: key === 'CRITICAL' ? 1 : (key === 'MAJOR' ? 2 : 3), affectedTotal: 0, items: [] as UTSJSONObject[] })
    }
    const group = groupMap.get(key)
    group.items.push(defect)
    const quantity = parseInt(String(defect?.quantity ?? defect?.defectCount ?? 0))
    if (quantity > 0) group.affectedTotal += quantity
  })
  return {
    counts,
    groups: Array.from(groupMap.values()).filter((group) => group.items.length > 0).sort((left, right) => left.order - right.order)
  }
}

/**
 * 将空值格式化为订单信息页统一占位符，同时保留数字零。
 * value 为原始计划字段（任意动态值），fallback 为占位文本；返回原值、数字零或占位文本。
 */
function formatPlanValue(value: any, fallback: string = '-'): any {
  if (value === 0) return 0
  if (value === null || value === undefined || value === '') return fallback
  return value
}

/**
 * 构建与 H5 完全一致的十八个订单详情字段及显示值。
 * plan 为计划 JSON；返回 label、value 字段数组，供订单信息页直接渲染。
 */
export function buildPlanInfoFields(plan: UTSJSONObject): UTSJSONObject[] {
  const source = plan != null && typeof plan === 'object' ? plan : {}
  const inspectionLevel = formatPlanValue(source?.inspectionLevel, '-')
  const criticalAql = formatPlanValue(source?.criticalAql, '-')
  const majorAql = formatPlanValue(source?.majorAql, '-')
  const minorAql = formatPlanValue(source?.minorAql, '-')
  return [
    { label: '产品名称', value: formatPlanValue(source?.goodsName, '-') },
    { label: '需验数量', value: `${formatPlanValue(source?.requiredQuantity, 0)} 件` },
    { label: '样品数量', value: `${formatPlanValue(source?.sampleSize, 0)} 件` },
    { label: '供应商名称', value: formatPlanValue(source?.factoryName, '-') },
    { label: '交货日期', value: formatPlanValue(source?.deliveryDate, '-') },
    { label: '清单', value: formatPlanValue(source?.templateName, '-') },
    { label: '验货类型', value: formatPlanValue(source?.inspectType, '-') },
    { label: '抽样标准', value: `${inspectionLevel} ${criticalAql}/${majorAql}/${minorAql}` },
    { label: '供应商编号', value: formatPlanValue(source?.factoryNo, '-') },
    { label: '客户名称', value: formatPlanValue(source?.clientName, '-') },
    { label: '客户编号', value: formatPlanValue(source?.clientNo, '-') },
    { label: '货号', value: formatPlanValue(source?.subGoodsNo, '-') },
    { label: '客户订单号', value: formatPlanValue(source?.clientOrderNo, '-') },
    { label: '采购合同号', value: formatPlanValue(source?.domeNo, '-') },
    { label: '制造令', value: formatPlanValue(source?.produceNo, '-') },
    { label: '模具色卡号', value: formatPlanValue(source?.modelNo, '-') },
    { label: '批次', value: formatPlanValue(source?.batchNo, '-') },
    { label: '验货员', value: formatPlanValue(source?.inspectorName, '-') }
  ]
}

/**
 * 汇总合并验货所有子计划的需验数量和样品数量。
 * inspectionPlans 为合并成员计划行；返回 requiredQuantity、sampleSize 汇总值。
 */
export function buildMergedPlanSummary(inspectionPlans: UTSJSONObject[]): UTSJSONObject {
  const rows = Array.isArray(inspectionPlans) ? inspectionPlans : ([] as UTSJSONObject[])
  return rows.reduce((totals, row) => ({
    requiredQuantity: totals.requiredQuantity + (parseInt(String(row?.requiredQuantity)) ?? 0),
    sampleSize: totals.sampleSize + (parseInt(String(row?.sampleSize)) ?? 0)
  }), { requiredQuantity: 0, sampleSize: 0 })
}

/**
 * 按 H5 口径汇总报告的订单、已备好与预计抽样数量，合并验货按成员计划去重。
 * detail 为详情 JSON；返回 orderQuantity、readyQuantity、sampleQuantity 汇总值。
 */
export function buildFinishQuantityTotals(detail: UTSJSONObject): UTSJSONObject {
  const members = Array.isArray(detail?.inspectionPlans) && detail.inspectionPlans.length > 1
    ? detail.inspectionPlans : [detail?.plan ?? detail]
  const seen = new Set<string>()
  return members.reduce((totals, plan) => {
    const planId = String(plan?.id ?? plan?.planId ?? '')
    if (planId !== '' && seen.has(planId)) return totals
    if (planId !== '') seen.add(planId)
    return {
      orderQuantity: totals.orderQuantity + parseInt(String(plan?.requiredQuantity ?? 0)),
      readyQuantity: totals.readyQuantity + parseInt(String(plan?.finishQuantity ?? plan?.readyQuantity ?? 0)),
      sampleQuantity: totals.sampleQuantity + parseInt(String(plan?.sampleQuantity ?? plan?.sampleSize ?? 0))
    }
  }, { orderQuantity: 0, readyQuantity: 0, sampleQuantity: 0 })
}

/**
 * 将 H5 的章节树或已有扁平检查项转换为页面使用的一维列表。
 * standardItems 为章节树，fallbackItems 为兜底扁平检查项；返回带 sectionId、sectionName 的一维列表。
 */
export function flattenStandardItems(standardItems: UTSJSONObject[], fallbackItems: UTSJSONObject[] = []): UTSJSONObject[] {
  const rows: UTSJSONObject[] = []
  const sections = Array.isArray(standardItems) ? standardItems : ([] as UTSJSONObject[])
  sections.forEach((section) => {
    const children = Array.isArray(section?.children) ? section.children : ([] as UTSJSONObject[])
    if (children.length > 0) {
      children.forEach((item) => rows.push({
        ...item,
        sectionId: section?.id ?? '',
        sectionName: (section?.itemName || section?.name || section?.title) ?? ''
      }))
    } else if (section?.id || section?.itemId) {
      rows.push(section)
    }
  })
  if (rows.length > 0) return rows
  return Array.isArray(fallbackItems) ? fallbackItems : ([] as UTSJSONObject[])
}

/**
 * 将对象中有意义的字段覆盖到基础对象，避免空字符串覆盖远程产品信息。
 * base 为基础对象，overlay 为覆盖对象；返回合并后的新对象，不修改入参。
 */
function mergeNonEmptyFields(base: UTSJSONObject, overlay: UTSJSONObject): UTSJSONObject {
  const result = { ...(base ?? {}) }
  Object.keys(overlay ?? {}).forEach((key) => {
    const value = overlay[key]
    if (value !== undefined && value !== null && value !== '') result[key] = value
  })
  return result
}

/**
 * 按当前计划 ID 从 H5 inspectionPlans 详情包中选中产品计划，并合并显式 plan 字段。
 * detail 为详情 JSON，requestedPlanId 为请求的计划 ID；返回选中计划，缺失时回退首个成员或空对象。
 */
function resolveDetailPlan(detail: UTSJSONObject, requestedPlanId: string): UTSJSONObject {
  const explicitPlan = detail?.plan != null && typeof detail.plan === 'object' ? detail.plan : {}
  const plans = Array.isArray(detail?.inspectionPlans) ? detail.inspectionPlans : ([] as UTSJSONObject[])
  const normalizedPlanId = String(requestedPlanId ?? explicitPlan?.id ?? explicitPlan?.planId ?? '').trim()
  const matchedPlan = plans.find((plan) => {
    return String(plan?.id ?? plan?.planId ?? plan?.reportId ?? '').trim() === normalizedPlanId
  }) || null
  const fallbackPlan = matchedPlan || (plans.length > 0 ? plans[0] : {})
  return mergeNonEmptyFields(fallbackPlan, explicitPlan)
}

/**
 * 将服务端文件列表转换为 App 可直接展示和同步的照片记录。
 * fileList 为服务端文件行或路径数组，ownerId、ownerType 为归属信息；返回过滤空路径后的照片记录数组。
 */
function normalizeFileList(fileList: any, ownerId: string = '', ownerType: string = 'checklist'): UTSJSONObject[] {
  return (Array.isArray(fileList) ? fileList : ([] as any[])).map((file, index) => {
    if (typeof file === 'string') {
      return {
        photoId: `${ownerId}-remote-${index}`,
        ownerId,
        ownerType,
        filePath: file,
        uploadStatus: 'done'
      }
    }
    const fileId = String(file?.fileId ?? file?.id ?? '').trim()
    return {
      ...file,
      photoId: String(file?.photoId || fileId || `${ownerId}-remote-${index}`),
      ownerId: file?.ownerId || ownerId,
      ownerType: file?.ownerType || ownerType,
      fileId,
      filePath: (file?.filePath || file?.fileUrl || file?.url || file?.path) ?? '',
      thumbnailPath: (file?.thumbnailPath || file?.thumbPath) ?? '',
      uploadStatus: file?.uploadStatus || (fileId ? 'done' : 'pending')
    }
  }).filter((photo) => photo.fileId || photo.filePath || photo.localPath || photo.thumbnailPath)
}

/**
 * 根据 H5 itemResults 构建详情页可编辑的 checklistData。
 * itemResults 为服务端检查结果行；返回以本地数据键索引的检查项编辑数据对象。
 */
function buildChecklistData(itemResults: UTSJSONObject[]): UTSJSONObject {
  const data = {}
  ;(Array.isArray(itemResults) ? itemResults : ([] as UTSJSONObject[])).forEach((row) => {
    const rowId = String(row?.id ?? row?.itemResultId ?? '').trim()
    if (rowId === '') return
    const sonPlanId = String(row?.sonPlanId ?? '').trim()
    const baseItemId = row?.baseItemResultId
      ? String(row.baseItemResultId)
      : (sonPlanId && rowId.endsWith(`_${sonPlanId}`) ? rowId.slice(0, -(`_${sonPlanId}`.length)) : rowId)
    const key = makeChecklistDataKey(baseItemId, sonPlanId)
    const result = parseResultStatus(row?.resultStatus)
    const photos = normalizeFileList(row?.fileList, baseItemId, 'checklist')
    const measurements = parseRows(row?.specResult)
    const textGroups = parseRows(row?.textContent)
    const barcodeItems = parseBarcodeItems(row?.barcodeValue)
    const barcodeList = barcodeItems.map((item) => item.code).filter((code) => code !== '')
    const comment = String(row?.remarks ?? '')
    data[key] = {
      result,
      comment,
      photos,
      measurements,
      textGroups,
      barcode: barcodeList[0] ?? '',
      barcodeList,
      barcodeItems,
      completed: result !== '' || comment.trim() !== '' || photos.length > 0 || measurements.length > 0 || textGroups.length > 0 || barcodeList.length > 0
    }
  })
  return data
}

/**
 * 统一检查项草稿中的照片结构并补充所属检查项信息。
 * checklistData 为本地检查项编辑数据对象；返回照片结构归一化后的新对象。
 */
function normalizeChecklistData(checklistData: UTSJSONObject): UTSJSONObject {
  const normalized = {}
  Object.keys(checklistData ?? {}).forEach((itemId) => {
    const data = checklistData[itemId] ?? {}
    normalized[itemId] = {
      ...data,
      photos: normalizeFileList(data?.photos, itemId, 'checklist')
    }
  })
  return normalized
}

/**
 * 统一服务端和本地疵点结构，并还原疵点关联媒体。
 * defects 为疵点行；返回补齐 id、严重等级、数量与照片字段的疵点数组。
 */
function normalizeDefects(defects: UTSJSONObject[]): UTSJSONObject[] {
  return (Array.isArray(defects) ? defects : ([] as UTSJSONObject[])).map((defect, index) => {
    const defectId = String(defect?.defectId ?? defect?.id ?? `local-defect-${index}`)
    const sonPlanId = String(defect?.sonPlanId ?? '').trim()
    const checkItemResultId = String(defect?.checkItemResultId ?? defect?.itemResultId ?? '').trim()
    const derivedCheckItemId = sonPlanId && checkItemResultId.endsWith(`_${sonPlanId}`)
      ? checkItemResultId.slice(0, -(`_${sonPlanId}`.length))
      : checkItemResultId
    return {
      ...defect,
      id: defect?.id || defectId,
      defectId,
      type: (defect?.type || defect?.defectType || defect?.defectLevel) ?? 'MINOR',
      quantity: parseInt(String(defect?.commonFlag ?? (defect?.isCommon ? 1 : 0))) === 1 ? null : parseFloat(String(defect?.quantity ?? defect?.defectCount ?? 0)),
      description: (defect?.description || defect?.remark) ?? '',
      checkItemId: defect?.checkItemId || derivedCheckItemId,
      checkItemResultId,
      sonPlanId: sonPlanId || null,
      photos: normalizeFileList(defect?.photos || defect?.fileList, defectId, 'defect')
    }
  })
}

/**
 * 汇总检查项和疵点中的全部媒体记录并按稳定标识去重。
 * checklistData 为检查项编辑数据，defects 为疵点行，directPhotos 为详情直属媒体；返回按稳定标识去重后的媒体数组。
 */
export function collectDetailPhotos(checklistData: UTSJSONObject, defects: UTSJSONObject[], directPhotos: UTSJSONObject[] = []): UTSJSONObject[] {
  const photos: UTSJSONObject[] = []
  const seen = new Set<string>()
  const append = (photo: UTSJSONObject, ownerId: string = '', ownerType: string = '') => {
    if (photo == null || typeof photo !== 'object') return
    const normalized = {
      ...photo,
      ownerId: photo?.ownerId || ownerId,
      ownerType: photo?.ownerType || ownerType
    }
    const key = String(normalized?.photoId ?? normalized?.fileId ?? normalized?.localPath ?? normalized?.filePath ?? '')
    if (key === '' || seen.has(key)) return
    seen.add(key)
    photos.push(normalized)
  }
  ;(Array.isArray(directPhotos) ? directPhotos : ([] as UTSJSONObject[])).forEach((photo) => append(photo))
  Object.keys(checklistData ?? {}).forEach((itemId) => {
    ;(Array.isArray(checklistData[itemId]?.photos) ? checklistData[itemId].photos : ([] as UTSJSONObject[])).forEach((photo) => append(photo, itemId, 'checklist'))
  })
  ;(Array.isArray(defects) ? defects : ([] as UTSJSONObject[])).forEach((defect) => {
    const defectId = String(defect?.defectId ?? defect?.id ?? '')
    ;(Array.isArray(defect?.photos) ? defect.photos : ([] as UTSJSONObject[])).forEach((photo) => append(photo, defectId, 'defect'))
  })
  return photos
}

/**
 * 按已完成检查项数量计算 0 到 100 的验货进度。
 * checklistItems 为检查项列表，checklistData 为本地编辑数据；返回 0-100 的整数进度，无检查项时为 0。
 */
export function calculateDetailProgress(checklistItems: UTSJSONObject[], checklistData: UTSJSONObject): number {
  const items = (Array.isArray(checklistItems) ? checklistItems : ([] as UTSJSONObject[])).filter((item) => String(item?.sonPlanId ?? '') === '')
  if (items.length === 0) return 0
  const completed = items.filter((item) => {
    const itemId = String(item?.itemId ?? item?.id ?? '')
    const data = (checklistData?.[itemId] || item?.data) ?? {}
    return data?.completed === true
  }).length
  return Math.round((completed / items.length) * 100)
}

/**
 * 按 H5 的普通、锁定、待验/在验条件筛选复制目标，同时排除当前合并组的全部成员。
 * plans 为候选计划行，currentDetail 为当前详情；返回可用于复制的目标计划数组。
 */
export function filterCopyTargetPlans(plans: UTSJSONObject[], currentDetail: UTSJSONObject): UTSJSONObject[] {
  const ownPlan = currentDetail?.plan ?? {}
  const excludedIds = new Set([
    currentDetail?.planId, ownPlan?.id, ownPlan?.parentPlanId,
    ...(Array.isArray(currentDetail?.inspectionPlans) ? currentDetail.inspectionPlans.map((row) => row?.id ?? row?.planId) : ([] as any[]))
  ].map((id) => String(id ?? '').trim()).filter((id) => id !== ''))
  return (Array.isArray(plans) ? plans : ([] as UTSJSONObject[])).filter((row) => {
    const plan = row?.plan ?? row
    const id = String(plan?.id ?? plan?.planId ?? '').trim()
    const parentId = String(plan?.parentPlanId ?? row?.parentPlanId ?? '').trim()
    const status = parseInt(String(plan?.status ?? row?.status ?? 0))
    const mergeType = parseInt(String(plan?.mergeType ?? row?.mergeType ?? 0))
    const lockFlag = plan?.lockFlag ?? row?.lockFlag
    return id !== '' && !excludedIds.has(id) && !excludedIds.has(parentId)
      && mergeType === 0 && [0, 1].includes(status)
      && (lockFlag == null || parseInt(String(lockFlag)) === 1)
  })
}

/**
 * 联网原样展示搜索接口记录；离线才筛选当前验货员已锁定的本地普通计划。
 * remotePlans、localPlans 为远程与本地候选，currentDetail 为当前详情，inspectorId 为当前验货员，remoteAuthoritative 表示以远程为准。
 */
export function selectCopyTargetPlans(remotePlans: UTSJSONObject[], localPlans: UTSJSONObject[], currentDetail: UTSJSONObject, inspectorId: string, remoteAuthoritative: boolean): UTSJSONObject[] {
  if (remoteAuthoritative) return Array.isArray(remotePlans) ? remotePlans : ([] as UTSJSONObject[])
  const userId = String(inspectorId ?? '').trim()
  const candidates = filterCopyTargetPlans(localPlans, currentDetail)
  const seen = new Set<string>()
  const selected: UTSJSONObject[] = []
  for (const row of candidates) {
    const plan = row?.plan ?? row
    const id = String(plan?.id ?? plan?.planId ?? '').trim()
    if (seen.has(id)) continue
    if (parseInt(String(plan?.lockFlag ?? row?.lockFlag)) !== 1
      || (userId !== '' && String(plan?.inspectorId ?? row?.inspectorId ?? '').trim() !== userId)) continue
    seen.add(id)
    selected.push(plan)
  }
  return selected
}

/**
 * 仅展示有真实结果主键的主检查点及合并子检查点，并排除当前来源。
 * detail 为详情 JSON，sourceItemId 为当前来源检查项键；返回可批量移动的目标检查项数组。
 */
export function buildBatchMoveTargets(detail: UTSJSONObject, sourceItemId: string = ''): UTSJSONObject[] {
  const baseItems = (Array.isArray(detail?.checklistItems) ? detail.checklistItems : ([] as UTSJSONObject[]))
    .filter((item) => String(item?.sonPlanId ?? '').trim() === '')
  const plans = Array.isArray(detail?.inspectionPlans) ? detail.inspectionPlans : ([] as UTSJSONObject[])
  const results = Array.isArray(detail?.itemResults) ? detail.itemResults : ([] as UTSJSONObject[])
  const sourceKey = String(sourceItemId ?? '').trim()
  const targets: UTSJSONObject[] = []
  for (const item of baseItems) {
    const baseId = String(item?.baseItemId ?? item?.itemId ?? item?.id ?? '').trim()
    if (baseId === '') continue
    const standardId = String(item?.standardItemId ?? '').trim()
    const result = results.find((row) => !row?.sonPlanId && (
      String(row?.id ?? row?.itemResultId ?? '').trim() === baseId
      || (standardId !== '' && String(row?.standardItemId ?? '').trim() === standardId)
    ))
    const bizId = String(result?.id ?? result?.itemResultId ?? '').trim()
    if (bizId === '') continue
    const name = String(item?.itemName ?? item?.name ?? baseId)
    if (baseId !== sourceKey && bizId !== sourceKey) targets.push({ ...item, bizId, itemId: bizId, sonPlanId: '', name, subLabel: '' })
  }
  if (plans.length <= 1) return targets
  for (const plan of plans) {
    const sonPlanId = String(plan?.id ?? plan?.planId ?? '').trim()
    if (sonPlanId === '') continue
    const extra = [plan?.subGoodsNo, plan?.batchNo].map((value) => String(value ?? '').trim()).filter((value) => value !== '').join('#')
    const orderNo = String(plan?.clientOrderNo ?? '').trim()
    const subLabel = extra !== '' && orderNo !== '' ? `${orderNo}（${extra}）` : orderNo || extra || sonPlanId
    for (const item of baseItems) {
      const baseId = String(item?.baseItemId ?? item?.itemId ?? item?.id ?? '').trim()
      const localKey = makeChecklistDataKey(baseId, sonPlanId)
      if (baseId === '' || localKey === sourceKey) continue
      const standardId = String(item?.standardItemId ?? '').trim()
      const result = results.find((row) => String(row?.sonPlanId ?? '').trim() === sonPlanId && (
        String(row?.baseItemResultId ?? '').trim() === baseId
        || (standardId !== '' && String(row?.standardItemId ?? '').trim() === standardId)
        || String(row?.id ?? row?.itemResultId ?? '').trim() === `${baseId}_${sonPlanId}`
      ))
      const bizId = String(result?.id ?? result?.itemResultId ?? '').trim()
      if (bizId === '') continue
      targets.push({ ...item, bizId, itemId: localKey, baseItemId: baseId, sonPlanId, name: String(item?.itemName ?? item?.name ?? baseId), subLabel })
    }
  }
  return targets
}

/**
 * 将远程或本地报告详情归一化为 App 详情页统一数据结构。
 * source 为远程或本地详情 JSON，requestedPlanId 为请求的计划 ID；返回含检查项、疵点、照片与进度的统一详情对象。
 */
export function normalizeInspectionDetail(source: UTSJSONObject, requestedPlanId: string = ''): UTSJSONObject {
  const detail = source != null && typeof source === 'object' ? source : {}
  const plan = resolveDetailPlan(detail, requestedPlanId)
  const planId = String(requestedPlanId ?? plan?.id ?? detail?.planId ?? detail?.id ?? '').trim()
  const itemResults = Array.isArray(detail?.itemResults) ? detail.itemResults : ([] as UTSJSONObject[])
  const standardItems = Array.isArray(detail?.standardItems) && detail.standardItems.length > 0
    ? alignStandardItemsWithResults(detail.standardItems, itemResults)
    : buildStandardItemsFromItemResults(itemResults)
  const baseChecklistItems = flattenStandardItems(standardItems, detail?.checklistItems)
  const rawChecklistData = detail?.checklistData != null && typeof detail.checklistData === 'object' && Object.keys(detail.checklistData).length > 0
    ? detail.checklistData
    : buildChecklistData(itemResults)
  const checklistData = normalizeChecklistData(rawChecklistData)
  const defects = normalizeDefects(Array.isArray(detail?.defects)
    ? detail.defects
    : (Array.isArray(detail?.defectRecords) ? detail.defectRecords : ([] as UTSJSONObject[])))
  const itemsWithData: UTSJSONObject[] = []
  baseChecklistItems.forEach((item) => {
    const baseItemId = String(item?.baseItemId ?? item?.itemId ?? item?.id ?? '')
    itemsWithData.push({ ...item, itemId: baseItemId, baseItemId, sonPlanId: '', data: checklistData?.[baseItemId] ?? {} })
    Object.keys(checklistData).filter((key) => key.startsWith(`${baseItemId}__`)).forEach((key) => {
      const sonPlanId = key.slice(`${baseItemId}__`.length)
      itemsWithData.push({ ...item, itemId: key, baseItemId, sonPlanId, itemName: `${item?.itemName || item?.name || baseItemId} · 子计划`, data: checklistData[key] ?? {} })
    })
  })
  const photos = collectDetailPhotos(checklistData, defects, detail?.photos)
  return {
    ...detail,
    id: detail?.id || planId,
    planId,
    reportId: detail?.reportId || detail?.report?.id || planId,
    plan: { ...plan, id: plan?.id || planId },
    itemResults,
    standardItems,
    checklistItems: itemsWithData,
    checklistData,
    defects,
    photos,
    progress: calculateDetailProgress(itemsWithData, checklistData)
  }
}

/**
 * 判断下载记录是否具备离线验货所需的产品信息和可渲染清单定义。
 * detail 为本地详情 JSON；返回同时具备清单定义与产品信息时为 true。
 */
export function isInspectionDetailComplete(detail: UTSJSONObject): boolean {
  if (detail == null || typeof detail !== 'object') return false
  const rebuilt = buildStandardItemsFromItemResults(detail?.itemResults ?? ([] as UTSJSONObject[]))
  const hasChecklist = (Array.isArray(detail?.standardItems) && detail.standardItems.length > 0)
    || (Array.isArray(detail?.checklistItems) && detail.checklistItems.length > 0)
    || rebuilt.some((section) => Array.isArray(section?.children) && section.children.length > 0)
  if (!hasChecklist) return false
  const plan = resolveDetailPlan(detail, detail?.planId)
  return [plan?.goodsName, plan?.goodsCname, plan?.subGoodsNo, plan?.planNo, plan?.clientOrderNo]
    .some((value) => value !== undefined && value !== null && String(value).trim() !== '')
}

/**
 * 根据照片 ID、服务端文件 ID 或本地/服务端路径识别同一张媒体。
 * left、right 为待比较的两张媒体记录；返回任一稳定标识相同即为 true。
 */
function isSameDetailPhoto(left: UTSJSONObject, right: UTSJSONObject): boolean {
  const leftId = String(left?.photoId ?? left?.id ?? '').trim()
  const rightId = String(right?.photoId ?? right?.id ?? '').trim()
  const leftFileId = String(left?.fileId ?? '').trim()
  const rightFileId = String(right?.fileId ?? '').trim()
  const leftLocalPath = String(left?.localPath ?? '').trim()
  const rightLocalPath = String(right?.localPath ?? '').trim()
  const leftFilePath = String(left?.filePath ?? '').trim()
  const rightFilePath = String(right?.filePath ?? '').trim()
  return (leftId !== '' && leftId === rightId)
    || (leftFileId !== '' && leftFileId === rightFileId)
    || (leftLocalPath !== '' && leftLocalPath === rightLocalPath)
    || (leftFilePath !== '' && leftFilePath === rightFilePath)
}

/**
 * 为同一照片的本地 ID、服务端 ID 与路径建立可复用的合并键。
 * photo 为媒体记录；返回形如 photo:xx、file:xx、local:xx、remote:xx 的非空键数组。
 */
function detailPhotoKeys(photo: UTSJSONObject): string[] {
  return [
    ['photo', photo?.photoId ?? photo?.id],
    ['file', photo?.fileId],
    ['local', photo?.localPath],
    ['remote', photo?.filePath]
  ].filter((entry) => String(entry[1] ?? '').trim() !== '')
    .map((entry) => `${entry[0]}:${String(entry[1]).trim()}`)
}

/**
 * 保留详情快照中的原有媒体，并按稳定键线性回填照片表的上传状态。
 * existingPhotos 为详情内已有媒体，storedPhotos 为照片表最新记录；返回合并后的媒体数组。
 */
function mergeDetailPhotoLists(existingPhotos: UTSJSONObject[], storedPhotos: UTSJSONObject[]): UTSJSONObject[] {
  const merged = Array.isArray(existingPhotos) ? [...existingPhotos] : ([] as UTSJSONObject[])
  const indexes = new Map<string, number>()
  merged.forEach((photo, index) => detailPhotoKeys(photo).forEach((key) => indexes.set(key, index)))
  ;(Array.isArray(storedPhotos) ? storedPhotos : ([] as UTSJSONObject[])).forEach((photo) => {
    const keys = detailPhotoKeys(photo)
    const matchedKey = keys.find((key) => indexes.has(key))
    const index = matchedKey != null ? indexes.get(matchedKey) : merged.length
    merged[index] = index < merged.length ? { ...merged[index], ...photo } : photo
    detailPhotoKeys(merged[index]).forEach((key) => indexes.set(key, index))
  })
  return merged
}

/**
 * 将照片仓库中的最新上传状态合并回检查项、疵点和详情媒体集合，同时保留旧详情中未拆表的图片。
 * detail 为详情 JSON，photos 为照片表最新记录；返回合并媒体状态后的详情对象。
 */
export function mergeDetailPhotos(detail: UTSJSONObject, photos: UTSJSONObject[]): UTSJSONObject {
  const normalized = Array.isArray(detail?.checklistItems) && detail?.checklistData != null
    ? detail : normalizeInspectionDetail(detail, detail?.planId)
  const sourcePhotos = Array.isArray(photos) ? photos : ([] as UTSJSONObject[])
  const checklistPhotos = new Map<string, any[]>()
  const defectPhotos = new Map<string, any[]>()
  sourcePhotos.forEach((photo) => {
    const ownerType = String(photo?.ownerType ?? '')
    const ownerId = ownerType === 'checklist'
      ? String(photo?.dataKey ?? photo?.ownerId ?? '') : String(photo?.ownerId ?? '')
    const owners = ownerType === 'checklist' ? checklistPhotos : defectPhotos
    if (ownerType !== 'checklist' && ownerType !== 'defect') return
    if (!owners.has(ownerId)) owners.set(ownerId, [] as UTSJSONObject[])
    owners.get(ownerId).push(photo)
  })
  const checklistData = { ...(normalized?.checklistData ?? {}) }
  checklistPhotos.forEach((owned, itemId) => {
    if (checklistData[itemId] == null) return
    checklistData[itemId] = { ...checklistData[itemId], photos: mergeDetailPhotoLists(checklistData[itemId]?.photos, owned) }
  })
  const defects = (normalized?.defects ?? ([] as UTSJSONObject[])).map((defect) => {
    const defectId = String(defect?.defectId ?? defect?.id ?? '')
    const owned = defectPhotos.get(defectId)
    return owned == null ? defect : { ...defect, photos: mergeDetailPhotoLists(defect?.photos, owned) }
  })
  const checklistItems = (normalized?.checklistItems ?? ([] as UTSJSONObject[])).map((item) => {
    const itemId = String(item?.itemId ?? '')
    return checklistPhotos.has(itemId) ? { ...item, data: checklistData[itemId] } : item
  })
  return { ...normalized, checklistData, checklistItems, defects, photos: mergeDetailPhotoLists(normalized.photos, sourcePhotos) }
}

/**
 * 更新单个检查项编辑数据并重新计算详情进度和媒体集合。
 * detail 为详情 JSON，itemId 为本地数据键，patch 为本次编辑字段；返回更新后的详情对象。
 */
export function updateChecklistItem(detail: UTSJSONObject, itemId: string, patch: UTSJSONObject): UTSJSONObject {
  const normalized = Array.isArray(detail?.checklistItems) && detail?.checklistData != null
    ? detail : normalizeInspectionDetail(detail, detail?.planId)
  const normalizedItemId = String(itemId ?? '').trim()
  const current = normalized?.checklistData?.[normalizedItemId] ?? {}
  const nextData = { ...current, ...(patch ?? {}) }
  const currentPhotos = Array.isArray(current?.photos) ? current.photos : ([] as UTSJSONObject[])
  const patchedPhotos = Array.isArray(patch?.photos) ? patch.photos : currentPhotos
  const photosChanged = currentPhotos.length !== patchedPhotos.length
    || patchedPhotos.some((photo, index) => !isSameDetailPhoto(currentPhotos[index], photo))
  if (!photosChanged) nextData.photos = currentPhotos
  const hasExplicitCompleted = patch != null && typeof patch === 'object' && Object.prototype.hasOwnProperty.call(patch, 'completed')
  nextData.completed = hasExplicitCompleted
    ? patch.completed === true
    : (nextData?.completed === true
      || String(nextData?.result ?? '') !== ''
      || String(nextData?.comment ?? '').trim() !== ''
      || (Array.isArray(nextData?.photos) && nextData.photos.length > 0))
  const checklistData = { ...normalized.checklistData, [normalizedItemId]: nextData }
  const checklistItems = normalized.checklistItems.map((item) => {
    return item.itemId === normalizedItemId ? { ...item, data: nextData } : item
  })
  const retainedDirectPhotos = photosChanged ? (normalized.photos ?? ([] as UTSJSONObject[])).filter((photo) => {
    return !(photo?.ownerType === 'checklist' && String(photo?.ownerId ?? '') === normalizedItemId)
  }) : normalized.photos
  return {
    ...normalized,
    checklistData,
    checklistItems,
    photos: photosChanged ? collectDetailPhotos(checklistData, normalized.defects, retainedDirectPhotos) : retainedDirectPhotos,
    progress: calculateDetailProgress(checklistItems, checklistData)
  }
}

/**
 * 快速更新已加载检查项的四态结果和进度；不重建未改变的照片、疵点或章节树。
 * detail 为详情 JSON，itemId 为本地数据键，result 为新的四态结果值；返回更新后的详情对象。
 */
export function updateChecklistResult(detail: UTSJSONObject, itemId: string, result: string): UTSJSONObject {
  const key = String(itemId ?? '').trim()
  const checklistData = {
    ...(detail?.checklistData ?? {}),
    [key]: { ...(detail?.checklistData?.[key] ?? {}), result, completed: result !== 'pending' }
  }
  const checklistItems = (detail?.checklistItems ?? ([] as UTSJSONObject[])).map((item) => {
    return item.itemId === key ? { ...item, data: checklistData[key] } : item
  })
  return { ...detail, checklistData, checklistItems, progress: calculateDetailProgress(checklistItems, checklistData) }
}

/**
 * 深拷贝可序列化的检查项字段，避免复制后源计划与目标计划共享可变引用。
 * value 为任意可序列化值；返回深拷贝结果，无法序列化时原样返回。
 */
function cloneSerializableValue(value: any): any {
  if (value === undefined) return undefined
  try { return JSON.parse(JSON.stringify(value)) } catch (_) { return value }
}

/**
 * 按检查项 ID、标准项 ID 和合并子计划 ID 解析目标详情中的本地数据键及服务端业务 ID。
 * detail 为目标详情，requestedItemId 为请求的检查项 ID，sonPlanId 为合并子计划 ID；返回 key、item、bizId 定位结果。
 */
function resolveChecklistTarget(detail: UTSJSONObject, requestedItemId: string, sonPlanId: string = ''): ChecklistTarget {
  const normalizedItemId = String(requestedItemId ?? '').trim()
  const normalizedSonPlanId = String(sonPlanId ?? '').trim()
  /** 判断一个主行或合并子行是否对应请求的检查项。 */
  const matchesItem = (row: UTSJSONObject) => {
    const candidates = [row?.itemId, row?.id, row?.baseItemId, row?.standardItemId]
      .map((value) => String(value ?? '').trim())
      .filter((value) => value !== '')
    return candidates.includes(normalizedItemId)
  }
  const items = detail?.checklistItems ?? ([] as UTSJSONObject[])
  const exact = items.find((row) => String(row?.sonPlanId ?? '').trim() === normalizedSonPlanId && matchesItem(row)) || null
  const item = exact ?? (normalizedSonPlanId !== '' ? items.find((row) => String(row?.sonPlanId ?? '').trim() === '' && matchesItem(row)) : null)
  const baseItemId = String(item?.baseItemId ?? item?.id ?? item?.itemId ?? normalizedItemId).split('__')[0]
  const key = exact != null ? String(exact?.itemId ?? makeChecklistDataKey(baseItemId, normalizedSonPlanId)) : makeChecklistDataKey(baseItemId, normalizedSonPlanId)
  const sourceRow = (detail?.itemResults ?? ([] as UTSJSONObject[])).find((row) => {
    const rowSonPlanId = String(row?.sonPlanId ?? '').trim()
    if (rowSonPlanId !== normalizedSonPlanId) return false
    const candidates = [row?.id, row?.itemResultId, row?.standardItemId, row?.baseItemResultId]
      .map((value) => String(value ?? '').trim())
      .filter((value) => value !== '')
    return candidates.includes(normalizedItemId) || candidates.includes(baseItemId)
  }) ?? {}
  return {
    key,
    item,
    bizId: String(sourceRow?.id ?? sourceRow?.itemResultId ?? item?.itemResultId ?? baseItemId)
  }
}

/**
 * 为目标检查项克隆一张本地媒体记录；无服务端文件 ID 时重新进入图片上传队列。
 * photo 为源媒体，target 为目标检查项定位结果，targetPlan 为目标计划，index 为序号，createPhotoId 为可选的照片 ID 生成器；返回克隆后的媒体记录。
 */
function cloneChecklistPhotoForTarget(photo: UTSJSONObject, target: ChecklistTarget, targetPlan: UTSJSONObject, index: number, createPhotoId: any): UTSJSONObject {
  const fileId = String(photo?.fileId ?? '').trim()
  const generatedId = typeof createPhotoId === 'function'
    ? createPhotoId(photo, target.key, index)
    : `${(photo?.photoId || fileId) ?? 'photo'}-${target.key}-${Date.now()}-${index}`
  return {
    ...cloneSerializableValue(photo),
    photoId: String(generatedId),
    ownerType: 'checklist',
    ownerId: target.key,
    dataKey: target.key,
    bizId: target.bizId,
    bizType: photo?.bizType ?? 'checkResult',
    subGoodsNo: String(targetPlan?.subGoodsNo ?? targetPlan?.goodsNo ?? photo?.subGoodsNo ?? ''),
    sortNo: index + 1,
    uploadStatus: fileId !== '' ? 'done' : 'pending',
    uploadError: ''
  }
}

/**
 * 将 H5 支持的检查结果、规格、文本、条码、备注和图片字段复制到目标检查项数据。
 * sourceData 为源检查项数据，targetData 为目标检查项数据，target 为目标定位结果，targetPlan 为目标计划，payload 为复制选项，createPhotoId 为可选的照片 ID 生成器。
 */
function applyCopiedChecklistFields(sourceData: UTSJSONObject, targetData: UTSJSONObject, target: ChecklistTarget, targetPlan: UTSJSONObject, payload: UTSJSONObject, createPhotoId: any): UTSJSONObject {
  const nextData = { ...(targetData ?? {}) }
  if (payload?.copyPhotos === true) {
    nextData.photos = (Array.isArray(sourceData?.photos) ? sourceData.photos : ([] as UTSJSONObject[])).map((photo, index) => {
      return cloneChecklistPhotoForTarget(photo, target, targetPlan, index, createPhotoId)
    })
  }
  if (payload?.copyStatus === true) nextData.result = sourceData?.result ?? ''
  if (payload?.copySpecs === true) nextData.measurements = cloneSerializableValue(sourceData?.measurements ?? ([] as any[]))
  if (payload?.copyText === true) {
    nextData.textData = cloneSerializableValue(sourceData?.textData ?? {})
    nextData.textGroups = cloneSerializableValue(sourceData?.textGroups ?? ([] as any[]))
  }
  if (payload?.copyBarcode === true) {
    nextData.barcode = sourceData?.barcode ?? ''
    nextData.barcodeList = cloneSerializableValue(sourceData?.barcodeList ?? ([] as any[]))
    nextData.barcodeItems = cloneSerializableValue(sourceData?.barcodeItems ?? ([] as any[]))
  }
  if (payload?.copyRemarks === true) nextData.comment = sourceData?.comment ?? ''
  nextData.completed = String(nextData?.result ?? '') !== ''
    || String(nextData?.comment ?? '').trim() !== ''
    || (Array.isArray(nextData?.photos) && nextData.photos.length > 0)
    || (Array.isArray(nextData?.measurements) && nextData.measurements.length > 0)
    || (Array.isArray(nextData?.textGroups) && nextData.textGroups.length > 0)
  return nextData
}

/**
 * 将源详情中的检查项内容复制到目标本地详情，调用方随后持久化即可离线恢复和自动同步。
 * sourceDetail 为源详情，targetDetail 为目标详情，payload 为复制选项，options 可注入 createPhotoId；返回复制后的目标详情。
 */
export function copyChecklistItemToDetail(sourceDetail: UTSJSONObject, targetDetail: UTSJSONObject, payload: any = {}, options: any = {}): UTSJSONObject {
  const source = normalizeInspectionDetail(sourceDetail, sourceDetail?.planId)
  let targetDetailState = normalizeInspectionDetail(targetDetail, targetDetail?.planId)
  const sourceTarget = resolveChecklistTarget(source, payload?.sourceItemId, payload?.sourceSonPlanId ?? '')
  const sourceData = source?.checklistData?.[sourceTarget.key] ?? {}
  const targetItemIds = (Array.isArray(payload?.targetItemIds) && payload.targetItemIds.length > 0)
    ? payload.targetItemIds
    : [payload?.sourceItemId]

  targetItemIds.forEach((targetItemId) => {
    const target = resolveChecklistTarget(targetDetailState, targetItemId, payload?.targetSonPlanId ?? '')
    if (target.key === '') return
    const targetData = targetDetailState?.checklistData?.[target.key] ?? {}
    const nextData = applyCopiedChecklistFields(
      sourceData,
      targetData,
      target,
      targetDetailState?.plan ?? {},
      payload,
      options?.createPhotoId
    )
    targetDetailState = updateChecklistItem(targetDetailState, target.key, nextData)
  })

  return targetDetailState
}

/**
 * 按标准检查项 ID 找到每个目标计划自己的结果主键；缺少真实结果行时阻止复用源计划主键。
 * sourceDetail 为源详情，targetDetail 为目标详情，selectedItemIds 为勾选的源结果行 ID；返回与源顺序一致的目标结果主键数组。
 */
export function resolveCopyTargetItemIds(sourceDetail: UTSJSONObject, targetDetail: UTSJSONObject, selectedItemIds: string[]): string[] {
  const sourceRows = Array.isArray(sourceDetail?.itemResults) ? sourceDetail.itemResults : ([] as UTSJSONObject[])
  const targetRows = Array.isArray(targetDetail?.itemResults) ? targetDetail.itemResults : ([] as UTSJSONObject[])
  const requested = Array.isArray(selectedItemIds) ? selectedItemIds : ([] as string[])
  return [...new Set(requested.map((id) => String(id ?? '').trim()).filter((id) => id !== ''))].map((sourceId) => {
    const sourceRow = sourceRows.find((row) => String(row?.id ?? row?.itemResultId ?? '') === sourceId && !row?.sonPlanId)
    const sourceItem = (sourceDetail?.checklistItems ?? ([] as UTSJSONObject[])).find((item) => String(item?.itemId ?? item?.id ?? '') === sourceId && !item?.sonPlanId)
    const standardItemId = String(sourceRow?.standardItemId ?? sourceItem?.standardItemId ?? '').trim()
    if (standardItemId === '') throw new Error(`源检查项 ${sourceId} 缺少模板 ID，无法匹配目标`)
    const targetRow = targetRows.find((row) => String(row?.standardItemId ?? '').trim() === standardItemId && !row?.sonPlanId)
    const targetId = String(targetRow?.id ?? targetRow?.itemResultId ?? '').trim()
    if (targetId === '') throw new Error(`目标计划缺少检查结果 ${standardItemId}，请先下载目标计划`)
    return targetId
  })
}

/**
 * 按照片实际来源检查结果分组，为 H5 图片复制接口生成持久任务参数。
 * detail 为详情 JSON，fileIds 为选中的服务端文件 ID，targetItems 为目标检查项；返回按来源与目标分组的复制请求数组。
 */
export function buildBatchPhotoCopyRequests(detail: UTSJSONObject, fileIds: string[], targetItems: UTSJSONObject[]): UTSJSONObject[] {
  const planId = String(detail?.planId ?? detail?.plan?.id ?? '').trim()
  const requested = new Set((Array.isArray(fileIds) ? fileIds : ([] as string[])).map((id) => String(id ?? '').trim()).filter((id) => id !== ''))
  const targets = Array.isArray(targetItems) ? targetItems : ([] as UTSJSONObject[])
  const groups = new Map<string, any>()
  for (const photo of (detail?.photos ?? ([] as UTSJSONObject[]))) {
    const fileId = String(photo?.fileId ?? '').trim()
    if (!requested.has(fileId) || photo?.ownerType !== 'checklist') continue
    const ownerKey = String(photo?.dataKey ?? photo?.ownerId ?? '').trim()
    const sourceRow = (detail?.itemResults ?? ([] as UTSJSONObject[])).find((row) => {
      const rowId = String(row?.id ?? row?.itemResultId ?? '').trim()
      const sonPlanId = String(row?.sonPlanId ?? '').trim()
      return rowId === ownerKey || (sonPlanId !== '' && makeChecklistDataKey(String(row?.baseItemResultId ?? rowId.split(`_${sonPlanId}`)[0]), sonPlanId) === ownerKey)
    })
    const sourceItemId = String(sourceRow?.id ?? sourceRow?.itemResultId ?? ownerKey).trim()
    const targetItemIds = [...new Set(targets.map((target) => String(target?.bizId ?? '').trim()).filter((id) => id !== '' && id !== sourceItemId))]
    if (sourceItemId === '' || targetItemIds.length === 0) continue
    const groupKey = `${sourceItemId}:${targetItemIds.join(',')}`
    if (!groups.has(groupKey)) groups.set(groupKey, { sourcePlanId: planId, sourceItemId, targetPlanIds: [planId], targetItemIds, fileIds: [] as string[] })
    if (!groups.get(groupKey).fileIds.includes(fileId)) groups.get(groupKey).fileIds.push(fileId)
  }
  return [...groups.values()]
}

/**
 * 将一张已上传图片复制到目标本地检查项，并按服务端文件 ID 防止重复记录。
 * detail 为详情 JSON，photo 为待复制媒体，targetItem 为目标检查项，options 可注入 createPhotoId；返回更新后的详情对象。
 */
export function copyChecklistPhotoToItem(detail: UTSJSONObject, photo: UTSJSONObject, targetItem: UTSJSONObject, options: any = {}): UTSJSONObject {
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const target = resolveChecklistTarget(
    normalized,
    targetItem?.standardItemId || targetItem?.itemId || targetItem?.id,
    targetItem?.sonPlanId ?? ''
  )
  if (target.key === '' || String(photo?.ownerId ?? photo?.dataKey ?? '') === target.key) return normalized
  const current = normalized?.checklistData?.[target.key] ?? {}
  const currentPhotos = Array.isArray(current?.photos) ? current.photos : ([] as UTSJSONObject[])
  const fileId = String(photo?.fileId ?? '').trim()
  const duplicated = fileId !== '' && currentPhotos.some((item) => String(item?.fileId ?? '').trim() === fileId)
  if (duplicated) return normalized
  const copiedPhoto = cloneChecklistPhotoForTarget(
    photo,
    target,
    normalized?.plan ?? {},
    currentPhotos.length,
    options?.createPhotoId
  )
  return updateChecklistItem(normalized, target.key, { ...current, photos: [...currentPhotos, copiedPhoto] })
}

/**
 * 一次解析当前详情，把选中已上传媒体复制到多个检查项并按目标文件 ID 去重。
 * detail 为详情 JSON，fileIds 为选中的服务端文件 ID，targetItems 为目标检查项，options 可注入 createPhotoId；返回更新后的详情对象。
 */
export function copyChecklistPhotosToItems(detail: UTSJSONObject, fileIds: string[], targetItems: UTSJSONObject[], options: any = {}): UTSJSONObject {
  const requestedIds = new Set((Array.isArray(fileIds) ? fileIds : ([] as string[])).map((id) => String(id ?? '').trim()).filter((id) => id !== ''))
  if (requestedIds.size === 0 || !Array.isArray(targetItems) || targetItems.length === 0) return detail
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const photosById = new Map<string, any>()
  for (const photo of (normalized?.photos ?? ([] as UTSJSONObject[]))) {
    const id = String(photo?.fileId ?? '').trim()
    if (requestedIds.has(id) && !photosById.has(id)) photosById.set(id, photo)
  }
  let updated = normalized
  let changed = false
  for (const targetItem of targetItems) {
    const target = resolveChecklistTarget(updated, targetItem?.standardItemId ?? targetItem?.itemId ?? targetItem?.id, targetItem?.sonPlanId ?? '')
    if (target.key === '') continue
    const current = updated?.checklistData?.[target.key] ?? {}
    const currentPhotos = Array.isArray(current?.photos) ? current.photos : ([] as UTSJSONObject[])
    const existing = new Set(currentPhotos.map((photo) => String(photo?.fileId ?? '').trim()))
    const additional: any[] = []
    for (const id of requestedIds) {
      const photo = photosById.get(id)
      if (photo == null || existing.has(id) || String(photo?.ownerId ?? photo?.dataKey ?? '') === target.key) continue
      additional.push(cloneChecklistPhotoForTarget(photo, target, updated?.plan ?? {}, currentPhotos.length + additional.length, options?.createPhotoId))
      existing.add(id)
    }
    if (additional.length === 0) continue
    updated = updateChecklistItem(updated, target.key, { ...current, photos: [...currentPhotos, ...additional] })
    changed = true
  }
  return changed ? updated : detail
}

/**
 * 将备货或完工数量写入当前计划及合并验货计划行，供普通草稿队列统一同步。
 * detail 为详情 JSON，rows 为含计划 ID 与完工数量的行；返回写回数量后的标准化详情对象。
 */
export function applyFinishQuantityRows(detail: UTSJSONObject, rows: UTSJSONObject[]): UTSJSONObject {
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const quantityByPlanId = new Map((Array.isArray(rows) ? rows : ([] as UTSJSONObject[])).map((row) => [
    String(row?.id ?? row?.planId ?? '').trim(),
    parseInt(String(row?.finishQuantity ?? 0))
  ]))
  const currentPlanId = String(normalized?.plan?.id ?? normalized?.plan?.planId ?? normalized?.planId ?? '').trim()
  const plan = quantityByPlanId.has(currentPlanId)
    ? { ...(normalized?.plan ?? {}), finishQuantity: quantityByPlanId.get(currentPlanId) }
    : normalized?.plan
  const inspectionPlans = (Array.isArray(normalized?.inspectionPlans) ? normalized.inspectionPlans : ([] as UTSJSONObject[])).map((row) => {
    const rowId = String(row?.id ?? row?.planId ?? '').trim()
    return quantityByPlanId.has(rowId) ? { ...row, finishQuantity: quantityByPlanId.get(rowId) } : row
  })
  return normalizeInspectionDetail({ ...normalized, plan, inspectionPlans }, normalized.planId)
}

/**
 * 将当前计划抽样数量写入本地详情及对应合并验货计划行。
 * detail 为详情 JSON，value 为新的抽样数量；返回写回数量后的标准化详情对象。
 */
export function applySampleQuantity(detail: UTSJSONObject, value: number): UTSJSONObject {
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const quantity = parseInt(String(value ?? 0))
  const currentPlanId = String(normalized?.plan?.id ?? normalized?.plan?.planId ?? normalized?.planId ?? '').trim()
  const inspectionPlans = (Array.isArray(normalized?.inspectionPlans) ? normalized.inspectionPlans : ([] as UTSJSONObject[])).map((row) => {
    const rowId = String(row?.id ?? row?.planId ?? '').trim()
    return rowId === currentPlanId ? { ...row, sampleQuantity: quantity } : row
  })
  return normalizeInspectionDetail({
    ...normalized,
    plan: { ...(normalized?.plan ?? {}), sampleQuantity: quantity },
    inspectionPlans
  }, normalized.planId)
}

/**
 * 仅保留已经上传成功并可提交到服务端的文件字段。
 * photos 为检查项媒体记录；返回仅含服务端文件 ID 的提交字段数组。
 */
function buildUploadedFileList(photos: UTSJSONObject[]): UTSJSONObject[] {
  return (Array.isArray(photos) ? photos : ([] as UTSJSONObject[])).filter((photo) => String(photo?.fileId ?? '').trim() !== '')
    .map((photo) => ({
      fileId: String(photo?.fileId ?? ''),
      filePath: photo?.filePath ?? '',
      thumbnailPath: photo?.thumbnailPath ?? '',
      ...(photo?.sortNo != null ? { sortNo: parseInt(String(photo.sortNo)) } : {}),
      ...(photo?.bizType ? { bizType: photo.bizType } : {}),
      ...(photo?.fileType ? { fileType: photo.fileType } : {}),
      ...(photo?.fileExt ? { fileExt: photo.fileExt } : {}),
      ...(photo?.fileName ? { fileName: photo.fileName } : {}),
      ...(photo?.mediaType ? { mediaType: photo.mediaType } : {}),
      ...(photo?.mimeType ? { mimeType: photo.mimeType } : {}),
      ...(photo?.coverUrl ? { coverUrl: photo.coverUrl } : {}),
      ...(photo?.duration ? { duration: photo.duration } : {})
    }))
}

/**
 * 将条码编辑数据转换为服务端 barcodeValue JSON 字符串。
 * data 为检查项编辑数据；返回 barcodeValue JSON 文本，无有效条码时返回 null。
 */
function buildBarcodeValue(data: UTSJSONObject): string | null {
  const items = (Array.isArray(data?.barcodeItems) ? data.barcodeItems : ([] as any[])).map((row) => typeof row === 'string'
    ? { name: '', code: row.trim(), format: '' }
    : { name: String(row?.name ?? row?.label ?? '').trim(), code: String(row?.code ?? row?.value ?? row?.barcode ?? '').trim(), format: String(row?.format ?? row?.scanType ?? '').trim() })
    .filter((row) => row.name !== '' || row.code !== '' || row.format !== '')
  if (items.length > 0) return JSON.stringify(items)
  const codes = Array.isArray(data?.barcodeList) ? data.barcodeList : ([] as any[])
  if (codes.length > 0) return JSON.stringify(codes.map((code) => ({ name: '', code: String(code ?? ''), format: '' })))
  const barcode = String(data?.barcode ?? '').trim()
  return barcode === '' ? null : JSON.stringify([{ name: '', code: barcode, format: '' }])
}

/**
 * 判断合并子检查点是否有实际输入，避免仅有空白占位行时生成服务端结果。
 * data 为检查项编辑数据；返回存在结果、备注、图片或已填写规格/文本/条码时为 true。
 */
function hasFilledChildItemData(data: UTSJSONObject): boolean {
  const hasFilledRows = (rows: any) => Array.isArray(rows) && rows.some((row) => Object.keys(row ?? {}).some((key) => String(row[key] ?? '').trim() !== ''))
  return String(data?.result ?? '').trim() !== ''
    || String(data?.comment ?? '').trim() !== ''
    || (Array.isArray(data?.photos) && data.photos.length > 0)
    || hasFilledRows(data?.measurements)
    || hasFilledRows(data?.textGroups)
    || (Array.isArray(data?.barcodeItems) && data.barcodeItems.some((row) => String(row?.code ?? '').trim() !== ''))
    || (Array.isArray(data?.barcodeList) && data.barcodeList.some((code) => String(code ?? '').trim() !== ''))
    || String(data?.barcode ?? '').trim() !== ''
}

/**
 * 从本地 JSON 结果和当前编辑值生成 H5 字段形状的报告 payload，已上传图片保留供原生端同步。
 * detail 为详情 JSON；返回含 itemResults、defectRecords 与数量字段的报告提交 payload。
 */
export function buildGeneratePayload(detail: UTSJSONObject): UTSJSONObject {
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const planId = normalized.planId
  const sourceRows = Array.isArray(normalized?.itemResults) ? normalized.itemResults : ([] as UTSJSONObject[])
  const sourceById = new Map<string, any>()
  const baseIdByTemplate = new Map<string, string>()
  sourceRows.forEach((row) => {
    const rowId = String(row?.id ?? row?.itemResultId ?? '')
    if (rowId === '') return
    const templateId = String(row?.standardItemId ?? '')
    const sonPlanId = String(row?.sonPlanId ?? '').trim()
    if (templateId !== '' && sonPlanId === '' && !baseIdByTemplate.has(templateId)) baseIdByTemplate.set(templateId, rowId)
    const baseItemId = row?.baseItemResultId
      ? String(row.baseItemResultId)
      : (sonPlanId && rowId.endsWith(`_${sonPlanId}`) ? rowId.slice(0, -(`_${sonPlanId}`.length)) : rowId)
    const localKey = makeChecklistDataKey(baseItemId, sonPlanId)
    sourceById.set(localKey, row)
    if (templateId !== '') sourceById.set(makeChecklistDataKey(templateId, sonPlanId), row)
  })
  const itemResults = normalized.checklistItems.filter((item) => {
    const itemId = String(item?.itemId ?? item?.id ?? '')
    const sonPlanId = String(item?.sonPlanId ?? '')
    if (sonPlanId === '') return true
    const data = normalized.checklistData?.[itemId] ?? {}
    return hasFilledChildItemData(data)
  }).map((item) => {
    const itemId = String(item?.itemId ?? item?.id ?? '')
    const baseItemId = String(item?.baseItemId ?? item?.id ?? itemId)
    const sonPlanId = String(item?.sonPlanId ?? '')
    const data = normalized.checklistData?.[itemId] ?? {}
    const sourceRow = sourceById.get(itemId) ?? {}
    const itemType = (item?.itemType || sourceRow?.itemType) ?? 'Standard'
    const standardItemId = String(item?.standardItemId || sourceRow?.standardItemId || '')
    const originalId = baseIdByTemplate.get(standardItemId) ?? baseItemId
    const result = {
      id: sourceRow?.id || makeItemResultId(originalId, sonPlanId),
      planId,
      standardItemId,
      itemType,
      textContent: null,
      barcodeValue: null,
      resultStatus: mapResultStatus(data?.result),
      remarks: data?.comment || null,
      sonPlanId: sonPlanId || null
    }
    const uploadedFiles = buildUploadedFileList(data?.photos)
    if (uploadedFiles.length > 0) result.fileList = uploadedFiles
    if (itemType === 'Measurements') result.specResult = Array.isArray(data?.measurements) && data.measurements.length > 0 ? JSON.stringify(data.measurements) : null
    if (itemType === 'Text') result.textContent = Array.isArray(data?.textGroups) && data.textGroups.length > 0 ? JSON.stringify(data.textGroups) : null
    if (itemType === 'Barcodes') result.barcodeValue = buildBarcodeValue(data)
    return result
  })
  const inspectorName = String(normalized?.plan?.inspectorName ?? '')
  const defectRecords = normalized.defects.map((defect, index) => ({
    id: defect?.id || defect?.defectId || `${planId}_defect_${index}`,
    defectId: defect?.defectId || defect?.id || `${planId}_defect_${index}`,
    planId,
    defectType: String(defect?.type ?? defect?.defectType ?? defect?.defectLevel ?? '').toLowerCase(),
    defectCode: defect?.defectCode ?? '',
    defectDesc: defect?.defectDesc ?? '',
    itemResultId: (defect?.checkItemResultId || defect?.itemResultId) ?? '',
    defectCount: parseInt(String(defect?.commonFlag ?? (defect?.isCommon ? 1 : 0))) === 1 ? null : parseFloat(String(defect?.quantity ?? defect?.defectCount ?? 0)),
    commonFlag: parseInt(String(defect?.commonFlag ?? (defect?.isCommon ? 1 : 0))),
    remark: (defect?.description || defect?.remark) ?? '',
    findUser: inspectorName,
    sonPlanId: defect?.sonPlanId || null
  }))
  return {
    reportId: normalized.reportId,
    planId,
    itemResults,
    defectRecords,
    finishQuantity: parseInt(String(normalized?.plan?.finishQuantity ?? normalized?.finishQuantity ?? 0)),
    sampleQuantity: parseInt(String(normalized?.plan?.sampleQuantity ?? normalized?.sampleQuantity ?? normalized?.plan?.sampleSize ?? 0)),
    overallResult: null,
    overallRemarks: String(normalized?.overallRemarks ?? normalized?.plan?.overallRemarks ?? ''),
    finishFlag: '0'
  }
}

/**
 * 校验最终提交必需的总结结果、检查项完成状态和失败项图片。
 * 校验顺序与 H5 一致：先必填检查项、再必传图片、最后总结结果；detail 为详情 JSON，summary 为总结草稿。
 * 返回 valid、reason、message，reason 供页面区分提示场景。
 */
export function validateFinalSubmission(detail: UTSJSONObject, summary: any = {}): UTSJSONObject {
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const requiredItems = normalized.checklistItems.filter((item) => String(item?.sonPlanId ?? '') === '' && Boolean(item?.isRequired))
  const incomplete = requiredItems.filter((item) => {
    const data = normalized.checklistData?.[item.itemId] ?? {}
    return String(data?.result ?? '') === ''
  })
  if (incomplete.length > 0) return { valid: false, reason: 'missing-results', message: `仍有 ${incomplete.length} 个必填检查项未完成` }
  const requiredPhotoItems = normalized.checklistItems.filter((item) => String(item?.sonPlanId ?? '') === '' && Boolean(item?.isPhotoRequired))
  const requiredWithoutPhoto = requiredPhotoItems.filter((item) => {
    const data = normalized.checklistData?.[item.itemId] ?? {}
    return data?.result !== 'na' && (!Array.isArray(data?.photos) || !data.photos.some((photo) => photo?.bizType !== 'checkPoint'))
  })
  if (requiredWithoutPhoto.length > 0) return { valid: false, reason: 'missing-photos', message: `仍有 ${requiredWithoutPhoto.length} 个检查项缺少必传图片` }
  const overallResult = String(summary?.overallResult ?? '').trim()
  if (overallResult === '') return { valid: false, reason: 'missing-result', message: '请选择总结结果后再提交' }
  return { valid: true, reason: '', message: '' }
}

/**
 * 将历史 PASS/FAIL 与 H5 的 APPROVED/REJECTED/PENDING 总结结果值统一为服务端值域，无法识别时返回空串。
 * rawValue 为本地或服务端的总结结果值；返回服务端值域文本。
 */
export function normalizeOverallResult(rawValue: any): string {
  const value = String(rawValue ?? '').trim().toUpperCase()
  if (value === 'APPROVED' || value === 'PASS') return 'APPROVED'
  if (value === 'REJECTED' || value === 'FAIL') return 'REJECTED'
  if (value === 'PENDING') return 'PENDING'
  return ''
}

/**
 * 按 H5 normalizeSeverityValue 语义解析疵点严重等级为小写桶键；无法识别时返回空串（统计时跳过，不回退 MINOR）。
 * rawValue 为等级编码，rawLabel 为等级中文或英文名；返回 critical/major/minor 之一或空串。
 */
function resolveFinishSeverityKey(rawValue: any, rawLabel: string = ''): string {
  const text = `${String(rawValue ?? '').toLowerCase()} ${String(rawLabel ?? '').toLowerCase()}`
  if (text.includes('critical') || text.includes('致命') || text.includes('极严重')) return 'critical'
  if (text.includes('major') || text.includes('主要') || text.includes('严重') || text.includes('大')) return 'major'
  if (text.includes('minor') || text.includes('次要') || text.includes('轻微') || text.includes('小')) return 'minor'
  return ''
}

/**
 * 构建总结弹窗所需的统计视图：AQL 疵点统计（实际发现 vs 计划 Ac 阈值）、失败检查点与截断后的总结评语。
 * 与 H5 一致：疵点数量按归一化严重等级聚合（quantity 优先，未知等级跳过），超出 AQL 阈值仅作警示，不阻断提交。
 * detail 为详情 JSON，summary 为总结草稿；返回 defectStats、exceedsAql、failedCheckpoints 与截断后的 remarks。
 */
export function buildFinishSummary(detail: UTSJSONObject, summary: any = {}): UTSJSONObject {
  const normalized = normalizeInspectionDetail(detail, detail?.planId)
  const plan = normalized?.plan ?? {}
  const totals = { critical: 0, major: 0, minor: 0 }
  normalized.defects.forEach((defect) => {
    const key = resolveFinishSeverityKey(defect?.type || defect?.defectType || defect?.defectLevel, defect?.typeLabel || defect?.defectLevel)
    const quantity = parseInt(String(defect?.quantity ?? defect?.defectCount ?? 0))
    if (key !== '' && Number.isFinite(quantity) && quantity > 0) {
      totals[key] += quantity
    }
  })
  const defectStats = [
    { key: 'critical', label: '极严重', actual: totals.critical, max: parseInt(String(plan?.criticalAc ?? 0)) },
    { key: 'major', label: '大', actual: totals.major, max: parseInt(String(plan?.majorAc ?? 0)) },
    { key: 'minor', label: '小', actual: totals.minor, max: parseInt(String(plan?.minorAc ?? 0)) }
  ].map((row) => ({ ...row, exceed: row.actual > row.max }))
  const exceedsAql = defectStats.some((row) => row.exceed)
  const failedCheckpoints = normalized.checklistItems
    .filter((item) => String(item?.sonPlanId ?? '') === '' && normalized.checklistData?.[item.itemId]?.result === 'fail')
    .map((item) => ({ id: item.itemId, name: item?.itemName || item?.name || item.itemId }))
  const remarks = String(summary?.overallRemarks ?? normalized?.overallRemarks ?? plan?.overallRemarks ?? '').slice(0, 3000)
  return { defectStats, exceedsAql, failedCheckpoints, remarks }
}
