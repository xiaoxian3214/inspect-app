const DEFECT_FIELDS = 'id plan_id item_result_id defect_level defect_code defect_desc defect_position quantity common_flag create_date create_by update_date update_by son_plan_id file_list comments'.split(' ')

/** 将 SQLite 列名转换成后端疵点属性。 */
function defectField(column) {
  return column.replace(/_([a-z])/g, (_matched, letter) => letter.toUpperCase())
}

/** 从疵点实体提取后端业务列，文件及评论数组作为单列 JSON。 */
function defectColumns(defect, reportId) {
  const source = { ...defect, id: defect?.id ?? defect?.defectId, planId: reportId,
    itemResultId: defect?.itemResultId ?? defect?.checkItemResultId ?? '',
    defectLevel: defect?.defectLevel ?? defect?.defectType ?? defect?.severity,
    defectDesc: defect?.defectDesc ?? defect?.desc }
  const columns = {}
  DEFECT_FIELDS.forEach((field) => {
    const value = source[defectField(field)]
    if (value !== undefined) columns[field] = value != null && typeof value === 'object' ? JSON.stringify(value) : value
  })
  return columns
}

/** 保留业务表之外的本地媒体、展示扩展和离线编辑字段。 */
function defectExtras(defect) {
  const known = new Set(DEFECT_FIELDS.map(defectField))
  const extras = {}
  Object.keys(defect ?? {}).forEach((field) => { if (!known.has(field)) extras[field] = defect[field] })
  return extras
}

/** 从业务列与离线扩展还原疵点，兼容尚未迁移的旧 JSON 行。 */
function parseDefectRow(row) {
  let restored = {}
  try {
    restored = JSON.parse(row?.jsonData ?? '{}')
  } catch (_) {}
  DEFECT_FIELDS.forEach((field) => {
    const value = row?.[field]
    if (value == null) return
    if ((field === 'file_list' || field === 'comments') && typeof value === 'string') {
      try { restored[defectField(field)] = JSON.parse(value) }
      catch (_) { restored[defectField(field)] = value }
    } else restored[defectField(field)] = value
  })
  return restored
}

/**
 * 创建报告与疵点 ID 组合的稳定本地主键。
 */
function buildDefectKey(reportId, defectId) {
  return `${String(reportId ?? '').trim()}::${String(defectId ?? '').trim()}`
}

/**
 * 创建离线疵点仓库。
 */
export function createDefectRepository(database) {
  /**
   * 按报告 ID 读取全部本地疵点。
   */
  async function listByReportId(reportId) {
    const normalizedReportId = String(reportId ?? '').trim()
    return database.readTable('defect')
      .filter((row) => String(row?.reportId ?? '') === normalizedReportId)
      .sort((left, right) => Number(left?.sortNo ?? 0) - Number(right?.sortNo ?? 0))
      .map(parseDefectRow)
  }

  /**
   * 完整替换指定报告的疵点快照。
   */
  async function replaceByReportId(reportId, defects) {
    const normalizedReportId = String(reportId ?? '').trim()
    if (normalizedReportId === '') throw new Error('报告ID不能为空')
    const source = Array.isArray(defects) ? defects : []
    await database.transaction(async (transaction) => {
      transaction.removeWhere('defect', (row) => String(row?.reportId ?? '') === normalizedReportId)
      source.forEach((defect, index) => {
        const sourceDefectId = String(defect?.defectId ?? defect?.id ?? `local-${index}`)
        transaction.upsert('defect', 'defectId', {
          defectId: buildDefectKey(normalizedReportId, sourceDefectId),
          sourceDefectId,
          reportId: normalizedReportId,
          ...defectColumns(defect, normalizedReportId),
          itemId: defect?.itemId ?? '',
          defectType: (defect?.defectType || defect?.severity) ?? '',
          desc: (defect?.defectDesc || defect?.desc) ?? '',
          photoPaths: JSON.stringify(defect?.photos ?? []),
          sortNo: index,
          jsonData: JSON.stringify(defectExtras(defect)),
          createAt: defect?.createAt || new Date().toISOString()
        })
      })
    })
    return source
  }

  /**
   * 新增或更新单个本地疵点。
   */
  async function save(reportId, defect) {
    const existing = await listByReportId(reportId)
    const sourceDefectId = String(defect?.defectId ?? defect?.id ?? '').trim()
    if (sourceDefectId === '') throw new Error('疵点ID不能为空')
    const index = existing.findIndex((current) => String(current?.defectId ?? current?.id ?? '') === sourceDefectId)
    if (index >= 0) existing[index] = { ...existing[index], ...defect }
    else existing.push(defect)
    await replaceByReportId(reportId, existing)
    return defect
  }

  /**
   * 删除指定报告中的单个本地疵点。
   */
  async function remove(reportId, defectId) {
    const normalizedReportId = String(reportId ?? '').trim()
    const normalizedDefectId = String(defectId ?? '').trim()
    await database.transaction(async (transaction) => {
      transaction.removeWhere('defect', (row) => {
        return String(row?.reportId ?? '') === normalizedReportId
          && String(row?.sourceDefectId ?? '') === normalizedDefectId
      })
    })
  }

  return { listByReportId, replaceByReportId, save, remove }
}
