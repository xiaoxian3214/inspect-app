/**
 * 安全解析检查项数据库行中的完整 JSON 数据。
 */
function parseChecklistRow(row) {
  try {
    return JSON.parse(row?.jsonData ?? '{}').checklistItem ?? {}
  } catch (_) {
    return {}
  }
}

/**
 * 创建报告与检查项 ID 组合的稳定本地主键。
 */
function buildChecklistKey(reportId, itemId) {
  return `${String(reportId ?? '').trim()}::checklist::${String(itemId ?? '').trim()}`
}

/**
 * 创建离线检查项仓库。
 */
export function createChecklistRepository(database) {
  /**
   * 按报告 ID 读取并按原始顺序还原完整检查项。
   */
  async function listByReportId(reportId) {
    const normalizedReportId = String(reportId ?? '').trim()
    return database.readTable('item_result')
      .filter((row) => String(row?.planId ?? '') === normalizedReportId && row?.itemResultId?.startsWith(`${normalizedReportId}::checklist::`))
      .sort((left, right) => Number(JSON.parse(left.jsonData ?? '{}').sortOrder ?? 0) - Number(JSON.parse(right.jsonData ?? '{}').sortOrder ?? 0))
      .map(parseChecklistRow)
  }

  /**
   * 完整替换指定报告的检查项快照，其他报告数据保持不变。
   */
  async function replaceByReportId(reportId, items) {
    const normalizedReportId = String(reportId ?? '').trim()
    if (normalizedReportId === '') throw new Error('报告ID不能为空')
    const source = Array.isArray(items) ? items : []
    await database.transaction(async (transaction) => {
      transaction.removeWhere('item_result', (row) => String(row?.planId ?? '') === normalizedReportId
        && row?.itemResultId?.startsWith(`${normalizedReportId}::checklist::`))
      source.forEach((item, index) => {
        const sourceItemId = String(item?.itemId ?? item?.id ?? index)
        transaction.upsert('item_result', 'itemResultId', {
          itemResultId: buildChecklistKey(normalizedReportId, sourceItemId),
          planId: normalizedReportId,
          jsonData: JSON.stringify({ checklistItem: item, sortOrder: index })
        })
      })
    })
    return source
  }

  /**
   * 新增或更新指定报告中的单个检查项。
   */
  async function save(reportId, item) {
    const existing = await listByReportId(reportId)
    const sourceItemId = String(item?.itemId ?? item?.id ?? '').trim()
    if (sourceItemId === '') throw new Error('检查项ID不能为空')
    const index = existing.findIndex((current) => String(current?.itemId ?? current?.id ?? '') === sourceItemId)
    if (index >= 0) existing[index] = { ...existing[index], ...item }
    else existing.push(item)
    await replaceByReportId(reportId, existing)
    return item
  }

  return { listByReportId, replaceByReportId, save }
}
