/**
 * 安全还原照片数据库行中的完整媒体记录。
 */
function parsePhotoRow(row) {
  try {
    return { ...JSON.parse(row?.jsonData ?? '{}'), reportId: String(row?.reportId ?? '') }
  } catch (_) {
    return { reportId: String(row?.reportId ?? '') }
  }
}

/** 安全读取报告快照中的合并身份，供照片共享范围校验使用。 */
function parseReportRow(row) {
  try {
    return JSON.parse(row?.jsonData ?? '{}')
  } catch (_) {
    return {}
  }
}

/**
 * 创建报告与照片 ID 组合的稳定本地主键。
 */
function buildPhotoKey(reportId, photoId) {
  return `${String(reportId ?? '').trim()}::${String(photoId ?? '').trim()}`
}

/**
 * 判断媒体记录是否仍需上传或重试。
 */
function isPendingPhoto(photo) {
  if (String(photo?.fileId ?? '').trim() !== '') return false
  const status = String(photo?.uploadStatus ?? 'pending').toLowerCase()
  if (status === 'draft') return false
  return status !== 'done' && status !== 'success' && status !== 'uploaded'
}

/**
 * 创建手机本地照片与上传状态仓库。
 */
export function createPhotoRepository(database) {
  /** 从验货计划主表解析照片共享计划 ID，兼容尚未迁移的旧合并组。 */
  function resolveStorageId(planId) {
    const normalizedPlanId = String(planId ?? '').trim()
    const member = database.readTable('inspection_plan').find((row) => String(row?.planId ?? '') === normalizedPlanId)
    if (member != null) return String(member.groupPlanId)
    const legacyMember = database.readTable('report_member').find((row) => String(row?.planId ?? '') === normalizedPlanId)
    return String(legacyMember?.groupId ?? normalizedPlanId)
  }

  /** 根据相同报告实体与合并父计划确定共享媒体的成员计划 ID；普通报告仅返回自身。 */
  function getSharedPlanIds(planId) {
    const normalizedPlanId = String(planId ?? '').trim()
    if (database.readTable('inspection_plan').some((row) => String(row?.planId ?? '') === normalizedPlanId)) {
      return new Set([resolveStorageId(normalizedPlanId)])
    }
    const member = database.readTable('report_member').find((row) => String(row?.planId ?? '') === normalizedPlanId)
    if (member != null) return new Set([String(member.groupId)])
    if (database.readTable('report_group').some((row) => String(row?.groupId ?? '') === normalizedPlanId)) return new Set([normalizedPlanId])
    const rows = database.readTable('report')
    const current = rows.find((row) => String(row?.reportId ?? '') === normalizedPlanId)
    if (current == null) return new Set([normalizedPlanId])
    const detail = parseReportRow(current)
    const parentPlanId = String(detail?.plan?.parentPlanId ?? '').trim()
    const reportEntityId = String(detail?.report?.id ?? '').trim()
    if (parseInt(String(detail?.plan?.mergeType ?? 0)) !== 2 || parentPlanId === '' || reportEntityId === '') return new Set([normalizedPlanId])
    const memberIds = new Set((Array.isArray(detail?.inspectionPlans) ? detail.inspectionPlans : [])
      .map((plan) => String(plan?.id ?? plan?.planId ?? '').trim()).filter((id) => id !== ''))
    const sharedIds = new Set([normalizedPlanId])
    rows.forEach((row) => {
      const siblingId = String(row?.reportId ?? '')
      if (!memberIds.has(siblingId)) return
      const sibling = parseReportRow(row)
      if (String(sibling?.report?.id ?? '') === reportEntityId && String(sibling?.plan?.parentPlanId ?? '') === parentPlanId) sharedIds.add(siblingId)
    })
    return sharedIds
  }

  /**
   * 按计划 ID 读取共享合并报告的媒体记录，按照片 ID 去重并保留原拍摄计划。
   */
  async function listByReportId(reportId) {
    const normalizedReportId = String(reportId ?? '').trim()
    const sharedPlanIds = getSharedPlanIds(normalizedReportId)
    const seen = new Set<string>()
    return database.readTable('photo')
      .filter((row) => sharedPlanIds.has(String(row?.reportId ?? '')))
      .sort((left, right) => parseInt(String(left?.sortNo ?? 0)) - parseInt(String(right?.sortNo ?? 0)))
      .filter((row) => {
        const photoId = String(row?.sourcePhotoId ?? row?.photoId ?? '')
        if (seen.has(photoId)) return false
        seen.add(photoId)
        return true
      })
      .map(parsePhotoRow)
  }

  /**
   * 只读取当前计划实际持有的待上传行，避免合并成员重复上传同一文件。
   */
  async function listPendingByReportId(reportId) {
    const normalizedReportId = String(reportId ?? '').trim()
    const storageId = resolveStorageId(normalizedReportId)
    return database.readTable('photo')
      .filter((row) => String(row?.reportId ?? '') === storageId)
      .map(parsePhotoRow)
      .filter(isPendingPhoto)
  }

  /**
   * 读取全部报告中仍需上传或重试的媒体记录。
   */
  async function listPending() {
    return database.readTable('photo').map(parsePhotoRow).filter(isPendingPhoto)
  }

  /**
   * 返回仍有本地图片待上传的全部报告 ID，并保持数据库中的首次出现顺序。
   */
  async function listPendingReportIds() {
    const reportIds: string[] = []
    const seen = new Set<string>()
    database.readTable('photo').forEach((row) => {
      const reportId = String(row?.reportId ?? '').trim()
      if (reportId === '' || seen.has(reportId) || !isPendingPhoto(parsePhotoRow(row))) return
      seen.add(reportId)
      reportIds.push(reportId)
    })
    return reportIds
  }

  /** 完整替换指定报告的媒体快照，合并成员统一写入共享组。 */
  async function saveAll(reportId, photos) {
    const normalizedReportId = String(reportId ?? '').trim()
    if (normalizedReportId === '') throw new Error('报告ID不能为空')
    const storageId = resolveStorageId(normalizedReportId)
    const source = Array.isArray(photos) ? photos : []
    await database.transaction(async (transaction) => {
      transaction.removeWhere('photo', (row) => String(row?.reportId ?? '') === storageId)
      source.forEach((photo, index) => {
        const sourcePhotoId = String(photo?.photoId ?? photo?.id ?? `local-${index}`)
        transaction.upsert('photo', 'photoId', {
          photoId: buildPhotoKey(storageId, sourcePhotoId),
          sourcePhotoId,
          defectId: photo?.defectId ?? '',
          reportId: storageId,
          ownerType: photo?.ownerType ?? '',
          ownerId: (photo?.ownerId || photo?.itemId || photo?.defectId) ?? '',
          localPath: photo?.localPath ?? '',
          uploadStatus: photo?.uploadStatus || (photo?.fileId ? 'done' : 'pending'),
          fileId: photo?.fileId ?? '',
          sortNo: index,
          md5: photo?.md5 ?? '',
          jsonData: JSON.stringify(photo)
        })
      })
    })
    return source
  }

  /**
   * 新增媒体；若合并报告已存在该照片，则更新原拍摄成员的唯一媒体行。
   */
  async function save(reportId, photo) {
    const normalizedReportId = String(reportId ?? '').trim()
    if (normalizedReportId === '') throw new Error('报告ID不能为空')
    const sourcePhotoId = String(photo?.photoId ?? photo?.id ?? '').trim()
    if (sourcePhotoId === '') throw new Error('照片ID不能为空')
    const storageId = resolveStorageId(normalizedReportId)
    let saved = photo
    await database.transaction(async (transaction) => {
      const sharedPlanIds = getSharedPlanIds(normalizedReportId)
      const ownerRow = transaction.read('photo').find((row) => sharedPlanIds.has(String(row?.reportId ?? ''))
        && String(row?.sourcePhotoId ?? '') === sourcePhotoId)
      const ownerPlanId = String(ownerRow?.reportId ?? storageId)
      const existing = transaction.read('photo').filter((row) => String(row?.reportId ?? '') === ownerPlanId)
      const previous = existing.find((row) => String(row?.sourcePhotoId ?? '') === sourcePhotoId)
      saved = { ...(previous != null ? parsePhotoRow(previous) : {}), ...photo, reportId: ownerPlanId }
      transaction.upsert('photo', 'photoId', {
        photoId: buildPhotoKey(ownerPlanId, sourcePhotoId),
        sourcePhotoId,
        defectId: saved?.defectId ?? '',
        reportId: ownerPlanId,
        ownerType: saved?.ownerType ?? '',
        ownerId: (saved?.ownerId || saved?.itemId || saved?.defectId) ?? '',
        localPath: saved?.localPath ?? '',
        uploadStatus: saved?.uploadStatus || (saved?.fileId ? 'done' : 'pending'),
        fileId: saved?.fileId ?? '',
        sortNo: previous?.sortNo ?? existing.length,
        md5: saved?.md5 ?? '',
        jsonData: JSON.stringify(saved)
      })
    })
    return saved
  }

  /**
   * 将照片标记为上传成功并写入服务端文件信息。
   */
  async function markUploaded(reportId, photoId, remoteFile) {
    const normalizedReportId = String(reportId ?? '').trim()
    const storageId = resolveStorageId(normalizedReportId)
    const normalizedPhotoId = String(photoId ?? '').trim()
    let uploaded = null
    await database.transaction(async (transaction) => {
      const previous = transaction.read('photo').find((row) => String(row?.reportId ?? '') === storageId && String(row?.sourcePhotoId ?? '') === normalizedPhotoId)
      if (previous == null) throw new Error('本地照片不存在')
      uploaded = { ...parsePhotoRow(previous), ...(remoteFile ?? {}), uploadStatus: 'done', uploadError: '', uploadedAt: new Date().toISOString() }
      transaction.upsert('photo', 'photoId', {
        ...previous,
        localPath: uploaded.localPath ?? '',
        uploadStatus: 'done',
        fileId: uploaded.fileId ?? '',
        jsonData: JSON.stringify(uploaded)
      })
    })
    return uploaded
  }

  /**
   * 从合并报告中删除指定照片，允许在非拍摄成员的详情里操作共享媒体。
   */
  async function remove(reportId, photoId) {
    const normalizedReportId = String(reportId ?? '').trim()
    const normalizedPhotoId = String(photoId ?? '').trim()
    await database.transaction(async (transaction) => {
      const sharedPlanIds = getSharedPlanIds(normalizedReportId)
      transaction.removeWhere('photo', (row) => {
        return sharedPlanIds.has(String(row?.reportId ?? ''))
          && String(row?.sourcePhotoId ?? '') === normalizedPhotoId
      })
    })
  }

  return { listByReportId, listPendingByReportId, listPending, listPendingReportIds, saveAll, save, markUploaded, remove }
}
