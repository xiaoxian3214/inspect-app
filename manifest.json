{
	"name": "中艺验货",
	"appid": "__UNI__1FFA0B1",
	"description": "支持 Android 与 iOS 的离线验货应用",
	"versionName": "1.0.0",
	"versionCode": "104",
	"uni-app-x": {
		"styleIsolationVersion": "2",
		"vapor": true,
		/* 蒸汽渲染目标：bytecode 走字节码解释器（12 次 SIGSEGV 全部发生在 TemplateRender::RenderInstructionRange），
		   改用 nativecode 把模板编译为原生渲染指令，保留蒸汽模式同时绕开该解释器。
		   若 nativecode 无法编译/基座不支持，改回 "bytecode" 即可。 */
		"vapor-render-target": "nativecode"
	},
	/* 快应用特有相关 */
	"quickapp": {},
	/* 小程序特有相关 */
	"mp-weixin": {
		"appid": "",
		"setting": {
			"urlCheck": false
		},
		"usingComponents": true
	},
	"mp-alipay": {
		"usingComponents": true
	},
	"mp-baidu": {
		"usingComponents": true
	},
	"mp-toutiao": {
		"usingComponents": true
	},
	"uniStatistics": {
		"enable": false
	},
	"vueVersion": "3",
	"app": {
		"distribute": {
			"icons": {
				"android": {
					"hdpi": "static/icons/inspection-hdpi.png",
					"xhdpi": "static/icons/inspection-xhdpi.png",
					"xxhdpi": "static/icons/inspection-xxhdpi.png",
					"xxxhdpi": "static/icons/inspection-xxxhdpi.png"
				}
			}
		}
	},
	"app-android": {
		"distribute": {
			"modules": {
				"uni-barcode-scanning": {},
				/* 机身方向优先由加速度计给绝对方向，自定义基座/打包需要在这里声明；
				   陀螺仪作为基座缺加速度计模块时的兜底链路，一并保留。 */
				"uni-accelerometer": {},
				"uni-gyroscope": {}
			},
			"icons": {
				"hdpi": "static/icons/inspection-hdpi.png",
				"xhdpi": "static/icons/inspection-xhdpi.png",
				"xxhdpi": "static/icons/inspection-xxhdpi.png",
				"xxxhdpi": "static/icons/inspection-xxxhdpi.png"
			},
			"splashScreens": {
				"default": {}
			}
		}
	},
	"app-ios": {
		"distribute": {
			"modules": {
				"uni-barcode-scanning": {},
				/* 与 Android 保持一致：加速度计给绝对方向，陀螺仪作为缺模块时的兜底链路。 */
				"uni-accelerometer": {},
				"uni-gyroscope": {}
			},
			"icons": {
				"appstore": "static/icons/inspection-appstore.png"
			},
			"splashScreens": {},
			"privacyDescription": {
				"NSCameraUsageDescription": "用于离线验货时拍摄现场检查图片和扫描条码",
				"NSPhotoLibraryUsageDescription": "用于离线验货时从系统相册选择现场检查图片",
				"NSPhotoLibraryAddUsageDescription": "用于将验货拍摄图片保存到应用本地目录"
			}
		}
	},
	"web": {
		"router": {
			"mode": ""
		}
	}
}
