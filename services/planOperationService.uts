/**
 * 创建搜索页计划操作服务，统一编排远程接口与本地离线数据变更。
 */
export function createPlanOperationService(options) {
  const planApi = options.planApi
  const reportRepository = options.reportRepository
  const planDownloadService = options.planDownloadService
  const searchViewModel = options.searchViewModel

  /**
   * 合并指定计划并返回后台生成的合并计划信息。
   */
  async function mergePlans(sourcePlanIds) {
    return planApi.mergePlans(sourcePlanIds)
  }

  /**
   * 拆分指定合并计划并返回后台拆分结果。
   */
  async function splitPlan(planId) {
    return planApi.splitPlan(planId)
  }

  /**
   * 复制当前或合并验货计划并返回新计划信息。
   */
  async function copyPlan(planId, payload) {
    return planApi.copyPlan(planId, payload ?? {})
  }

  /**
   * 下载指定计划并保存本地，转交预期成员与原卡片供下载服务校验和补齐字段。
   */
  async function downloadToLocal(planId, payload, expectedPlanIds: string[] = [], sourceItems: any[] = []) {
    return planDownloadService.downloadToLocal(planId, payload ?? {}, expectedPlanIds, sourceItems)
  }

  /** 分页查询合并父计划成员，包含尚未下载或未回传 parentPlanId 的远程卡片。 */
  async function getMergedMemberIds(parentPlanId) {
    const memberIds = new Set<any>()
    const pageSize = 100
    let page = 1
    while (true) {
      const response = await planApi.searchPlans({ parentPlanId }, page, pageSize)
      const records = Array.isArray(response?.records) ? response.records : []
      for (const record of records) {
        const recordParentId = searchViewModel.getItemParentPlanId(record)
        if (recordParentId !== '' && recordParentId !== parentPlanId) continue
        const recordId = searchViewModel.getPlanOperationId(record)
        if (recordId !== '') memberIds.add(recordId)
      }
      if (records.length === 0 || page * pageSize >= parseInt(String(response?.total ?? records.length))) break
      page += 1
    }
    return memberIds
  }

  /**
   * 解锁或重置计划；释放后用本地与云端成员 ID 清理整个合并组及列表缓存。
   */
  async function releasePlan(item, reportDeleteFlag = 0) {
    const planId = searchViewModel.getPlanOperationId(item)
    if (planId === '') throw new Error('计划ID缺失，无法执行操作')
    const mergeType = parseInt(String(item?.plan?.mergeType ?? item?.mergeType ?? item?.raw?.mergeType ?? 0))
    const mergedParentPlanId = searchViewModel.getItemParentPlanId(item)
    const parentPlanId = mergeType === 2 ? (mergedParentPlanId !== '' ? mergedParentPlanId : planId) : ''
    const removeIdSet = new Set([planId])
    if (parentPlanId !== '') {
      const remoteMemberIds = await getMergedMemberIds(parentPlanId)
      for (const memberId of remoteMemberIds) removeIdSet.add(memberId)
      const localPlans = await reportRepository.listPlans()
      for (const localPlan of localPlans) {
        if (searchViewModel.getItemParentPlanId(localPlan) !== parentPlanId) continue
        const localPlanId = searchViewModel.getPlanOperationId(localPlan)
        if (localPlanId !== '') removeIdSet.add(localPlanId)
      }
    }
    const result = await planApi.releasePlan(planId, reportDeleteFlag)
    const removedIds = Array.from(removeIdSet)
    await reportRepository.removePlansByIds(removedIds)
    return { result, removedIds, parentPlanId }
  }

  /**
   * 解锁计划并保留云端报告删除标记为否。
   */
  async function unlockPlan(item) {
    return releasePlan(item, 0)
  }

  /**
   * 重置计划并要求云端删除已生成的报告数据。
   */
  async function resetPlan(item) {
    return releasePlan(item, 1)
  }

  return {
    mergePlans,
    splitPlan,
    copyPlan,
    downloadToLocal,
    releasePlan,
    unlockPlan,
    resetPlan
  }
}
