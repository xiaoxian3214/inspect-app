/** 只接受中文、英文和越南语代码，系统地区代码归并到对应语言。 */
export function normalizeLocale(locale) {
  const code = String(locale ?? '').toLowerCase().split(/[-_]/)[0]
  return code === 'en' || code === 'vi' ? code : 'zh'
}

/** 翻译中文源文案并替换命名参数，词条缺失时保留原文而不显示空白。 */
export function translate(key: string, locale: string, params: UTSJSONObject = {}): string {
  const source = String(key ?? '')
  const unfinishedPhotos = source.match(/^仍有 (\d+) 张图片未上传完成，请联网后重试$/)
  if (unfinishedPhotos != null) return translate('仍有 {count} 张图片未上传完成，请联网后重试', locale, { count: unfinishedPhotos[1] })
  const incompleteItems = source.match(/^仍有 (\d+) 个必填检查项未完成$/)
  if (incompleteItems != null) return translate('仍有 {count} 个必填检查项未完成', locale, { count: incompleteItems[1] })
  const missingPhotos = source.match(/^仍有 (\d+) 个检查项缺少必传图片$/)
  if (missingPhotos != null) return translate('仍有 {count} 个检查项缺少必传图片', locale, { count: missingPhotos[1] })
  const language = normalizeLocale(locale)
  const translated = language === 'en' ? (english.get(source) ?? appCopy.get(source)?.[0]) : language === 'vi' ? (vietnamese.get(source) ?? appCopy.get(source)?.[1]) : null
  const text = translated ?? source
  return text.replace(/\{(\w+)\}/g, (match, name) => {
    const value = params[name]
    return value === undefined || value === null ? match : String(value)
  })
}
