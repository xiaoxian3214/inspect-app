<template>
	<view>
			<view class="inspection-card" @click="handleCardClick">
				<view class="card-left">
					<view class="download-icon-wrapper" :class="downloadStateClass">
						<AppIcon :type="downloadStateClass === 'locked' ? 'locked' : 'downloadFilled'" :size="18" color="#ffffff" />
					</view>
				<view class="product-image">
					<text class="image-placeholder">📦</text>
				</view>
			</view>

			<view class="card-middle">
				<view class="product-name">{{ productName === '未命名产品' ? translateText('未命名产品') : productName }}</view>
				<view class="status-row">
					<text class="status-badge">{{ inspectTypeShort }}</text>
					<text class="goods-no">{{ goodsNoWithBatch }}</text>
					<view class="status-right">
					<text class="progress-status" :class="statusClass">{{ translateText(statusText) }}</text>
					</view>
				</view>
				<view v-if="goodsFlagType === 'raw'" class="goods-extra-line">
					<view class="goods-extra-item">
						<text class="goods-extra-label">{{ translateText('制造令：') }}</text>
						<text class="goods-extra-value">{{ produceNo }}</text>
					</view>
					<view class="goods-extra-item goods-extra-spacer">
						<text class="goods-extra-label">{{ translateText('模具色卡号：') }}</text>
						<text class="goods-extra-value">{{ modelNo }}</text>
					</view>
				</view>
				<view v-else class="goods-extra-line">
					<view class="goods-extra-item">
						<text class="goods-extra-label">{{ translateText('采购合同号：') }}</text>
						<text class="goods-extra-value">{{ domeNo }}</text>
					</view>
				</view>
			</view>

					<view class="card-right">
						<view v-if="selectionMode" class="merge-check-wrapper" :class="{ selected: selectionChecked, disabled: selectionDisabled }" @click.stop="toggleMergeSelection">
							<view v-if="selectionDisabled" class="merge-disabled-mark">—</view>
							<view v-else class="merge-checkbox" :class="{ checked: selectionChecked }">
								<text v-if="selectionChecked" class="merge-check-mark">✓</text>
							</view>
						</view>
						<view v-else-if="isMerged" class="merge-flag">
							<MergePlanIcon />
						</view>
						<view v-if="!selectionMode" class="card-more-btn" @click.stop="openActionSheet">
						<MoreDotsIcon />
					</view>
				</view>
			</view>

			<BottomActionSheet
				:visible="showActionSheet"
				title="操作"
				:actions="cardActions"
				@select="handleCardAction"
				@cancel="closeActionSheet"
			/>

		<view v-if="showDownloadModal" class="menu-overlay" @click="closeDownloadModal">
			<view class="copy-modal download-modal" @click.stop>
				<text class="copy-modal-title">{{ translateText('下载验货') }}</text>
				<PlanDownloadDetails :item="props.item" :template-name="downloadTemplateDisplayName" :is-merged="isMerged" :merged-items="downloadMergedItems" :merged-loading="downloadPreviewLoading" @open-template="openDownloadTemplateSheet" />
					<view class="copy-actions">
						<button class="copy-btn close" :disabled="submitting" @click="closeDownloadModal">{{ translateText('取消') }}</button>
						<button class="copy-btn create" :disabled="submitting || downloadTemplateId === '' || (isMerged && (downloadPreviewLoading || downloadMergedItems.length < 2))" @click="confirmDownload">
						{{ translateText(submitting ? '下载中...' : '下载') }}
					</button>
				</view>
			</view>
		</view>
		<OptionSelectSheet :visible="showDownloadTemplateSheet" title="选择清单" empty-text="暂无可选清单" :options="downloadTemplateOptions" :selected-value="downloadTemplateId" @close="closeDownloadTemplateSheet" @confirm="selectDownloadTemplate" />

			<view v-if="showUnlockModal" class="menu-overlay" @click="closeUnlockModal">
				<view class="confirm-modal" @click.stop>
					<text class="confirm-title">{{ translateText('解锁验货任务') }}</text>
					<text class="confirm-message">{{ translateText('当前验货会恢复到已定计划状态。请确认您需要解锁该验货任务？') }}</text>
					<view class="confirm-actions">
						<button class="confirm-btn cancel" :disabled="submitting" @click="closeUnlockModal">{{ translateText('取消') }}</button>
						<button class="confirm-btn agree" :disabled="submitting" @click="confirmUnlock">{{ translateText(submitting ? '处理中...' : '同意') }}</button>
					</view>
				</view>
			</view>

			<view v-if="showResetModal" class="menu-overlay" @click="closeResetModal">
				<view class="copy-modal" :style="{ maxHeight: resetModalMaxHeight }" @click.stop>
					<text class="copy-modal-title">{{ translateText('重置验货任务') }}</text>
					<view class="copy-info-card">
						<view class="copy-info-row"><text class="copy-label">{{ translateText('订单号') }}</text><text class="copy-value">{{ orderNo }}</text></view>
						<view class="copy-info-row"><text class="copy-label">{{ translateText('款号#批次') }}</text><text class="copy-value">{{ goodsNoWithBatch }}</text></view>
						<view class="copy-info-row"><text class="copy-label">{{ translateText('产品名称') }}</text><text class="copy-value">{{ productName }}</text></view>
						<view class="copy-info-row"><text class="copy-label">{{ translateText('供应商') }}</text><text class="copy-value">{{ supplierName }}</text></view>
						<view class="copy-info-row"><text class="copy-label">{{ translateText('计划日期') }}</text><text class="copy-value">{{ detailDate }}</text></view>
						<view class="copy-info-row"><text class="copy-label">{{ translateText('检查类型') }}</text><text class="copy-value">{{ inspectType }}</text></view>
					</view>
					<text class="reset-tip">{{ translateText('您确定需要重置该验货任务？') }}</text>
					<view class="copy-actions">
						<button class="copy-btn close" :disabled="submitting" @click="closeResetModal">{{ translateText('取消') }}</button>
						<button class="copy-btn create" :disabled="submitting" @click="confirmReset">{{ translateText(submitting ? '处理中...' : '重置') }}</button>
					</view>
				</view>
			</view>

		<view v-if="showInspectorModal" class="menu-overlay" @click="closeInspectorModal">
			<view class="confirm-modal" @click.stop>
				<text class="confirm-title">{{ translateText('当前验货员') }}</text>
				<view class="confirm-content">
					<view class="copy-info-row"><text class="copy-label">{{ translateText('姓名') }}</text><text class="copy-value">{{ inspectorName }}</text></view>
					<view class="copy-info-row"><text class="copy-label">{{ translateText('工号') }}</text><text class="copy-value">{{ inspectorId }}</text></view>
				</view>
				<view class="confirm-actions single-row">
					<button class="confirm-btn agree full" @click="closeInspectorModal">{{ translateText('关闭') }}</button>
				</view>
			</view>
		</view>

			<CopyPlanSheet
				:visible="showCopySheet"
				:mode="copyMode"
				:item="item"
				:inspect-type-options="copyInspectTypeOptions"
				:templates="copyTemplateOptions"
				:merged-items="copyMergedItems"
				:merged-loading="copyMergedLoading"
				:selected-inspect-type="copyInspectType"
				:selected-template-id="copyTemplateId"
				:selected-template-name="copyTemplateName"
				:created="copyCreated"
				:submitting="submitting"
				@close="closeCopySheet"
				@update-inspect-type="setCopyInspectType"
				@update-template="setCopyTemplate"
				@confirm="confirmCopy"
				@download="downloadCopiedPlan"
			/>
			<ReadyQuantitySheet :visible="showReadyQuantitySheet" :rows="readyQuantityRows" :submitting="submitting" @close="closeReadyQuantitySheet" @update-quantity="updateReadyQuantity" @save="saveReadyQuantities" />
		</view>
</template>

<script setup lang="uts">
	import { windowHeightPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
		import { computed, ref } from 'vue'
		import BottomActionSheet from '../common/BottomActionSheet.uvue'
		import CopyPlanSheet from '../search/CopyPlanSheet.uvue'
		import OptionSelectSheet from '../search/OptionSelectSheet.uvue'
		import PlanDownloadDetails from './PlanDownloadDetails.uvue'
		import ReadyQuantitySheet from './ReadyQuantitySheet.uvue'
	import AppIcon from '../icons/AppIcon.uvue'
	import MergePlanIcon from '../icons/MergePlanIcon.uvue'
	import MoreDotsIcon from '../icons/MoreDotsIcon.uvue'
		import { buildCardActions, resolveCardClickAction, resolveDownloadState } from '../../domain/listActionViewModel.uts'
	import { openUrlInSystemBrowser } from '../../domain/openUrlInSystemBrowser.uts'
		import { normalizePlanStatus } from '../../domain/planViewModel.uts'
	import { extractCopiedPlanId, firstNonEmptyText, getItemInspectType, getItemParentPlanId, getMergePreviewRow, getPlanInspectTypeLabel, getPlanOperationId } from '../../domain/searchViewModel.uts'
	import { initializeRuntime, planApi, planDownloadService, planOperationService, reportRepository } from '../../runtime/appRuntime.uts'
	/** 计划接口收窄视图；updateFinishQuantity 经 apiClient.request → unwrapResponse 返回 JSON 数据或 null。 */
	type PlanApiMethods = { searchPlans: (params: UTSJSONObject, page: number, pageSize: number) => Promise<UTSJSONObject>, getPlanTemplates: () => Promise<UTSJSONObject[]>, getInspectTypeDict: () => Promise<UTSJSONObject[]>, updateFinishQuantity: (planId: string, quantity: string) => Promise<UTSJSONObject | null> }
	type ReadyQuantityRow = { planId: string, productName: string, orderNo: string, goodsNo: string, orderQuantity: number, finishQuantity: string }
	const nativePlanApi = planApi as PlanApiMethods
	/** 本地计划仓库收窄视图；reportRepository.savePlan 的所有分支都返回传入的计划对象。 */
	type ReportRepositoryMethods = { listPlans: () => Promise<UTSJSONObject[]>, savePlan: (plan: UTSJSONObject) => Promise<UTSJSONObject> }
	const nativeReportRepository = reportRepository as ReportRepositoryMethods
	/** 计划操作服务收窄视图；downloadToLocal 返回落库后的本地计划数组，unlockPlan/resetPlan 走 releasePlan 返回结果对象。 */
	type PlanOperationMethods = { copyPlan: (planId: string, payload: UTSJSONObject) => Promise<UTSJSONObject>, downloadToLocal: (planId: string, payload: UTSJSONObject, expectedIds?: string[], sourceItems?: UTSJSONObject[]) => Promise<UTSJSONObject[]>, unlockPlan: (item: UTSJSONObject) => Promise<UTSJSONObject>, resetPlan: (item: UTSJSONObject) => Promise<UTSJSONObject> }
	const nativePlanOperation = planOperationService as PlanOperationMethods
	/** 计划下载服务收窄视图；downloadToLocal 返回切分并补全后的本地计划数组。 */
	type PlanDownloadMethods = { downloadToLocal: (planId: string, payload: UTSJSONObject, expectedIds: string[], sourceItems: UTSJSONObject[]) => Promise<UTSJSONObject[]> }
	const nativePlanDownload = planDownloadService as PlanDownloadMethods

	const props = defineProps({
		item: { type: Object, required: true },
		showDownload: { type: Boolean, default: false },
		currentUserId: { type: [String, Number], default: '' },
		statusKey: { type: String, default: '' },
		isLocalDownloaded: { type: Boolean, default: false },
			useInternalActions: { type: Boolean, default: false },
			manageActionsInCard: { type: Boolean, default: false },
			useInternalCardClick: { type: Boolean, default: false },
			showActionSplit: { type: Boolean, default: false },
			delegateRemoteActions: { type: Boolean, default: false },
			selectionMode: { type: Boolean, default: false },
			selectionChecked: { type: Boolean, default: false },
			selectionDisabled: { type: Boolean, default: false }
		})
		const emit = defineEmits([
			'open',
			'download',
			'request-refresh',
			'released',
			'action-unlock',
			'action-reset',
			'action-download',
			'action-copy',
			'action-copy-merged',
			'action-split',
			'merge-toggle'
		])

	const showActionSheet = ref(false)
	const showDownloadModal = ref(false)
	const showInspectorModal = ref(false)
	const showUnlockModal = ref(false)
	const showResetModal = ref(false)
	const downloadTemplates = ref<UTSJSONObject[]>([])
	const showDownloadTemplateSheet = ref(false)
	const downloadMergedItems = ref<UTSJSONObject[]>([])
	const downloadPreviewLoading = ref(false)
	const downloadTemplateId = ref('')
	const downloadTemplateName = ref('')
	const showCopySheet = ref(false)
	const copyMode = ref(1)
	const copyInspectTypeOptions = ref<UTSJSONObject[]>([])
	const copyTemplateOptions = ref<UTSJSONObject[]>([])
	const copyMergedItems = ref<UTSJSONObject[]>([])
	const copyMergedLoading = ref(false)
	const copyInspectType = ref('')
	const copyTemplateId = ref('')
	const copyTemplateName = ref('')
	const copyCreated = ref(false)
	const copiedPlanId = ref('')
	const showReadyQuantitySheet = ref(false)
	const readyQuantityRows = ref<ReadyQuantityRow[]>([])
	const submitting = ref(false)
	/** 为计划卡片的原生模板提供可调用的多语言方法。 */
	function translateText(key: string): string { return t(key) }
	/** 将计划日期格式化为年月日文本。 */
	function formatDate(value: string): string { if (value.length >= 10) return value.substring(0, 10); return value === '' ? '-' : value }
	/** 将嵌套卡片计划收窄为可索引的 UTS 对象。 */
	const itemData = computed((): UTSJSONObject => props.item as UTSJSONObject)
	/** 限制重置确认弹层的可用窗口高度。 */
	const resetModalMaxHeight = computed((): string => windowHeightPx(0.9))

	/** 返回卡片使用的计划主体，兼容嵌套与平铺记录。 */
	const plan = computed((): UTSJSONObject => (itemData.value['plan'] as UTSJSONObject | null) ?? itemData.value)
	/** 归一化计划状态码，与 H5 列表的状态判断保持一致。 */
	const status = computed((): number => normalizePlanStatus(props.item))
	/** 选择卡片展示的产品名称。 */
	const productName = computed((): string => ((getMergePreviewRow(props.item) as UTSJSONObject)['productName'] ?? '-').toString())
	/** 选择卡片展示的货号。 */
	const goodsNo = computed((): string => firstNonEmptyText([plan.value['subGoodsNo'], plan.value['goodsNo'], itemData.value['subGoodsNo']], '-'))
	/** 选择卡片展示的批次号。 */
	const batchNo = computed((): string => firstNonEmptyText([plan.value['batchNo'], itemData.value['batchNo']], ''))
	const goodsNoWithBatch = computed((): string => batchNo.value !== '' ? `${goodsNo.value}#${batchNo.value}` : goodsNo.value)
	/** 选择卡片展示的供应商。 */
	const supplierName = computed((): string => firstNonEmptyText([plan.value['factoryName'], itemData.value['supplierName'], itemData.value['factoryName']], '-'))
	/** 选择卡片分组使用的订单号。 */
	const orderNo = computed((): string => firstNonEmptyText([plan.value['clientOrderNo'], plan.value['domeNo'], itemData.value['clientOrderNo'], itemData.value['orderNo']], '未分组'))
	/** 按 H5 卡片的类型显示顺序，保留拆分计划平铺字段中的原验货类型。 */
	const inspectType = computed((): string => getPlanInspectTypeLabel(props.item))
	const inspectTypeShort = computed((): string => inspectType.value.length > 2 ? inspectType.value.substring(0, 2) : inspectType.value)
	const goodsFlagType = computed((): string => (plan.value['goodsFlag'] ?? itemData.value['goodsFlag'] ?? 1).toString() === '0' ? 'raw' : 'finished')
	const produceNo = computed((): string => firstNonEmptyText([plan.value['produceNo'], itemData.value['produceNo']], '-'))
	const modelNo = computed((): string => firstNonEmptyText([plan.value['modelNo'], itemData.value['modelNo']], '-'))
	const domeNo = computed((): string => firstNonEmptyText([plan.value['domeNo'], itemData.value['domeNo']], '-'))
	/** 格式化卡片展示的交货或创建日期。 */
	const detailDate = computed((): string => formatDate(firstNonEmptyText([plan.value['deliveryDate'], plan.value['createDate'], itemData.value['deliveryDate'], itemData.value['createDate']], '')))
	const inspectorId = computed((): string => firstNonEmptyText([plan.value['inspectorId'], itemData.value['inspectorId'], itemData.value['lockerId']], '').trim())
	const inspectorName = computed((): string => firstNonEmptyText([plan.value['inspectorName'], itemData.value['inspectorName']], '验货员').trim())
	const lockFlag = computed((): number => parseFloat((plan.value['lockFlag'] ?? itemData.value['lockFlag'] ?? 0).toString()))
	const isMerged = computed((): boolean => (plan.value['mergeType'] ?? itemData.value['mergeType'] ?? 0).toString() === '2')
		const resolvedDownloadState = computed((): string => resolveDownloadState({
				isLocalDownloaded: props.isLocalDownloaded,
				lockFlag: lockFlag.value,
			inspectorId: inspectorId.value,
			currentUserId: props.currentUserId
		}))
	/** 当前计划已下载到本机。 */
	const isDownloaded = computed((): boolean => resolvedDownloadState.value === 'downloaded')
	/** 当前计划已被其他验货员锁定。 */
	const isLockedByOther = computed((): boolean => resolvedDownloadState.value === 'locked')
	/** 下载图标使用的原生样式类名。 */
	const downloadStateClass = computed((): string => resolvedDownloadState.value)
	/** 将已报告计划的卡片状态显示为“报告”，其他计划沿用原状态文案。 */
	const statusText = computed((): string => status.value === 3 ? '报告' : (status.value === 1 ? '进行中' : '已定计划'))
	const statusClass = computed((): string => status.value === 3 ? 'completed' : (status.value === 1 ? 'in-progress' : 'planned'))
	/** 允许下载需要页面开启下载入口，且本机未下载、未被他人锁定。 */
	const canDownload = computed((): boolean => props.showDownload && !isLockedByOther.value && !isDownloaded.value)
	type CardAction = { key: string, label: string, icon: string, disabled: boolean }
	/** 将下载清单转换为选择弹层选项；只传 UTSJSONObject 字面量，自定义类型实例跨组件传递会在 Android 原生端触发类型转换闪退。 */
	const downloadTemplateOptions = computed((): UTSJSONObject[] => downloadTemplates.value.map((item: UTSJSONObject): UTSJSONObject => ({ value: (item['id'] ?? '').toString(), label: (item['name'] ?? '').toString(), raw: item })))
	/** 返回下载弹层当前清单显示名称。 */
	const downloadTemplateDisplayName = computed((): string => downloadTemplateName.value !== '' ? downloadTemplateName.value : '请选择清单')
		/** 按下载状态、计划状态和合并标记生成卡片“更多”操作项。 */
		const cardActions = computed((): CardAction[] => (buildCardActions({
			downloadState: resolvedDownloadState.value,
			statusKey: props.statusKey !== '' ? props.statusKey : (status.value === 3 ? 'report' : (status.value === 1 ? 'progress' : 'planned')),
			manageActionsInCard: props.manageActionsInCard,
			isMerged: isMerged.value,
			showSplit: props.showActionSplit
		}) as UTSJSONObject[]).map((action: UTSJSONObject): CardAction => ({ key: (action['key'] ?? '').toString(), label: (action['label'] ?? '').toString(), icon: (action['icon'] ?? '').toString(), disabled: submitting.value })))

		/** 在合并多选模式下通知页面切换当前计划的选中状态。 */
		function toggleMergeSelection(): void { if (!props.selectionMode || props.selectionDisabled) return; emit('merge-toggle', props.item) }

		/**
		 * 关闭卡片右侧“更多”操作菜单。
		 */
		function closeActionSheet(): void {
		showActionSheet.value = false
	}

		/**
		 * 打开与 H5 可见性规则一致的卡片操作菜单。
		 */
		function openActionSheet(): void {
			if (props.selectionMode) {
				toggleMergeSelection()
				return
			}
			if (!props.useInternalActions) return
			showActionSheet.value = true
		}

		/**
		 * 关闭计划下载确认弹窗。
		 */
	function closeDownloadModal(): void {
		showDownloadModal.value = false
		showDownloadTemplateSheet.value = false
		downloadMergedItems.value = []
	}

	/** 按旧版合并弹框查询同组成员，下载前展示并校验整组计划。 */
	async function loadDownloadMergedItems(): Promise<void> {
		downloadMergedItems.value = []
		if (!isMerged.value) return
		const mergedParentPlanId = getItemParentPlanId(props.item)
		const parentPlanId = mergedParentPlanId !== '' ? mergedParentPlanId : getPlanOperationId(props.item)
		if (parentPlanId === '') return
		downloadPreviewLoading.value = true
		try {
			const response = await nativePlanApi.searchPlans({ parentPlanId }, 1, 100)
			const seen = new Set<string>()
			const storedRecords = response['records']
			downloadMergedItems.value = (Array.isArray(storedRecords) ? storedRecords as UTSJSONObject[] : []).filter((member: UTSJSONObject) => {
				const memberId = getPlanOperationId(member)
				if (memberId === '' || seen.has(memberId) || getItemParentPlanId(member) !== parentPlanId) return false
				seen.add(memberId)
				return true
			})
		} catch (error) { uni.showToast({ title: error?.message ?? t('加载合并验货成员失败'), icon: 'none' }) }
		finally { downloadPreviewLoading.value = false }
	}

		/**
		 * 加载 H5 同源清单模板并打开下载确认弹层。
		 */
		async function openDownloadModal(): Promise<void> {
			downloadTemplateId.value = firstNonEmptyText([plan.value['templateId'], itemData.value['templateId']], '')
			downloadTemplateName.value = firstNonEmptyText([plan.value['templateName'], itemData.value['templateName']], '')
			showDownloadModal.value = true
			loadDownloadMergedItems()
			try {
				downloadTemplates.value = await nativePlanApi.getPlanTemplates()
				if (downloadTemplateId.value === '' && downloadTemplates.value.length > 0) {
					downloadTemplateId.value = (downloadTemplates.value[0]['id'] ?? '').toString()
					downloadTemplateName.value = (downloadTemplates.value[0]['name'] ?? '').toString()
				}
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('加载清单失败'), icon: 'none' })
			}
		}

		/** 打开与复制验货相同的底部清单选择弹层。 */
		function openDownloadTemplateSheet(): void { if (!submitting.value) showDownloadTemplateSheet.value = true }

		/** 取消清单选择且不改变当前下载参数。 */
		function closeDownloadTemplateSheet(): void { showDownloadTemplateSheet.value = false }

		/** 确认清单选项后同步下载参数及弹框回显。 */
		function selectDownloadTemplate(option: UTSJSONObject): void {
			const template = (option['raw'] as UTSJSONObject | null) ?? option
			downloadTemplateId.value = (template['id'] ?? '').toString()
			downloadTemplateName.value = (template['name'] ?? '').toString()
			closeDownloadTemplateSheet()
		}

		/**
		 * 关闭解锁二次确认弹层。
		 */
		function closeUnlockModal(): void {
			showUnlockModal.value = false
		}

		/**
		 * 关闭重置二次确认弹层。
		 */
		function closeResetModal(): void {
			showResetModal.value = false
		}

		/** 更新内部复制流程选择的清单模板。 */
		function setCopyTemplate(option: UTSJSONObject): void { copyTemplateId.value = (option['id'] ?? '').toString(); copyTemplateName.value = (option['name'] ?? '').toString() }
		/** 查询复制合并验货的全部成员，接口失败时至少展示当前卡片。 */
		async function loadCopyMergedItems(): Promise<void> {
			const mergedParentPlanId = getItemParentPlanId(props.item)
			const parentPlanId = mergedParentPlanId !== '' ? mergedParentPlanId : getPlanOperationId(props.item)
			copyMergedLoading.value = true
			try {
				const response = await nativePlanApi.searchPlans({ parentPlanId }, 1, 100)
				const storedMembers = response['records']
				const members = Array.isArray(storedMembers) ? storedMembers as UTSJSONObject[] : []
				copyMergedItems.value = members.length > 0 ? members : [itemData.value]
			} catch (error) { copyMergedItems.value = [itemData.value]; uni.showToast({ title: error?.message ?? t('加载合并验货成员失败'), icon: 'none' }) }
			finally { copyMergedLoading.value = false }
		}
		/** 加载检查类型和清单模板并打开内部复制弹层。 */
		async function openCopySheet(mode: number): Promise<void> {
			try {
				const options = await Promise.all([nativePlanApi.getInspectTypeDict(), nativePlanApi.getPlanTemplates()])
				copyInspectTypeOptions.value = options[0] ?? []
				copyTemplateOptions.value = options[1] ?? []
				copyMode.value = mode === 2 ? 2 : 1
				copyCreated.value = false
				copiedPlanId.value = ''
				const currentType = getItemInspectType(props.item)
				copyInspectType.value = copyInspectTypeOptions.value.some((option: UTSJSONObject) => (option['value'] ?? '').toString() === currentType)
					? currentType
					: (copyInspectTypeOptions.value[0]?.['value'] ?? '').toString()
				const existingTemplateId = firstNonEmptyText([plan.value['templateId'], itemData.value['templateId']], '')
				const existingTemplate = copyTemplateOptions.value.find((option: UTSJSONObject) => (option['id'] ?? '').toString() === existingTemplateId)
				setCopyTemplate(existingTemplate ?? { id: existingTemplateId, name: firstNonEmptyText([plan.value['templateName'], itemData.value['templateName']], '') })
				copyMergedItems.value = []
				showCopySheet.value = true
				if (copyMode.value === 2) loadCopyMergedItems()
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('加载复制选项失败'), icon: 'none' })
			}
		}

		/**
		 * 关闭内部复制弹层并清理复制结果状态。
		 */
		function closeCopySheet(): void {
			showCopySheet.value = false
			copyCreated.value = false
			copiedPlanId.value = ''
			copyMergedItems.value = []
		}

		/**
		 * 从计划字段中读取 H5 备货数量弹层所需的原始订单数量。
		 */
		function getOrderQuantity(item: UTSJSONObject): number {
			const source = (item['plan'] as UTSJSONObject | null) ?? item
			return parseFloat((source['requiredQuantity'] ?? source['quantity'] ?? source['orderQuantity'] ?? source['totalQuantity'] ?? 0).toString())
		}

		/**
		 * 加载当前计划或合并组计划并打开备货数量弹层。
		 */
		async function openReadyQuantitySheet(): Promise<void> {
			try {
			let items: UTSJSONObject[] = [itemData.value]
				if (isMerged.value) {
					const candidateParentId = getItemParentPlanId(props.item)
					const parentPlanId = candidateParentId !== '' ? candidateParentId : getPlanOperationId(props.item)
				const response = await nativePlanApi.searchPlans({ parentPlanId }, 1, 100)
				const storedRecords = response['records']
				if (Array.isArray(storedRecords) && (storedRecords as UTSJSONObject[]).length > 0) items = storedRecords as UTSJSONObject[]
			}
			readyQuantityRows.value = items.map((item: UTSJSONObject): ReadyQuantityRow => {
				const source = (item['plan'] as UTSJSONObject | null) ?? item
				const orderQuantity = getOrderQuantity(item)
				return {
					planId: getPlanOperationId(item),
					productName: firstNonEmptyText([source['goodsName'], source['goodsCname']], ''),
					orderNo: firstNonEmptyText([source['clientOrderNo'], source['domeNo']], ''),
					goodsNo: firstNonEmptyText([source['subGoodsNo'], source['goodsNo']], ''),
					orderQuantity,
					finishQuantity: (source['finishQuantity'] ?? source['readyQuantity'] ?? orderQuantity).toString()
				}
			}).filter((row: ReadyQuantityRow) => row.planId !== '')
				showReadyQuantitySheet.value = true
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('加载备货数量失败'), icon: 'none' })
			}
		}

		/**
		 * 关闭备货数量弹层。
		 */
		function closeReadyQuantitySheet(): void {
			showReadyQuantitySheet.value = false
		}

		/**
		 * 更新备货数量弹层指定行的输入值。
		 */
		function updateReadyQuantity(payload: UTSJSONObject): void {
			const index = parseInt((payload['index'] ?? -1).toString())
			if (index < 0 || index >= readyQuantityRows.value.length) return
			readyQuantityRows.value = readyQuantityRows.value.map((row: ReadyQuantityRow, rowIndex: number): ReadyQuantityRow => rowIndex === index ? { ...row, finishQuantity: (payload['value'] ?? '').toString() } : row)
		}

		/**
		 * 保存全部备货数量并同步更新已下载的本地计划。
		 */
		async function saveReadyQuantities(): Promise<void> {
			if (submitting.value) return
			submitting.value = true
			try {
				for (const row of readyQuantityRows.value) await nativePlanApi.updateFinishQuantity(row.planId, row.finishQuantity)
				const localPlans = await nativeReportRepository.listPlans()
				for (const row of readyQuantityRows.value) {
					const localPlan = localPlans.find((item: UTSJSONObject) => getPlanOperationId(item) === row.planId)
					if (localPlan == null) continue
					const storedPlan = (localPlan['plan'] as UTSJSONObject | null) ?? {}
					await nativeReportRepository.savePlan({ ...localPlan, plan: { ...storedPlan, finishQuantity: parseFloat(row.finishQuantity) } })
				}
				showReadyQuantitySheet.value = false
				emit('request-refresh')
				uni.showToast({ title: t('备货数量已更新'), icon: 'success' })
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('修改备货数量失败'), icon: 'none' })
			} finally {
				submitting.value = false
			}
		}

		/**
		 * 更新内部复制流程选择的检查类型。
		 */
		function setCopyInspectType(option: UTSJSONObject): void {
			copyInspectType.value = (option['value'] ?? '').toString()
		}

		/**
		 * 创建当前验货或整个合并验货的副本。
		 */
		async function confirmCopy(): Promise<void> {
			if (submitting.value) return
			const parentPlanId = getItemParentPlanId(props.item)
			const sourcePlanId = copyMode.value === 2 && parentPlanId !== '' ? parentPlanId : getPlanOperationId(props.item)
			if (sourcePlanId === '' || copyInspectType.value === '' || copyTemplateId.value === '') return
			submitting.value = true
			try {
			const response = await nativePlanOperation.copyPlan(sourcePlanId, {
					inspectType: copyInspectType.value,
					copyFlag: copyMode.value,
					templateId: copyTemplateId.value,
					templateName: copyTemplateName.value
				})
				copiedPlanId.value = extractCopiedPlanId(response)
				if (copyMode.value === 2 && copiedPlanId.value === '') {
					const parentPlanId = (response['parentPlanId'] ?? '').toString()
					if (parentPlanId !== '') {
						const rows = await nativePlanApi.searchPlans({ parentPlanId }, 1, 100)
						const storedRecords = rows['records']
						const records = Array.isArray(storedRecords) ? storedRecords as UTSJSONObject[] : []
						copiedPlanId.value = getPlanOperationId(records[0] ?? {})
					}
				}
				if (copiedPlanId.value === '') throw new Error('复制成功但未返回新计划ID')
				copyCreated.value = true
				uni.showToast({ title: t('复制验货成功'), icon: 'success' })
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('复制验货失败'), icon: 'none' })
			} finally {
				submitting.value = false
			}
		}

		/**
		 * 下载复制成功的新计划并刷新本地列表状态。
		 */
		async function downloadCopiedPlan(): Promise<void> {
			if (copiedPlanId.value === '' || submitting.value) return
			submitting.value = true
			try {
			await nativePlanOperation.downloadToLocal(copiedPlanId.value, { templateId: copyTemplateId.value, templateName: copyTemplateName.value }, [], [])
				closeCopySheet()
				emit('request-refresh')
				uni.showToast({ title: t('已下载到本地'), icon: 'success' })
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('下载失败'), icon: 'none' })
			} finally {
				submitting.value = false
			}
		}

		/**
		 * 关闭当前验货员信息弹窗。
		 */
		function closeInspectorModal(): void {
		showInspectorModal.value = false
	}

		/**
		 * 从卡片操作菜单进入下载确认流程。
		 */
		async function openDownloadModalFromMenu(): Promise<void> {
		closeActionSheet()
		await openDownloadModal()
	}

		/**
		 * 从卡片操作菜单查看锁定计划的当前验货员。
		 */
		function openInspectorModalFromMenu(): void {
		closeActionSheet()
		showInspectorModal.value = true
	}

		/** 提取当前卡片用于本地详情页导航的计划 ID。 */
		function getDetailPlanId(): string { return getPlanOperationId(props.item).trim() }
		/** 本机已下载才进入详情；未下载则提示锁定或打开下载确认弹框。 */
		function openDetailPage(): void {
			if (!props.isLocalDownloaded) {
				if (resolvedDownloadState.value === 'locked') uni.showToast({ title: t('该计划已被其他验货员下载，当前账号不可操作'), icon: 'none' })
				else openDownloadModal()
				return
			}
			const planId = getDetailPlanId()
			if (planId === '') { uni.showToast({ title: t('计划ID缺失，无法进入详情'), icon: 'none' }); return }
			uni.navigateTo({ url: `/pages/report/detail?planId=${encodeURIComponent(planId)}` })
		}
		/** 临时验证【显示报告】是否能调起系统浏览器打开百度；调起失败则提示用户。 */
		function openReportInBrowser(): void {
			closeActionSheet()
			if (openUrlInSystemBrowser('https://www.baidu.com')) return
			uni.showToast({ title: t('唤起浏览器失败'), icon: 'none' })
		}

		/**
		 * 分发卡片菜单操作，按当前页面配置执行或委托下载、解锁、重置、复制及拆分。
		 */
		function handleCardAction(action: UTSJSONObject): void {
			const actionKey = (action['key'] ?? '').toString()
			if (actionKey === 'download') {
				openDownloadModalFromMenu()
				return
			}
			if (actionKey === 'view-inspector') {
				openInspectorModalFromMenu()
				return
			}
			if (actionKey === 'reset') {
				closeActionSheet()
				if (props.delegateRemoteActions) {
					emit('action-reset', props.item)
					return
				}
				showResetModal.value = true
				return
			}
			if (actionKey === 'report') { openReportInBrowser(); return }
			closeActionSheet()
			if (actionKey === 'unlock') {
				if (props.delegateRemoteActions) {
					emit('action-unlock', props.item)
					return
				}
				showUnlockModal.value = true
				return
			}
			if (actionKey === 'copy') {
				if (props.delegateRemoteActions) {
					emit('action-copy', props.item)
					return
				}
				openCopySheet(1)
				return
			}
			if (actionKey === 'copy-merged') {
				if (props.delegateRemoteActions) {
					emit('action-copy-merged', props.item)
					return
				}
				openCopySheet(2)
				return
			}
			if (actionKey === 'ready-quantity') {
				openReadyQuantitySheet()
				return
			}
			if (actionKey === 'split') {
				emit('action-split', props.item)
				return
			}
		}

		/**
		 * 下载完整计划并事务性保存，同时传入原卡片字段供本地摘要补全。
		 */
		async function confirmDownload(): Promise<void> {
		const planId = firstNonEmptyText([plan.value['planId'], plan.value['id'], itemData.value['planId'], itemData.value['id']], '').trim()
		if (planId === '') {
			uni.showToast({ title: t('计划ID缺失'), icon: 'none' })
			return
		}
		if (isMerged.value && (downloadPreviewLoading.value || downloadMergedItems.value.length < 2)) { uni.showToast({ title: t('合并验货成员未加载完整，请重试'), icon: 'none' }); return }
		const parentPlanId = getItemParentPlanId(props.item)
		const downloadPlanId = isMerged.value && parentPlanId !== '' ? parentPlanId : planId
		submitting.value = true
		try {
			await initializeRuntime()
			await nativePlanDownload.downloadToLocal(downloadPlanId, {
			templateId: downloadTemplateId.value,
			templateName: downloadTemplateName.value
			}, isMerged.value ? downloadMergedItems.value.map((member: UTSJSONObject): string => getPlanOperationId(member)) : [],
			isMerged.value ? downloadMergedItems.value : [itemData.value])
			showDownloadModal.value = false
			emit('download', props.item)
			emit('request-refresh')
			uni.showToast({ title: t('下载成功'), icon: 'success' })
		} catch (error) {
			uni.showToast({ title: error?.message ?? t('下载失败'), icon: 'none' })
		} finally {
			submitting.value = false
		}
	}

		/**
		 * 二次确认后解锁当前任务，并通知列表移除已释放的本地与远程缓存。
		 */
		async function confirmUnlock(): Promise<void> {
		submitting.value = true
		try {
			await initializeRuntime()
			const response = await nativePlanOperation.unlockPlan(itemData.value)
			showUnlockModal.value = false
			emit('released', response)
			emit('request-refresh')
			uni.showToast({ title: t('解锁成功'), icon: 'success' })
		} catch (error) {
			uni.showToast({ title: error?.message ?? t('解锁失败'), icon: 'none' })
		} finally {
			submitting.value = false
		}
	}

		/**
		 * 二次确认后重置任务并删除云端报告，同时通知列表移除已释放的缓存。
		 */
		async function confirmReset(): Promise<void> {
			submitting.value = true
			try {
				await initializeRuntime()
			const response = await nativePlanOperation.resetPlan(itemData.value)
				showResetModal.value = false
				emit('released', response)
				emit('request-refresh')
				uni.showToast({ title: t('重置成功'), icon: 'success' })
			} catch (error) {
				uni.showToast({ title: error?.message ?? t('重置失败'), icon: 'none' })
			} finally {
				submitting.value = false
			}
		}

		/**
		 * 本机未下载的进行中任务先弹下载确认，已缓存才打开详情。
		 */
		function handleCardClick(): void {
			if (!props.useInternalCardClick) {
				emit('open', props.item)
				return
			}
			const action = resolveCardClickAction({
				selectionMode: props.selectionMode,
				status: status.value,
				downloadState: resolvedDownloadState.value,
				isLocalDownloaded: props.isLocalDownloaded,
				manageActionsInCard: props.manageActionsInCard
			})
			if (action === 'toggle-merge') { toggleMergeSelection(); return }
			if (action === 'open-download') { openDownloadModal(); return }
			if (action === 'request-download') { emit('action-download', props.item); return }
			if (action === 'open-actions') { openActionSheet(); return }
			openDetailPage()
	}
</script>

<style>
	.inspection-card { background-color: #ffffff; padding: 24rpx 8rpx 24rpx 24rpx; flex-direction: row; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06); position: relative; min-height: 160rpx; }
		.card-left { position: relative; flex-shrink: 0; overflow: visible; }
		.download-icon-wrapper { position: absolute; top: -8rpx; left: 0; width: 56rpx; height: 56rpx; border-radius: 16rpx; align-items: center; justify-content: center; box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2); z-index: 1; }
		.download-icon-wrapper.available { background-color: #94a3b8; }
		.download-icon-wrapper.downloaded { background-color: #16a34a; }
		.download-icon-wrapper.locked { background-color: #6b7280; }
		.product-image { width: 140rpx; height: 140rpx; border-radius: 16rpx; background-color: #f1f5f9; align-items: center; justify-content: center; border-width: 2rpx; border-color: #e2e8f0; }
	.image-placeholder { font-size: 64rpx; }
	.card-middle { flex: 1; min-width: 0; margin-left: 24rpx; }
	.product-name { font-size: 26rpx; font-weight: 600; color: #1e293b; line-height: 1.5; padding-right: 88rpx; }
	.status-row { flex-direction: row; align-items: center; margin-top: 10rpx; }
	.status-badge { background-color: #dbeafe; color: #1e40af; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: 600; }
	.goods-no { flex: 1; min-width: 0; margin-left: 12rpx; font-size: 24rpx; color: #64748b; }
	.status-right { margin-left: auto; }
	.progress-status { font-size: 24rpx; font-weight: 600; padding: 4rpx 16rpx; border-radius: 20rpx; }
	.progress-status.planned { background-color: #fef3c7; color: #92400e; }
	.progress-status.in-progress { background-color: #fef3c7; color: #f59e0b; }
	.progress-status.completed { background-color: #d1fae5; color: #065f46; }
	.goods-extra-line { flex-direction: row; align-items: center; margin-top: 10rpx; }
	.goods-extra-item { flex-direction: row; align-items: center; }
	.goods-extra-spacer { margin-left: 12rpx; }
	.goods-extra-label { color: #94a3b8; font-size: 20rpx; }
	.goods-extra-value { color: #64748b; font-size: 20rpx; }
		.card-right { position: absolute; top: 20rpx; right: 24rpx; z-index: 1; flex-direction: row; align-items: center; }
		.merge-flag { width: 46rpx; height: 46rpx; margin-right: 10rpx; border-radius: 12rpx; background-color: #ecfdf5; border-width: 2rpx; border-color: #a7f3d0; align-items: center; justify-content: center; box-shadow: 0 2rpx 4rpx rgba(5, 150, 105, 0.12); }
		.merge-check-wrapper { width: 56rpx; height: 56rpx; border-width: 2rpx; border-color: #cbd5e1; border-radius: 14rpx; background-color: #ffffff; align-items: center; justify-content: center; box-shadow: 0 3rpx 8rpx rgba(15, 23, 42, 0.08); }
		.merge-check-wrapper.selected { border-color: #22c55e; background-color: #ecfdf5; }
		.merge-check-wrapper.disabled { border-color: #94a3b8; background-color: #cbd5e1; }
		.merge-checkbox { width: 36rpx; height: 36rpx; border-width: 2rpx; border-style: solid; border-color: #94a3b8; border-radius: 6rpx; background-color: #ffffff; align-items: center; justify-content: center; }
		.merge-checkbox.checked { border-color: #1a5f3f; background-color: #1a5f3f; }
		.merge-check-mark { color: #ffffff; font-size: 24rpx; font-weight: 700; line-height: 28rpx; }
		.merge-disabled-mark { color: #475569; font-size: 36rpx; font-weight: 700; line-height: 42rpx; }
		.card-more-btn { width: 46rpx; height: 46rpx; background-color: #f8fafc; border-width: 2rpx; border-color: #e2e8f0; border-radius: 12rpx; flex-direction: row; align-items: center; justify-content: center; box-shadow: 0 2rpx 4rpx rgba(15, 23, 42, 0.08); }
		.menu-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.5); z-index: 2000; justify-content: flex-end; }
	.confirm-modal { width: 100%; background-color: #ffffff; border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; overflow: hidden; }
	.confirm-title { padding: 40rpx; font-size: 48rpx; font-weight: 700; color: #111827; border-bottom-width: 2rpx; border-bottom-color: #f1f5f9; }
	.confirm-content { padding: 20rpx 40rpx 10rpx; }
	.confirm-message { padding: 32rpx 40rpx; color: #475569; font-size: 28rpx; line-height: 44rpx; }
	.confirm-actions { flex-direction: row; padding: 0 40rpx 40rpx; }
	.confirm-actions.single-row { padding-top: 20rpx; }
	.confirm-btn { height: 88rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
	.confirm-btn.cancel { flex: 1; margin-right: 20rpx; color: #334155; border-width: 2rpx; border-color: #e2e8f0; background-color: #ffffff; }
	.confirm-btn.agree { flex: 1; background-color: #03ae4f; color: #ffffff; }
	.confirm-btn.full { width: 100%; }
	.copy-modal { width: 100%; background-color: #ffffff; border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; padding: 32rpx; }
	.download-modal { height: 85%; }
	.copy-modal-title { font-size: 40rpx; font-weight: 700; color: #111827; margin-bottom: 24rpx; }
	.copy-info-card { background-color: #ffffff; border-width: 2rpx; border-color: #e5e7eb; border-radius: 24rpx; padding: 16rpx 24rpx; }
	.copy-info-row { flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 20rpx 0; border-bottom-width: 2rpx; border-bottom-color: #cbd5e1; }
	.copy-info-row.selectable { background-color: #f8fafc; }
	.copy-label { color: #64748b; font-size: 28rpx; }
	.copy-value { max-width: 420rpx; color: #111827; font-size: 28rpx; text-align: right; }
	.copy-actions { flex-direction: row; margin-top: 36rpx; }
	.copy-btn { flex: 1; height: 88rpx; margin: 0 12rpx; border-radius: 20rpx; font-size: 32rpx; font-weight: 600; }
	.copy-btn.close { background-color: #ffffff; border-width: 2rpx; border-color: #e5e7eb; color: #334155; }
	.copy-btn.create { background-color: #03ae4f; color: #ffffff; }
	.reset-tip { margin-top: 28rpx; color: #b45309; font-size: 28rpx; text-align: center; }
</style>
