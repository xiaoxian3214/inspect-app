<template>
	<view class="record">
		<view class="record-heading">
			<text class="record-title">{{ reportRow.productName ? reportRow.productName : reportRow.planId }}</text>
			<text class="record-status">{{ translateText('状态 {status}', { status: reportRow.status }) }}</text>
		</view>
		<text class="record-meta">{{ translateText('计划 ID：{id}', { id: reportRow.planId }) }}</text>
		<text v-if="reportRow.reportId !== reportRow.planId" class="record-meta">{{ translateText('共享计划 ID：{id}', { id: reportRow.reportId }) }}</text>
		<text class="record-meta">{{ translateText('订单号：{number}', { number: reportRow.orderNo ? reportRow.orderNo : '-' }) }}</text>
		<text class="record-meta">{{ translateText('验货类型：{type}', { type: reportRow.data.inspect_type ? reportRow.data.inspect_type : '-' }) }}</text>
		<text class="record-meta">{{ translateText('工厂：{name}', { name: reportRow.data.factory_name ? reportRow.data.factory_name : '-' }) }}</text>
		<text class="record-meta">{{ translateText('下载时间：{time}', { time: reportRow.downloadAt ? reportRow.downloadAt : '-' }) }}</text>
		<view class="record-actions">
			<view class="record-action" @click="toggleRawData"><text class="record-action-text">{{ translateText(expanded ? '收起验货计划原始行' : '查看验货计划原始行') }}</text></view>
			<view class="record-action" @click="copyDiagnostic"><text class="record-action-text">{{ translateText('复制诊断 JSON') }}</text></view>
			<view v-if="expanded" class="record-action" @click="copyRawData"><text class="record-action-text">{{ translateText('复制完整 JSON') }}</text></view>
			<view v-if="expanded" class="record-action" @click="shareRawData"><text class="record-action-text">{{ translateText('分享完整 JSON 文件') }}</text></view>
		</view>
		<text v-if="expanded" class="record-json">{{ rawData }}</text>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { buildLocalReportDiagnostic } from '../../domain/localReportDiagnostic.uts'
	import { computed, ref } from 'vue'
	type ReportRow = { planId: string, reportId: string, productName: string, status: string, orderNo: string, downloadAt: string, data: UTSJSONObject }

	const props = defineProps({ row: { type: Object, required: true } })
	const expanded = ref(false)
	/** 将 SQLite 计划行转换成原生模板可读取的固定字段。 */
	const reportRow = computed((): ReportRow => { const raw = props.row as UTSJSONObject; return { planId: (raw['planId'] ?? '').toString(), reportId: (raw['reportId'] ?? '').toString(), productName: (raw['productName'] ?? '').toString(), status: (raw['status'] ?? '').toString(), orderNo: (raw['orderNo'] ?? '').toString(), downloadAt: (raw['downloadAt'] ?? '').toString(), data: (raw['data'] as UTSJSONObject | null) ?? {} } })
	/** 为本地计划卡片提供模板可调用的多语言方法。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }

	/** 将计划表真实行序列化，复制与分享均使用同一份内容。 */
	const rawData = computed((): string => JSON.stringify(reportRow.value.data, null, 2) ?? '{}')

	/** 展开或收起当前验货计划的 SQLite 原始行。 */
	function toggleRawData() { expanded.value = !expanded.value }

	/** 复制无需照片和清单内容的短诊断，方便排查离线详情及剪贴板容量问题。 */
	function copyDiagnostic() {
		uni.setClipboardData({
			data: buildLocalReportDiagnostic(props.row),
			success: () => uni.showToast({ title: t('诊断 JSON 已复制'), icon: 'success' }),
			fail: (error) => uni.showToast({ title: t('复制失败，请重试'), icon: 'none' })
		})
	}

	/** 展开后尝试复制计划原始行，失败时提示改用文件分享。 */
	function copyRawData() {
		uni.setClipboardData({
			data: rawData.value,
			success: () => uni.showToast({ title: t('已复制本地数据'), icon: 'success' }),
			fail: (error) => uni.showToast({ title: t('复制失败，请分享完整 JSON 文件'), icon: 'none' })
		})
	}

	/** 将计划原始行写入 App 本地文件并调用系统分享，避免大文本剪贴板限制。 */
	function shareRawData() {
		const planId = (reportRow.value.planId !== '' ? reportRow.value.planId : 'plan').replace(/[^a-zA-Z0-9_-]/g, '_')
		const filePath = `${uni.env.USER_DATA_PATH}/inspection-plan-${planId}.json`
		uni.getFileSystemManager().writeFile({
			filePath,
			data: rawData.value,
			encoding: 'utf-8',
			success: () => uni.shareWithSystem({
				type: 'file',
				filePaths: [filePath],
				fail: (error) => uni.showToast({ title: t('分享文件失败，请重试'), icon: 'none' })
			}),
			fail: (error) => uni.showToast({ title: t('保存文件失败，请重试'), icon: 'none' })
		})
	}
</script>

<style>
	.record { margin: 0 16px 14px; padding: 14px; border-radius: 16px; background-color: #ffffff; }
	.record-heading { flex-direction: row; align-items: center; justify-content: space-between; }
	.record-title { flex: 1; color: #0f172a; font-size: 16px; font-weight: 600; }
	.record-status { margin-left: 8px; color: #166534; font-size: 12px; }
	.record-meta { margin-top: 7px; color: #64748b; font-size: 12px; }
	.record-actions { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: #e2e8f0; }
	.record-action { min-height: 44px; justify-content: center; margin-right: 10px; }
	.record-action-text { color: #15803d; font-size: 13px; }
	.record-json { margin-top: 12px; padding: 10px; border-radius: 8px; color: #334155; background-color: #f1f5f9; font-size: 11px; }
</style>
