<template>
	<scroll-view class="download-info-scroll" :scroll-y="true">
		<view v-if="isMerged" class="merged-info-card">
			<text class="merged-title">{{ translateText('此合并验货包含以下验货：') }}</text>
			<PlanMemberTable :items="mergedItems" :loading="mergedLoading" />
		</view>
		<view class="copy-info-card">
			<view v-for="field in fields" :key="field.label" class="copy-info-row">
				<text class="copy-label">{{ field.label }}</text>
				<text class="copy-value">{{ field.value }}</text>
			</view>
		</view>
		<view class="section" @click="openTemplateOptions">
			<text class="section-label">{{ translateText('清单') }}</text>
			<view class="select-value"><text class="select-text">{{ templateName === '请选择清单' ? translateText('请选择清单') : templateName }}</text><text class="select-chevron">›</text></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'
	import { buildDownloadPlanFields } from '../../domain/planDownloadPreview.uts'
	import PlanMemberTable from './PlanMemberTable.uvue'
	type DownloadField = { label: string, value: string }

	const props = defineProps({
		item: { type: Object, default: () => ({}) },
		templateName: { type: String, default: '请选择清单' },
		mergedItems: { type: Array, default: () => [] },
		isMerged: { type: Boolean, default: false },
		mergedLoading: { type: Boolean, default: false }
	})
	const emit = defineEmits(['open-template'])
	/** 为原生下载弹层提供可调用的多语言方法。 */
	function translateText(key: string): string { return t(key) }

	/** 根据当前卡片计划生成与 H5 下载确认弹框一致的展示行。 */
	const fields = computed((): DownloadField[] => (buildDownloadPlanFields(props.item) as UTSJSONObject[]).map((raw: UTSJSONObject): DownloadField => ({ label: (raw['label'] ?? '').toString(), value: (raw['value'] ?? '-').toString() })))

	/** 请求卡片打开与复制验货共用的清单选择弹层。 */
	function openTemplateOptions() { emit('open-template') }
</script>

<style>
	.download-info-scroll { flex: 1; }
	.merged-info-card { margin-bottom: 20rpx; padding: 20rpx 24rpx; border-width: 2rpx; border-color: #e5e7eb; border-radius: 20rpx; background-color: #ffffff; }
	.merged-title { margin-bottom: 14rpx; color: #334155; font-size: 26rpx; font-weight: 600; }
	.copy-info-card { background-color: #ffffff; border-width: 2rpx; border-color: #e5e7eb; border-radius: 24rpx; padding: 16rpx 24rpx; }
	.copy-info-row { flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 20rpx 0; border-bottom: 2rpx solid #f5f5f5; }
	.copy-label { color: #64748b; font-size: 28rpx; }
	.copy-value { max-width: 420rpx; color: #111827; font-size: 28rpx; text-align: right; }
	.section { margin-top: 28rpx; }
	.section-label { color: #334155; font-size: 28rpx; font-weight: 600; }
	.select-value { min-height: 80rpx; margin-top: 14rpx; padding: 14rpx 24rpx; border-width: 2rpx; border-color: #d1d5db; border-radius: 16rpx; background-color: #f8fafc; flex-direction: row; align-items: center; }
	.select-text { flex: 1; color: #334155; font-size: 27rpx; }
	.select-chevron { color: #64748b; font-size: 36rpx; }
</style>
