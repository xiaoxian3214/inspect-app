<template>
	<view class="capture-control-row">
		<view class="control-side control-side-left">
			<view class="control-cell" @click="handleCancel">
				<view class="cancel-pill">
					<text class="cancel-pill-text">{{ translateText('取消') }}</text>
				</view>
			</view>
			<view class="control-cell" @click="toggleFlash">
				<image class="control-icon" :src="flashIcon" mode="aspectFit" />
				<!-- <text class="control-label">{{ translateText('闪光灯') }}</text> -->
			</view>
			<view class="control-cell" @click="cycleZoom">
				<view v-if="zoomLevels.length > 1" class="zoom-circle">
					<text class="zoom-circle-text">{{ zoomLabel(activeZoom) }}</text>
				</view>
				<!-- <text v-if="zoomLevels.length > 1" class="control-label">{{ translateText('倍率') }}</text> -->
			</view>
		</view>
		<view class="shutter-wrap" :class="{ disabled: shutterDisabled }" @click="pressShutter">
			<view class="shutter-rotate" :style="shutterRotationStyle">
				<image class="shutter-icon" :src="shutterIcon" mode="aspectFit" />
				<view v-if="captureMode === 'photo'" class="shutter-glyph">
					<AppIcon type="camera" :size="40" color="#0f172a" />
				</view>
			</view>
		</view>
		<view class="control-side control-side-right">
			<view class="control-cell" @click="switchMode">
				<image class="control-icon" :src="modeIcon" mode="aspectFit" />
				<!-- <text class="control-label">{{ modeLabel }}</text> -->
			</view>
			<view class="control-cell" :class="{ disabled: recording }" @click="switchCamera">
				<image class="control-icon" src="/static/camera/flip.png" mode="aspectFit" />
				<!-- <text class="control-label">{{ translateText('翻转') }}</text> -->
			</view>
			<view class="control-cell" :class="{ disabled: !finishEnabled }" @click="finishCapture">
				<view class="finish-pill">
					<text class="finish-pill-text">{{ translateText('完成') }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'
	import AppIcon from '../icons/AppIcon.uvue'
	import { resolveNextCameraZoom } from '../../domain/cameraCapture.uts'
	import { resolveThumbnailRotation } from '../../domain/imageOrientation.uts'

	const props = defineProps({
		flashOn: { type: Boolean, default: false },
		zoomOptions: { type: Array, default: () => [] as number[] },
		activeZoom: { type: Number, default: 1 },
		captureMode: { type: String, default: 'photo' },
		recording: { type: Boolean, default: false },
		shutterDisabled: { type: Boolean, default: false },
		finishEnabled: { type: Boolean, default: false },
		deviceRotation: { type: Number, default: 0 }
	})
	const emit = defineEmits(['cancel-capture', 'toggle-flash', 'change-zoom', 'switch-capture-mode', 'switch-camera', 'press-shutter', 'finish-capture'])

	/** 为原生模板提供可调用的翻译方法。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }

	/** 可用倍率档位；相机尚未上报能力时兜底为 1x，避免出现空档位。 */
	const zoomLevels = computed((): number[] => {
		const options = props.zoomOptions as number[]
		return options.length > 0 ? options : ([1] as number[])
	})
	/** 闪光灯图标：开启时使用点亮图标，关闭时使用熄灭图标。 */
	const flashIcon = computed((): string => props.flashOn ? '/static/camera/flashon.png' : '/static/camera/flashoff.png')
	/** 模式切换按钮图标：当前为录像时显示录像图标，否则显示拍照图标。 */
	const modeIcon = computed((): string => props.captureMode === 'video' ? '/static/camera/doing.png' : '/static/camera/snapshot.png')
	/** 模式切换按钮文案，点击后进入另一模式。 */
	const modeLabel = computed((): string => translateText(props.captureMode === 'video' ? '录像' : '拍照'))
	/** 快门图标：拍照用相机图标，录像待录制用录像图标，录制中用停止图标。 */
	const shutterIcon = computed((): string => {
		if (props.captureMode === 'video') return props.recording ? '/static/camera/stop.png' : '/static/camera/doing.png'
		return '/static/camera/shutter.png'
	})
	/**
	 * 快门内容的补偿旋转：手机横过来时按握持角反向旋转，按钮里的相机图标始终朝上。
	 * 方向未知（-1）时不叠加旋转，与底部缩略图的处理保持一致。
	 */
	const shutterRotationStyle = computed((): string => `transform: rotate(${resolveThumbnailRotation(props.deviceRotation)}deg)`)

	/** 倍率档位文案，如 2x。 */
	function zoomLabel(zoom: number): string {
		return `${zoom}x`
	}
	/** 通知页面取消本次拍摄并退出取景页。 */
	function handleCancel(): void {
		emit('cancel-capture')
	}
	/** 通知页面切换闪光灯开关。 */
	function toggleFlash(): void {
		emit('toggle-flash')
	}
	/**
	 * 通知页面把倍率切到下一个档位。
	 * 圆形倍率按钮只展示当前档位，每点一次循环往后一档；只有一个可用档位时不显示该按钮。
	 */
	function cycleZoom(): void {
		const levels = zoomLevels.value
		if (levels.length <= 1) return
		emit('change-zoom', resolveNextCameraZoom(levels, props.activeZoom))
	}
	/** 通知页面在拍照与录像模式之间切换。 */
	function switchMode(): void {
		emit('switch-capture-mode', props.captureMode === 'video' ? 'photo' : 'video')
	}
	/** 通知页面翻转前后摄像头；录像过程中禁止翻转，避免中断录像会话。 */
	function switchCamera(): void {
		if (props.recording) return
		emit('switch-camera')
	}
	/** 通知页面按下快门；录像进行中即使限流也可以点击停止。 */
	function pressShutter(): void {
		if (props.shutterDisabled && !props.recording) return
		emit('press-shutter')
	}
	/** 通知页面完成拍摄并回传已拍媒体；没有媒体时由页面给出提示。 */
	function finishCapture(): void {
		emit('finish-capture')
	}
</script>

<style>
	/* 取消、闪光灯、倍率、快门、模式、翻转、完成排成一行：左右两组各三个等宽控件，与居中的快门共用一条中心线。 */
	.capture-control-row { height: 148rpx; flex-direction: row; align-items: center; padding: 0 16rpx; background-color: #0f172a; }
	.control-side { flex: 1; height: 148rpx; flex-direction: row; align-items: center; }
	.control-side-left { justify-content: space-between; padding-right: 8rpx; }
	.control-side-right { justify-content: space-between; padding-left: 8rpx; }
	/* 控件按固定宽高居中：图标、圆形倍率与胶囊按钮都落在同一条水平中线上，文案统一贴在格子底部。 */
	.control-cell { position: relative; width: 88rpx; height: 148rpx; align-items: center; justify-content: center; }
	.control-cell.disabled { opacity: 0.4; }
	.control-icon { width: 44rpx; height: 44rpx; }
	.control-label { position: absolute; left: 0; right: 0; bottom: 10rpx; color: #cbd5e1; font-size: 20rpx; line-height: 24rpx; text-align: center; }
	/* 倍率圆形按钮：常亮表示可直接点击循环切换。 */
	.zoom-circle { width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border-width: 2rpx; border-style: solid; border-color: #facc15; border-radius: 22rpx; background-color: rgba(250, 204, 21, 0.16); }
	.zoom-circle-text { color: #facc15; font-size: 22rpx; line-height: 24rpx; }
	.cancel-pill { height: 44rpx; padding: 0 16rpx; align-items: center; justify-content: center; border-radius: 22rpx; background-color: rgba(255, 255, 255, 0.12); }
	.cancel-pill-text { color: #e2e8f0; font-size: 22rpx; line-height: 26rpx; }
	.finish-pill { height: 44rpx; padding: 0 16rpx; align-items: center; justify-content: center; border-radius: 22rpx; background-color: #facc15; }
	.finish-pill-text { color: #0f172a; font-size: 22rpx; line-height: 26rpx; }
	/* 紧凑的快门按钮：圆形底板保持小尺寸，内容整体按握持角补角，中间的相机图标因此始终朝上。 */
	.shutter-wrap { width: 124rpx; height: 124rpx; align-items: center; justify-content: center; }
	.shutter-wrap.disabled { opacity: 0.4; }
	/* 相机图标绝对居中压在底板上：AppIcon 的 size 是 px，40px 约占 116rpx 圆形直径的三分之二，比按钮本体更显眼。 */
	.shutter-rotate { position: relative; width: 124rpx; height: 124rpx; align-items: center; justify-content: center; }
	.shutter-icon { width: 116rpx; height: 116rpx; }
	/* 深色相机图标落在浅色圆形上，按下快门时能明确看出这是拍照按钮。 */
	.shutter-glyph { position: absolute; top: 0; left: 0; right: 0; bottom: 0; align-items: center; justify-content: center; }
</style>