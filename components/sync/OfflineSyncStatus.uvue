<template>
	<view class="sync-cloud-wrap">
		<view class="sync-cloud-icon" :class="{ disabled: disabled }" @click="handleClick">
			<AppIcon type="cloudUpload" :size="26" :color="iconColor" />
			<view v-if="isUploading" class="sync-upload-arrow" :style="{ opacity: arrowLit ? 1 : 0.15 }">
				<AppIcon type="arrowDown" :size="14" color="#ffffff" />
			</view>
			<view v-if="pendingCount > 0" class="sync-badge">
				<text class="sync-badge-text">{{ badgeText }}</text>
			</view>
		</view>

		<view v-if="showCard" class="sync-card" @click.stop>
			<view class="sync-card-inner">
				<view class="sync-card-header">
					<view class="sync-card-icon-wrap">
						<AppIcon type="cloudUpload" :size="22" color="#60a5fa" />
					</view>
					<view class="sync-card-title-area">
						<text class="sync-card-title">{{ t(cardTitle) }}</text>
						<text class="sync-card-count">{{ t(cardSubtitle) }}</text>
					</view>
					<view class="sync-card-close" @click.stop="hideCard">
						<AppIcon type="close" :size="16" color="#64748b" />
					</view>
				</view>
				<view v-if="isSyncing" class="sync-card-progress">
					<view class="sync-card-progress-bar">
						<view class="sync-card-progress-fill"></view>
					</view>
				</view>
				<text class="sync-card-tip">{{ t(cardTip) }}</text>
				<view class="sync-detail">
					<text class="sync-detail-title">{{ t('待同步队列（{count}）', { count: queueItems.length }) }}</text>
					<scroll-view v-if="queueItems.length > 0" class="sync-detail-list" scroll-y="true">
						<view v-for="(item, index) in queueItems" :key="item.id || index" class="sync-detail-item" :class="{ failed: isFailedItem(item) }">
							<text class="sync-detail-tag">[{{ item.syncType }}]</text>
							<view class="sync-detail-info">
							<text class="sync-detail-content">{{ item.content }}</text>
							<text v-if="item.meta" class="sync-detail-meta">{{ item.meta }}</text>
							</view>
						</view>
					</scroll-view>
					<text v-else class="sync-detail-empty">{{ t('✓ 所有数据已同步') }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed, onBeforeUnmount, ref, watch } from 'vue'
	import AppIcon from '../icons/AppIcon.uvue'

	const props = defineProps({
		isOnline: { type: Boolean, default: true },
		isSyncing: { type: Boolean, default: false },
		isUploading: { type: Boolean, default: false },
		pendingCount: { type: Number, default: 0 },
		failedCount: { type: Number, default: 0 },
		queueItems: { type: Array, default: () => [] }
	})

	const showCard = ref(false)
	const arrowLit = ref(true)
	let autoHideTimer = null
	let uploadAnimationTimer = null

	/** 上传接口运行期间定时交替箭头亮度，停止时立即释放计时器。 */
	function handleUploadingChange(uploading) {
		if (uploadAnimationTimer != null) { clearInterval(uploadAnimationTimer); uploadAnimationTimer = null }
		arrowLit.value = true
		if (uploading) uploadAnimationTimer = setInterval(() => { arrowLit.value = !arrowLit.value }, 450)
	}

	/**
	 * 判断云同步入口当前是否不可操作。
	 */
	const disabled = computed(() => !props.isOnline)

	/**
	 * 生成不超过两位数的待同步徽标文本。
	 */
	const badgeText = computed(() => props.pendingCount > 99 ? '99+' : String(props.pendingCount))

	/**
	 * 根据联网与失败状态计算顶部云图标颜色。
	 */
	const iconColor = computed(() => {
		if (!props.isOnline) return 'rgba(255, 255, 255, 0.72)'
		if (props.failedCount > 0) return '#fecaca'
		return '#ffffff'
	})

	/**
	 * 生成同步状态卡标题。
	 */
	const cardTitle = computed(() => {
		if (!props.isOnline) return '离线模式'
		if (props.isSyncing) return '上传数据'
		if (props.failedCount > 0) return '同步失败'
		if (props.pendingCount > 0) return '待同步数据'
		return '云端同步'
	})

	/**
	 * 生成同步状态卡的数量与状态说明。
	 */
	const cardSubtitle = computed(() => {
		if (!props.isOnline) return '当前无法连接云端'
		if (props.pendingCount > 0) return t('{count} 个剩余项目', { count: props.pendingCount })
		return props.isSyncing ? '正在同步中' : '当前没有待同步数据'
	})

	/**
	 * 生成同步状态卡底部提示。
	 */
	const cardTip = computed(() => {
		if (!props.isOnline) return '恢复网络后会自动同步云端数据。'
		if (props.isSyncing) return '所有数据上传完毕之前务必保持 app 打开状态。'
		if (props.failedCount > 0) return '系统会自动重试，请保持网络连接并稍后查看。'
		if (props.pendingCount > 0) return '恢复网络后会自动同步；联网时请保持 app 打开。'
		return '当前数据已与云端保持同步。'
	})

	/**
	 * 判断同步明细是否处于失败或需要人工处理状态。
	 */
	function isFailedItem(item) {
		const status = String(item?.status ?? '').toLowerCase()
		return status === 'failed' || status === 'error' || status === 'needs_attention'
	}

	/**
	 * 清理同步状态卡自动隐藏定时器。
	 */
	function clearAutoHideTimer() {
		if (autoHideTimer == null) return
		clearTimeout(autoHideTimer)
		autoHideTimer = null
	}

	/**
	 * 在状态展示完成后自动收起同步卡片。
	 */
	function scheduleAutoHide(delay = 4000) {
		clearAutoHideTimer()
		autoHideTimer = setTimeout(() => {
			showCard.value = false
			autoHideTimer = null
		}, delay)
	}

	/**
	 * 手动关闭同步状态卡。
	 */
	function hideCard() {
		showCard.value = false
		clearAutoHideTimer()
	}

	/**
	 * 仅展开同步状态卡；实际同步由网络恢复、页面恢复和本地保存统一触发。
	 */
	function handleClick() {
		if (disabled.value) {
			showCard.value = true
			scheduleAutoHide()
			return
		}
		showCard.value = true
		if (!props.isSyncing && props.pendingCount === 0) scheduleAutoHide()
	}

	/**
	 * 待同步数量归零后短暂展示成功状态再自动收起。
	 */
	function handlePendingCountChange(value) {
		if (value === 0 && showCard.value) scheduleAutoHide(1500)
	}

	/**
	 * 组件销毁前清理定时器，避免状态回调泄漏。
	 */
	function handleBeforeUnmount() {
		clearAutoHideTimer()
		if (uploadAnimationTimer != null) { clearInterval(uploadAnimationTimer); uploadAnimationTimer = null }
	}

	watch(() => props.pendingCount, handlePendingCountChange)
	watch(() => props.isUploading, handleUploadingChange, { immediate: true })
	onBeforeUnmount(handleBeforeUnmount)
</script>

<style>
	.sync-cloud-wrap { position: relative; }
	.sync-cloud-icon { width: 40px; height: 40px; position: relative; align-items: center; justify-content: center; }
	.sync-cloud-icon.disabled { opacity: 0.7; }
	.sync-upload-arrow { position: absolute; top: 7px; left: 13px; transform: rotate(180deg); transition-property: opacity; transition-duration: 220ms; }
	.sync-badge { position: absolute; top: 3px; right: 1px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background-color: #ef4444; align-items: center; justify-content: center; }
	.sync-badge-text { color: #ffffff; font-size: 10px; font-weight: 700; line-height: 16px; }
	.sync-card { position: fixed; left: 0; right: 0; top: 48px; z-index: 2200; padding: 0 12px; }
	.sync-card-inner { padding: 14px 14px 12px; border-radius: 14px; background-color: #1e293b; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.24); }
	.sync-card-header { flex-direction: row; align-items: center; }
	.sync-card-icon-wrap { width: 36px; height: 36px; border-radius: 10px; background-color: rgba(59, 130, 246, 0.15); align-items: center; justify-content: center; }
	.sync-card-title-area { flex: 1; margin-left: 10px; }
	.sync-card-title { color: #ffffff; font-size: 15px; font-weight: 700; }
	.sync-card-count { margin-top: 2px; color: #94a3b8; font-size: 12px; }
	.sync-card-close { width: 32px; height: 32px; align-items: center; justify-content: center; }
	.sync-card-progress { margin-top: 10px; }
	.sync-card-progress-bar { height: 4px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.1); overflow: hidden; }
	.sync-card-progress-fill { width: 42%; height: 100%; border-radius: 4px; background-color: #60a5fa; }
	.sync-card-tip { margin-top: 10px; color: #94a3b8; font-size: 11px; line-height: 16px; }
	.sync-detail { margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: rgba(148, 163, 184, 0.22); }
	.sync-detail-title { color: #cbd5e1; font-size: 12px; font-weight: 700; }
	.sync-detail-list { max-height: 220px; margin-top: 8px; }
	.sync-detail-item { padding: 8px 0; flex-direction: row; border-bottom-width: 1px; border-bottom-color: rgba(148, 163, 184, 0.12); }
	.sync-detail-tag { width: 48px; color: #60a5fa; font-size: 11px; font-weight: 700; }
	.sync-detail-info { flex: 1; }
	.sync-detail-content { color: #f8fafc; font-size: 12px; line-height: 17px; }
	.sync-detail-meta { margin-top: 2px; color: #94a3b8; font-size: 10px; line-height: 15px; }
	.sync-detail-empty { margin-top: 8px; color: #4ade80; font-size: 12px; }
</style>
