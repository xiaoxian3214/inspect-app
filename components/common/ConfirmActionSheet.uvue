<template>
	<view v-if="visible" class="overlay" :class="{ dialogOverlay: variant === 'dialog' }" @click="closeSheet">
		<view class="sheet" :class="{ dialogSheet: variant === 'dialog' }" :style="{ paddingBottom: variant === 'dialog' ? '0rpx' : sheetBottomPadding }" @click.stop="stopEvent">
			<view v-if="variant !== 'dialog'" class="sheet-handle"></view>
			<text class="title">{{ translateText(title) }}</text>
			<text class="message" :class="{ dialogMessage: variant === 'dialog' }">{{ translateText(message) }}</text>
			<view class="actions" :class="{ dialogActions: variant === 'dialog' }">
				<button v-if="showCancel" class="button cancel" :disabled="submitting" @click="closeSheet">{{ translateText(cancelText) }}</button>
				<button class="button confirm" :class="{ danger: danger }" :disabled="submitting" @click="confirmAction">{{ translateText(submitting ? '处理中...' : confirmText) }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { safeBottomPaddingPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	const sheetBottomPadding = safeBottomPaddingPx(30)
	const props = defineProps({ visible: { type: Boolean, default: false }, variant: { type: String, default: 'sheet' }, title: { type: String, default: '操作确认' }, message: { type: String, default: '' }, confirmText: { type: String, default: '确认' }, cancelText: { type: String, default: '取消' }, showCancel: { type: Boolean, default: true }, danger: { type: Boolean, default: false }, submitting: { type: Boolean, default: false } })
	const emit = defineEmits(['close', 'confirm'])
	/** 用本地方法为原生模板翻译底部确认弹层文案。 */
	function translateText(key: string): string { return t(key) }

	/** 关闭通用二次确认底部弹层。 */
	function closeSheet() { if (!props.submitting) emit('close') }
	/** 通知业务页面执行已经确认的操作。 */
	function confirmAction() { if (!props.submitting) emit('confirm') }
	/** 阻止点击底部内容区域关闭弹层。 */
	function stopEvent() {}
</script>

<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2450; justify-content: flex-end; background-color: rgba(15,23,42,.58); }
	.overlay.dialogOverlay { justify-content: center; align-items: center; }
	.sheet { width: 100%; padding: 14rpx 30rpx 30rpx; border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; background-color: #ffffff; }
	.sheet.dialogSheet { width: 86%; padding: 36rpx 30rpx 0; border-radius: 26rpx; align-items: center; }
	.message.dialogMessage { padding-bottom: 38rpx; text-align: center; }
	.actions.dialogActions { width: 100%; margin-top: 0; border-top-width: 2rpx; border-top-color: #f1f5f9; }
	.sheet-handle { width: 74rpx; height: 8rpx; margin: 0 auto 22rpx; border-radius: 4rpx; background-color: #d7dde7; }
	.title { color: #172033; font-size: 34rpx; font-weight: 700; }
	.message { margin-top: 16rpx; color: #64748b; font-size: 25rpx; line-height: 40rpx; }
	.actions { margin-top: 30rpx; flex-direction: row; }
	.button { flex: 1; height: 82rpx; margin: 0 8rpx; border-radius: 18rpx; font-size: 26rpx; }
	.button.cancel { color: #475569; background-color: #f1f5f9; }
	.button.confirm { color: #ffffff; background-color: #03ae4f; }
	.button.confirm.danger { background-color: #ef4444; }
</style>
