<template>
	<view v-if="visible" class="update-overlay">
		<view class="update-card">
			<text class="update-title">{{ translateText('正在下载新版本') }}</text>
			<text class="update-progress-text">{{ translateText('下载中 {progress}% {size}MB', { progress: percent, size: sizeText }) }}</text>
			<view class="update-track">
				<view class="update-fill" :style="{ width: progressWidth }" />
			</view>
			<view v-if="cancellable" class="update-cancel" @click="cancelUpdate">
				<text class="update-cancel-text">{{ translateText('取消') }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'

	const props = defineProps({
		visible: { type: Boolean, default: false },
		percent: { type: Number, default: 0 },
		sizeText: { type: String, default: '0' },
		cancellable: { type: Boolean, default: true }
	})

	const emit = defineEmits(['cancel-update'])

	/** 把 0-100 的进度归一为进度条宽度，避免异常值把填充撑出轨道。 */
	const progressWidth = computed((): string => {
		const normalized = Math.min(100, Math.max(0, Math.round(props.percent)))
		return `${normalized}%`
	})

	/** 通过本地明确签名调用翻译服务，供原生模板渲染。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }

	/** 通知页面中断原生下载任务，避免强行下载消耗用户流量。 */
	function cancelUpdate(): void {
		emit('cancel-update')
	}
</script>

<style>
	.update-overlay {
		position: fixed;
		left: 0;
		right: 0;
		top: 0;
		bottom: 0;
		z-index: 2100;
		background-color: rgba(0, 0, 0, 0.5);
		align-items: center;
		justify-content: center;
	}

	.update-card {
		width: 280px;
		padding: 20px;
		border-radius: 12px;
		background-color: #ffffff;
	}

	.update-title {
		color: #333333;
		font-size: 16px;
		font-weight: 600;
		text-align: center;
	}

	.update-progress-text {
		margin-top: 12px;
		color: #666666;
		font-size: 14px;
		text-align: center;
	}

	.update-track {
		height: 8px;
		margin-top: 16px;
		border-radius: 4px;
		background-color: #ececec;
		overflow: hidden;
	}

	.update-fill {
		height: 8px;
		border-radius: 4px;
		background-color: #03ae4f;
	}

	.update-cancel {
		height: 40px;
		margin-top: 20px;
		border-width: 1px;
		border-color: #dddddd;
		border-radius: 8px;
		align-items: center;
		justify-content: center;
	}

	.update-cancel-text {
		color: #666666;
		font-size: 15px;
		line-height: 40px;
	}
</style>