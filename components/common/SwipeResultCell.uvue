<template>
	<view class="swipe-result-cell">
		<view class="swipe-left-action" :class="leftActionClass">
			<AppIcon :type="resultIcon(normalizedResult)" :size="27" color="#ffffff" />
			<text class="swipe-left-label">{{ t(resultLabel(normalizedResult)) }}</text>
		</view>
		<view class="swipe-right-actions">
			<view v-for="action in resultActions" :key="action.value" class="swipe-action" :class="action.value" @click.stop="selectResult(action.value)">
				<AppIcon :type="action.icon" :size="32" :color="action.color" />
				<text class="swipe-action-label">{{ t(action.label) }}</text>
			</view>
		</view>
		<view
			class="swipe-content"
			:class="{ dragging: dragging }"
			:style="contentStyle"
			@touchstart="handleTouchStart"
			@touchmove="handleTouchMove"
			@touchend="handleTouchEnd"
			@touchcancel="handleTouchCancel"
			@click="handleContentClick"
		>
			<slot></slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed, ref } from 'vue'
	import { resolveGestureAxis, resolveSwipeMove, resolveSwipeRelease } from '../../domain/swipeCellGesture.uts'
	import AppIcon from '../icons/AppIcon.uvue'

	const props = defineProps({
		result: { type: String, default: '' },
		autoCloseDelay: { type: Number, default: 400 }
	})
	const emit = defineEmits(['left-open', 'select-result', 'content-click'])
	const offsetX = ref(0)
	const dragging = ref(false)
	let touchStartX = 0
	let touchStartY = 0
	let gestureStartOffset = 0
	let gestureAxis = 'pending'
	let movedDistance = 0
	let gestureDeltaX = 0
	let autoCloseTimer = null

	const resultActions = [
		{ value: 'pass', label: '合格', icon: 'check', color: '#22c55e' },
		{ value: 'fail', label: '不合格', icon: 'warning', color: '#ef4444' },
		{ value: 'pending', label: '待定', icon: 'help', color: '#f59e0b' },
		{ value: 'na', label: '不适用', icon: 'clear', color: '#64748b' }
	]

	/** 返回设备上与 H5 180rpx 一致的左侧快捷操作宽度。 */
	function leftActionWidth() { return uni.rpx2px(180) }
	/** 返回设备上与 H5 四个 140rpx 操作一致的右侧操作总宽度。 */
	function rightActionWidth() { return uni.rpx2px(560) }
	/** 返回当前设备的横向滑动触发阈值。 */
	function swipeThreshold() { return uni.rpx2px(96) }
	/** 将空结果转换为 H5 右滑默认展示的合格状态。 */
	const normalizedResult = computed(() => String(props.result ?? '').trim() ?? 'pass')
	/** 返回左侧快捷操作对应的状态颜色类。 */
	const leftActionClass = computed(() => `action-${normalizedResult.value}`)
	/** 返回滑动内容层的实时位移和回弹动画。 */
	const contentStyle = computed(() => ({ transform: `translateX(${offsetX.value}px)`, transitionDuration: dragging.value ? '0ms' : '220ms' }))

	/** 返回 H5 四种检查结果对应的 Uni Icons 图标类型。 */
	function resultIcon(result) { if (result === 'pass') return 'check'; if (result === 'fail') return 'warning'; if (result === 'pending') return 'help'; return 'clear' }
	/** 返回 H5 四种检查结果对应的中文名称。 */
	function resultLabel(result) { if (result === 'pass') return '合格'; if (result === 'fail') return '不合格'; if (result === 'pending') return '待定'; return '不适用' }
	/** 清理右滑快捷动作的自动回弹计时器。 */
	function clearAutoCloseTimer() { if (autoCloseTimer != null) { clearTimeout(autoCloseTimer); autoCloseTimer = null } }
	/** 关闭左右操作区并恢复清单内容到初始位置。 */
	function close() { clearAutoCloseTimer(); dragging.value = false; offsetX.value = 0 }
	/** 读取触摸事件中第一根手指的横坐标。 */
	function touchX(event) { return Number(event?.touches?.[0]?.clientX ?? event?.changedTouches?.[0]?.clientX ?? 0) }
	/** 读取触摸事件中第一根手指的纵坐标。 */
	function touchY(event) { return Number(event?.touches?.[0]?.clientY ?? event?.changedTouches?.[0]?.clientY ?? 0) }
	/** 记录手势起点和当前已打开操作区的位置。 */
	function handleTouchStart(event) { clearAutoCloseTimer(); touchStartX = touchX(event); touchStartY = touchY(event); gestureStartOffset = offsetX.value; gestureAxis = 'pending'; movedDistance = 0; gestureDeltaX = 0; dragging.value = false }
	/** 锁定首个明确手势方向，仅横向手势更新卡片位移，纵向手势完整交还详情页滚动。 */
	function handleTouchMove(event) { const deltaX = touchX(event) - touchStartX; const deltaY = touchY(event) - touchStartY; movedDistance = Math.max(movedDistance, Math.abs(deltaX), Math.abs(deltaY)); if (gestureAxis === 'pending') gestureAxis = resolveGestureAxis(deltaX, deltaY); if (gestureAxis !== 'horizontal') return; dragging.value = true; gestureDeltaX = deltaX; offsetX.value = resolveSwipeMove(gestureStartOffset, deltaX, leftActionWidth(), rightActionWidth()) }
	/** 根据松手方向打开对应 H5 操作区，右滑快捷操作触发后自动回弹。 */
	function handleTouchEnd() { dragging.value = false; if (gestureAxis !== 'horizontal') return; const target = resolveSwipeRelease(offsetX.value, gestureStartOffset, gestureDeltaX, leftActionWidth(), rightActionWidth(), swipeThreshold()); offsetX.value = target.offset; if (target.position === 'left') { emit('left-open'); autoCloseTimer = setTimeout(close, Number(props.autoCloseDelay ?? 400)) } }
	/** 手势被系统取消时关闭操作区，避免卡片停留在中间位置。 */
	function handleTouchCancel() { close() }
	/** 点击结果操作后先关闭滑层，再把选择结果交给清单业务组件。 */
	function selectResult(result) { close(); emit('select-result', result) }
	/** 未发生横向滑动时才透传卡片点击，避免滑动后误打开检查项。 */
	function handleContentClick() { if (movedDistance > 8) { movedDistance = 0; return }; if (offsetX.value !== 0) { close(); return }; emit('content-click') }

	defineExpose({ close })
</script>

<style>
	.swipe-result-cell { position: relative; overflow: hidden; background-color: #ffffff; }
	.swipe-left-action { position: absolute; left: 0; top: 0; bottom: 0; width: 180rpx; flex-direction: column; align-items: center; justify-content: center; }
	.swipe-left-action.action-pass { background-color: #22c55e; }
	.swipe-left-action.action-fail { background-color: #ef4444; }
	.swipe-left-action.action-pending { background-color: #f59e0b; }
	.swipe-left-action.action-na { background-color: #64748b; }
	.swipe-left-label { margin-top: 8rpx; color: #ffffff; font-size: 24rpx; font-weight: 500; }
	.swipe-right-actions { position: absolute; right: 0; top: 0; bottom: 0; width: 560rpx; flex-direction: row; }
	.swipe-action { width: 140rpx; flex-direction: column; align-items: center; justify-content: center; }
	.swipe-action.pass { background-color: #dcfce7; }
	.swipe-action.fail { background-color: #fee2e2; }
	.swipe-action.pending { background-color: #fef3c7; }
	.swipe-action.na { background-color: #f1f5f9; }
	.swipe-action-label { margin-top: 12rpx; color: #64748b; font-size: 22rpx; font-weight: 500; }
	.swipe-content { position: relative; z-index: 2; background-color: #ffffff; transition-property: transform; transition-timing-function: ease-out; }
	.swipe-content.dragging { transition-duration: 0ms; }
</style>
