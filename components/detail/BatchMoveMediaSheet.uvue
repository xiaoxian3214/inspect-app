<template>
	<view v-if="visible" class="overlay" @click="closeSheet">
		<view class="dialog" :style="{ height: dialogHeight, paddingBottom: dialogBottomPadding }" @click.stop="stopEvent">
			<view class="header"><text class="close" @click="closeSheet">×</text><text class="title">{{ translateText(currentStep === 1 ? '批量移动照片/视频' : '选择目标检查点') }}</text><text class="step-indicator">{{ currentStep }}/2</text></view>
			<view v-if="currentStep === 1" class="body">
				<view class="select-row" @click="toggleAllPhotos"><view class="checkbox" :class="{ checked: allPhotosSelected }"><text v-if="allPhotosSelected" class="check-mark">✓</text></view><text class="row-label">{{ translateText('全选') }}</text></view>
				<text class="hint">{{ translateText('可移动 {movable}/{total}（未上传不可移动）', { movable: movablePhotos.length, total: photos.length }) }}</text>
				<scroll-view class="media-scroll" direction="vertical"><view class="media-grid"><view v-for="(photo, index) in mediaItems" :key="index" class="media-cell" :class="{ selected: selectedIndexes.includes(index), unavailable: !isMovable(index) }" @click="togglePhoto(index)"><InspectionMediaImage :media="photo" /><view class="media-check"><view class="checkbox" :class="{ checked: selectedIndexes.includes(index) }"><text v-if="selectedIndexes.includes(index)" class="check-mark">✓</text></view></view><view v-if="!isMovable(index)" class="media-mask"><text class="mask-label">{{ translateText('未上传') }}</text></view></view></view></scroll-view>
			</view>
			<view v-else class="body"><view v-if="targetRows.length > 0" class="select-row" @click="toggleAllTargets"><view class="checkbox" :class="{ checked: allTargetsSelected }"><text v-if="allTargetsSelected" class="check-mark">✓</text></view><text class="row-label">{{ translateText('全选') }}</text></view><scroll-view class="target-scroll" direction="vertical"><text v-if="targetRows.length === 0" class="empty">{{ translateText('暂无可选的检查点') }}</text><view v-for="item in targetRows" :key="item.id" class="target-row" :class="{ selected: selectedTargetBizIds.includes(item.id) }" @click="toggleTarget(item.id)"><view class="checkbox" :class="{ checked: selectedTargetBizIds.includes(item.id) }"><text v-if="selectedTargetBizIds.includes(item.id)" class="check-mark">✓</text></view><view class="target-info"><text class="row-label">{{ item.name }}</text><text v-if="item.subLabel !== ''" class="row-hint">{{ item.subLabel }}</text></view></view></scroll-view></view>
			<view class="footer"><view v-if="currentStep === 2" class="action back" @click="previousStep"><text class="back-label">{{ translateText('上一步') }}</text></view><view class="action cancel" @click="closeSheet"><text class="cancel-label">{{ translateText('取消') }}</text></view><view v-if="currentStep === 1" class="action primary" :class="{ disabled: selectedIndexes.length === 0 }" @click="nextStep"><text class="primary-label">{{ translateText('移动') }}</text></view><view v-else class="action primary" :class="{ disabled: selectedTargetBizIds.length === 0 || submitting }" @click="submitMove"><text class="primary-label">{{ translateText(submitting ? '移动中...' : '完成') }}</text></view></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { windowHeightPx, safeBottomPaddingPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { computed, ref, watch } from 'vue'
	import { firstNonEmptyText } from '../../domain/searchViewModel.uts'
	import InspectionMediaImage from './InspectionMediaImage.uvue'
	type TargetRow = { id: string, localKey: string, name: string, subLabel: string }
	const props = defineProps({ visible: { type: Boolean, default: false }, photos: { type: Array, default: () => [] }, items: { type: Array, default: () => [] }, sourceItemId: { type: String, default: '' }, submitting: { type: Boolean, default: false } })
	const emit = defineEmits(['close', 'submit'])
	const currentStep = ref(1)
	const selectedIndexes = ref<number[]>([])
	const selectedTargetBizIds = ref<string[]>([])
	/** 翻译媒体选择与目标选择步骤的原生文案。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }
	/** 固定两步批量媒体弹层高度为屏幕九成。 */
	const dialogHeight = windowHeightPx(0.9)
	/** 在操作区下方加入系统安全区。 */
	const dialogBottomPadding = safeBottomPaddingPx(24)
	/** 列出拥有服务端文件 ID 的可移动媒体索引。 */
	const movablePhotos = computed((): number[] => (props.photos as UTSJSONObject[]).map((photo: UTSJSONObject, index: number): number => (photo['fileId'] ?? '').toString() !== '' ? index : -1).filter((index: number): boolean => index >= 0))
	/** 把媒体数组属性收窄为对象数组，避免原生模板把动态元素传给 media 为 Object 的子组件时报类型不匹配。 */
	const mediaItems = computed((): UTSJSONObject[] => (props.photos as UTSJSONObject[]).map((photo: UTSJSONObject): UTSJSONObject => photo))
	/** 拒绝勾选尚未上传完成的媒体。 */
	function isMovable(index: number): boolean { return movablePhotos.value.includes(index) }
	/** 检查可移动媒体是否全部选中。 */
	const allPhotosSelected = computed((): boolean => movablePhotos.value.length > 0 && selectedIndexes.value.length === movablePhotos.value.length)
	/** 切换一个已上传媒体的选择状态。 */
	function togglePhoto(index: number) { if (!isMovable(index)) return; selectedIndexes.value = selectedIndexes.value.includes(index) ? selectedIndexes.value.filter((value: number): boolean => value !== index) : [...selectedIndexes.value, index] }
	/** 全选或清空全部已上传媒体。 */
	function toggleAllPhotos() { selectedIndexes.value = allPhotosSelected.value ? [] : [...movablePhotos.value] }
	/** 采用 H5 业务 ID 选择主/子检查点，用本地键排除当前源行。 */
	const targetRows = computed((): TargetRow[] => (props.items as UTSJSONObject[]).map((item: UTSJSONObject): TargetRow => ({ id: firstNonEmptyText([item['bizId'], item['itemId'], item['id']], ''), localKey: firstNonEmptyText([item['itemId'], item['id']], ''), name: firstNonEmptyText([item['itemName'], item['name']], ''), subLabel: firstNonEmptyText([item['subLabel']], '') })).filter((item: TargetRow): boolean => item.id !== '' && item.localKey !== props.sourceItemId))
	/** 判断所有可用目标是否选中。 */
	const allTargetsSelected = computed((): boolean => targetRows.value.length > 0 && targetRows.value.every((item: TargetRow): boolean => selectedTargetBizIds.value.includes(item.id)))
	/** 切换一个目标检查点。 */
	function toggleTarget(id: string) { selectedTargetBizIds.value = selectedTargetBizIds.value.includes(id) ? selectedTargetBizIds.value.filter((value: string): boolean => value !== id) : [...selectedTargetBizIds.value, id] }
	/** 全选或取消所有其他检查点。 */
	function toggleAllTargets() { selectedTargetBizIds.value = allTargetsSelected.value ? [] : targetRows.value.map((item: TargetRow): string => item.id) }
	/** 已选择至少一个可移动媒体后进入目标选择。 */
	function nextStep() { if (selectedIndexes.value.length > 0) currentStep.value = 2 }
	/** 返回媒体选择并保留已勾选状态。 */
	function previousStep() { currentStep.value = 1 }
	/** 将服务端文件 ID 与目标检查项业务 ID 交给详情页在线复制。 */
	function submitMove() { if (props.submitting || selectedIndexes.value.length === 0 || selectedTargetBizIds.value.length === 0) return; const fileIds = selectedIndexes.value.map((index: number): string => ((props.photos as UTSJSONObject[])[index]['fileId'] ?? '').toString()).filter((id: string): boolean => id !== ''); if (fileIds.length === 0) return; emit('submit', { fileIds, targetBizIds: selectedTargetBizIds.value }) }
	/** 正在移动时阻止重复关闭弹层。 */
	function closeSheet() { if (!props.submitting) emit('close') }
	/** 阻止操作弹层点击事件穿透遮罩。 */
	function stopEvent() {}
	/** 每次打开弹层重置为 H5 的媒体选择第一步。 */
	function resetSelection(visible: boolean) { if (visible) { currentStep.value = 1; selectedIndexes.value = []; selectedTargetBizIds.value = [] } }
	/** 监听弹层打开并重置多选步骤。 */
	watch((): boolean => props.visible, (visible: boolean) => resetSelection(visible))
</script>

<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2330; justify-content: flex-end; background-color: rgba(15,23,42,.55); }
	.dialog { width: 100%; box-sizing: border-box; flex-direction: column; overflow: hidden; border-top-left-radius: 28rpx; border-top-right-radius: 28rpx; background-color: #fff; }
	.header { min-height: 96rpx; flex-direction: row; align-items: center; padding: 0 24rpx; border-bottom-width: 1rpx; border-bottom-color: #f0f0f0; }
	.close { width: 76rpx; color: #94a3b8; font-size: 44rpx; }
	.title { flex: 1; color: #1a1a1a; font-size: 32rpx; font-weight: 600; text-align: center; }
	.step-indicator { width: 76rpx; color: #94a3b8; font-size: 26rpx; text-align: right; }
	.body { flex: 1; min-height: 0; box-sizing: border-box; padding: 24rpx 32rpx; }
	.select-row { min-height: 70rpx; flex-direction: row; align-items: center; border-bottom-width: 1rpx; border-bottom-color: #f1f5f9; }
	.checkbox { width: 36rpx; height: 36rpx; margin-right: 16rpx; border-width: 2rpx; border-style: solid; border-color: #94a3b8; border-radius: 6rpx; background-color: #ffffff; align-items: center; justify-content: center; }
	.checkbox.checked { border-color: #1a5f3f; background-color: #1a5f3f; }
	.check-mark { color: #fff; font-size: 24rpx; }
	.row-label { color: #334155; font-size: 28rpx; }
	.row-hint { margin-top: 4rpx; color: #94a3b8; font-size: 23rpx; }
	.hint { margin: 16rpx 0; color: #64748b; font-size: 24rpx; }
	.media-scroll, .target-scroll { flex: 1; min-height: 0; width: 100%; }
	.media-grid { flex-direction: row; flex-wrap: wrap; }
	.media-cell { position: relative; width: 30%; height: 190rpx; margin: 1.5%; overflow: hidden; border-width: 2rpx; border-color: #e2e8f0; border-radius: 14rpx; }
	.media-cell.selected { border-color: #1a5f3f; }
	.media-cell.unavailable { opacity: .55; }
	.media-check { position: absolute; right: 0; top: 8rpx; }
	.media-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(15,23,42,.4); }
	.mask-label { color: #fff; font-size: 22rpx; }
	.target-row { min-height: 88rpx; flex-direction: row; align-items: center; margin-top: 10rpx; padding: 16rpx; border-radius: 12rpx; background-color: #f8fafc; }
	.target-row.selected { background-color: #e8f5ee; }
	.target-info { flex: 1; }
	.empty { padding: 60rpx 0; color: #94a3b8; font-size: 26rpx; text-align: center; }
	.footer { flex-direction: row; padding: 20rpx 24rpx 0; border-top-width: 1rpx; border-top-color: #f0f0f0; }
	.action { flex: 1; height: 80rpx; margin: 0 6rpx; border-radius: 12rpx; align-items: center; justify-content: center; }
	.action.back, .action.cancel { background-color: #f5f5f5; }
	.action.primary { background-color: #1a5f3f; }
	.action.disabled { opacity: .5; }
	.back-label, .cancel-label { color: #64748b; font-size: 27rpx; }
	.primary-label { color: #fff; font-size: 27rpx; }
</style>
