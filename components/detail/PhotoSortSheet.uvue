<template>
	<view v-if="visible" class="overlay" @click="closeSheet">
		<view class="sheet" :style="{ height: sheetHeight, paddingBottom: sheetBottomPadding }" @click.stop="stopEvent">
			<view class="sheet-handle"></view>
			<view class="sheet-head">
				<text class="head-action" @click="closeSheet">{{ translateText('取消') }}</text>
				<text class="sheet-title">{{ translateText('调整图片顺序') }}</text>
				<text class="head-action done" @click="saveOrder">{{ translateText(saving ? '保存中...' : '完成') }}</text>
			</view>
			<text class="sort-hint">{{ translateText('按住照片拖拽可调整顺序') }}</text>
			<scroll-view class="sort-body" direction="dragIndex < 0 ? 'vertical' : 'none'" :show-scrollbar="false">
				<view class="sort-grid">
					<view
						v-for="(photo, index) in sortedPhotos"
						:key="index"
						class="sort-cell" :style="{ height: sortCellHeight, transform: dragIndex === index ? dragTransform : 'translate(0px, 0px)' }"
						:class="{ dragging: dragIndex === index }"
						@touchstart="onTouchStart(index, $event as UniTouchEvent)"
						@touchmove="onTouchMove"
						@touchend="onTouchEnd"
						@touchcancel="onTouchCancel"
					>
						<InspectionMediaImage class="sort-image" :class="{ 'drop-target': dragOverIndex === index && dragIndex !== index }" :media="photo" />
						<view class="sort-number"><text>{{ index + 1 }}</text></view>
					</view>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { windowHeightPx, safeBottomPaddingPx, photoSortCellPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { computed, onUnmounted, ref, watch } from 'vue'
	import { moveMediaItem, normalizeMediaOrder, resolveMediaDragTarget } from '../../domain/mediaSort.uts'
	import InspectionMediaImage from './InspectionMediaImage.uvue'

	const props = defineProps({
		visible: { type: Boolean, default: false },
		photos: { type: Array, default: () => [] },
		saving: { type: Boolean, default: false }
	})
	const emit = defineEmits(['close', 'sorted'])
	const sortedPhotos = ref<UTSJSONObject[]>([])
	const dragIndex = ref(-1)
	const dragOverIndex = ref(-1)
	const dragDeltaX = ref(0)
	const dragDeltaY = ref(0)
	let touchStartIndex = -1
	let touchStartX = 0
	let touchStartY = 0
	let pressTimer: number | null = null
	/** 为原生排序弹层提供可调用的多语言方法。 */
	function translateText(key: string): string { return t(key) }
	/** 固定排序弹层为当前窗口高度的九成。 */
	const sheetHeight = computed((): string => windowHeightPx(0.9))
	/** 将底部系统安全区纳入排序弹层内边距。 */
	const sheetBottomPadding = computed((): string => safeBottomPaddingPx(24))
	/** 根据设备宽度计算三列照片格子高度。 */
	const sortCellHeight = computed((): string => photoSortCellPx())
	/** 将拖动位移作用于当前照片格子，手指下方保持预览。 */
	const dragTransform = computed((): string => `translate(${dragDeltaX.value}px, ${dragDeltaY.value}px)`)

	/** 取消未到期的长按计时器，防止滚动或关闭后错误开启拖动。 */
	function clearPressTimer() { const timer = pressTimer; if (timer != null) { clearTimeout(timer); pressTimer = null } }
	/** 清除一次触摸手势的位置和高亮，不改变待保存照片顺序。 */
	function resetDrag() { clearPressTimer(); touchStartIndex = -1; dragIndex.value = -1; dragOverIndex.value = -1; dragDeltaX.value = 0; dragDeltaY.value = 0 }
	/**
	 * 打开排序弹层时复制当前图片顺序并清除上一次的拖动状态。
	 * 关闭时不再写入拖动状态：弹层根节点已被 v-if 销毁，此时写入会驱动已销毁的渲染子树
	 * 在 vapor 原生渲染线程重新渲染并闪退；再次打开时会重新清理。
	 */
	watch((): boolean => props.visible, (visible: boolean) => {
		if (!visible) return
		sortedPhotos.value = normalizeMediaOrder(props.photos) as UTSJSONObject[]
		resetDrag()
	})

	/** 长按计时完成后开启拖动，轻触或滚动不改变顺序。 */
	function beginDrag(index: number) { pressTimer = null; if (touchStartIndex !== index) return; dragIndex.value = index; dragOverIndex.value = index }
	/** 记录按住照片的位置，短暂按住后开启拖动；模板 $event 是动态类型，这里收窄为原生触摸事件再取坐标。 */
	function onTouchStart(index: number, event: UniTouchEvent) { resetDrag(); touchStartIndex = index; const touch = event.touches[0]; touchStartX = touch != null ? parseFloat((touch.clientX ?? 0).toString()) : 0; touchStartY = touch != null ? parseFloat((touch.clientY ?? 0).toString()) : 0; pressTimer = setTimeout(() => beginDrag(index), 300) }
	/** 拖动时预览目标位置；未长按前明显移动手指则交还滚动。 */
	function onTouchMove(event: UniTouchEvent) { if (touchStartIndex < 0) return; const touch = event.touches[0]; const currentX: number = touch != null ? parseFloat((touch.clientX ?? 0).toString()) : touchStartX; const currentY: number = touch != null ? parseFloat((touch.clientY ?? 0).toString()) : touchStartY; const deltaX = currentX - touchStartX; const deltaY = currentY - touchStartY; if (dragIndex.value < 0) { if (Math.abs(deltaX) > 12 || Math.abs(deltaY) > 12) { clearPressTimer(); touchStartIndex = -1 }; return }; dragDeltaX.value = deltaX; dragDeltaY.value = deltaY; dragOverIndex.value = resolveMediaDragTarget(dragIndex.value, deltaX, deltaY, parseFloat(sortCellHeight.value), sortedPhotos.value.length) }
	/** 松手时将拖动照片插入目标格，再清理临时拖动状态。 */
	function onTouchEnd() { if (dragIndex.value >= 0 && dragOverIndex.value >= 0 && dragOverIndex.value !== dragIndex.value) sortedPhotos.value = moveMediaItem(sortedPhotos.value, dragIndex.value, dragOverIndex.value) as UTSJSONObject[]; resetDrag() }
	/** 系统取消触摸时放弃本次拖动，不修改顺序。 */
	function onTouchCancel() { resetDrag() }
	/** 组件卸载时取消尚未到期的长按任务。 */
	onUnmounted(() => clearPressTimer())

	/** 请求详情页在线提交临时顺序；等待请求完成期间阻止重复点击。 */
	function saveOrder() { if (!props.saving) emit('sorted', normalizeMediaOrder(sortedPhotos.value)) }
	/** 关闭排序弹层并放弃尚未提交的临时顺序。 */
	function closeSheet() { if (!props.saving) emit('close') }
	/** 阻止点击弹层内容时触发遮罩关闭。 */
	function stopEvent() {}
</script>

<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2600; justify-content: flex-end; background-color: rgba(15,23,42,.46); }
	.sheet { width: 100%; box-sizing: border-box; flex-direction: column; overflow: hidden; border-top-left-radius: 30rpx; border-top-right-radius: 30rpx; background-color: #ffffff; }
	.sheet-handle { width: 72rpx; height: 8rpx; margin: 14rpx auto 4rpx; border-radius: 4rpx; background-color: #cbd5e1; }
	.sheet-head { height: 92rpx; padding: 0 28rpx; flex-direction: row; align-items: center; justify-content: space-between; border-bottom-width: 1rpx; border-bottom-color: #eef2f7; }
	.sheet-title { color: #0f172a; font-size: 30rpx; font-weight: 700; }
	.head-action { width: 100rpx; color: #64748b; font-size: 25rpx; }
	.head-action.done { color: #039447; text-align: right; font-weight: 600; }
	.sort-hint { padding: 18rpx 28rpx; color: #64748b; font-size: 23rpx; background-color: #f8fafc; }
	.sort-body { flex: 1; min-height: 0; width: 100%; padding: 18rpx; box-sizing: border-box; }
	.sort-grid { width: 100%; flex-direction: row; flex-wrap: wrap; }
	.sort-cell { position: relative; width: 33.333333%; padding: 8rpx; box-sizing: border-box; }
	.sort-cell.dragging { z-index: 3; opacity: .88; }
	.sort-image { width: 100%; height: 100%; overflow: hidden; border-width: 3rpx; border-style: solid; border-color: transparent; border-radius: 18rpx; background-color: #f1f5f9; }
	.sort-image.drop-target { border-color: #1a5f3f; }
	
	.sort-number { position: absolute; left: 18rpx; top: 18rpx; min-width: 42rpx; height: 42rpx; padding: 0 8rpx; border-radius: 21rpx; align-items: center; justify-content: center; color: #ffffff; font-size: 21rpx; background-color: rgba(15,23,42,.72); }
	
</style>
