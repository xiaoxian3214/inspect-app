<template>
	<view class="tab-page">
		<view class="defects-summary"><view class="summary-item"><text class="summary-label">{{ translateText('致命缺陷') }}</text><text class="summary-value critical">{{ counts.critical }}</text></view><view class="summary-item"><text class="summary-label">{{ translateText('主要缺陷') }}</text><text class="summary-value major">{{ counts.major }}</text></view><view class="summary-item"><text class="summary-label">{{ translateText('次要缺陷') }}</text><text class="summary-value minor">{{ counts.minor }}</text></view></view>
		<view v-if="defects.length === 0" class="empty-state"><text class="empty-icon">✓</text><text class="empty-text">{{ translateText('暂无疵点记录') }}</text></view>
		<view v-else class="defects-list">
			<view v-for="group in groups" :key="group.key" class="defect-group">
				<view class="defect-group-title"><text>{{ translateText(group.label) }}（{{ group.items.length }}）</text><text v-if="group.affectedTotal > 0" class="actual-total">{{ translateText('实际发现：{count}', { count: group.affectedTotal }) }}</text></view>
				<view v-for="(defect, index) in group.items" :key="defect.id !== '' ? defect.id : `${group.key}-${index}`" class="defect-card" @click="openDefect(defect.raw)">
					<InspectionMediaImage v-if="firstPhoto(defect)" class="defect-cover" :media="firstPhoto(defect)" /><view v-else class="defect-cover placeholder"><text class="placeholder-text">{{ translateText('暂无图片') }}</text></view>
					<view class="defect-main"><view class="defect-head"><text class="severity" :class="severityClass(defect)">{{ translateText(severityLabel(defect)) }}</text><text class="defect-time">{{ formatTime(defect.createdAt) }}</text></view><text class="defect-code">{{ translateText(defect.defectCode ?? '未填写编码') }}</text><text v-if="defect.defectDesc" class="defect-desc">{{ defect.defectDesc }}</text><view class="defect-meta"><text v-if="isCommon(defect)" class="defect-meta-text common-label">{{ translateText('普遍性疵点') }}</text><text v-else-if="defect.quantity !== '' ? defect.quantity : defect.defectCount" class="defect-meta-text">{{ translateText('受影响数量：{count}个', { count: defect.quantity || defect.defectCount }) }}</text><text v-if="photoCount(defect) > 0" class="defect-meta-text">{{ translateText('{count} 张图片', { count: photoCount(defect) }) }}</text></view></view>
					<view class="delete-action" @click.stop="removeDefect(defect.raw)"><text class="delete-action-text">{{ translateText('删除') }}</text></view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'
	import { firstNonEmptyText } from '../../domain/searchViewModel.uts'
	import InspectionMediaImage from './InspectionMediaImage.uvue'
	type DefectRow = { id: string, type: string, typeLabel: string, defectCode: string, defectDesc: string, createdAt: string, quantity: string, defectCount: string, commonFlag: string, isCommon: boolean, photos: UTSJSONObject[], raw: UTSJSONObject }
	type DefectGroup = { key: string, label: string, affectedTotal: number, items: DefectRow[] }
	type DefectCounts = { critical: number, major: number, minor: number }
	const props = defineProps({ defects: { type: Array, default: () => [] }, defectCounts: { type: Object, default: () => ({ critical: 0, major: 0, minor: 0 }) }, defectGroups: { type: Array, default: () => [] } })
	const emit = defineEmits(['open-defect', 'edit-defect', 'remove-defect'])
	/** 为原生模板提供可调用的多语言文案方法。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }
	/** 提取列表疵点的固定字段，同时保留原始记录供编辑和删除。 */
	function toDefectRow(raw: UTSJSONObject): DefectRow { const storedPhotos = raw['photos']; return { id: firstNonEmptyText([raw['id'], raw['defectId']], ''), type: firstNonEmptyText([raw['type'], raw['defectType']], ''), typeLabel: (raw['typeLabel'] ?? '').toString(), defectCode: (raw['defectCode'] ?? '').toString(), defectDesc: (raw['defectDesc'] ?? '').toString(), createdAt: firstNonEmptyText([raw['createdAt'], raw['updateDate'], raw['updatedAt']], ''), quantity: (raw['quantity'] ?? '').toString(), defectCount: (raw['defectCount'] ?? '').toString(), commonFlag: (raw['commonFlag'] ?? '').toString(), isCommon: raw['isCommon'] === true, photos: Array.isArray(storedPhotos) ? storedPhotos as UTSJSONObject[] : [], raw } }
	/** 将动态疵点分组数据转换为模板可访问的结构。 */
	const groups = computed((): DefectGroup[] => (props.defectGroups as UTSJSONObject[]).map((raw: UTSJSONObject): DefectGroup => { const storedItems = raw['items']; return { key: (raw['key'] ?? '').toString(), label: (raw['label'] ?? '').toString(), affectedTotal: parseFloat((raw['affectedTotal'] ?? 0).toString()), items: Array.isArray(storedItems) ? (storedItems as UTSJSONObject[]).map((item: UTSJSONObject): DefectRow => toDefectRow(item)) : [] } }))
	/** 将疵点统计转换为三项明确的数字字段。 */
	const counts = computed((): DefectCounts => { const raw = props.defectCounts as UTSJSONObject; return { critical: parseFloat((raw['critical'] ?? 0).toString()), major: parseFloat((raw['major'] ?? 0).toString()), minor: parseFloat((raw['minor'] ?? 0).toString()) } })
	/** 返回疵点严重等级标准值。 */
	function severityValue(defect: DefectRow): string { const text = `${defect.type.toLowerCase()} ${defect.typeLabel.toLowerCase()}`; if (text.includes('critical') || text.includes('致命') || text.includes('极严重')) return 'CRITICAL'; if (text.includes('major') || text.includes('主要') || text.includes('严重')) return 'MAJOR'; return 'MINOR' }
	/** 返回疵点严重等级中文名称。 */
	function severityLabel(defect: DefectRow): string { const value = severityValue(defect); return value === 'CRITICAL' ? '致命缺陷' : (value === 'MAJOR' ? '主要缺陷' : '次要缺陷') }
	/** 返回严重等级样式类。 */
	function severityClass(defect: DefectRow): string { return severityValue(defect).toLowerCase() }
	/** 返回疵点图片数量。 */
	function photoCount(defect: DefectRow): number { return defect.photos.length }
	/** 返回疵点首张媒体记录。 */
	function firstPhoto(defect: DefectRow): UTSJSONObject | null { return defect.photos.length > 0 ? defect.photos[0] : null }
	/** 判断疵点是否为普遍性疵点。 */
	function isCommon(defect: DefectRow): boolean { return defect.commonFlag === '1' || (defect.commonFlag === '' && defect.isCommon) }
	/** 将疵点时间格式化为 H5 卡片短时间。 */
	function formatTime(value: string): string { if (value === '') return ''; const date = new Date(value); if (Number.isNaN(date.getTime())) return value; const pad = (number: number): string => number.toString().padStart(2, '0'); return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}` }
	/** 请求父页打开已有疵点。 */
	function openDefect(defect: UTSJSONObject) { emit('open-defect', defect); emit('edit-defect', defect) }
	/** 请求父页二次确认后删除疵点。 */
	function removeDefect(defect: UTSJSONObject) { emit('remove-defect', defect) }
</script>

<style>
	.tab-page { padding: 22rpx; }.defects-summary { margin-bottom: 22rpx; flex-direction: row; }.summary-item { flex: 1; margin: 0 6rpx; padding: 24rpx 10rpx; align-items: center; border-radius: 20rpx; background-color: #ffffff; }.summary-label { color: #64748b; font-size: 22rpx; }.summary-value { margin-top: 10rpx; font-size: 42rpx; font-weight: 700; }.summary-value.critical { color: #dc2626; }.summary-value.major { color: #f59e0b; }.summary-value.minor { color: #3b82f6; }.empty-state { padding: 90rpx 20rpx; align-items: center; }.empty-icon { color: #03ae4f; font-size: 70rpx; }.empty-text { margin-top: 15rpx; color: #94a3b8; font-size: 26rpx; }.defect-group { margin-bottom: 24rpx; }.defect-group-title { padding: 0 5rpx 14rpx; flex-direction: row; align-items: center; justify-content: space-between; color: #475569; font-size: 25rpx; font-weight: 600; }.actual-total { color: #0f766e; font-size: 22rpx; font-weight: 500; }.defect-card { position: relative; margin-bottom: 16rpx; padding: 22rpx; flex-direction: row; border-radius: 22rpx; background-color: #ffffff; }.defect-cover { width: 150rpx; height: 150rpx; border-radius: 18rpx; background-color: #f8fafc; }.defect-cover.placeholder { align-items: center; justify-content: center; }.placeholder-text { color: #94a3b8; font-size: 21rpx; }.defect-main { flex: 1; min-width: 0; margin-left: 20rpx; }.defect-head { flex-direction: row; align-items: center; justify-content: space-between; }.severity { padding: 7rpx 14rpx; border-radius: 14rpx; color: #3b82f6; font-size: 20rpx; background-color: #dbeafe; }.severity.major { color: #f59e0b; background-color: #fef3c7; }.severity.critical { color: #dc2626; background-color: #fee2e2; }.defect-time { color: #94a3b8; font-size: 20rpx; }.defect-code { margin-top: 13rpx; color: #1e293b; font-size: 27rpx; font-weight: 600; }.defect-desc { margin-top: 5rpx; color: #64748b; font-size: 23rpx; }.defect-meta { margin-top: 14rpx; flex-direction: row; flex-wrap: wrap; }.defect-meta-text { margin-right: 18rpx; color: #64748b; font-size: 21rpx; }.common-label { color: #0f766e; }.delete-action { position: absolute; right: 18rpx; bottom: 14rpx; }.delete-action-text { color: #ef4444; font-size: 21rpx; }.add-button { height: 88rpx; border-radius: 22rpx; align-items: center; justify-content: center; background-color: #03ae4f; }.add-button-text { color: #ffffff; font-size: 28rpx; font-weight: 600; }
</style>
