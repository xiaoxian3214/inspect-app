<template>
	<view v-if="visible" class="overlay" @click="closeSheet">
		<view class="sheet" @click.stop="stopEvent">
			<view class="sheet-handle"></view>
			<view class="sheet-head">
				<AppButton variant="icon" icon-type="close" :icon-size="22" icon-color="#475569" @press="closeSheet" />
				<text class="sheet-title">{{ modalTitle }}</text>
				<AppButton variant="icon camera" icon-type="camera" :icon-size="25" icon-color="#1a5f3f" @press="addPhoto" />
			</view>

			<scroll-view class="sheet-body" scroll-y="true" show-scrollbar="false">
				<view v-if="draft.result" class="current-result-banner" :class="`banner-${draft.result}`">
					<view class="banner-left"><view class="result-status-dot"></view><text class="result-status-label">{{ currentResultLabel }}</text></view>
					<text class="banner-right">{{ t('检查 - {label}', { label: t(currentResultLabel) }) }}</text>
				</view>

				<view v-if="item?.itemDescription" class="item-description"><text>{{ item.itemDescription }}</text></view>

				<view v-if="itemType === 'Measurements'" class="type-section">
					<text class="section-title">{{ t('测量数据') }}</text>
					<view class="group-card">
						<view class="group-head"><text>规格组 {{ measurementIndex + 1 }} / {{ draft.measurements.length }}</text><AppButton v-if="draft.measurements.length > 1" variant="remove" @press="removeMeasurement(measurementIndex)">{{ t('删除当前组') }}</AppButton></view>
						<view v-for="attr in specAttributes" :key="attr.attrId" class="value-row"><text class="value-label">{{ attr.attrName }}</text><input class="value-input" :value="draft.measurements[measurementIndex]?.[attr.attrId]" :placeholder="t('请输入{name}', { name: attr.attrName })" @input="updateMeasurement(measurementIndex, attr.attrId, $event)" /></view>
					</view>
					<view class="group-navigation"><AppButton variant="nav" :disabled="measurementIndex === 0" @press="previousMeasurement">{{ t('上一组') }}</AppButton><AppButton variant="nav" :disabled="measurementIndex >= draft.measurements.length - 1" @press="nextMeasurement">{{ t('下一组') }}</AppButton></view>
					<AppButton variant="soft" block @press="addMeasurement">{{ t('＋ 新增一组规格') }}</AppButton>
					<view v-if="draft.measurements.length > 1" class="group-summary"><text>{{ t('规格汇总') }}</text><scroll-view scroll-x="true" class="summary-scroll"><view class="summary-row"><text class="summary-label">{{ t('规格') }}</text><text v-for="(_, summaryIndex) in draft.measurements" :key="summaryIndex" class="summary-cell">{{ summaryIndex + 1 }}</text></view><view v-for="attr in specAttributes" :key="attr.attrId" class="summary-row"><text class="summary-label">{{ attr.attrName }}</text><text v-for="(summaryRow, summaryIndex) in draft.measurements" :key="summaryIndex" class="summary-cell" :class="{ 'summary-current': summaryIndex === measurementIndex }">{{ summaryRow[attr.attrId] || '-' }}</text></view></scroll-view></view>
				</view>

				<view v-else-if="itemType === 'Text'" class="type-section">
					<text class="section-title">{{ t('文本检查内容') }}</text>
					<view class="group-card">
						<view class="group-head"><text>文本组 {{ textGroupIndex + 1 }} / {{ draft.textGroups.length }}</text><AppButton v-if="draft.textGroups.length > 1" variant="remove" @press="removeTextGroup(textGroupIndex)">{{ t('删除当前组') }}</AppButton></view>
						<view v-for="attr in specAttributes" :key="attr.attrId" class="value-row"><text class="value-label">{{ attr.attrName }}</text><input class="value-input" :value="draft.textGroups[textGroupIndex]?.[attr.attrId]" :placeholder="t('请输入{name}', { name: attr.attrName })" @input="updateTextField(textGroupIndex, attr.attrId, $event)" /></view>
					</view>
					<view class="group-navigation"><AppButton variant="nav" :disabled="textGroupIndex === 0" @press="previousTextGroup">{{ t('上一组') }}</AppButton><AppButton variant="nav" :disabled="textGroupIndex >= draft.textGroups.length - 1" @press="nextTextGroup">{{ t('下一组') }}</AppButton></view>
					<AppButton variant="soft" block @press="addTextGroup">{{ t('＋ 新增一组文本') }}</AppButton>
				</view>

				<view v-else-if="itemType === 'Barcodes'" class="type-section">
					<text class="section-title">{{ t('条码数据') }}</text>
					<view v-for="(barcode, index) in draft.barcodeItems" :key="index" class="group-card"><view class="group-head"><text>{{ barcode.name || `条码 ${index + 1}` }}</text><AppButton variant="small" @press="openBarcodeEditor(index)">{{ t('编辑') }}</AppButton></view><view class="value-row"><text class="value-label">{{ t('条码信息') }}</text><input class="value-input" :value="barcode.code" :placeholder="t('输入或扫描条码')" @input="updateBarcode(index, $event)" /><AppButton variant="primary" @press="scanBarcode(index)">{{ t('扫描条码') }}</AppButton></view><view class="value-row"><text class="value-label">{{ t('扫码格式') }}</text><text>{{ barcode.format || '-' }}</text></view></view>
					<AppButton block @press="openBarcodeEditor(-1)">{{ t('＋ 增加条码') }}</AppButton>
				</view>

				<view class="media-section">
					<view class="section-title-row"><text class="section-title">{{ t('媒体库') }}</text><AppButton v-if="mediaPhotos.length > 1" variant="small" @press="openPhotoSort">{{ t('照片重新排序') }}</AppButton></view>
					<InspectionMediaGrid :photos="mediaPhotos" add-label="拍照" @capture-media="addPhoto" @remove-media="removePhoto" @preview-media="previewPhoto" @retry-media="retryPhoto" />
				</view>
				<view class="type-section">
					<AppButton block @press="requestCopyItems">{{ t('复制到其他验货') }}</AppButton>
				<AppButton v-if="mediaPhotos.length" block @press="requestBatchMove">{{ t('批量移动照片/视频') }}</AppButton>
				<AppButton v-if="hasContent" variant="danger" block @press="requestResetItem">{{ t('重置检查点') }}</AppButton>
				<AppButton v-if="showCheckPointUpload" block @press="addCheckPointPhoto">{{ t('上传检查点图片') }}</AppButton>
				<view v-if="showCheckPointUpload && checkPointPhotos.length" class="media-section">
					<text class="section-title">{{ t('检查点图片') }}</text>
					<InspectionMediaGrid :photos="checkPointPhotos" add-label="上传检查点图片" @capture-media="addCheckPointPhoto" @remove-media="removePhoto" @preview-media="previewPhoto" @retry-media="retryPhoto" /></view></view>

				<view v-if="defects.length" class="defects-section">
					<text class="section-title">关联疵点（{{ defects.length }}）</text>
					<view v-for="(defect, index) in defects" :key="defect.id || defect.defectId || index" class="defect-item" @click="openDefect(defect)">
						<text class="defect-severity-tag" :class="`severity-${normalizeSeverity(defect.type)}`">{{ getSeverityLabel(defect.type) }}</text>
						<text class="defect-category">{{ (defect.defectCode || defect.categoryName) ?? '-' }}</text>
						<text class="defect-quantity">× {{ defect.quantity ?? 1 }}</text>
						<AppIcon type="arrowRight" :size="16" color="#94a3b8" />
					</view>
				</view>

				<view class="notes-section"><text class="section-title">{{ t('检查备注') }}</text><textarea class="remarks" :value="draft.comment" maxlength="500" :placeholder="t('填写检查情况、异常说明等')" @input="updateComment" /></view>
			</scroll-view>

			<view class="modal-footer-fixed">
				<view class="result-circles-row">
					<view v-for="option in resultOptions" :key="option.value" class="result-circle" :class="[option.value, { active: draft.result === option.value }]" @click="confirmResult(option.value)">
						<view class="circle-icon" :class="[option.value, { active: draft.result === option.value }]"><AppIcon :type="option.icon" :size="30" :color="draft.result === option.value ? '#ffffff' : option.color" /></view>
						<text class="circle-text" :class="{ active: draft.result === option.value }">{{ option.label }}</text>
					</view>
				</view>
			</view>
			</view>
		<PhotoSortSheet :visible="showPhotoSort" :photos="mediaPhotos" @close="closePhotoSort" @sorted="confirmPhotoSort" />
		<view v-if="showBarcodeEditor" class="barcode-overlay" @click.stop="closeBarcodeEditor"><view class="barcode-dialog" @click.stop="stopEvent"><text class="section-title">{{ t('条码名称') }}</text><input class="value-input" :value="barcodeName" :placeholder="t('请输入条码名称')" @input="updateBarcodeName" /><view class="group-navigation"><AppButton v-if="editingBarcodeIndex >= 0" variant="small" @press="deleteBarcode">{{ t('删除') }}</AppButton><AppButton variant="small" @press="closeBarcodeEditor">{{ t('取消') }}</AppButton><AppButton variant="primary" @press="saveBarcodeName">{{ t('保存') }}</AppButton></view></view></view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed, ref, watch } from 'vue'
	import AppIcon from '../icons/AppIcon.uvue'
	import AppButton from '../common/AppButton.uvue'
	import InspectionMediaGrid from './InspectionMediaGrid.uvue'
	import PhotoSortSheet from './PhotoSortSheet.uvue'

	const props = defineProps({
		visible: { type: Boolean, default: false },
		item: { type: Object, default: () => ({}) },
		defects: { type: Array, default: () => [] },
		goodsFlag: { type: Number, default: 0 }
	})
	const emit = defineEmits(['close', 'select-result', 'auto-save', 'add-photo', 'remove-photo', 'preview-photo', 'retry-photo', 'open-defect', 'photos-sorted', 'copy-items', 'batch-move', 'reset-item', 'add-checkpoint-photo'])
	const draft = ref({ result: '', comment: '', photos: [], measurements: [], textGroups: [], barcodeItems: [] })
	const showPhotoSort = ref(false)
	const measurementIndex = ref(0)
	const textGroupIndex = ref(0)
	const showBarcodeEditor = ref(false)
	const editingBarcodeIndex = ref(-1)
	const barcodeName = ref('')
	/** 返回普通检查结果媒体，避免检查点照片混入排序。 */
	const mediaPhotos = computed(() => draft.value.photos.filter((photo) => photo?.bizType !== 'checkPoint'))
	/** 返回与普通检查媒体分开展示的检查点图片。 */
	const checkPointPhotos = computed(() => draft.value.photos.filter((photo) => photo?.bizType === 'checkPoint'))
	/** 仅指定货品类型允许上传检查点图片。 */
	const showCheckPointUpload = computed(() => Number(props.goodsFlag) === 9)
	/** 有检查结果或填写内容时才允许显示重置入口。 */
	const hasContent = computed(() => !!draft.value.result || !!draft.value.comment || draft.value.photos.length > 0 || draft.value.measurements.some((row) => Object.values(row).some(Boolean)) || draft.value.textGroups.some((row) => Object.values(row).some(Boolean)) || draft.value.barcodeItems.some((row) => !!row?.code))
	const resultOptions = [
		{ value: 'pass', label: '检查 - 合格', icon: 'check', color: '#22c55e' },
		{ value: 'fail', label: '检查 - 不合格', icon: 'warning', color: '#ef4444' },
		{ value: 'pending', label: '检查 - 待定', icon: 'help', color: '#f59e0b' },
		{ value: 'na', label: '检查 - 不适用', icon: 'clear', color: '#64748b' }
	]

	/** 返回标准化检查项类型，用于展示 H5 对应的输入区域。 */
	const itemType = computed(() => String(props.item?.itemType ?? 'Standard'))
	/** 返回 H5 规格和文本检查项使用的属性定义。 */
	const specAttributes = computed(() => Array.isArray(props.item?.specAttributes) && props.item.specAttributes.length > 0 ? props.item.specAttributes : [{ attrId: 'value', attrName: itemType.value === 'Text' ? '文本内容' : '测量值' }])
	/** 返回包含检查项类型的弹框标题。 */
	const modalTitle = computed(() => { const typeLabels = { Measurements: '规格', Barcodes: '条码', Text: '文本', Standard: '标准' }; return `${(props.item?.itemName || props.item?.name) ?? '检查项详情'} (${typeLabels[itemType.value] ?? '标准'})` })
	/** 返回当前检查结果的中文标签。 */
	const currentResultLabel = computed(() => { const option = resultOptions.find((item) => item.value === draft.value.result); return option ? option.label.replace('检查 - ', '') : '' })

	/** 将当前检查项数据复制到弹层草稿，避免未保存输入直接污染页面状态。 */
	function resetDraft(item) { const data = item?.data ?? {}; const attributes = Array.isArray(item?.specAttributes) && item.specAttributes.length > 0 ? item.specAttributes : [{ attrId: 'value', attrName: item?.itemType === 'Text' ? '文本内容' : '测量值' }]; const emptyRow = {}; attributes.forEach((attr) => { emptyRow[attr.attrId] = '' }); const measurements = Array.isArray(data?.measurements) && data.measurements.length > 0 ? data.measurements.map((row) => ({ ...emptyRow, ...row })) : [{ ...emptyRow }]; const textGroups = Array.isArray(data?.textGroups) && data.textGroups.length > 0 ? data.textGroups.map((row) => ({ ...emptyRow, ...row })) : [{ ...emptyRow }]; const barcodeItems = Array.isArray(data?.barcodeItems) && data.barcodeItems.length > 0 ? data.barcodeItems.map((row) => ({ ...row })) : (Array.isArray(data?.barcodeList) ? data.barcodeList.map((code, index) => ({ name: `条码项${index + 1}`, code, format: '' })) : []); draft.value = { ...data, result: data?.result ?? '', comment: data?.comment ?? '', photos: Array.isArray(data?.photos) ? [...data.photos] : [], measurements, textGroups, barcodeItems }; measurementIndex.value = 0; textGroupIndex.value = 0; showBarcodeEditor.value = false }
	/** 创建一行与 H5 specAttributes 对齐的空字段对象。 */
	function createEmptyAttributeRow() { const row = {}; specAttributes.value.forEach((attr) => { row[attr.attrId] = '' }); return row }
	/** 判断当前类型数据是否满足 H5 的完成条件。 */
	function isDraftCompleted() { const isMergedChild = String(props.item?.sonPlanId ?? '') !== ''; if (!isMergedChild && props.item?.isPhotoRequired && mediaPhotos.value.length === 0) return false; if (itemType.value === 'Measurements') return draft.value.measurements.some((row) => Object.values(row ?? {}).some((value) => String(value ?? '').trim() !== '')); if (itemType.value === 'Text') return draft.value.textGroups.some((row) => Object.values(row ?? {}).some((value) => String(value ?? '').trim() !== '')); if (itemType.value === 'Barcodes') return draft.value.barcodeItems.some((row) => String(row?.code ?? '').trim() !== ''); if (itemType.value === 'Standard') return String(draft.value?.result ?? '') !== ''; return true }
	/** 生成供父页面持久化的完整检查项草稿。 */
	function buildDraftData() { return { ...draft.value, completed: isDraftCompleted() } }
	/** 自动保存字段、备注或分组变化，但保持弹框继续打开。 */
	function autoSaveDraft() { emit('auto-save', { item: props.item, data: buildDraftData() }) }
	/** 选择检查结果后立即保存并交由父页面关闭弹框或进入疵点录入。 */
	function confirmResult(result) { const isMergedChild = String(props.item?.sonPlanId ?? '') !== ''; if (!isMergedChild && props.item?.isPhotoRequired && result !== 'na' && mediaPhotos.value.length === 0) { uni.showToast({ title: t('请上传照片(必填项)'), icon: 'none' }); return }; draft.value = { ...draft.value, result }; emit('select-result', { item: props.item, result, data: buildDraftData() }) }
	/** 更新检查项备注并触发离线草稿自动保存。 */
	function updateComment(event) { draft.value = { ...draft.value, comment: String(event?.detail?.value ?? '') }; autoSaveDraft() }
	/** 更新指定规格组中的属性值并触发自动保存。 */
	function updateMeasurement(rowIndex, attrId, event) { const rows = [...draft.value.measurements]; rows[rowIndex] = { ...rows[rowIndex], [attrId]: String(event?.detail?.value ?? '') }; draft.value = { ...draft.value, measurements: rows }; autoSaveDraft() }
	/** 新增一组 H5 规格属性并触发自动保存。 */
	function addMeasurement() { draft.value = { ...draft.value, measurements: [...draft.value.measurements, createEmptyAttributeRow()] }; measurementIndex.value = draft.value.measurements.length - 1; autoSaveDraft() }
	/** 删除指定规格组、至少保留一组空数据并触发自动保存。 */
	function removeMeasurement(rowIndex) { const rows = draft.value.measurements.filter((_, index) => index !== rowIndex); draft.value = { ...draft.value, measurements: rows.length > 0 ? rows : [createEmptyAttributeRow()] }; measurementIndex.value = Math.min(measurementIndex.value, draft.value.measurements.length - 1); autoSaveDraft() }
	/** 在规格组之间向前切换，不修改已保存数据。 */
	function previousMeasurement() { measurementIndex.value = Math.max(0, measurementIndex.value - 1) }
	/** 在规格组之间向后切换，不修改已保存数据。 */
	function nextMeasurement() { measurementIndex.value = Math.min(draft.value.measurements.length - 1, measurementIndex.value + 1) }
	/** 更新指定文本组中的属性值并触发自动保存。 */
	function updateTextField(rowIndex, attrId, event) { const rows = [...draft.value.textGroups]; rows[rowIndex] = { ...rows[rowIndex], [attrId]: String(event?.detail?.value ?? '') }; draft.value = { ...draft.value, textGroups: rows }; autoSaveDraft() }
	/** 新增一组 H5 文本属性并触发自动保存。 */
	function addTextGroup() { draft.value = { ...draft.value, textGroups: [...draft.value.textGroups, createEmptyAttributeRow()] }; textGroupIndex.value = draft.value.textGroups.length - 1; autoSaveDraft() }
	/** 删除指定文本组、至少保留一组空数据并触发自动保存。 */
	function removeTextGroup(rowIndex) { const rows = draft.value.textGroups.filter((_, index) => index !== rowIndex); draft.value = { ...draft.value, textGroups: rows.length > 0 ? rows : [createEmptyAttributeRow()] }; textGroupIndex.value = Math.min(textGroupIndex.value, draft.value.textGroups.length - 1); autoSaveDraft() }
	/** 在文本组之间向前切换。 */
	function previousTextGroup() { textGroupIndex.value = Math.max(0, textGroupIndex.value - 1) }
	/** 在文本组之间向后切换。 */
	function nextTextGroup() { textGroupIndex.value = Math.min(draft.value.textGroups.length - 1, textGroupIndex.value + 1) }
	/** 更新指定条码记录并触发自动保存。 */
	function updateBarcode(index, event) { const rows = [...draft.value.barcodeItems]; rows[index] = { ...rows[index], code: String(event?.detail?.value ?? '') }; draft.value = { ...draft.value, barcodeItems: rows }; syncBarcodes() }
	/** 同步条码对象及旧版条码列表到离线草稿。 */
	function syncBarcodes() { const barcodeList = draft.value.barcodeItems.map((row) => String(row?.code ?? '').trim()).filter((code) => code !== ''); draft.value = { ...draft.value, barcodeList, barcode: barcodeList[0] ?? '' }; autoSaveDraft() }
	/** 打开新建或编辑条码名称的原生弹层。 */
	function openBarcodeEditor(index) { editingBarcodeIndex.value = index; barcodeName.value = index >= 0 ? String(draft.value.barcodeItems[index]?.name ?? '') : ''; showBarcodeEditor.value = true }
	/** 更新条码名称输入。 */
	function updateBarcodeName(event) { barcodeName.value = String(event?.detail?.value ?? '') }
	/** 关闭条码名称弹层。 */
	function closeBarcodeEditor() { showBarcodeEditor.value = false; editingBarcodeIndex.value = -1 }
	/** 保存新条码项或当前条码名称。 */
	function saveBarcodeName() { const name = barcodeName.value.trim(); if (!name) { uni.showToast({ title: t('请输入条码名称'), icon: 'none' }); return }; const rows = [...draft.value.barcodeItems]; if (editingBarcodeIndex.value >= 0) rows[editingBarcodeIndex.value] = { ...rows[editingBarcodeIndex.value], name }; else rows.push({ name, code: '', format: '' }); draft.value = { ...draft.value, barcodeItems: rows }; closeBarcodeEditor(); syncBarcodes() }
	/** 删除当前条码项并同步旧版条码字段。 */
	function deleteBarcode() { const rows = draft.value.barcodeItems.filter((_, index) => index !== editingBarcodeIndex.value); draft.value = { ...draft.value, barcodeItems: rows }; closeBarcodeEditor(); syncBarcodes() }
	/** 使用 App 原生扫码，保存扫描值及格式；取消扫码不改草稿。 */
	function scanBarcode(index) { uni.scanCode({ scanType: ['barCode', 'qrCode'], success: (result) => { const rows = [...draft.value.barcodeItems]; if (!rows[index]) return; rows[index] = { ...rows[index], code: String(result?.result ?? '').trim(), format: String(result?.scanType ?? '') }; draft.value = { ...draft.value, barcodeItems: rows }; syncBarcodes() }, fail: (error) => { if (!String(error?.errMsg ?? '').toLowerCase().includes('cancel')) uni.showToast({ title: t('扫码失败，请重试'), icon: 'none' }) } }) }
	/** 请求复制当前检查项到其他验货计划。 */
	function requestCopyItems() { emit('copy-items', props.item) }
	/** 请求批量移动当前检查项已上传的照片或视频。 */
	function requestBatchMove() { emit('batch-move', props.item) }
	/** 请求详情页二次确认后重置当前检查项。 */
	function requestResetItem() { emit('reset-item', props.item) }
	/** 请求详情页以检查点图片业务类型保存本地照片。 */
	function addCheckPointPhoto() { emit('add-checkpoint-photo', props.item) }
	/** 请求页面调用相机或相册添加检查项图片。 */
	function addPhoto() { emit('add-photo', props.item) }
	/** 请求页面删除当前检查项中的指定图片。 */
	function removePhoto(photo) { emit('remove-photo', { item: props.item, photo }) }
	/** 请求页面预览当前检查项图片。 */
	function previewPhoto(photo) { emit('preview-photo', { item: props.item, photo }) }
	/** 请求页面将上传失败的检查项图片重新加入上传队列。 */
	function retryPhoto(photo) { emit('retry-photo', { item: props.item, photo }) }
	/** 打开当前检查项图片排序底部弹层。 */
	function openPhotoSort() { if (mediaPhotos.value.length > 1) showPhotoSort.value = true }
	/** 关闭图片排序底部弹层并放弃临时顺序。 */
	function closePhotoSort() { showPhotoSort.value = false }
	/** 应用确认后的图片顺序并通知详情页保存普通草稿。 */
	function confirmPhotoSort(photos) { let index = 0; const merged = draft.value.photos.map((photo) => photo?.bizType === 'checkPoint' ? photo : photos[index++]); draft.value = { ...draft.value, photos: merged }; showPhotoSort.value = false; emit('photos-sorted', { item: props.item, photos: merged, data: buildDraftData() }) }
	/** 打开当前检查项已关联的疵点记录。 */
	function openDefect(defect) { emit('open-defect', defect) }
	/** 将服务端疵点等级标准化为 H5 使用的三级枚举。 */
	function normalizeSeverity(raw) { const value = String(raw ?? '').toUpperCase(); if (value.includes('CRITICAL') || value.includes('致命')) return 'CRITICAL'; if (value.includes('MAJOR') || value.includes('主要') || value.includes('严重')) return 'MAJOR'; return 'MINOR' }
	/** 返回标准化疵点等级对应的中文名称。 */
	function getSeverityLabel(raw) { const labels = { CRITICAL: '致命', MAJOR: '主要', MINOR: '次要' }; return labels[normalizeSeverity(raw)] }
	/** 关闭检查项编辑弹层。 */
	function closeSheet() { emit('close') }
	/** 阻止点击弹层内容区域时触发遮罩关闭。 */
	function stopEvent() {}

	watch(() => props.item, resetDraft, { immediate: true, deep: true })
</script>

<style>
