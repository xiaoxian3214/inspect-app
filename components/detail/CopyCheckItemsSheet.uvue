<template>
	<view v-if="visible" class="overlay" @click="closeSheet"><view class="dialog" :style="{ maxHeight: dialogMaxHeight, paddingBottom: dialogBottomPadding }" @click.stop="stopEvent"><text class="title">{{ translateText('复制检查项') }}</text><text class="hint">{{ translateText('将当前计划的检查结果复制到同一合并验货组中的其他计划。') }}</text><text class="label">{{ translateText('源检查项') }}</text><picker :range="itemLabels" @change="selectItem"><view class="picker"><text>{{ translateText(itemLabels[itemIndex] ?? '请选择检查项') }}</text><text>›</text></view></picker><text class="label">{{ translateText('目标计划') }}</text><picker :range="planLabels" @change="selectPlan"><view class="picker"><text>{{ translateText(planLabels[planIndex] ?? '请选择目标计划') }}</text><text>›</text></view></picker><view class="option-row"><text>{{ translateText('复制检查结果') }}</text><switch :checked="copyStatus" color="#03ae4f" @change="changeStatus" /></view><view class="option-row"><text>{{ translateText('复制备注') }}</text><switch :checked="copyRemarks" color="#03ae4f" @change="changeRemarks" /></view><view class="option-row"><text>{{ translateText('复制图片') }}</text><switch :checked="copyPhotos" color="#03ae4f" @change="changePhotos" /></view><view class="actions"><button class="button cancel" @click="closeSheet">{{ translateText('取消') }}</button><button class="button save" :disabled="submitting" @click="submitCopy">{{ translateText(submitting ? '处理中...' : '确认复制') }}</button></view></view></view>
</template>
<script setup lang="uts">
	import { windowHeightPx, safeBottomPaddingPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { firstNonEmptyText } from '../../domain/searchViewModel.uts'
	import { computed, ref, watch } from 'vue'
	const props = defineProps({ visible: { type: Boolean, default: false }, items: { type: Array, default: () => [] }, sourceItemId: { type: String, default: '' }, plans: { type: Array, default: () => [] }, submitting: { type: Boolean, default: false } })
	const emit = defineEmits(['close', 'submit'])
	const itemIndex = ref(0); const planIndex = ref(0); const copyStatus = ref(true); const copyRemarks = ref(true); const copyPhotos = ref(false)
	/** 提供原生模板可调用的翻译方法。 */
	function translateText(key: string): string { return t(key) }
	/** 按设备窗口尺寸限制弹窗最大高度。 */
	const dialogMaxHeight = computed((): string => windowHeightPx(0.9))
	/** 为弹窗底部叠加系统安全区。 */
	const dialogBottomPadding = computed((): string => safeBottomPaddingPx(30))
	/** 返回检查项选择器文案。 */
	const itemLabels = computed((): string[] => (props.items as UTSJSONObject[]).map((item: UTSJSONObject): string => firstNonEmptyText([item['itemName'], item['name'], item['itemId'], item['id']], '')))
	/** 返回目标计划选择器文案。 */
	const planLabels = computed((): string[] => (props.plans as UTSJSONObject[]).map((plan: UTSJSONObject): string => { const order = firstNonEmptyText([plan['clientOrderNo']], ''); const goods = firstNonEmptyText([plan['subGoodsNo'], plan['goodsName']], ''); const label = [order, goods].filter((part: string) => part !== '').join(' · '); return label !== '' ? label : (plan['id'] ?? '').toString() }))
	/** 选择源检查项。 */ function selectItem(event: UniPickerChangeEvent) { itemIndex.value = parseInt((event.detail.value ?? '0').toString()) }
	/** 选择目标计划。 */ function selectPlan(event: UniPickerChangeEvent) { planIndex.value = parseInt((event.detail.value ?? '0').toString()) }
	/** 更新是否复制检查结果。 */ function changeStatus(event: UniSwitchChangeEvent) { copyStatus.value = event.detail.value === true }
	/** 更新是否复制备注。 */ function changeRemarks(event: UniSwitchChangeEvent) { copyRemarks.value = event.detail.value === true }
	/** 更新是否复制图片。 */ function changePhotos(event: UniSwitchChangeEvent) { copyPhotos.value = event.detail.value === true }
	/** 提交复制检查项请求参数。 */ function submitCopy() { const item = (props.items as UTSJSONObject[])[itemIndex.value]; const plan = (props.plans as UTSJSONObject[])[planIndex.value]; if (item == null || plan == null) return; emit('submit', { sourceItemId: firstNonEmptyText([item['itemId'], item['id']], ''), targetPlanIds: [firstNonEmptyText([plan['id'], plan['planId']], '')], targetItemIds: [firstNonEmptyText([item['standardItemId'], item['itemId'], item['id']], '')], copyStatus: copyStatus.value, copyRemarks: copyRemarks.value, copyPhotos: copyPhotos.value }) }
	/** 关闭复制检查项弹层。 */ function closeSheet() { emit('close') }
	/** 阻止点击内容区域关闭弹层。 */ function stopEvent() {}
	/** 每次打开弹层时预选入口检查项，普通菜单仍从首项开始。 */ function resetSelection(visible: boolean) { if (visible) { const index = (props.items as UTSJSONObject[]).findIndex((item: UTSJSONObject) => firstNonEmptyText([item['itemId'], item['id']], '') === props.sourceItemId); itemIndex.value = index >= 0 ? index : 0; planIndex.value = 0 } }
	/** 监听弹层显隐并恢复当前入口对应的检查项选择。 */
	watch((): boolean => props.visible, (visible: boolean) => resetSelection(visible))
</script>
<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2320; justify-content: flex-end; background-color: rgba(15,23,42,.55); }.dialog { width: 100%; padding: 24rpx 30rpx 30rpx; border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; background-color: #fff; }.title { color: #172033; font-size: 33rpx; font-weight: 700; }.hint { margin-top: 12rpx; color: #64748b; font-size: 23rpx; line-height: 36rpx; }.label { margin: 22rpx 0 10rpx; color: #334155; font-size: 24rpx; font-weight: 600; }.picker { height: 72rpx; padding: 0 18rpx; flex-direction: row; align-items: center; justify-content: space-between; border-width: 2rpx; border-color: #e2e8f0; border-radius: 15rpx; color: #475569; background-color: #f8fafc; }.option-row { min-height: 76rpx; flex-direction: row; align-items: center; justify-content: space-between; color: #475569; font-size: 25rpx; border-bottom-width: 2rpx; border-bottom-color: #f1f5f9; }.actions { margin-top: 24rpx; flex-direction: row; }.button { flex: 1; height: 80rpx; margin: 0 8rpx; border-radius: 17rpx; font-size: 26rpx; }.button.cancel { color: #475569; background-color: #f1f5f9; }.button.save { color: #fff; background-color: #03ae4f; }
</style>
