<template>
	<view v-if="visible" class="overlay" @click="closeSheet"><view class="dialog" @click.stop="stopEvent"><text class="title">{{ t('复制检查项') }}</text><text class="hint">{{ t('将当前计划的检查结果复制到同一合并验货组中的其他计划。') }}</text><text class="label">{{ t('源检查项') }}</text><picker :range="itemLabels" @change="selectItem"><view class="picker"><text>{{ t(itemLabels[itemIndex] ?? '请选择检查项') }}</text><text>›</text></view></picker><text class="label">{{ t('目标计划') }}</text><picker :range="planLabels" @change="selectPlan"><view class="picker"><text>{{ t(planLabels[planIndex] ?? '请选择目标计划') }}</text><text>›</text></view></picker><view class="option-row"><text>{{ t('复制检查结果') }}</text><switch :checked="copyStatus" color="#03ae4f" @change="changeStatus" /></view><view class="option-row"><text>{{ t('复制备注') }}</text><switch :checked="copyRemarks" color="#03ae4f" @change="changeRemarks" /></view><view class="option-row"><text>{{ t('复制图片') }}</text><switch :checked="copyPhotos" color="#03ae4f" @change="changePhotos" /></view><view class="actions"><button class="button cancel" @click="closeSheet">{{ t('取消') }}</button><button class="button save" :disabled="submitting" @click="submitCopy">{{ t(submitting ? '处理中...' : '确认复制') }}</button></view></view></view>
</template>
<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed, ref, watch } from 'vue'
	const props = defineProps({ visible: { type: Boolean, default: false }, items: { type: Array, default: () => [] }, sourceItemId: { type: String, default: '' }, plans: { type: Array, default: () => [] }, submitting: { type: Boolean, default: false } })
	const emit = defineEmits(['close', 'submit'])
	const itemIndex = ref(0); const planIndex = ref(0); const copyStatus = ref(true); const copyRemarks = ref(true); const copyPhotos = ref(false)
	/** 返回检查项选择器文案。 */
	const itemLabels = computed(() => props.items.map((item) => item.itemName || item.name || item.itemId || item.id))
	/** 返回目标计划选择器文案。 */
	const planLabels = computed(() => props.plans.map((plan) => [plan.clientOrderNo, plan.subGoodsNo || plan.goodsName].filter(Boolean).join(' · ') || plan.id))
	/** 选择源检查项。 */ function selectItem(event) { itemIndex.value = Number(event?.detail?.value ?? 0) }
	/** 选择目标计划。 */ function selectPlan(event) { planIndex.value = Number(event?.detail?.value ?? 0) }
	/** 更新是否复制检查结果。 */ function changeStatus(event) { copyStatus.value = event?.detail?.value === true }
	/** 更新是否复制备注。 */ function changeRemarks(event) { copyRemarks.value = event?.detail?.value === true }
	/** 更新是否复制图片。 */ function changePhotos(event) { copyPhotos.value = event?.detail?.value === true }
	/** 提交复制检查项请求参数。 */ function submitCopy() { const item = props.items[itemIndex.value]; const plan = props.plans[planIndex.value]; if (!item || !plan) return; emit('submit', { sourceItemId: item.itemId || item.id, targetPlanIds: [plan.id || plan.planId], targetItemIds: [item.standardItemId || item.itemId || item.id], copyStatus: copyStatus.value, copyRemarks: copyRemarks.value, copyPhotos: copyPhotos.value }) }
	/** 关闭复制检查项弹层。 */ function closeSheet() { emit('close') }
	/** 阻止点击内容区域关闭弹层。 */ function stopEvent() {}
	/** 每次打开弹层时预选入口检查项，普通菜单仍从首项开始。 */ function resetSelection(visible) { if (visible) { const index = props.items.findIndex((item) => String(item?.itemId ?? item?.id ?? '') === props.sourceItemId); itemIndex.value = index >= 0 ? index : 0; planIndex.value = 0 } }
	watch(() => props.visible, resetSelection)
</script>
<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2320; justify-content: flex-end; background-color: rgba(15,23,42,.55); }.dialog { width: 100%; max-height: 90vh; padding: 24rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; background-color: #fff; }.title { color: #172033; font-size: 33rpx; font-weight: 700; }.hint { margin-top: 12rpx; color: #64748b; font-size: 23rpx; line-height: 36rpx; }.label { margin: 22rpx 0 10rpx; color: #334155; font-size: 24rpx; font-weight: 600; }.picker { height: 72rpx; padding: 0 18rpx; flex-direction: row; align-items: center; justify-content: space-between; border-width: 2rpx; border-color: #e2e8f0; border-radius: 15rpx; color: #475569; background-color: #f8fafc; }.option-row { min-height: 76rpx; flex-direction: row; align-items: center; justify-content: space-between; color: #475569; font-size: 25rpx; border-bottom-width: 2rpx; border-bottom-color: #f1f5f9; }.actions { margin-top: 24rpx; flex-direction: row; }.button { flex: 1; height: 80rpx; margin: 0 8rpx; border-radius: 17rpx; font-size: 26rpx; }.button.cancel { color: #475569; background-color: #f1f5f9; }.button.save { color: #fff; background-color: #03ae4f; }
</style>
