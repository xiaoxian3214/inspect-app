<template>
	<view v-if="visible" class="overlay" @click="closeSheet">
		<view class="editor" @click.stop="stopEvent">
			<video v-if="isVideo" class="preview-video" :src="videoSource" />
			<InspectionMediaImage v-else class="preview" :media="photo" view-mode="preview" image-mode="aspectFit" />
			<view class="meta"><text>{{ metaLabel }}</text></view>
			<view class="actions">
				<button class="button close-button" @click="closeSheet">{{ t('关闭') }}</button>
				<button class="button delete-button" @click="deletePhoto">{{ t(isVideo ? '删除视频' : '删除图片') }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'
	import InspectionMediaImage from './InspectionMediaImage.uvue'
	import { API_BASE_URL } from '../../config/appConfig.uts'
	import { getMediaDisplayUrl } from '../../domain/mediaDisplay.uts'
	import { isVideoMedia } from '../../domain/photoUploadPolicy.uts'

	const props = defineProps({ visible: { type: Boolean, default: false }, photo: { type: Object, default: () => ({}) } })
	const emit = defineEmits(['close', 'delete'])

	/** 判定当前预览媒体是否为视频，决定使用视频播放器还是图片预览。 */
	const isVideo = computed(() => isVideoMedia(props.photo))
	/** 视频播放源优先使用本地路径，本地上传后回退到服务端文件地址。 */
	const videoSource = computed(() => {
		const localPath = String(props.photo?.localPath ?? '').trim()
		if (localPath !== '') return localPath
		return getMediaDisplayUrl({ ...props.photo, localPath: '' }, 'preview', API_BASE_URL)
	})
	/** 返回预览区的上传状态文案，按媒体类型区分视频与图片业务用语。 */
	const metaLabel = computed(() => {
		if (props.photo?.fileId) return isVideo.value ? '视频已上传' : '图片已上传'
		return isVideo.value ? '本地视频，等待上传' : '本地图片，等待上传'
	})
	/** 关闭媒体预览编辑弹层。 */
	function closeSheet() { emit('close') }
	/** 请求删除当前预览媒体。 */
	function deletePhoto() { emit('delete') }
	/** 阻止点击预览区域关闭弹层。 */
	function stopEvent() {}
</script>

<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2400; justify-content: flex-end; background-color: rgba(0,0,0,.82); }
	.editor { width: 100%; max-height: 94vh; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; background-color: #0f172a; }
	.preview { width: 100%; height: 72vh; border-radius: 20rpx; }
	.preview-video { width: 100%; height: 72vh; border-radius: 20rpx; background-color: #020617; }
	.meta { margin-top: 18rpx; align-items: center; color: #fff; font-size: 23rpx; }
	.actions { margin-top: 24rpx; flex-direction: row; }
	.button { flex: 1; height: 80rpx; margin: 0 8rpx; border-radius: 17rpx; font-size: 25rpx; }
	.close-button { color: #334155; background-color: #fff; }
	.delete-button { color: #fff; background-color: #ef4444; }
</style>
