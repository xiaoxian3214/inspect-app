<template>
	<view v-if="visible" class="overlay" @click="closeSheet">
		<view class="editor" :style="{ maxHeight: editorMaxHeight, paddingBottom: editorBottomPadding }" @click.stop="stopEvent">
			<view v-if="photos.length > 1" class="viewer-navigation">
				<text class="navigation-action" @click="previousPhoto">{{ translateText('上一张') }}</text>
				<text class="navigation-count">{{ currentIndex + 1 }} / {{ photos.length }}</text>
				<text class="navigation-action" @click="nextPhoto">{{ translateText('下一张') }}</text>
			</view>
			<video v-if="isVideo" class="preview-video" :style="{ height: previewHeight }" :src="videoSource" />
			<InspectionMediaImage v-else class="preview" :style="{ height: previewHeight }" :media="photo" view-mode="preview" image-mode="aspectFit" />
			<view class="meta"><text>{{ translateText(metaLabel) }}</text></view>
			<view class="actions">
				<button class="button close-button" @click="closeSheet">{{ translateText('关闭') }}</button>
				<button v-if="!isVideo" class="button edit-button" @click="openImageEditor">{{ translateText('编辑图片') }}</button>
				<button class="button delete-button" @click="deletePhoto">{{ translateText(isVideo ? '删除视频' : '删除图片') }}</button>
			</view>
		</view>
	</view>
	<ImageMarkupEditor :visible="editing" :source="editSource" @cancel="closeImageEditor" @edited="saveEditedImage" />
</template>

<script setup lang="uts">
	import { windowHeightPx, safeBottomPaddingPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { computed, ref, watch } from 'vue'
	import InspectionMediaImage from './InspectionMediaImage.uvue'
	import ImageMarkupEditor from './ImageMarkupEditor.uvue'
	import { API_BASE_URL } from '../../config/appConfig.uts'
	import { getMediaDisplayUrl } from '../../domain/mediaDisplay.uts'
	import { adjacentMedia, findMediaIndex } from '../../domain/mediaViewer.uts'
	import { isVideoMedia } from '../../domain/photoUploadPolicy.uts'
	import { reportFileApi } from '../../runtime/appRuntime.uts'

	const props = defineProps({ visible: { type: Boolean, default: false }, photo: { type: Object, default: () => ({}) }, photos: { type: Array, default: () => [] }, saving: { type: Boolean, default: false } })
	const emit = defineEmits(['close', 'delete', 'select-media', 'edited'])
	const editing = ref(false)
	const editSource = ref('')
	const openingEditor = ref(false)
	/** 为原生媒体预览模板提供可调用的翻译方法。 */
	function translateText(key: string): string { return t(key) }
	/** 读取媒体对象的动态本地路径和服务端文件字段。 */
	const photoData = computed((): UTSJSONObject => props.photo as UTSJSONObject)
	/** 返回当前图片在所属媒体库中的位置，用于显示导航进度。 */
	const currentIndex = computed((): number => findMediaIndex(props.photos, photoData.value))
	/** 限制媒体编辑弹层最大高度。 */
	const editorMaxHeight = computed((): string => windowHeightPx(0.94))
	/** 让图片和视频预览共用设备窗口高度。 */
	const previewHeight = computed((): string => windowHeightPx(0.72))
	/** 叠加底部系统安全区，避免按钮被手势区域遮住。 */
	const editorBottomPadding = computed((): string => safeBottomPaddingPx(24))

	/** 判定当前预览媒体是否为视频，决定使用视频播放器还是图片预览。 */
	const isVideo = computed((): boolean => isVideoMedia(photoData.value))
	/** 视频播放源优先使用本地路径，本地上传后回退到服务端文件地址。 */
	const videoSource = computed((): string => {
		const localPath = (photoData.value['localPath'] ?? '').toString().trim()
		if (localPath !== '') return localPath
		return getMediaDisplayUrl({ ...photoData.value, localPath: '' }, 'preview', API_BASE_URL)
	})
	/** 返回预览区的上传状态文案，按媒体类型区分视频与图片业务用语。 */
	const metaLabel = computed((): string => {
		if ((photoData.value['fileId'] ?? '').toString() !== '') return isVideo.value ? '视频已上传' : '图片已上传'
		return isVideo.value ? '本地视频，等待上传' : '本地图片，等待上传'
	})
	/** 关闭媒体预览编辑弹层。 */
	function closeSheet() { if (props.saving) return; emit('close') }
	/** 请求删除当前预览媒体。 */
	function deletePhoto() { if (props.saving) return; emit('delete') }
	/** 在当前检查项或疵点媒体库中循环切换，并交由父页面更新删除目标。 */
	function navigatePhoto(offset: number) { if (props.saving) return; const next = adjacentMedia(props.photos, photoData.value, offset); if (next != null) emit('select-media', next) }
	/** 预览当前媒体库的上一张。 */
	function previousPhoto() { navigatePhoto(-1) }
	/** 预览当前媒体库的下一张。 */
	function nextPhoto() { navigatePhoto(1) }
	/**
	 * 本地图片直接编辑；仅有服务端文件时先鉴权下载预览图到本地。
	 * 每一步 await 之后都校验弹层仍可见，避免下载期间弹层被关闭后仍改写编辑状态、
	 * 甚至在关闭态把标注编辑器打开（写入已销毁的渲染子树会触发 vapor 渲染线程崩溃）。
	 */
	async function openImageEditor() {
		if (isVideo.value || openingEditor.value || props.saving) return
		openingEditor.value = true
		try {
			const localPath = (photoData.value['localPath'] ?? '').toString().trim()
			const fileId = (photoData.value['fileId'] ?? '').toString().trim()
			let localAvailable = false
			if (localPath !== '') {
				localAvailable = await new Promise<boolean>((resolve) => {
					uni.getImageInfo({ src: localPath, success: () => resolve(true), fail: () => { console.warn('[PhotoEditorSheet] localPath not readable:', localPath); resolve(false) } })
				})
				if (!props.visible) return
			}
			const resolvedSource = localAvailable ? localPath : (fileId !== '' ? await reportFileApi.downloadInspectFile(fileId, 'preview') : '')
			if (!props.visible) return
			editSource.value = resolvedSource
			if (editSource.value === '') {
				if (fileId !== '' && localPath !== '') throw new Error('本地图片不可用且服务端下载失败，请检查网络后重试')
				if (fileId !== '') throw new Error('服务端图片下载失败，请检查网络后重试')
				throw new Error('当前图片没有可编辑的本地文件')
			}
			editing.value = true
		} catch (error) { uni.showToast({ title: t(((error as Error)?.message ?? t('下载图片失败')).toString()), icon: 'none', duration: 2500 }) }
		finally { if (props.visible) openingEditor.value = false }
	}
	/** 关闭画布编辑器并丢弃未保存的笔画。 */
	function closeImageEditor() { editing.value = false; editSource.value = '' }
	/** 将已保存的本地新图路径交给页面持久化为待上传媒体。 */
	function saveEditedImage(path: string) { emit('edited', path) }
	/**
	 * 切换预览目标时清空旧图的编辑状态，且仅在预览可见时写入。
	 * 弹层实例在关闭后仍然挂载，若不带守卫，关闭期间父页面推送新的预览媒体会改写编辑状态，
	 * 驱动已销毁的渲染子树在 vapor 原生渲染线程重新渲染并闪退。
	 */
	watch((): UTSJSONObject => photoData.value, () => { if (props.visible) closeImageEditor() })
	/**
	 * 打开媒体预览时清空上一次的图片编辑状态并解除编辑请求锁；关闭时不写入内部状态，
	 * 避免弹层子树已销毁后仍被内部状态驱动重新渲染。
	 */
	watch((): boolean => props.visible, (visible: boolean) => { if (visible) { openingEditor.value = false; closeImageEditor() } })
	/** 阻止点击预览区域关闭弹层。 */
	function stopEvent() {}
</script>

<style>
	.overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2400; justify-content: flex-end; background-color: rgba(0,0,0,.82); }
	.editor { width: 100%; padding: 24rpx 24rpx 24rpx; border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; background-color: #0f172a; }
	.viewer-navigation { height: 70rpx; flex-direction: row; align-items: center; justify-content: space-between; }
	.navigation-action { padding: 12rpx; color: #fff; font-size: 27rpx; }
	.navigation-count { color: #cbd5e1; font-size: 24rpx; }
	.preview { width: 100%; border-radius: 20rpx; }
	.preview-video { width: 100%; border-radius: 20rpx; background-color: #020617; }
	.meta { margin-top: 18rpx; align-items: center; color: #fff; font-size: 23rpx; }
	.actions { margin-top: 24rpx; flex-direction: row; }
	.button { flex: 1;  margin: 0 8rpx; border-radius: 17rpx; font-size: 25rpx; }
	.close-button { color: #334155; background-color: #fff; }
	.edit-button { color: #fff; background-color: #16a34a; }
	.delete-button { color: #fff; background-color: #ef4444; }
</style>
