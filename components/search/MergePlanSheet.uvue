<template>
	<page-container :show="visible" position="bottom" :overlay="true" :z-index="2200" overlay-style="background-color: rgba(15, 23, 42, 0.42)" @clickoverlay="closeSheet">
		<view class="sheet-panel" :style="{ maxHeight: sheetMaxHeight, minHeight: sheetMinHeight }">
			<text class="sheet-title">{{ translateText(stage === 'type' ? '选择合并验货类型' : '确认合并以下验货数据') }}</text>

			<scroll-view v-if="stage === 'type'" class="type-body" :style="{ maxHeight: typeBodyMaxHeight }" direction="vertical">
				<view class="section">
					<text class="section-label">{{ translateText('验货类型') }}</text>
					<view class="type-grid">
						<view v-for="(row, rowIndex) in typeRows" :key="rowIndex" class="type-row">
							<view v-for="cell in row" :key="cell.value" class="type-cell">
								<view v-if="cell.placeholder" class="type-chip placeholder"></view>
								<view v-else class="type-chip" :class="{ active: selectedInspectType == cell.value }" @click="selectInspectType(cell.value)">
									<text class="type-chip-text" :class="{ active: selectedInspectType == cell.value }">{{ cell.label }}</text>
								</view>
							</view>
						</view>
					</view>
					<text v-if="inspectTypeOptions.length === 0" class="empty-text">{{ translateText('暂无可选验货类型') }}</text>
				</view>
			</scroll-view>

			<scroll-view v-else class="confirm-body" :style="{ maxHeight: confirmBodyMaxHeight }" direction="vertical">
				<text class="summary-text">{{ translateText('已选择 {count} 条计划', { count: selectedItems.length }) }}</text>
				<view class="merge-table">
					<view class="merge-table-header">
						<text class="merge-table-cell merge-table-header-cell">{{ translateText('单号') }}</text>
						<text class="merge-table-cell merge-table-header-cell">{{ translateText('款号#批次') }}</text>
						<text class="merge-table-cell merge-table-header-cell">{{ translateText('产品名称') }}</text>
					</view>
					<view class="merge-table-body">
						<view v-for="row in previewRows" :key="row.key" class="merge-table-row">
							<text class="merge-table-cell">{{ row.orderNo }}</text>
							<text class="merge-table-cell">{{ row.itemBatch }}</text>
							<text class="merge-table-cell">{{ row.productName }}</text>
						</view>
					</view>
				</view>
			</scroll-view>

			<!-- 清单在合并成功后固定展示在滚动区之外，计划再多也不用滚动才能看到 -->
			<view v-if="mergedPlanId !== '' && stage !== 'type'" class="section">
				<view class="select-field" @click="openTemplatePicker">
					<text class="select-label">{{ translateText('清单模板') }}</text>
					<text class="select-text" :class="{ placeholder: selectedTemplateName == '' }">{{ templateValueText }}</text>
					<text class="select-chevron">›</text>
				</view>
			</view>

			<view v-if="mergedPlanId !== '' && stage !== 'type'" class="success-box">
				<text class="success-title">{{ translateText('合并成功') }}</text>
				<text class="success-text">{{ translateText('可立即下载并保存到本地。') }}</text>
			</view>

			<view class="sheet-actions">
				<button class="action-button secondary" :disabled="submitting" @click="closeSheet">{{ translateText('取消') }}</button>
				<button v-if="stage === 'type'" class="action-button primary" :disabled="submitting || selectedInspectType === ''" @click="startSelection">{{ translateText('开始选择') }}</button>
				<button v-else-if="mergedPlanId === ''" class="action-button primary" :disabled="submitting || selectedItems.length < 2" @click="confirmMerge">
					{{ translateText(submitting ? '合并中...' : '确认合并') }}
				</button>
				<button v-else class="action-button primary" :disabled="submitting" @click="downloadMerged">
					{{ translateText(submitting ? '下载中...' : '下载到本地') }}
				</button>
			</view>
		</view>
		<OptionSelectSheet :visible="showTemplateSheet" title="清单模板" empty-text="暂无可选清单" :options="templateOptionRows" :selected-value="selectedTemplateId" @close="closeTemplateSheet" @confirm="confirmTemplateOption" />
	</page-container>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { firstNonEmptyText, getMergePreviewRow } from '../../domain/searchViewModel.uts'
	import { windowHeightPx } from '../../domain/nativeLayout.uts'
	import OptionSelectSheet from './OptionSelectSheet.uvue'
	import { computed, ref, watch } from 'vue'
	type MergeOption = { value: string, label: string }
	type MergePreview = { key: string, orderNo: string, itemBatch: string, productName: string }
	/** 合并类型格子：placeholder 为 true 时仅占位，保持最后一行同样三等分铺满整行。 */
	type MergeTypeCell = { value: string, label: string, placeholder: boolean }

	/** 合并类型弹层每行固定展示的列数，对齐 H5 三列等宽网格。 */
	const MERGE_TYPE_COLUMNS = 3

	const props = defineProps({
		visible: { type: Boolean, default: false },
		stage: { type: String, default: 'type' },
		inspectTypeOptions: { type: Array, default: () => [] },
		selectedInspectType: { type: String, default: '' },
		selectedItems: { type: Array, default: () => [] },
		templates: { type: Array, default: () => [] },
		selectedTemplateId: { type: String, default: '' },
		/** 页面已确定的清单名称：合并成功时由页面按计划自带清单预置，用于未在模板列表中找到同名项时回显。 */
		selectedTemplateName: { type: String, default: '' },
		mergedPlanId: { type: String, default: '' },
		submitting: { type: Boolean, default: false }
	})
	const emit = defineEmits(['close', 'update-inspect-type', 'start-selection', 'update-template', 'confirm-merge', 'download'])
	/** 为原生合并弹层提供可调用的多语言方法。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }
	/** 限制合并弹层最大高度。 */
	const sheetMaxHeight = computed((): string => windowHeightPx(0.88))
	/** 当前是否处于“确认合并以下验货数据”阶段。 */
	const confirmStage = computed((): boolean => props.stage !== 'type')
	/** 确认阶段弹层整体加高到至少 70% 窗口高，给可滚动明细区留出足够可视高度；类型阶段保持自然高度。 */
	const sheetMinHeight = computed((): string => confirmStage.value ? windowHeightPx(0.7) : '0px')
	/** 确认阶段明细区最大高度：为标题、清单模板与底部按钮预留空间后，超出的计划在明细区内纵向滚动，避免数据多时撑出屏幕却无法滑动。 */
	const confirmBodyMaxHeight = computed((): string => windowHeightPx(0.62))
	/** 类型阶段类型网格最大高度：验货类型较多或系统字号放大时在弹层内纵向滚动，避免把“开始选择”按钮顶出屏幕。 */
	const typeBodyMaxHeight = computed((): string => windowHeightPx(0.55))
	/** 将检查类型字典转换为模板可读取的选项。 */
	const displayTypes = computed((): MergeOption[] => (props.inspectTypeOptions as UTSJSONObject[]).map((raw: UTSJSONObject): MergeOption => ({ value: (raw['value'] ?? '').toString(), label: (raw['label'] ?? '').toString() })))
	/**
	 * 将验货类型切成每行 3 个的格子；末行不足时补透明占位格，保证任意行都三等分铺满整行，
	 * 不会再在右侧留下大片空白。
	 */
	const typeRows = computed((): MergeTypeCell[][] => {
		const options = displayTypes.value
		const rows: MergeTypeCell[][] = []
		const rowCount = Math.ceil(options.length / MERGE_TYPE_COLUMNS)
		for (let rowIndex = 0; rowIndex < rowCount; rowIndex++) {
			const cells: MergeTypeCell[] = []
			for (let columnIndex = 0; columnIndex < MERGE_TYPE_COLUMNS; columnIndex++) {
				const optionIndex = rowIndex * MERGE_TYPE_COLUMNS + columnIndex
				if (optionIndex < options.length) cells.push({ value: options[optionIndex].value, label: options[optionIndex].label, placeholder: false })
				else cells.push({ value: `placeholder-${rowIndex}-${columnIndex}`, label: '', placeholder: true })
			}
			rows.push(cells)
		}
		return rows
	})
	/** 从嵌套或平铺的计划对象中读取稳定 ID。 */
	function getItemId(item: UTSJSONObject): string { const plan = (item['plan'] as UTSJSONObject | null) ?? {}; return firstNonEmptyText([plan['id'], plan['planId'], item['planId'], item['id']], '') }

	/** 把清单模板转换为选择弹层可用的 UTSJSONObject 选项；raw 原样带回页面，避免自定义类型实例跨组件传递。 */
	const templateOptionRows = computed((): UTSJSONObject[] => (props.templates as UTSJSONObject[]).map((item: UTSJSONObject): UTSJSONObject => ({ value: (item['id'] ?? '').toString(), label: (item['name'] ?? '').toString(), raw: item })))
	/** 清单模板选择弹层是否可见；仅在合并成功、准备下载时由页面数据驱动打开。 */
	const showTemplateSheet = ref(false)
	/** 父层关闭合并弹层时同步收起清单选择弹层，避免内层弹层遮罩残留在空页面上。 */
	watch((): boolean => props.visible, (visible: boolean) => { if (!visible) showTemplateSheet.value = false })

	/**
	 * 按已选清单 ID 在模板列表中查找名称；模板列表未命中时返回空串。
	 */
	const templateNameFromOptions = computed((): string => { const match = (props.templates as UTSJSONObject[]).find((item: UTSJSONObject) => (item['id'] ?? '').toString() === props.selectedTemplateId); return (match?.['name'] ?? '').toString() })

	/**
	 * 返回清单选择框的展示文案：优先显示页面传入的已选清单名称（合并成功时由计划自带的模板预置），
	 * 其次按 ID 在模板列表里查找，最后提示“请选择清单”，避免下载前只看到空白框。
	 */
	const templateValueText = computed((): string => {
		if (props.selectedTemplateName != '') return props.selectedTemplateName
		const name = templateNameFromOptions.value
		return name != '' ? name : translateText('请选择清单')
	})

	/** 将已选计划转换为稳定 ID 与 H5 三列展示字段，供原生表格渲染。 */
	const previewRows = computed((): MergePreview[] => (props.selectedItems as UTSJSONObject[]).map((item: UTSJSONObject): MergePreview => { const preview = getMergePreviewRow(item) as UTSJSONObject; return { key: getItemId(item), orderNo: (preview['orderNo'] ?? '').toString(), itemBatch: (preview['itemBatch'] ?? '').toString(), productName: (preview['productName'] ?? '').toString() } }))

	/**
	 * 关闭合并弹层。
	 */
	function closeSheet() {
		emit('close')
	}

	/**
	 * 更新合并流程选中的验货类型。
	 */
	function selectInspectType(value: string) {
		emit('update-inspect-type', value)
	}

	/**
	 * 进入卡片多选合并模式。
	 */
	function startSelection() {
		emit('start-selection')
	}

	/**
	 * 打开清单模板选择弹层；合并完成前清单不可选，提交中也不允许打开。
	 */
	function openTemplatePicker(): void {
		if (props.mergedPlanId === '' || props.submitting) return
		showTemplateSheet.value = true
	}

	/**
	 * 关闭清单模板选择弹层，不改动页面已选清单。
	 */
	function closeTemplateSheet(): void { showTemplateSheet.value = false }

	/**
	 * 回传用户选中的清单模板原始对象，由页面更新下载参数后关闭选择弹层。
	 * option 为 OptionSelectSheet 的确认事件参数，raw 为原始模板对象。
	 */
	function confirmTemplateOption(option: UTSJSONObject): void {
		showTemplateSheet.value = false
		const raw = (option['raw'] as UTSJSONObject | null) ?? option
		emit('update-template', raw)
	}

	/**
	 * 提交已选计划进行远程合并。
	 */
	function confirmMerge() {
		emit('confirm-merge')
	}

	/**
	 * 下载合并成功的新计划到本地。
	 */
	function downloadMerged() {
		emit('download')
	}
</script>

<style>
	.sheet-panel { width: 100%; padding: 36rpx 32rpx 48rpx; border-top-left-radius: 40rpx; border-top-right-radius: 40rpx; background-color: #ffffff; }
	.sheet-title { color: #111827; font-size: 38rpx; font-weight: 700; }
	.section { margin-top: 30rpx; }
	.section-label { color: #334155; font-size: 28rpx; font-weight: 600; }
	.type-body { width: 100%; }
	.type-grid { margin-top: 20rpx; }
	.type-row { flex-direction: row; }
	.type-cell { flex: 1; margin-left: 10rpx; margin-right: 10rpx; margin-bottom: 16rpx; }
	.type-chip { width: 100%; height: 112rpx; border-width: 2rpx; border-style: solid; border-color: #e2e8f0; border-radius: 20rpx; background-color: #f8fafc; align-items: center; justify-content: center; padding: 0 8rpx; }
	.type-chip.placeholder { border-width: 0; background-color: transparent; }
	.type-chip.active { border-color: #34d399; background-color: #e8f7ef; }
	.type-chip-text { color: #9ca3af; font-size: 26rpx; line-height: 36rpx; text-align: center; }
	.type-chip-text.active { color: #047857; font-weight: 600; }
	.summary-text { margin-top: 24rpx; color: #166534; font-size: 28rpx; font-weight: 600; }
	.confirm-body { width: 100%; flex: 1; min-height: 0; }
	.merge-table { margin-top: 18rpx; border-width: 2rpx; border-color: #e5e7eb; border-radius: 20rpx; overflow: hidden; }
	.merge-table-header, .merge-table-row { flex-direction: row; align-items: center; }
	.merge-table-header { background-color: #f8fafc; }
	.merge-table-row { min-height: 74rpx; border-top-width: 2rpx; border-top-color: #f1f5f9; }
	.merge-table-cell { flex: 1; min-width: 0; padding: 18rpx 10rpx; color: #334155; font-size: 24rpx; line-height: 34rpx; }
	.merge-table-header-cell { color: #0f172a; font-weight: 700; }
	.empty-text { margin-top: 8rpx; color: #64748b; font-size: 24rpx; }
	.select-field { min-height: 88rpx; margin-top: 18rpx; padding: 0 24rpx; border-width: 2rpx; border-style: solid; border-color: #e5e7eb; border-radius: 16rpx; background-color: #f8fafc; flex-direction: row; align-items: center; }
	.select-label { color: #0f172a; font-size: 27rpx; font-weight: 600; }
	.select-text { flex: 1; margin-left: 16rpx; color: #334155; font-size: 27rpx; text-align: right; }
	.select-text.placeholder { color: #94a3b8; }
	.select-chevron { margin-left: 10rpx; color: #94a3b8; font-size: 34rpx; }
	.success-box { margin-top: 24rpx; padding: 22rpx; border-radius: 18rpx; background-color: #ecfdf5; }
	.success-title { color: #166534; font-size: 28rpx; font-weight: 700; }
	.success-text { margin-top: 6rpx; color: #15803d; font-size: 24rpx; }
	.sheet-actions { flex-direction: row; margin-top: 32rpx; }
	.action-button { flex: 1;  margin: 0 10rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
	.action-button.secondary { color: #334155; border-width: 2rpx; border-color: #e2e8f0; background-color: #ffffff; }
	.action-button.primary { color: #ffffff; background-color: #16a34a; }
</style>
