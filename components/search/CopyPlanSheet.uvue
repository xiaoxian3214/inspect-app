<template>
	<page-container :show="visible" position="bottom" :overlay="true" :z-index="2200" overlay-style="background-color: rgba(15, 23, 42, 0.42)" @clickoverlay="closeSheet">
		<view class="sheet-panel">
			<text class="sheet-title">{{ translateText(mode === 2 ? '复制合并验货' : '复制当前验货') }}</text>
			<scroll-view class="copy-content" direction="vertical">
				<view v-if="mode === 2" class="merged-section">
					<text class="merged-title">{{ translateText('此合并验货包含以下验货：') }}</text>
					<PlanMemberTable :items="mergedItems" :loading="mergedLoading" />
				</view>
				<view v-else class="info-card">
					<view v-for="field in infoFields" :key="field.label" class="info-row">
						<text class="info-label">{{ translateText(field.label) }}</text><text class="info-value">{{ field.value }}</text>
					</view>
				</view>

				<view class="section" @click="openOption('template')">
					<text class="section-label">{{ translateText('清单') }}</text>
					<view class="select-value"><text class="select-text">{{ selectedTemplateName !== '' ? selectedTemplateName : translateText('请选择清单') }}</text><text class="select-chevron">›</text></view>
				</view>
				<view class="section" @click="openOption('type')">
					<text class="section-label">{{ translateText('检查类型') }}</text>
					<view class="select-value"><text class="select-text">{{ selectedInspectTypeName !== '' ? selectedInspectTypeName : translateText('请选择验货类型') }}</text><text class="select-chevron">›</text></view>
				</view>
				<view v-if="created" class="success-box">
					<text class="success-title">{{ translateText('复制成功') }}</text>
					<text class="success-text">{{ translateText('新验货计划可立即下载到本地。') }}</text>
				</view>
			</scroll-view>

			<view class="sheet-actions">
				<button class="action-button secondary" :disabled="submitting" @click="closeSheet">{{ translateText('关闭') }}</button>
				<button v-if="!created" class="action-button primary" :disabled="submitting || selectedInspectType === '' || selectedTemplateId === ''" @click="confirmCopy">
					{{ translateText(submitting ? '复制中...' : '创建副本') }}
				</button>
				<button v-else class="action-button primary" :disabled="submitting" @click="downloadCopy">
					{{ translateText(submitting ? '下载中...' : '下载到本地') }}
				</button>
			</view>
		</view>
		<OptionSelectSheet :visible="activePicker !== ''" :title="pickerTitle" :empty-text="pickerEmptyText" :options="pickerOptions" :selected-value="pickerValue" @close="closeOption" @confirm="confirmOption" />
	</page-container>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed, ref } from 'vue'
	import { buildCopyPlanFields } from '../../domain/planDownloadPreview.uts'
	import PlanMemberTable from '../inspection/PlanMemberTable.uvue'
	import OptionSelectSheet from './OptionSelectSheet.uvue'
	type CopyInfoField = { label: string, value: string }

	const props = defineProps({
		visible: { type: Boolean, default: false },
		mode: { type: Number, default: 1 },
		item: { type: Object, default: () => ({}) },
		inspectTypeOptions: { type: Array, default: () => [] },
		templates: { type: Array, default: () => [] },
		mergedItems: { type: Array, default: () => [] },
		mergedLoading: { type: Boolean, default: false },
		selectedInspectType: { type: String, default: '' },
		selectedTemplateId: { type: String, default: '' },
		selectedTemplateName: { type: String, default: '' },
		created: { type: Boolean, default: false },
		submitting: { type: Boolean, default: false }
	})
	const emit = defineEmits(['close', 'update-inspect-type', 'update-template', 'confirm', 'download'])
	const activePicker = ref('')
	/** 为原生复制计划弹层提供可调用的多语言方法。 */
	function translateText(key: string): string { return t(key) }

	/** 按 H5 字段顺序返回复制当前验货的七行计划摘要。 */
	const infoFields = computed((): CopyInfoField[] => (buildCopyPlanFields(props.item) as UTSJSONObject[]).map((raw: UTSJSONObject): CopyInfoField => ({ label: (raw['label'] ?? '').toString(), value: (raw['value'] ?? '-').toString() })))

	/**
	 * 返回当前已选验货类型名称。
	 */
	const selectedInspectTypeName = computed((): string => { const match = (props.inspectTypeOptions as UTSJSONObject[]).find((item: UTSJSONObject) => (item['value'] ?? '').toString() === props.selectedInspectType); return (match?.['label'] ?? '').toString() })

	/**
	 * 返回当前已选清单模板名称。
	 */
	const selectedTemplateName = computed((): string => { const match = (props.templates as UTSJSONObject[]).find((item: UTSJSONObject) => (item['id'] ?? '').toString() === props.selectedTemplateId); return (match?.['name'] ?? props.selectedTemplateName).toString() })

	/** 将清单与检查类型转成同一种选择弹层选项；只传 UTSJSONObject 字面量，自定义类型实例跨组件传递会在 Android 原生端触发类型转换闪退。 */
	const pickerOptions = computed((): UTSJSONObject[] => activePicker.value === 'template'
		? (props.templates as UTSJSONObject[]).map((item: UTSJSONObject): UTSJSONObject => ({ value: (item['id'] ?? '').toString(), label: (item['name'] ?? '').toString(), raw: item }))
		: (props.inspectTypeOptions as UTSJSONObject[]).map((item: UTSJSONObject): UTSJSONObject => ({ value: (item['value'] ?? '').toString(), label: (item['label'] ?? '').toString(), raw: item })))

	/** 返回当前选项弹层的标题。 */
	const pickerTitle = computed(() => activePicker.value === 'template' ? '选择清单' : '检查类型')

	/** 根据选项类型展示清单或验货类型空状态。 */
	const pickerEmptyText = computed(() => activePicker.value === 'template' ? '暂无可选清单' : '暂无可选验货类型')

	/** 返回当前清单 ID 或检查类型值供选择弹层预选。 */
	const pickerValue = computed(() => activePicker.value === 'template' ? props.selectedTemplateId : props.selectedInspectType)

	/**
	 * 关闭复制弹层。
	 */
	function closeSheet() {
		activePicker.value = ''
		emit('close')
	}

	/** 点击清单或检查类型时打开原生底部选项弹层。 */
	function openOption(kind: string) { if (!props.submitting) activePicker.value = kind }

	/** 关闭选项弹层但保留复制业务已选值。 */
	function closeOption() { activePicker.value = '' }

	/** 确认选项后向页面发送对应业务事件。 */
	function confirmOption(option: UTSJSONObject) {
		if (activePicker.value === 'template') emit('update-template', option['raw'])
		else emit('update-inspect-type', option['raw'])
		closeOption()
	}

	/**
	 * 提交复制计划请求。
	 */
	function confirmCopy() {
		emit('confirm')
	}

	/**
	 * 下载复制成功的新计划到本地。
	 */
	function downloadCopy() {
		emit('download')
	}
</script>

<style>
	.sheet-panel { width: 100%; height: 85%; padding: 36rpx 32rpx 48rpx; border-top-left-radius: 40rpx; border-top-right-radius: 40rpx; background-color: #ffffff; }
	.sheet-title { color: #111827; font-size: 38rpx; font-weight: 700; }
	.copy-content { flex: 1; min-height: 0; margin-top: 22rpx; }
	.merged-section { margin-bottom: 24rpx; }
	.merged-title { margin-bottom: 18rpx; color: #334155; font-size: 27rpx; font-weight: 600; }
	.info-card { padding: 8rpx 24rpx; border-width: 2rpx; border-color: #e5e7eb; border-radius: 20rpx; }
	.info-row { flex-direction: row; justify-content: space-between; padding: 18rpx 0; border-bottom-width: 2rpx; border-bottom-color: #cbd5e1; }
	.info-label { color: #64748b; font-size: 25rpx; }
	.info-value { max-width: 440rpx; color: #0f172a; font-size: 25rpx; text-align: right; }
	.section { margin-top: 28rpx; }
	.section-label { color: #334155; font-size: 28rpx; font-weight: 600; }
	.select-value { min-height: 80rpx; margin-top: 14rpx; padding: 14rpx 24rpx; border-width: 2rpx; border-color: #d1d5db; border-radius: 16rpx; background-color: #f8fafc; flex-direction: row; align-items: center; }
	.select-text { flex: 1; color: #334155; font-size: 27rpx; }
	.select-chevron { color: #64748b; font-size: 36rpx; }
	.success-box { margin-top: 24rpx; padding: 22rpx; border-radius: 18rpx; background-color: #ecfdf5; }
	.success-title { color: #166534; font-size: 28rpx; font-weight: 700; }
	.success-text { margin-top: 6rpx; color: #15803d; font-size: 24rpx; }
	.sheet-actions { flex-direction: row; margin-top: 32rpx; }
	.action-button { flex: 1; height: 88rpx; line-height: 88rpx; margin: 0 10rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
	.action-button.secondary { color: #334155; border-width: 2rpx; border-color: #e2e8f0; background-color: #ffffff; }
	.action-button.primary { color: #ffffff; background-color: #16a34a; }
</style>
