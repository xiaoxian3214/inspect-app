<template>
	<view v-if="visible" class="sheet-overlay" @click="closeSheet">
		<view class="sheet-panel" :style="{ maxHeight: sheetMaxHeight }" @click.stop>
			<view class="sheet-header">
				<text class="sheet-title">{{ translateText('筛选') }}</text>
				<text class="clear-action" @click="clearFilters">{{ translateText('清空') }}</text>
			</view>

			<view class="section">
				<text class="section-title">{{ translateText('状态') }}</text>
				<view class="chip-list">
					<view v-for="option in displayStatusOptions" :key="option.value" class="chip" :class="{ active: filterDraft.status === option.value }" @click="selectStatus(option.value)">
						<text class="chip-text">{{ option.label }}</text>
					</view>
				</view>
			</view>

			<view class="section">
				<view class="section-heading">
					<text class="section-title">{{ translateText('验货类型') }}</text>
					<text v-if="loadingTypes" class="loading-text">{{ translateText('加载中...') }}</text>
				</view>
				<scroll-view class="type-scroll" direction="horizontal">
					<view class="chip-list nowrap">
						<view v-for="option in displayInspectTypes" :key="option.value" class="chip" :class="{ active: filterDraft.inspectType === option.value }" @click="selectInspectType(option.value)">
							<text class="chip-text">{{ option.label }}</text>
						</view>
					</view>
				</scroll-view>
			</view>

			<view class="section">
				<text class="section-title">{{ translateText('计划日期') }}</text>
				<view class="date-row">
					<picker class="date-picker" mode="date" :value="filterDraft.startDate" @change="changeStartDate">
						<view class="date-value">{{ translateText(filterDraft.startDate ?? '开始日期') }}</view>
					</picker>
					<text class="date-separator">{{ translateText('至') }}</text>
					<picker class="date-picker" mode="date" :value="filterDraft.endDate" @change="changeEndDate">
						<view class="date-value">{{ translateText(filterDraft.endDate ?? '结束日期') }}</view>
					</picker>
				</view>
			</view>

			<view class="sheet-actions">
				<button class="action-button secondary" @click="closeSheet">{{ translateText('取消') }}</button>
				<button class="action-button primary" @click="confirmFilters">{{ translateText('查看结果') }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { windowHeightPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'
	type FilterDraft = { status: string, inspectType: string, startDate: string, endDate: string }
	type FilterOption = { value: string, label: string }
	const props = defineProps({
		visible: { type: Boolean, default: false },
		draft: { type: Object, default: () => ({ status: '', inspectType: '', startDate: '', endDate: '' }) },
		statusOptions: { type: Array, default: () => [] },
		inspectTypeOptions: { type: Array, default: () => [] },
		loadingTypes: { type: Boolean, default: false }
	})
	const emit = defineEmits(['close', 'clear', 'update-status', 'update-inspect-type', 'update-start-date', 'update-end-date', 'confirm'])
	/** 为原生筛选模板提供可调用的多语言方法。 */
	function translateText(key: string): string { return t(key) }
	/** 计算筛选弹层可用的最大窗口高度。 */
	const sheetMaxHeight = computed((): string => windowHeightPx(0.88))
	/** 把父页动态筛选草稿转换为固定字段。 */
	const filterDraft = computed((): FilterDraft => { const raw = props.draft as UTSJSONObject; return { status: (raw['status'] ?? '').toString(), inspectType: (raw['inspectType'] ?? '').toString(), startDate: (raw['startDate'] ?? '').toString(), endDate: (raw['endDate'] ?? '').toString() } })
	/** 将状态筛选项转换为原生模板可读取的选项。 */
	const displayStatusOptions = computed((): FilterOption[] => (props.statusOptions as UTSJSONObject[]).map((raw: UTSJSONObject): FilterOption => ({ value: (raw['value'] ?? '').toString(), label: (raw['label'] ?? '').toString() })))
	/** 将验货类型筛选项转换为原生模板可读取的选项。 */
	const displayInspectTypes = computed((): FilterOption[] => (props.inspectTypeOptions as UTSJSONObject[]).map((raw: UTSJSONObject): FilterOption => ({ value: (raw['value'] ?? '').toString(), label: (raw['label'] ?? '').toString() })))

	/**
	 * 从 picker 事件中读取日期或选项值。
	 */
	function resolvePickerValue(event: UniPickerChangeEvent): string {
		return (event.detail.value ?? '').toString()
	}

	/**
	 * 关闭筛选弹层且不提交草稿值。
	 */
	function closeSheet() {
		emit('close')
	}

	/**
	 * 通知页面清空全部筛选草稿。
	 */
	function clearFilters() {
		emit('clear')
	}

	/**
	 * 更新草稿状态筛选值。
	 */
	function selectStatus(value: string) {
		emit('update-status', value)
	}

	/**
	 * 更新草稿验货类型筛选值。
	 */
	function selectInspectType(value: string) {
		emit('update-inspect-type', value)
	}

	/**
	 * 更新计划开始日期筛选值。
	 */
	function changeStartDate(event: UniPickerChangeEvent) {
		emit('update-start-date', resolvePickerValue(event))
	}

	/**
	 * 更新计划结束日期筛选值。
	 */
	function changeEndDate(event: UniPickerChangeEvent) {
		emit('update-end-date', resolvePickerValue(event))
	}

	/**
	 * 提交当前筛选草稿并关闭弹层。
	 */
	function confirmFilters() {
		emit('confirm')
	}
</script>

<style>
	.sheet-overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 2200; justify-content: flex-end; background-color: rgba(15, 23, 42, 0.42); }
	.sheet-panel { width: 100%; padding: 36rpx 32rpx 48rpx; border-top-left-radius: 40rpx; border-top-right-radius: 40rpx; background-color: #ffffff; }
	.sheet-header, .section-heading, .date-row, .sheet-actions { flex-direction: row; align-items: center; }
	.sheet-header, .section-heading { justify-content: space-between; }
	.sheet-title { color: #111827; font-size: 38rpx; font-weight: 700; }
	.clear-action { color: #16a34a; font-size: 28rpx; }
	.section { margin-top: 32rpx; }
	.section-title { color: #334155; font-size: 28rpx; font-weight: 600; }
	.loading-text { color: #94a3b8; font-size: 24rpx; }
	.chip-list { flex-direction: row; flex-wrap: wrap; margin-top: 20rpx; }
	.chip-list.nowrap { flex-wrap: nowrap; padding-right: 24rpx; }
	.type-scroll { width: 100%; }
	.chip { margin-right: 16rpx; margin-bottom: 16rpx; padding: 16rpx 24rpx; border-width: 2rpx; border-color: #d1d5db; border-radius: 32rpx; background-color: #ffffff; }
	.chip.active { border-color: #16a34a; background-color: #f0fdf4; }
	.chip-text { color: #475569; font-size: 26rpx; white-space: nowrap; }
	.date-row { margin-top: 20rpx; }
	.date-picker { flex: 1; }
	.date-value { height: 76rpx; padding: 0 20rpx; border-width: 2rpx; border-color: #d1d5db; border-radius: 16rpx; color: #334155; font-size: 26rpx; line-height: 76rpx; text-align: center; }
	.date-separator { margin: 0 16rpx; color: #94a3b8; font-size: 26rpx; }
	.sheet-actions { margin-top: 32rpx; }
	.action-button { flex: 1; height: 88rpx; margin: 0 10rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
	.action-button.secondary { color: #334155; border-width: 2rpx; border-color: #e2e8f0; background-color: #ffffff; }
	.action-button.primary { color: #ffffff; background-color: #16a34a; }
</style>
