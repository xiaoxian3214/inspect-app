<template>
	<page-container :show="visible" position="bottom" :overlay="true" :z-index="2200" overlay-style="background-color: rgba(15, 23, 42, 0.42)" @clickoverlay="closeSheet">
		<view class="sheet-panel" :style="{ maxHeight: sheetMaxHeight, minHeight: sheetMinHeight }">
			<text class="sheet-title">{{ translateText('拆分验货') }}</text>
			<text class="summary-text">{{ resultItems.length > 0 ? '拆分完成，可逐项下载' : `将拆分 ${previewItems.length} 条合并明细` }}</text>
			<PlanMemberTable :items="displayItems" :downloadable="resultItems.length > 0" :localized-headers="true" :downloaded-ids="downloadedIds" :submitting="submitting" @download="downloadItem" />
			<view class="sheet-actions">
				<button class="action-button secondary" :disabled="submitting" @click="closeSheet">{{ translateText('关闭') }}</button>
				<button v-if="resultItems.length === 0" class="action-button primary" :disabled="submitting || previewItems.length === 0" @click="confirmSplit">
					{{ translateText(submitting ? '拆分中...' : '确认拆分') }}
				</button>
			</view>
		</view>
	</page-container>
</template>

<script setup lang="uts">
	import { windowHeightPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { computed } from 'vue'
	import PlanMemberTable from '../inspection/PlanMemberTable.uvue'

	const props = defineProps({
		visible: { type: Boolean, default: false },
		previewItems: { type: Array, default: () => [] },
		resultItems: { type: Array, default: () => [] },
		downloadedIds: { type: Array, default: () => [] },
		submitting: { type: Boolean, default: false }
	})
	const emit = defineEmits(['close', 'confirm', 'download'])
	/** 为原生拆分弹层提供模板可调用的翻译方法。 */
	function translateText(key: string): string { return t(key) }
	/** 限制拆分确认弹层的最大高度。 */
	const sheetMaxHeight = computed((): string => windowHeightPx(0.88))
	/** 拆分弹层整体最小高度，内容少时面板也能占据约 80% 窗口，与合并确认阶段一致。 */
	const sheetMinHeight = computed((): string => windowHeightPx(0.8))

	/**
	 * 返回拆分前预览或拆分后的结果列表。
	 */
	const displayItems = computed((): UTSJSONObject[] => props.resultItems.length > 0 ? props.resultItems as UTSJSONObject[] : props.previewItems as UTSJSONObject[])

	/**
	 * 关闭拆分弹层。
	 */
	function closeSheet() {
		emit('close')
	}

	/**
	 * 提交当前合并计划的拆分请求。
	 */
	function confirmSplit() {
		emit('confirm')
	}

	/**
	 * 请求下载指定拆分结果到本地。
	 */
	function downloadItem(item: UTSJSONObject) {
		emit('download', item)
	}
</script>

<style>
	.sheet-panel { width: 100%; padding: 36rpx 32rpx 48rpx; border-top-left-radius: 40rpx; border-top-right-radius: 40rpx; background-color: #ffffff; }
	.sheet-title { color: #111827; font-size: 38rpx; font-weight: 700; }
	.summary-text { margin-top: 14rpx; color: #64748b; font-size: 26rpx; }
	.sheet-actions { flex-direction: row; margin-top: 32rpx; }
	.action-button { flex: 1; height: 88rpx; margin: 0 10rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
	.action-button.secondary { color: #334155; border-width: 2rpx; border-color: #e2e8f0; background-color: #ffffff; }
	.action-button.primary { color: #ffffff; background-color: #16a34a; }
</style>
