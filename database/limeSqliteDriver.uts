import { openDatabase, closeDatabase, executeSql, selectSql, getDatabasePath, type DatabaseOptions, type SqlOperationOptions } from '@/uni_modules/lime-sqlite'
import { DATABASE_NAME } from './schema.uts'

/** 将 lime-sqlite 错误对象转换成业务层可读错误。 */
function sqliteErrorMessage(error) { return String(error?.errMsg ?? error ?? '未知错误') }

/** 使用 lime-sqlite 打开指定数据库，并在回调完成后返回 Promise。 */
function openSqlite(name) {
  return new Promise((resolve, reject) => openDatabase({
    name,
    success: () => resolve(null),
    fail: (error) => reject(new Error(`打开 SQLite 失败：${sqliteErrorMessage(error)}`))
  } as DatabaseOptions))
}

/** 使用 lime-sqlite 批量执行 SQL，并保留插件原生事务语义。 */
function executeSqlBatch(name, statements) {
  return new Promise((resolve, reject) => executeSql({
    name,
    sql: statements,
    success: () => resolve(null),
    fail: (error) => reject(new Error(`SQLite 事务失败：${sqliteErrorMessage(error)}`))
  } as SqlOperationOptions))
}

/** 使用 lime-sqlite 查询数据，并统一提取插件返回的行数组。 */
function querySql(name, sql) {
  return new Promise((resolve, reject) => selectSql({
    name,
    sql: [sql],
    success: (result) => resolve(Array.isArray(result?.result) ? result.result : (Array.isArray(result?.data) ? result.data : [])),
    fail: (error) => reject(new Error(`SQLite 查询失败：${sqliteErrorMessage(error)}`))
  } as SqlOperationOptions))
}

/** 使用 lime-sqlite 关闭连接，数据库文件继续保留在应用私有目录。 */
function closeSqlite(name) {
  return new Promise((resolve, reject) => closeDatabase({
    name,
    success: () => resolve(null),
    fail: (error) => reject(new Error(`关闭 SQLite 失败：${sqliteErrorMessage(error)}`))
  } as DatabaseOptions))
}

/** 提供现有数据库适配器需要的驱动接口，持久层统一改用 lime-sqlite。 */
export function createLimeSqliteDriver() {
  return {
    /** 打开应用私有 SQLite 数据库。 */
    async open() { await openSqlite(DATABASE_NAME) },
    /** 查询 SQL 并返回数据库行。 */
    async query(sql) { return await querySql(DATABASE_NAME, sql) },
    /** 批量执行 schema 或业务写入。 */
    async executeBatch(statements) { if (statements.length > 0) await executeSqlBatch(DATABASE_NAME, statements) },
    /** 关闭数据库连接。 */
    async close() { await closeSqlite(DATABASE_NAME) },
    /** 返回当前插件管理的数据库文件路径，供诊断页面或日志使用。 */
    databasePath() { return String(getDatabasePath(DATABASE_NAME) ?? '') },
    /** 旧照片迁移失败时保留原路径，避免误删仍可恢复的数据记录。 */
    async persistPhoto(path) { return path }
  }
}
