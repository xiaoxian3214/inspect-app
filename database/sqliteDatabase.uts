const TABLE_KEYS = {
  user: 'userId',
  inspection_plan: 'planId',
  report: 'reportId',
  item_result: 'itemResultId',
  report_group: 'groupId',
  report_member: 'planId',
  checklist: 'itemId',
  defect: 'defectId',
  photo: 'photoId',
  camera_capture: 'captureId',
  sync_log: 'id',
  request_queue: 'id',
  schema_migration: 'version',
  app_setting: 'key'
}

const BUSINESS_TABLES = {
  inspection_plan: 'qcm_inspection_plan',
  report: 'qcm_inspection_report',
  item_result: 'qcm_inspection_item_result',
  defect: 'qcm_inspection_defect_record'
}

const LEGACY_GROUP_SCHEMA = {
  report_group: 'CREATE TABLE IF NOT EXISTS report_group (groupId TEXT PRIMARY KEY, parentPlanId TEXT, jsonData TEXT, downloadAt TEXT, status INTEGER DEFAULT 0, syncStatus TEXT, updatedAt TEXT)',
  report_member: 'CREATE TABLE IF NOT EXISTS report_member (planId TEXT PRIMARY KEY, groupId TEXT NOT NULL, jsonData TEXT, status INTEGER DEFAULT 0)',
  checklist: 'CREATE TABLE IF NOT EXISTS checklist (itemId TEXT PRIMARY KEY, sourceItemId TEXT, reportId TEXT, skuNo TEXT, qty INTEGER, checkedQty INTEGER, passQty INTEGER, defectQty INTEGER, sortNo INTEGER, jsonData TEXT, updatedAt TEXT)'
}

/** 将仓储的逻辑键映射到后端同名的 SQLite 业务表。 */
function physicalTableName(tableName) {
  return BUSINESS_TABLES[tableName] ?? tableName
}

const TABLE_COLUMNS = {
  user: ['userId', 'userName', 'token', 'refreshToken', 'role', 'expireAt', 'encryptedPassword', 'autoLogin', 'rememberPwd', 'updatedAt', 'jsonData'],
  inspection_plan: ['planId', 'parentPlanId', 'groupPlanId', 'status', 'jsonData'],
  report: ['reportId', 'planId', 'orderNo', 'productName', 'jsonData', 'downloadAt', 'lockExpireAt', 'status', 'lockStatus', 'lockerId', 'syncRetry'],
  item_result: ['itemResultId', 'planId', 'reportId', 'sonPlanId', 'jsonData'],
  report_group: ['groupId', 'parentPlanId', 'jsonData', 'downloadAt', 'status', 'syncStatus', 'updatedAt'],
  report_member: ['planId', 'groupId', 'jsonData', 'status'],
  checklist: ['itemId', 'sourceItemId', 'reportId', 'skuNo', 'qty', 'checkedQty', 'passQty', 'defectQty', 'sortNo', 'jsonData', 'updatedAt'],
  defect: ['defectId', 'sourceDefectId', 'reportId', 'itemId', 'defectType', 'desc', 'photoPaths', 'sortNo', 'jsonData', 'createAt'],
  photo: ['photoId', 'sourcePhotoId', 'defectId', 'reportId', 'localPath', 'uploadStatus', 'fileId', 'ownerType', 'ownerId', 'sortNo', 'jsonData', 'md5'],
  camera_capture: ['captureId', 'sessionId', 'localPath', 'mediaType', 'durationSeconds', 'sortNo'],
  sync_log: ['id', 'reportId', 'action', 'errorMessage', 'retryCount', 'createdAt'],
  request_queue: ['id', 'taskType', 'method', 'url', 'payload', 'headers', 'priority', 'dedupeKey', 'status', 'retryCount', 'maxRetries', 'nextRunAt', 'lastError', 'createdAt', 'updatedAt'],
  schema_migration: ['version', 'appliedAt'],
  app_setting: ['key', 'jsonData', 'updatedAt']
}

/** 从受控 schema 的 CREATE TABLE 语句建立写入列白名单，兼容新增业务字段。 */
function registerSchemaColumns(schemaSqlList) {
  schemaSqlList.forEach((sql) => {
    const definition = sql.match(/CREATE TABLE IF NOT EXISTS (\w+)\s*\(([\s\S]*?)\);/)
    if (definition == null) return
    const logicalName = Object.keys(BUSINESS_TABLES).find((name) => BUSINESS_TABLES[name] === definition[1]) ?? definition[1]
    if (TABLE_COLUMNS[logicalName] == null) return
    TABLE_COLUMNS[logicalName] = definition[2].split(',')
      .map((part) => part.trim().split(/\s+/)[0])
      .filter((name) => /^[a-zA-Z_][a-zA-Z_0-9]*$/.test(name))
  })
}

/** 深拷贝可序列化的数据库行，使页面不能直接修改事务外的数据。 */
function clone(value) {
  return JSON.parse(JSON.stringify(value))
}

/** 将标量转为 SQLite 字面量，字符串中的单引号必须转义。 */
function sqlValue(value) {
  if (value == null) return 'NULL'
  if (typeof value === 'number') return Number.isFinite(value) ? String(value) : 'NULL'
  if (typeof value === 'boolean') return value ? '1' : '0'
  return `'${String(value).replace(/'/g, "''")}'`
}

/** 为白名单表的完整行生成 upsert，禁止未知列进入 SQL。 */
function upsertSql(tableName, row) {
  const allowed = TABLE_COLUMNS[tableName]
  let source = row
  if (tableName === 'user' && Object.keys(row).some((column) => !allowed.includes(column))) {
    source = {}
    allowed.forEach((column) => { if (row[column] !== undefined) source[column] = row[column] })
    source.jsonData = JSON.stringify(row)
  }
  const columns = Object.keys(source).filter((column) => allowed.includes(column))
  if (columns.length !== Object.keys(source).length) throw new Error(`${tableName} 存在未知列`)
  if (!columns.includes(TABLE_KEYS[tableName])) throw new Error(`${tableName} 缺少主键`)
  return `INSERT OR REPLACE INTO ${physicalTableName(tableName)} (${columns.join(', ')}) VALUES (${columns.map((column) => sqlValue(source[column])).join(', ')})`
}

/** 对比事务前后行的主键与内容，仅写入实际变化的 SQLite 行。 */
function diffTable(tableName, previous, next, dirtyKeys) {
  const primaryKey = TABLE_KEYS[tableName]
  const statements: string[] = []
  const before = new Map(previous.map((row) => [String(row[primaryKey]), row]))
  const after = new Map(next.map((row) => [String(row[primaryKey]), row]))
  dirtyKeys.forEach((key) => {
    const existing = before.get(key)
    const row = after.get(key)
    if (row == null) {
      if (existing != null) statements.push(`DELETE FROM ${physicalTableName(tableName)} WHERE ${primaryKey} = ${sqlValue(key)}`)
    } else if (existing == null || JSON.stringify(existing) !== JSON.stringify(row)) {
      statements.push(upsertSql(tableName, row))
    }
  })
  return statements
}

/** 提供与现有 Repository 一致的同步读取和串行事务接口，持久层只使用 SQLite。 */
export function createSqliteDatabase(driver: any, schemaSqlList: string[], legacyStorage: any | null = null) {
  registerSchemaColumns(schemaSqlList)
  let state = null
  let opening = null
  let writeTail = Promise.resolve()

  /** 列出磁盘现存表，以便升级旧表及跳过尚不存在的历史组表。 */
  async function existingTables() {
    return new Set((await driver.query("SELECT name FROM sqlite_master WHERE type = 'table'")).map((row) => String(row.name)))
  }

  /** 从原生 SQLite 读取所有业务表，启动时仅加载一次。 */
  async function loadState() {
    const loaded = {}
    const available = await existingTables()
    for (const tableName of Object.keys(TABLE_KEYS)) {
      const physical = physicalTableName(tableName)
      loaded[tableName] = available.has(physical) ? await driver.query(`SELECT * FROM ${physical}`) : []
    }
    return loaded
  }

  /** 将旧版 uniStorage 行一次性导入 SQLite，已有的较新 SQLite 行绝不覆盖。 */
  async function migrateLegacy(loaded) {
    const legacy = legacyStorage?.read()
    if (legacy == null || typeof legacy !== 'object') return loaded
    const missingGroups = Object.keys(LEGACY_GROUP_SCHEMA).filter((name) => Array.isArray(legacy[name]) && legacy[name].length > 0)
    if (missingGroups.length > 0) await driver.executeBatch(missingGroups.map((name) => LEGACY_GROUP_SCHEMA[name]))
    const statements: string[] = []
    for (const tableName of Object.keys(TABLE_KEYS)) {
      const existing = new Set(loaded[tableName].map((row) => String(row[TABLE_KEYS[tableName]])))
      for (const row of (Array.isArray(legacy[tableName]) ? legacy[tableName] : [])) {
        const key = String(row?.[TABLE_KEYS[tableName]] ?? '')
        if (key === '' || existing.has(key)) continue
        let migratedRow = row
        if (tableName === 'photo' && row?.localPath && legacyStorage?.migratePhoto != null) {
          const durablePath = await legacyStorage.migratePhoto(row.localPath)
          if (durablePath && durablePath !== row.localPath) {
            let media = {}
            try { media = JSON.parse(row.jsonData ?? '{}') } catch (_) {}
            migratedRow = { ...row, localPath: durablePath, jsonData: JSON.stringify({ ...media, localPath: durablePath }) }
          }
        }
        statements.push(upsertSql(tableName, migratedRow))
        existing.add(key)
      }
    }
    if (statements.length > 0) await driver.executeBatch(statements)
    legacyStorage.remove()
    return statements.length > 0 ? loadState() : loaded
  }

  /** 将旧版计划前缀主键还原为 jsonData.id，保留无结果 ID 的清单占位和冲突记录。 */
  async function migrateItemResultIds(loaded) {
    const rows = loaded.item_result
    const occupied = new Set(rows.map((row) => String(row.itemResultId)))
    const statements: string[] = []
    rows.forEach((row) => {
      let item = {}
      try { item = JSON.parse(row.jsonData ?? '{}') } catch (_) {}
      const resultId = String(item?.id ?? '').trim()
      const oldId = String(row.itemResultId ?? '')
      if (resultId === '' || item?.checklistItem != null || oldId === resultId || occupied.has(resultId)) return
      statements.push(`UPDATE qcm_inspection_item_result SET itemResultId = ${sqlValue(resultId)} WHERE itemResultId = ${sqlValue(oldId)}`)
      occupied.add(resultId)
      occupied.delete(oldId)
    })
    if (statements.length === 0) return loaded
    await driver.executeBatch(statements)
    return loadState()
  }

  /** 创建原生数据库及 schema，成功完成旧数据迁移后才开放读取。 */
  async function open() {
    if (state != null) return
    if (opening != null) return opening
    opening = (async () => {
      await driver.open()
      const before = await existingTables()
      const renames = Object.keys(BUSINESS_TABLES).filter((name) => before.has(name) && !before.has(BUSINESS_TABLES[name]))
        .map((name) => `ALTER TABLE ${name} RENAME TO ${physicalTableName(name)}`)
      if (renames.length > 0) await driver.executeBatch(renames)
      await driver.executeBatch(schemaSqlList)
      for (const tableName of ['report', 'inspection_plan', 'defect']) {
        const physical = physicalTableName(tableName)
        const existing = new Set((await driver.query(`PRAGMA table_info(${physical})`)).map((column) => String(column.name)))
        const definition = schemaSqlList.find((sql) => sql.includes(`CREATE TABLE IF NOT EXISTS ${physical} (`))
        const additions = definition.slice(definition.indexOf('(') + 1, definition.lastIndexOf(')')).split(',')
          .map((part) => part.trim()).filter((part) => {
            const column = part.split(/\s+/)[0]
            return column !== '' && !existing.has(column) && !/PRIMARY KEY/i.test(part)
          })
        if (additions.length > 0) await driver.executeBatch(additions.map((part) => `ALTER TABLE ${physical} ADD COLUMN ${part}`))
      }
      const leftovers = Object.keys(BUSINESS_TABLES).filter((name) => before.has(name) && !renames.some((sql) => sql.startsWith(`ALTER TABLE ${name} `)))
      for (const name of leftovers) {
        const physical = physicalTableName(name)
        const oldColumns = new Set((await driver.query(`PRAGMA table_info(${name})`)).map((column) => String(column.name)))
        const columns = (await driver.query(`PRAGMA table_info(${physical})`)).map((column) => String(column.name)).filter((column) => oldColumns.has(column))
        await driver.executeBatch([`INSERT OR IGNORE INTO ${physical} (${columns.join(', ')}) SELECT ${columns.join(', ')} FROM ${name}`, `DROP TABLE ${name}`])
      }
      state = await migrateItemResultIds(await migrateLegacy(await loadState()))
    })().finally(() => { opening = null })
    return opening
  }

  /** 旧组数据转换成功后才删除历史表；未解决的冲突行继续保留。 */
  async function finalizeLegacyTables() {
    await open()
    await writeTail
    if (state.report_group.length > 0 || state.report_member.length > 0) return false
    const available = await existingTables()
    if (available.has('checklist') && state.checklist.length > 0) {
      const existingIds = new Set(state.item_result.map((row) => String(row.itemResultId)))
      const statements = state.checklist.map((row) => {
        const itemId = String(row.sourceItemId ?? row.itemId ?? '')
        const storageId = String(row.reportId ?? '')
        const storageKey = `${storageId}::checklist::${itemId}`
        if (existingIds.has(storageKey)) return ''
        let checklistItem = {}
        try { checklistItem = JSON.parse(row.jsonData ?? '{}') }
        catch (_) { checklistItem = { rawJson: row.jsonData } }
        const marker = { checklistItem, sortOrder: parseInt(String(row.sortNo ?? 0)) }
        return upsertSql('item_result', {
          itemResultId: storageKey, planId: storageId,
          jsonData: JSON.stringify(marker)
        })
      }).filter((statement) => statement !== '')
      if (statements.length > 0) await driver.executeBatch(statements)
      state = await loadState()
    }
    const obsolete = Object.keys(LEGACY_GROUP_SCHEMA).filter((name) => available.has(name))
    if (obsolete.length > 0) {
      await driver.executeBatch(obsolete.map((name) => `DROP TABLE ${name}`))
      obsolete.forEach((name) => { state[name] = [] })
    }
    return true
  }

  /** 构造行级 COW 事务：表数组浅复制，写入行单独复制，记录脏主键避免全表 JSON 比较。 */
  function createTransactionContext(working, changed) {
    /** 为指定表登记本次变更主键；删除后重插和 replace 同样在提交时按最终状态结算。 */
    function markDirty(tableName, row) {
      changed.get(tableName).add(String(row[TABLE_KEYS[tableName]]))
    }
    /** 首次写入时复制对应表，避免事务失败污染已提交镜像。 */
    function writable(tableName) {
      if (!(tableName in TABLE_KEYS)) throw new Error(`未知数据表: ${tableName}`)
      if (!changed.has(tableName)) {
        working[tableName] = working[tableName].slice()
        changed.set(tableName, new Set<string>())
      }
      return working[tableName]
    }
    return {
      read(tableName) {
        if (!(tableName in TABLE_KEYS)) throw new Error(`未知数据表: ${tableName}`)
        return clone(working[tableName])
      },
      /** 先筛选再复制匹配行，上传状态查询不再深拷贝全部历史照片。 */
      readWhere(tableName, predicate) {
        if (!(tableName in TABLE_KEYS)) throw new Error(`未知数据表: ${tableName}`)
        return clone(working[tableName].filter(predicate))
      },
      upsert(tableName, primaryKey, row) {
        if (TABLE_KEYS[tableName] !== primaryKey) throw new Error(`${tableName}.${primaryKey} 不是主键`)
        const table = writable(tableName)
        const value = row?.[primaryKey]
        if (value == null || String(value) === '') throw new Error(`${tableName}.${primaryKey} 不能为空`)
        const index = table.findIndex((item) => item?.[primaryKey] === value)
        if (index >= 0) table[index] = { ...table[index], ...clone(row) }
        else table.push(clone(row))
        markDirty(tableName, row)
      },
      removeWhere(tableName, predicate) {
        writable(tableName)
        working[tableName] = working[tableName].filter((row) => {
          if (!predicate(row)) return true
          markDirty(tableName, row)
          return false
        })
      },
      replace(tableName, rows) {
        writable(tableName)
        working[tableName].forEach((row) => markDirty(tableName, row))
        working[tableName] = clone(Array.isArray(rows) ? rows : [])
        working[tableName].forEach((row) => markDirty(tableName, row))
      }
    }
  }

  /** 逐笔串行执行仓库事务，仅比较被标记的主键；原生提交成功后才更新可见内存镜像。 */
  async function transaction(executor) {
    await open()
    const task = writeTail.then(async () => {
      const working = { ...state }
      const changed = new Map<string, Set<string>>()
      const result = await executor(createTransactionContext(working, changed))
      const statements: string[] = []
      changed.forEach((dirtyKeys, tableName) => statements.push(...diffTable(tableName, state[tableName], working[tableName], dirtyKeys)))
      if (statements.length > 0) await driver.executeBatch(statements)
      state = working
      return result
    })
    writeTail = task.then(() => {}, () => {})
    return task
  }

  /** 返回内存镜像的只读副本；镜像仅反映已成功写入 SQLite 的行。 */
  function readTable(tableName) {
    if (state == null) throw new Error('SQLite 尚未初始化')
    if (!(tableName in TABLE_KEYS)) throw new Error(`未知数据表: ${tableName}`)
    return clone(state[tableName])
  }

  /** 先过滤内存镜像再复制匹配结果，避免单个报告上传时复制其他报告的媒体记录。 */
  function readWhere(tableName, predicate) {
    if (state == null) throw new Error('SQLite 尚未初始化')
    if (!(tableName in TABLE_KEYS)) throw new Error(`未知数据表: ${tableName}`)
    return clone(state[tableName].filter(predicate))
  }

  /** 等待已提交写入后执行只读 SQL，供列表按需 JOIN 查询。 */
  async function query(sql) {
    await open()
    await writeTail
    return driver.query(sql)
  }

  /** 返回调试页所需的当前已提交数据表快照。 */
  function snapshot() {
    if (state == null) throw new Error('SQLite 尚未初始化')
    return clone(state)
  }

  /** 关闭原生连接，并防止旧镜像在下次打开时遮蔽数据库。 */
  async function close() {
    await writeTail
    if (driver.close != null) await driver.close()
    state = null
  }

  return { open, close, transaction, readTable, readWhere, query, snapshot, finalizeLegacyTables }
}
