export function createApiRequestQueue() {
  const pendingTasks: UTSJSONObject[] = []
  const promisesByKey = new Map<string, any>()
  const activeLanes = new Set<string>()
  let sequence = 0

  /** 读取排队任务的数字字段，避免动态值在 Kotlin 端参与算术时报类型不匹配。 */
  function taskNumber(task: UTSJSONObject, field: string): number {
    return parseFloat((task[field] ?? 0).toString())
  }

  /** 读取排队任务的文本字段，收窄为 String 以便通过 Set/Map 做通道与去重查找。 */
  function taskText(task: UTSJSONObject, field: string): string {
    return String(task[field] ?? '')
  }

  /** 按优先级和入队顺序排列等待中的请求。 */
  function sortPendingTasks() {
    pendingTasks.sort((left: UTSJSONObject, right: UTSJSONObject): number => {
      const leftPriority = taskNumber(left, 'priority')
      const rightPriority = taskNumber(right, 'priority')
      if (leftPriority !== rightPriority) return rightPriority - leftPriority
      return taskNumber(left, 'sequence') - taskNumber(right, 'sequence')
    })
  }

  /** 为每条空闲通道启动最高优先级请求，通道内部保持串行。 */
  function runNext() {
    while (pendingTasks.length > 0) {
      const index = pendingTasks.findIndex((task: UTSJSONObject): boolean => !activeLanes.has(taskText(task, 'lane')))
      if (index < 0) return
      const task = pendingTasks.splice(index, 1)[0]
      activeLanes.add(taskText(task, 'lane'))

      Promise.resolve()
        .then(() => task['execute']())
        .then(task['resolve'], task['reject'])
        .finally(() => {
          if (taskText(task, 'key') !== '') promisesByKey.delete(taskText(task, 'key'))
          activeLanes.delete(taskText(task, 'lane'))
          runNext()
        })
    }
  }

  /** 按任务键去重入队；只读与写操作可在不同通道并行。 */
  function enqueue(task) {
    if (task == null || typeof task.execute !== 'function') {
      return Promise.reject(new Error('请求任务缺少 execute 方法'))
    }

    const key = String(task.key ?? '').trim()
    if (key !== '') {
      const existing = promisesByKey.get(key)
      if (existing != null) return existing
    }

    let resolveTask
    let rejectTask
    const promise = new Promise((resolve, reject) => {
      resolveTask = resolve
      rejectTask = reject
    })
    const queueTask = {
      key,
      lane: String(task.lane ?? 'write'),
      priority: parseInt(String(task.priority ?? 0)),
      sequence,
      execute: task.execute,
      resolve: resolveTask,
      reject: rejectTask
    }
    sequence += 1

    if (key !== '') promisesByKey.set(key, promise)
    pendingTasks.push(queueTask as UTSJSONObject)
    sortPendingTasks()
    Promise.resolve().then(runNext)
    return promise
  }

  /** 返回待处理及正在执行的请求总数。 */
  function getSize() {
    return pendingTasks.length + activeLanes.size
  }

  return {
    enqueue,
    getSize
  }
}