<template>
	<view class="home-page">
		<TopSafeArea background-color="#f5f7fb" />
		<scroll-view class="home-content" scroll-y="true">
		<view class="home-header">
			<view>
				<text class="welcome">{{ t('你好，{name}', { name: displayName }) }}</text>
				<text class="subtitle">{{ t('今天也要认真完成验货任务') }}</text>
			</view>
			<view class="avatar"><text class="avatar-text">{{ avatarText }}</text></view>
		</view>
		<view class="hero-card" @click="openList('planned')">
			<text class="hero-eyebrow">OFFLINE INSPECTION</text>
			<text class="hero-title">{{ t('验货工作台') }}</text>
			<text class="hero-description">{{ t('本地优先读取，联网后自动补充远端计划') }}</text>
			<view class="hero-action"><text class="hero-action-text">{{ t('进入任务列表 →') }}</text></view>
		</view>
		<text class="section-title">{{ t('任务概览') }}</text>
		<view class="summary-grid">
			<view class="summary-card blue" @click="openList('planned')">
				<text class="summary-value">{{ counts.planned }}</text>
				<text class="summary-label">{{ t('已定计划') }}</text>
			</view>
			<view class="summary-card amber" @click="openList('progress')">
				<text class="summary-value">{{ counts.progress }}</text>
				<text class="summary-label">{{ t('进行中') }}</text>
			</view>
			<view class="summary-card green" @click="openList('report')">
				<text class="summary-value">{{ counts.report }}</text>
				<text class="summary-label">{{ t('已完成') }}</text>
			</view>
		</view>
		<view class="quick-card" @click="openList('planned')">
			<view class="quick-icon"><text class="quick-icon-text">{{ t('检') }}</text></view>
			<view class="quick-content">
				<text class="quick-title">{{ t('验货任务') }}</text>
				<text class="quick-subtitle">{{ t('查看本地与云端验货计划') }}</text>
			</view>
			<text class="quick-arrow">›</text>
		</view>
		<text class="plugin-section-title">{{ t('插件测试') }}</text>
		<view class="quick-card plugin-card" @click="openPluginTest('/pages/debug/lime-sqlite')">
			<view class="quick-icon sqlite-icon"><text class="quick-icon-text sqlite-icon-text">{{ t('库') }}</text></view>
			<view class="quick-content">
				<text class="quick-title">{{ t('lime-sqlite 插件测试') }}</text>
				<text class="quick-subtitle">{{ t('验证数据库打开、写入、查询和持久化') }}</text>
			</view>
			<text class="quick-arrow">›</text>
		</view>
		<view class="quick-card plugin-card" @click="openPluginTest('/pages/debug/xview-camera')">
			<view class="quick-icon camera-icon"><text class="quick-icon-text camera-icon-text">{{ t('相') }}</text></view>
			<view class="quick-content">
				<text class="quick-title">{{ t('xview-camera-view 插件测试') }}</text>
				<text class="quick-subtitle">{{ t('验证预览、切换镜头、拍照和录像') }}</text>
			</view>
			<text class="quick-arrow">›</text>
		</view>
		<button class="logout-button" @click="handleLogout">{{ t('退出登录') }}</button>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'
	import { computed, reactive, ref } from 'vue'
	import TopSafeArea from '../../components/common/TopSafeArea.uvue'
	import { getCurrentSession, initializeRuntime, logout, planListService } from '../../runtime/appRuntime.uts'

	const displayName = ref('验货员')
	const counts = reactive({ planned: 0, progress: 0, report: 0 })
	const avatarText = computed(() => displayName.value.length > 0 ? displayName.value.substring(0, 1) : 'Q')

	/** 页面显示时初始化运行时，并刷新当前用户与本地任务数量。 */
	onShow(async () => {
		await initializeRuntime()
		const session = getCurrentSession()
		displayName.value = (session?.realName || session?.userName) ?? '验货员'
		const localCounts = await planListService.getLocalCounts()
		counts.planned = localCounts.planned
		counts.progress = localCounts.progress
		counts.report = localCounts.report
	})

	/** 打开指定状态的验货任务列表。 */
	function openList(tabKey) { uni.navigateTo({ url: `/pages/report/list?tab=${tabKey}` }) }
	/** 打开指定插件的独立测试页面。 */
	function openPluginTest(url) { uni.navigateTo({ url }) }
	/** 清除当前登录会话并返回登录页。 */
	async function handleLogout() {
		await logout()
		uni.reLaunch({ url: '/pages/login/login' })
	}
</script>

<style>
	.home-page { flex: 1; background-color: #f5f7fb; }
	.home-content { flex: 1; }
	.home-header { flex-direction: row; align-items: center; justify-content: space-between; padding: 28px 20px 20px; }
	.welcome { color: #172033; font-size: 23px; font-weight: 700; }
	.subtitle { margin-top: 6px; color: #94a3b8; font-size: 13px; }
	.avatar { width: 48px; height: 48px; align-items: center; justify-content: center; border-radius: 24px; background-color: #dcfce7; }
	.avatar-text { color: #15803d; font-size: 19px; font-weight: 700; }
	.hero-card { margin: 4px 20px 26px; padding: 24px; border-radius: 22px; background-color: #173a2a; box-shadow: 0 12px 28px rgba(20, 83, 45, 0.2); }
	.hero-eyebrow { color: #86efac; font-size: 10px; letter-spacing: 1px; }
	.hero-title { margin-top: 12px; color: #ffffff; font-size: 26px; font-weight: 700; }
	.hero-description { margin-top: 9px; color: #bbf7d0; font-size: 13px; }
	.hero-action { margin-top: 24px; align-self: flex-start; padding: 9px 14px; border-radius: 16px; background-color: rgba(255, 255, 255, 0.12); }
	.hero-action-text { color: #ffffff; font-size: 13px; }
	.section-title { margin: 0 20px 14px; color: #334155; font-size: 16px; font-weight: 600; }
	.summary-grid { flex-direction: row; padding: 0 14px; }
	.summary-card { flex: 1; margin: 0 6px; padding: 18px 12px; border-radius: 16px; }
	.summary-card.blue { background-color: #e0edff; }
	.summary-card.amber { background-color: #fff3d6; }
	.summary-card.green { background-color: #dcfce7; }
	.summary-value { color: #172033; font-size: 26px; font-weight: 700; }
	.summary-label { margin-top: 6px; color: #64748b; font-size: 12px; }
	.quick-card { flex-direction: row; align-items: center; margin: 24px 20px 0; padding: 17px; border-radius: 16px; background-color: #ffffff; }
	.quick-icon { width: 42px; height: 42px; align-items: center; justify-content: center; border-radius: 13px; background-color: #dcfce7; }
	.quick-icon-text { color: #15803d; font-weight: 700; }
	.quick-content { flex: 1; margin-left: 13px; }
	.quick-title { color: #1e293b; font-size: 15px; font-weight: 600; }
	.quick-subtitle { margin-top: 4px; color: #94a3b8; font-size: 12px; }
	.quick-arrow { color: #94a3b8; font-size: 28px; }
	.plugin-section-title { margin: 28px 20px 0; color: #334155; font-size: 16px; font-weight: 600; }
	.plugin-card { margin-top: 12px; }
	.sqlite-icon { background-color: #dbeafe; }
	.sqlite-icon-text { color: #2563eb; }
	.camera-icon { background-color: #f3e8ff; }
	.camera-icon-text { color: #9333ea; }
	.logout-button { margin: 24px 20px 36px; color: #64748b; background-color: #ffffff; border-radius: 12px; }
</style>
