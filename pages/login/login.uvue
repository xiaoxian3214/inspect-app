<template>
	<view class="page">
		<view class="brand">
			<text class="brand-title">{{ t('验货系统') }}</text>
			<text class="brand-sub">Inspection Workspace</text>
		</view>

		<view v-if="booting" class="boot-screen">
			<text class="boot-title">{{ t('验货系统') }}</text>
			<text class="boot-sub">{{ t('正在准备登录环境，请稍候') }}</text>
			<view class="boot-dots">
				<text class="dot dot-1"></text>
				<text class="dot dot-2"></text>
				<text class="dot dot-3"></text>
			</view>
		</view>

		<view v-else class="card">
			<view class="form-item">
				<text class="label">{{ t('用户名') }}</text>
				<input :value="userName" class="input" :placeholder="t('请输入用户名')" @input="handleUserNameInput" @change="handleUserNameInput" />
			</view>

			<view class="form-item">
				<text class="label">{{ t('密码') }}</text>
				<input
					:value="password"
					class="input"
					type="password"
					:password="true"
					:placeholder="t('请输入密码')"
					@input="handlePasswordInput"
					@change="handlePasswordInput"
					@confirm="doLogin"
				/>
			</view>

			<view class="option-row">
				<view class="check" @click="toggleRememberPwd">
					<checkbox :checked="rememberPwd" color="#00b050" />
					<text>{{ t('记住密码') }}</text>
				</view>
			</view>

			<view class="link-row">
				<text class="link" @click="handleForgetPwd">{{ t('忘记密码？') }}</text>
			</view>

			<text v-if="errorMessage !== ''" class="error-text">{{ errorMessage }}</text>

			<button class="login-btn" :disabled="loading" @click="doLogin">
				{{ t(loading ? '登录中...' : '登录') }}
			</button>
			<view class="locale-switch">
				<text v-for="language in supportedLocales" :key="language.code" class="locale-option" :class="{ selected: currentLocale === language.code }" @click="changeLanguage(language.code)">{{ language.label }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { onMounted, ref } from 'vue'
	import TopSafeArea from '../../components/common/TopSafeArea.uvue'
	import { applyLocale, currentLocale, t } from '../../i18n/index.uts'
	import { getAppSetting, initializeRuntime, login, setAppSetting } from '../../runtime/appRuntime.uts'

	const LOGIN_PREFS_KEY = 'login_prefs_v1'
	const supportedLocales = [{ code: 'zh', label: '中文' }, { code: 'en', label: 'English' }, { code: 'vi', label: 'Tiếng Việt' }]
	const userName = ref('')
	const password = ref('')
	const rememberPwd = ref(true)
	const loading = ref(false)
	const booting = ref(true)
	const errorMessage = ref('')

	/** 保存登录页选择的语言，使无登录会话时也能切换界面和后续 API 语言。 */
	async function changeLanguage(languageCode) {
		try {
			await setAppSetting('qcm_language', languageCode)
			applyLocale(languageCode)
		} catch (error) { errorMessage.value = error?.message ?? t('语言保存失败') }
	}

	/** 将记住密码设置写入 SQLite，失败时由调用者展示错误。 */
	async function saveLoginPrefs() {
		await setAppSetting(LOGIN_PREFS_KEY, {
			userName: userName.value ?? '',
			password: rememberPwd.value ? (password.value ?? '') : '',
			rememberPwd: rememberPwd.value
		})
	}

	/** 从已初始化的 SQLite 设置表还原用户名及用户选择保留的密码。 */
	function restoreLoginPrefs() {
		const raw = getAppSetting(LOGIN_PREFS_KEY)
		if (!raw || typeof raw !== 'object') return
		userName.value = String(raw.userName ?? '')
		rememberPwd.value = raw.rememberPwd !== false
		password.value = rememberPwd.value ? String(raw.password ?? '') : ''
	}

	/** 切换记住密码偏好，并在 SQLite 提交失败时提示用户。 */
	async function toggleRememberPwd() {
		rememberPwd.value = !rememberPwd.value
		if (!rememberPwd.value) password.value = ''
		try { await saveLoginPrefs() } catch (error) { errorMessage.value = error?.message ?? t('登录偏好保存失败') }
	}

	/** 从 uni-app 输入事件读取文字，兼容 detail 和 target 两种事件载荷。 */
	function resolveInputValue(event) {
		const detailValue = event?.detail?.value
		if (detailValue !== undefined && detailValue !== null) return String(detailValue)
		const targetValue = event?.target?.value
		if (targetValue !== undefined && targetValue !== null) return String(targetValue)
		return ''
	}

	/** 更新用户名输入值。 */
	function handleUserNameInput(event) {
		userName.value = resolveInputValue(event)
	}

	/** 更新密码输入值。 */
	function handlePasswordInput(event) {
		password.value = resolveInputValue(event)
	}

	/** 告知用户找回密码尚未开放。 */
	function handleForgetPwd() {
		uni.showToast({ title: t('忘记密码功能待接入'), icon: 'none' })
	}

	/** 验证输入并登录，成功后进入任务列表。 */
	async function doLogin() {
		const currentUserName = String(userName.value ?? '').trim()
		const currentPassword = String(password.value ?? '')
		if (currentUserName === '' || currentPassword === '') {
			errorMessage.value = t('请输入用户名和密码')
			return
		}

		loading.value = true
		errorMessage.value = ''
		try {
			await login({
				userName: currentUserName,
				password: currentPassword,
				rememberPwd: rememberPwd.value,
				autoLogin: true
			})
			await saveLoginPrefs()
			uni.reLaunch({ url: '/pages/report/list?tab=planned' })
		} catch (error) {
			errorMessage.value = error?.message ?? t('登录失败，请检查用户名和密码')
		} finally {
			loading.value = false
		}
	}

	onMounted(async () => {
		try {
			await initializeRuntime()
			applyLocale(getAppSetting('qcm_language') ?? 'zh')
			restoreLoginPrefs()
		} catch (error) {
			errorMessage.value = error?.message ?? t('初始化登录环境失败')
		} finally {
			booting.value = false
		}
	})
</script>

<style>
	.page {
		flex: 1;
		background-color: #00b050;
		padding: 80px 36px 40px;
	}

	.brand {
		align-items: center;
		margin-bottom: 40px;
	}

	.brand-title {
		color: #ffffff;
		font-size: 42px;
		font-weight: 700;
	}

	.brand-sub {
		margin-top: 8px;
		color: rgba(255, 255, 255, 0.88);
		font-size: 14px;
	}

	.card {
		background-color: #ffffff;
		border-radius: 24px;
		padding: 28px;
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.14);
	}

	.boot-screen {
		min-height: 220px;
		align-items: center;
		justify-content: center;
	}

	.boot-title {
		color: #ffffff;
		font-size: 22px;
		font-weight: 600;
	}

	.boot-sub {
		margin-top: 8px;
		color: rgba(255, 255, 255, 0.82);
		font-size: 14px;
	}

	.boot-dots {
		flex-direction: row;
		margin-top: 18px;
	}

	.dot {
		width: 8px;
		height: 8px;
		margin: 0 5px;
		border-radius: 4px;
		background-color: rgba(255, 255, 255, 0.4);
	}

	.dot-1 { opacity: 0.6; }
	.dot-2 { opacity: 0.85; }
	.dot-3 { opacity: 1; }

	.form-item {
		margin-bottom: 18px;
	}

	.label {
		margin-bottom: 10px;
		color: #666666;
		font-size: 14px;
	}

	.input {
		width: 100%;
		height: 50px;
		padding: 0 16px;
		border-width: 1px;
		border-color: #e5e7eb;
		border-radius: 14px;
		font-size: 16px;
		color: #172033;
		background-color: #ffffff;
		box-sizing: border-box;
	}

	.option-row {
		flex-direction: row;
		justify-content: space-between;
		margin: 12px 0 8px;
	}

	.check {
		flex-direction: row;
		align-items: center;
		color: #64748b;
		font-size: 14px;
	}

	.link-row {
		align-items: flex-end;
		margin-bottom: 10px;
	}

	.link {
		color: #00a450;
		font-size: 14px;
	}

	.error-text {
		margin-bottom: 12px;
		color: #dc2626;
		font-size: 13px;
	}

	.login-btn {
		height: 48px;
		color: #ffffff;
		background-color: #00b050;
		border-radius: 24px;
		font-size: 16px;
		font-weight: 600;
	}

	.locale-switch { flex-direction: row; justify-content: center; margin-top: 20px; }
	.locale-option { padding: 8px; color: #64748b; font-size: 13px; }
	.locale-option.selected { color: #008f41; font-weight: 700; }
</style>
