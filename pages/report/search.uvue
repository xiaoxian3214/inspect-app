<template>
	<view class="page">
		<view class="sticky-top-area">
			<TopSafeArea background-color="#ffffff" />
			<view class="header">
				<text class="back-btn" @click="goBack">←</text>
				<input :value="keyword" class="search-input" type="text" confirm-type="search" :placeholder="translateText('请输入单号，货号或扫描条码')" @input="handleKeywordInput" @change="handleKeywordInput" @confirm="doSearch" />
				<view class="scan-icon" @click="scanBarcode"><AppIcon type="scan" :size="24" color="#334155" /></view>
			</view>
			<view class="search-button-container">
				<button class="search-btn" :disabled="keyword.trim() === '' || searching" @click="doSearch">{{ translateText(searching ? '搜索中...' : '搜索') }}</button>
			</view>
			<view class="result-toolbar">
				<view class="result-toolbar-left"><text class="result-title">{{ translateText('搜索结果') }}</text><view class="result-divider"></view></view>
				<view class="toolbar-btn" @click="openFilterModal"><text class="toolbar-btn-text">{{ translateText('筛选') }}</text></view>
			</view>
		</view>

		<scroll-view class="content" direction="vertical">
			<view v-if="searching" class="loading">{{ translateText('搜索中...') }}</view>
			<view v-else-if="errorMessage !== '' && results.length === 0" class="empty"><text class="empty-icon">!</text><text class="empty-text">{{ translateText(errorMessage) }}</text></view>
			<view v-else-if="results.length === 0 && searched" class="empty"><text class="empty-icon">{{ translateText('查') }}</text><text class="empty-text">{{ translateText('未找到相关计划') }}</text></view>
			<view v-else-if="results.length > 0" class="results">
				<view v-for="group in groupedResults" :key="group.groupKey" class="plan-group">
					<view class="order-header">
						<text class="order-no">{{ group.clientOrderNo }}</text>
						<view v-if="mergeMode" class="group-select-all" :class="{ selected: isGroupAllSelected(group), disabled: !canGroupSelectAll(group) }" @click.stop="toggleGroupSelectAll(group)">
							<view v-if="!canGroupSelectAll(group)" class="group-disabled-mark">—</view>
							<view v-else class="group-checkbox" :class="{ checked: isGroupAllSelected(group) }">
								<text v-if="isGroupAllSelected(group)" class="group-check-mark">✓</text>
							</view>
						</view>
					</view>
					<view class="supplier-row"><text class="supplier-name">{{ group.supplierName }}</text><text class="order-date">{{ formatDate(group.orderDate) }}</text></view>
					<InspectionPlanCard
						v-for="item in group.items"
						:key="getPlanUniqueId(item)"
						:item="item"
						:show-download="true"
						:current-user-id="currentUserId"
						:status-key="resolveStatusKey(item)"
						:is-local-downloaded="isLocalDownloaded(item)"
						:use-internal-actions="true"
						:manage-actions-in-card="true"
						:use-internal-card-click="true"
						:delegate-remote-actions="true"
						:show-action-split="isSplitAvailable(item)"
						:selection-mode="mergeMode"
						:selection-checked="isMergeChecked(item)"
						:selection-disabled="mergeMode && !isMergeSelectableItem(item)"
						@merge-toggle="toggleMergeSelect"
						@action-unlock="handleUnlock"
						@action-reset="handleReset"
						@action-copy="openCopyCurrent"
						@action-copy-merged="openCopyMerged"
						@action-split="openSplitPreview"
						@request-refresh="handleCardRefresh"
					/>
				</view>
			</view>
			<view v-else class="hints">
				<text class="hint-title">{{ translateText('搜索提示') }}</text>
				<view class="hint-list"><text class="hint-item">{{ translateText('• 输入订单号、合同号、货号') }}</text><text class="hint-item">{{ translateText('• 支持扫码和模糊匹配') }}</text><text class="hint-item">{{ translateText('• 下载后计划将保存到本地离线列表') }}</text></view>
			</view>
			<view v-if="results.length > 0 && !searching && searchTotal > 0" class="search-pagination-bar">
				<text class="pagination-info">{{ translateText('第 {page} / {pages} 页，共 {total} 条', { page: searchPage, pages: totalSearchPages, total: searchTotal }) }}</text>
				<view v-if="searchTotal > searchPageSize" class="pagination-actions">
					<button class="page-nav-btn" :disabled="loadingMoreResults || searchPage <= 1" @click="loadPrevResults">{{ translateText('上一页') }}</button>
					<button class="page-nav-btn" :disabled="loadingMoreResults || searchPage >= totalSearchPages" @click="loadNextResults">{{ translateText(loadingMoreResults ? '加载中...' : '下一页') }}</button>
				</view>
				<button v-else class="load-more-btn" :disabled="true">{{ translateText('已全部加载') }}</button>
			</view>
			<view class="content-space" :class="{ 'merge-space': mergeMode }"></view>
		</scroll-view>
		<view v-if="mergeMode" class="merge-action-bar">
			<button class="merge-action-btn cancel" @click="cancelMergeMode">{{ translateText('取消') }}</button>
			<button class="merge-action-btn confirm" :class="{ disabled: mergeSelectedItems.length < 2 || operationSubmitting }" :disabled="mergeSelectedItems.length < 2 || operationSubmitting" @click="openMergeConfirm">{{ translateText('合并验货') }}（{{ mergeSelectedItems.length }}）</button>
		</view>
		<view v-if="results.length > 0 && !searching && !mergeMode" class="fab" @click="showActionMenu">
			<AppIcon type="plus" :size="32" color="#ffffff" />
		</view>
		<BottomActionSheet :visible="showMenu" :actions="searchFabActions" :show-icons="true" @select="handleFabAction" @cancel="hideActionMenu" />

		<SearchFilterSheet :visible="showFilterModal" :draft="draftFilters" :status-options="filterStatusOptions" :inspect-type-options="filterInspectTypeOptions" :loading-types="optionsLoading" @close="closeFilterModal" @clear="clearDraftFilters" @update-status="updateDraftStatus" @update-inspect-type="updateDraftInspectType" @update-start-date="updateDraftStartDate" @update-end-date="updateDraftEndDate" @confirm="applyFilters" />
		<MergePlanSheet :visible="showMergeSheet" :stage="mergeSheetStage" :inspect-type-options="inspectTypeOptions" :selected-inspect-type="mergeInspectType" :selected-items="mergeSelectedItems" :templates="templateOptions" :selected-template-id="mergeTemplateId" :merged-plan-id="mergedPlanId" :submitting="operationSubmitting" @close="closeMergeSheet" @update-inspect-type="setMergeInspectType" @start-selection="startMergeSelection" @update-template="setMergeTemplate" @confirm-merge="confirmMerge" @download="downloadMergedPlan" />
		<SplitPlanSheet :visible="showSplitSheet" :preview-items="splitPreviewItems" :result-items="splitResultItems" :downloaded-ids="splitDownloadedIds" :submitting="operationSubmitting" @close="closeSplitSheet" @confirm="confirmSplit" @download="downloadSplitItem" />
		<CopyPlanSheet :visible="showCopySheet" :mode="copyMode" :item="copyTarget" :inspect-type-options="inspectTypeOptions" :templates="templateOptions" :merged-items="copyMergedItems" :merged-loading="copyMergedLoading" :selected-inspect-type="copyInspectType" :selected-template-id="copyTemplateId" :selected-template-name="copyTemplateName" :created="copyCreated" :submitting="operationSubmitting" @close="closeCopySheet" @update-inspect-type="setCopyInspectType" @update-template="setCopyTemplate" @confirm="confirmCopy" @download="downloadCopiedPlan" />
	</view>
</template>

<script setup lang="uts">
	import { t } from '../../i18n/index.uts'

	/** 为 Android 原生模板提供可调用的翻译方法，保留占位符参数。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }
	import { computed, onMounted, ref } from 'vue'
	import { onLoad } from '@dcloudio/uni-app'
	import InspectionPlanCard from '../../components/inspection/InspectionPlanCard.uvue'
	import BottomActionSheet from '../../components/common/BottomActionSheet.uvue'
	import TopSafeArea from '../../components/common/TopSafeArea.uvue'
	import SearchFilterSheet from '../../components/search/SearchFilterSheet.uvue'
	import MergePlanSheet from '../../components/search/MergePlanSheet.uvue'
	import SplitPlanSheet from '../../components/search/SplitPlanSheet.uvue'
	import CopyPlanSheet from '../../components/search/CopyPlanSheet.uvue'
	import AppIcon from '../../components/icons/AppIcon.uvue'
	import { getPlanUniqueId, groupPlans, normalizePlanStatus } from '../../domain/planViewModel.uts'
	import { buildSearchParams, buildSplitPreview, extractCopiedPlanId, getMergeGroupTargets, getMergedPlanId, getItemInspectType, getItemParentPlanId, getPlanOperationId, isBaseMergeEligible, isMergeSelectable, isSplitAvailable, markMergedSourcePlans, markReleasedGroupPlans, markSplitSourcePlans, mergeRemoteWithLocal } from '../../domain/searchViewModel.uts'
	import { getCurrentSession, initializeRuntime, isNetworkOnline, planApi, planOperationService, reportRepository } from '../../runtime/appRuntime.uts'

	/** 按客户订单号聚合后的计划分组；items 与 raw 都保留原始计划对象，供卡片与合并流程继续使用。 */
	type PlanGroup = { groupKey: string, clientOrderNo: string, supplierName: string, orderDate: string, items: UTSJSONObject[], raw: UTSJSONObject }

	const keyword = ref('')
	const results = ref<UTSJSONObject[]>([])
	const localPlans = ref<UTSJSONObject[]>([])
	const currentUserId = ref('')
	const searching = ref(false)
	const loadingMoreResults = ref(false)
	const searched = ref(false)
	const errorMessage = ref('')
	const autoScanRequested = ref(false)
	const searchPage = ref(1)
	const searchPageSize = 100
	const searchTotal = ref(0)
	const showFilterModal = ref(false)
	const showMenu = ref(false)
	const searchFabActions: UTSJSONObject[] = [{ key: 'merge', label: '合并验货', icon: 'merge' }]
	const optionsLoading = ref(false)
	const inspectTypeOptions = ref<UTSJSONObject[]>([])
	const templateOptions = ref<UTSJSONObject[]>([])
	const activeFilters = ref<UTSJSONObject>({ status: '', inspectType: '', startDate: '', endDate: '' })
	const draftFilters = ref<UTSJSONObject>({ status: '', inspectType: '', startDate: '', endDate: '' })
	const mergeMode = ref(false)
	const showMergeSheet = ref(false)
	const mergeSheetStage = ref('type')
	const mergeInspectType = ref('')
	const mergeSelectedItems = ref<UTSJSONObject[]>([])
	const mergeTemplateId = ref('')
	const mergeTemplateName = ref('')
	const mergedPlanId = ref('')
	const showSplitSheet = ref(false)
	const splitTargetPlanId = ref('')
	const splitPreviewItems = ref<UTSJSONObject[]>([])
	const splitResultItems = ref<UTSJSONObject[]>([])
	const splitDownloadedIds = ref<string[]>([])
	const showCopySheet = ref(false)
	const copyTarget = ref<UTSJSONObject>({})
	const copyMode = ref(1)
	const copyMergedItems = ref<UTSJSONObject[]>([])
	const copyMergedLoading = ref(false)
	const copyInspectType = ref('')
	const copyTemplateId = ref('')
	const copyTemplateName = ref('')
	const copyCreated = ref(false)
	const copiedPlanId = ref('')
	const operationSubmitting = ref(false)

	/** 打开右下角悬浮按钮的合并验货操作菜单。 */
	function showActionMenu(): void { showMenu.value = true }
	/** 关闭悬浮操作菜单。 */
	function hideActionMenu(): void { showMenu.value = false }
	/** 从悬浮菜单选择合并验货后进入类型选择流程。 */
	function handleFabAction(action: UTSJSONObject): void {
		hideActionMenu()
		if ((action['key'] ?? '').toString() === 'merge') openMergeFlow()
	}

	/** 返回搜索筛选支持的 H5 状态选项。 */
	const filterStatusOptions = computed((): UTSJSONObject[] => [{ value: '', label: '全部' }, { value: 'planned', label: '已定计划' }, { value: 'progress', label: '进行中' }, { value: 'report', label: '报告' }])
	/** 返回包含“全部”的验货类型筛选选项。 */
	const filterInspectTypeOptions = computed((): UTSJSONObject[] => [{ value: '', label: '全部' }, ...inspectTypeOptions.value])
	/** 按订单和供应商对当前页搜索结果分组，并收窄为原生模板可直接读取的字段。 */
	const groupedResults = computed((): PlanGroup[] => (groupPlans(results.value) as UTSJSONObject[]).map((group: UTSJSONObject): PlanGroup => ({ groupKey: (group['groupKey'] ?? '').toString(), clientOrderNo: (group['clientOrderNo'] ?? '').toString(), supplierName: (group['supplierName'] ?? '-').toString(), orderDate: (group['orderDate'] ?? '').toString(), items: (group['items'] as UTSJSONObject[] | null) ?? [], raw: group })))
	/** 返回当前搜索结果的总页数。 */
	const totalSearchPages = computed((): number => Math.max(1, Math.ceil(searchTotal.value / searchPageSize)))

	/** 从 uni-app 输入事件中提取文本值，兼容 detail.value 与 target.value 两种结构。 */
	function resolveInputValue(event: UniInputEvent): string {
		const detailValue = event.detail?.value
		if (detailValue !== undefined && detailValue !== null) return detailValue.toString()
		const targetValue = (event.target as UniInputElement | null)?.value
		return targetValue !== undefined && targetValue !== null ? targetValue.toString() : ''
	}

	/** 更新搜索关键字。 */
	function handleKeywordInput(event: UniInputEvent): void { keyword.value = resolveInputValue(event) }

	/** 加载本地计划和当前登录用户信息。 */
	async function loadLocalPlans(): Promise<void> {
		localPlans.value = (await reportRepository.listPlans()) as UTSJSONObject[]
		const session = getCurrentSession()
		currentUserId.value = (session?.userId ?? '').toString()
	}

	/** 使用本地完整记录覆盖当前页同 ID 的远程记录。 */
	async function refreshLocalOverlay(): Promise<void> {
		await loadLocalPlans()
		results.value = mergeRemoteWithLocal(results.value, localPlans.value) as UTSJSONObject[]
	}

	/** 懒加载验货类型字典，失败时退回当前搜索结果中的类型。 */
	async function loadInspectTypeOptions(): Promise<void> {
		if (inspectTypeOptions.value.length > 0 || optionsLoading.value) return
		optionsLoading.value = true
		try {
			inspectTypeOptions.value = (await planApi.getInspectTypeDict()) as UTSJSONObject[]
		} catch (error) {
			const values = Array.from(new Set<string>(results.value.map((item: UTSJSONObject): string => (getItemInspectType(item) ?? '').toString()).filter((value: string): boolean => value !== '')))
			inspectTypeOptions.value = values.map((value: string, index: number): UTSJSONObject => ({ value, label: value, sortOrder: index + 1 }))
		} finally { optionsLoading.value = false }
	}

	/** 懒加载复制和下载流程使用的清单模板。 */
	async function loadTemplateOptions(): Promise<void> {
		if (templateOptions.value.length === 0) templateOptions.value = (await planApi.getPlanTemplates()) as UTSJSONObject[]
	}

	/** 执行指定页搜索并让本地计划完整覆盖同 ID 远程计划。 */
	async function performSearch(page: number, paging: boolean = false): Promise<void> {
		if (keyword.value.trim() === '') return
		errorMessage.value = ''
		if (paging) loadingMoreResults.value = true
		else searching.value = true
		try {
			await initializeRuntime()
			await loadLocalPlans()
			const response = await planApi.searchPlans(buildSearchParams(keyword.value, activeFilters.value), page, searchPageSize)
			results.value = mergeRemoteWithLocal(response?.records ?? [], localPlans.value) as UTSJSONObject[]
			searchPage.value = page
			searchTotal.value = parseInt((response?.total ?? results.value.length).toString())
			searched.value = true
		} catch (error) {
			errorMessage.value = (error?.message ?? t('查询失败，请检查网络')).toString()
			if (!paging) results.value = []
		} finally { searching.value = false; loadingMoreResults.value = false }
	}

	/** 从第一页执行搜索。 */
	async function doSearch(): Promise<void> { await performSearch(1, false) }
	/** 加载搜索结果上一页并替换当前页。 */
	async function loadPrevResults(): Promise<void> { if (searchPage.value > 1) await performSearch(searchPage.value - 1, true) }
	/** 加载搜索结果下一页并替换当前页。 */
	async function loadNextResults(): Promise<void> { if (searchPage.value < totalSearchPages.value) await performSearch(searchPage.value + 1, true) }
	/** 判断搜索结果是否已完整保存到本地数据库。 */
	function isLocalDownloaded(item: UTSJSONObject): boolean { const id = getPlanOperationId(item); return id !== '' && localPlans.value.some((plan: UTSJSONObject): boolean => getPlanOperationId(plan) === id) }
	/** 将计划日期格式化为年月日。 */
	function formatDate(value: string): string { return value.length >= 10 ? value.substring(0, 10) : value }
	/** 将计划状态转换为卡片菜单使用的状态键。 */
	function resolveStatusKey(item: UTSJSONObject): string { const status = normalizePlanStatus(item); return status === 0 ? 'planned' : ((status === 1 || status === 2) ? 'progress' : 'report') }

	/** 调用原生扫码，成功后自动填充关键字并搜索。 */
	function scanBarcode(): void { uni.scanCode({ scanType: ['barCode', 'qrCode'], success: handleScanSuccess, fail: handleScanFailure }) }
	/** 处理扫码成功结果并自动查询匹配计划。 */
	async function handleScanSuccess(result: ScanCodeSuccess): Promise<void> { keyword.value = (result.result ?? '').toString().trim(); if (keyword.value !== '') await doSearch() }
	/** 忽略用户主动取消，其余扫码失败显示明确提示。 */
	function handleScanFailure(error: ScanCodeFail): void { if (!JSON.stringify(error).toLowerCase().includes('cancel')) uni.showToast({ title: t('扫码失败，请重试'), icon: 'none' }) }

	/** 打开筛选弹层并复制当前已应用筛选值。 */
	async function openFilterModal(): Promise<void> { draftFilters.value = { ...activeFilters.value }; showFilterModal.value = true; await loadInspectTypeOptions() }
	/** 关闭筛选弹层。 */
	function closeFilterModal(): void { showFilterModal.value = false }
	/** 清空全部筛选草稿值。 */
	function clearDraftFilters(): void { draftFilters.value = { status: '', inspectType: '', startDate: '', endDate: '' } }
	/** 更新筛选草稿中的状态值。 */
	function updateDraftStatus(value: string): void { draftFilters.value = { ...draftFilters.value, status: value } }
	/** 更新筛选草稿中的验货类型值。 */
	function updateDraftInspectType(value: string): void { draftFilters.value = { ...draftFilters.value, inspectType: value } }
	/** 更新筛选草稿中的开始日期。 */
	function updateDraftStartDate(value: string): void { draftFilters.value = { ...draftFilters.value, startDate: value } }
	/** 更新筛选草稿中的结束日期。 */
	function updateDraftEndDate(value: string): void { draftFilters.value = { ...draftFilters.value, endDate: value } }
	/** 校验日期范围后应用筛选并重新请求第一页。 */
	async function applyFilters(): Promise<void> {
		if (draftFilters.value.startDate !== '' && draftFilters.value.endDate !== '' && draftFilters.value.startDate > draftFilters.value.endDate) { uni.showToast({ title: t('开始日期不能晚于结束日期'), icon: 'none' }); return }
		activeFilters.value = { ...draftFilters.value }
		closeFilterModal()
		if (searched.value && keyword.value.trim() !== '') await performSearch(1, false)
	}

	/** 加载验货类型并打开合并类型选择弹层。 */
	async function openMergeFlow(): Promise<void> {
		try {
			await loadInspectTypeOptions()
			if (mergeInspectType.value === '' && inspectTypeOptions.value.length > 0) mergeInspectType.value = (inspectTypeOptions.value[inspectTypeOptions.value.length - 1]['value'] ?? '').toString()
			mergeSheetStage.value = 'type'; showMergeSheet.value = true
		} catch (error) { uni.showToast({ title: (error?.message ?? t('加载验货类型失败')).toString(), icon: 'none' }) }
	}
	/** 更新合并流程选择的验货类型。 */
	function setMergeInspectType(value: string): void { mergeInspectType.value = value }
	/** 关闭合并弹层但保留当前多选模式。 */
	function closeMergeSheet(): void { showMergeSheet.value = false }
	/** 进入卡片多选模式并清空上一次选择结果。 */
	function startMergeSelection(): void { if (mergeInspectType.value !== '') { mergeSelectedItems.value = []; mergedPlanId.value = ''; mergeMode.value = true; showMergeSheet.value = false } }
	/** 返回当前合并选择中的首条计划作为兼容性锚点。 */
	function getMergeAnchorItem(): UTSJSONObject | null { return mergeSelectedItems.value.length > 0 ? mergeSelectedItems.value[0] : null }
	/** 判断计划是否已在合并选择列表中。 */
	function isMergeChecked(item: UTSJSONObject): boolean { const id = getPlanOperationId(item); return mergeSelectedItems.value.some((selected: UTSJSONObject): boolean => getPlanOperationId(selected) === id) }
	/** 判断计划是否满足当前合并类型和首条计划的兼容性规则。 */
	function isMergeSelectableItem(item: UTSJSONObject): boolean { return isMergeChecked(item) || isMergeSelectable(item, mergeInspectType.value, getMergeAnchorItem()) }
	/** 返回订单组内与合并锚点兼容的最大可选集合。 */
	function getGroupTargetItems(group: PlanGroup): UTSJSONObject[] { return getMergeGroupTargets(group.raw, mergeInspectType.value, mergeSelectedItems.value) as UTSJSONObject[] }
	/** 判断订单组是否存在可全选任务。 */
	function canGroupSelectAll(group: PlanGroup): boolean { return getGroupTargetItems(group).length > 0 }
	/** 判断当前订单组兼容任务是否均已选中。 */
	function isGroupAllSelected(group: PlanGroup): boolean {
		const targets = getGroupTargetItems(group)
		return targets.length > 0 && targets.every((item: UTSJSONObject): boolean => isMergeChecked(item))
	}
	/** 全选或取消订单组内兼容任务，保留其他组已选项。 */
	function toggleGroupSelectAll(group: PlanGroup): void {
		if (!mergeMode.value) return
		const targets = getGroupTargetItems(group)
		if (targets.length === 0) return
		const targetIds = new Set<string>(targets.map((item: UTSJSONObject): string => (getPlanOperationId(item) ?? '').toString()))
		if (isGroupAllSelected(group)) {
			mergeSelectedItems.value = mergeSelectedItems.value.filter((item: UTSJSONObject): boolean => !targetIds.has((getPlanOperationId(item) ?? '').toString()))
			return
		}
		const selectedIds = new Set<string>(mergeSelectedItems.value.map((item: UTSJSONObject): string => (getPlanOperationId(item) ?? '').toString()))
		mergeSelectedItems.value = [...mergeSelectedItems.value, ...targets.filter((item: UTSJSONObject): boolean => !selectedIds.has((getPlanOperationId(item) ?? '').toString()))]
	}
	/** 按 H5 合并规则添加或移除当前计划。 */
	function toggleMergeSelect(item: UTSJSONObject): void {
		const planId = getPlanOperationId(item)
		if (planId === '') return
		if (isMergeChecked(item)) { mergeSelectedItems.value = mergeSelectedItems.value.filter((selected: UTSJSONObject): boolean => getPlanOperationId(selected) !== planId); return }
		if (!isBaseMergeEligible(item, mergeInspectType.value)) { uni.showToast({ title: t('仅支持未下载、已定计划且未合并的同类型任务'), icon: 'none' }); return }
		if (!isMergeSelectableItem(item)) { uni.showToast({ title: t('需与首条计划保持同工厂、同货类、同验货类型'), icon: 'none' }); return }
		mergeSelectedItems.value = [...mergeSelectedItems.value, item]
	}
	/** 退出合并多选模式并清空流程状态。 */
	function cancelMergeMode(): void { mergeMode.value = false; showMergeSheet.value = false; mergeSelectedItems.value = []; mergedPlanId.value = '' }
	/** 加载清单并打开合并确认弹层。 */
	async function openMergeConfirm(): Promise<void> {
		if (mergeSelectedItems.value.length < 2) return
		try { await loadTemplateOptions(); if (mergeTemplateId.value === '' && templateOptions.value.length > 0) setMergeTemplate(templateOptions.value[0]); mergeSheetStage.value = 'confirm'; showMergeSheet.value = true }
		catch (error) { uni.showToast({ title: (error?.message ?? t('加载清单失败')).toString(), icon: 'none' }) }
	}
	/** 更新合并计划下载使用的清单模板。 */
	function setMergeTemplate(option: UTSJSONObject): void { mergeTemplateId.value = (option['id'] ?? '').toString(); mergeTemplateName.value = (option['name'] ?? '').toString() }
	/** 校验全部已选计划后调用远程合并接口。 */
	async function confirmMerge(): Promise<void> {
		if (operationSubmitting.value || mergeSelectedItems.value.length < 2) return
		const anchor = mergeSelectedItems.value[0]
		if (!mergeSelectedItems.value.every((item: UTSJSONObject): boolean => isMergeSelectable(item, mergeInspectType.value, anchor))) { uni.showToast({ title: t('存在不满足合并条件的任务'), icon: 'none' }); return }
		const sourcePlanIds = mergeSelectedItems.value.map((item: UTSJSONObject): string => (getPlanOperationId(item) ?? '').toString())
		operationSubmitting.value = true
		try {
			const response = await planOperationService.mergePlans(sourcePlanIds)
			mergedPlanId.value = (getMergedPlanId(response) ?? '').toString()
			if (mergedPlanId.value === '') throw new Error('合并成功但未返回计划ID')
			results.value = markMergedSourcePlans(results.value, sourcePlanIds, mergedPlanId.value) as UTSJSONObject[]
			localPlans.value = markMergedSourcePlans(localPlans.value, sourcePlanIds, mergedPlanId.value) as UTSJSONObject[]
			uni.showToast({ title: t('合并成功'), icon: 'success' })
		} catch (error) { uni.showToast({ title: (error?.message ?? t('合并失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 下载合并成功的新计划并刷新本地与远程回显。 */
	async function downloadMergedPlan(): Promise<void> {
		if (mergedPlanId.value === '' || operationSubmitting.value) return
		if (mergeTemplateId.value === '') { uni.showToast({ title: t('请选择清单'), icon: 'none' }); return }
		operationSubmitting.value = true
		try { await planOperationService.downloadToLocal(mergedPlanId.value, { templateId: mergeTemplateId.value, templateName: mergeTemplateName.value }, [], mergeSelectedItems.value); await refreshLocalOverlay(); showMergeSheet.value = false; mergeMode.value = false; mergeSelectedItems.value = []; uni.showToast({ title: t('已下载到本地'), icon: 'success' }) }
		catch (error) { uni.showToast({ title: (error?.message ?? t('下载失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}

	/** 加载同一合并组明细并打开拆分预览弹层。 */
	async function openSplitPreview(item: UTSJSONObject): Promise<void> {
		if (!isSplitAvailable(item)) { uni.showToast({ title: t('仅支持未锁定的已定合并计划拆分'), icon: 'none' }); return }
		if (!(await isNetworkOnline())) { uni.showToast({ title: t('拆分验货需要联网，请连接网络后重试'), icon: 'none' }); return }
		operationSubmitting.value = true
		try {
			const planId = (getPlanOperationId(item) ?? '').toString(); const candidateParentId = (getItemParentPlanId(item) ?? '').toString(); const parentPlanId = candidateParentId !== '' ? candidateParentId : planId
			const response = await planApi.searchPlans({ parentPlanId }, 1, searchPageSize)
			splitTargetPlanId.value = planId
			splitPreviewItems.value = buildSplitPreview(response?.records ?? [], localPlans.value, parentPlanId) as UTSJSONObject[]
			if (splitPreviewItems.value.length === 0) splitPreviewItems.value = [item]
			splitResultItems.value = []; splitDownloadedIds.value = []; showSplitSheet.value = true
		} catch (error) { uni.showToast({ title: (error?.message ?? t('加载拆分预览失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 调用拆分接口并展示可逐项下载的结果。 */
	async function confirmSplit(): Promise<void> {
		if (splitTargetPlanId.value === '' || operationSubmitting.value) return
		if (!(await isNetworkOnline())) { uni.showToast({ title: t('拆分验货需要联网，请连接网络后重试'), icon: 'none' }); return }
		operationSubmitting.value = true
		try {
			await planOperationService.splitPlan(splitTargetPlanId.value)
			const sourceIds = splitPreviewItems.value.map((item: UTSJSONObject): string => (getPlanOperationId(item) ?? '').toString())
			splitResultItems.value = markSplitSourcePlans(splitPreviewItems.value, sourceIds) as UTSJSONObject[]
			results.value = markSplitSourcePlans(results.value, sourceIds) as UTSJSONObject[]
			localPlans.value = markSplitSourcePlans(localPlans.value, sourceIds) as UTSJSONObject[]
			uni.showToast({ title: t('拆分成功'), icon: 'success' })
		}
		catch (error) { uni.showToast({ title: (error?.message ?? t('拆分失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 下载指定拆分结果并立即刷新本地已下载状态。 */
	async function downloadSplitItem(item: UTSJSONObject): Promise<void> {
		const planId = (getPlanOperationId(item) ?? '').toString(); if (planId === '' || operationSubmitting.value) return
		if (!(await isNetworkOnline())) { uni.showToast({ title: t('下载验货需要联网，请连接网络后重试'), icon: 'none' }); return }
		operationSubmitting.value = true
		try {
			const plan = (item['plan'] as UTSJSONObject | null) ?? item
			const templateId = (plan['templateId'] ?? item['templateId'] ?? '').toString()
			const templateName = (plan['templateName'] ?? item['templateName'] ?? '').toString()
			await planOperationService.downloadToLocal(planId, { templateId: templateId, templateName: templateName }, [], [item])
			splitDownloadedIds.value = Array.from(new Set<string>([...splitDownloadedIds.value, planId]))
			await refreshLocalOverlay(); uni.showToast({ title: t('已下载到本地'), icon: 'success' })
		}
		catch (error) { uni.showToast({ title: (error?.message ?? t('下载失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 关闭拆分弹层并清理当前拆分上下文。 */
	function closeSplitSheet(): void { showSplitSheet.value = false; splitTargetPlanId.value = ''; splitPreviewItems.value = []; splitResultItems.value = [] }

	/** 打开复制当前验货流程。 */
	async function openCopyCurrent(item: UTSJSONObject): Promise<void> { await openCopySheet(item, 1) }
	/** 打开复制整个合并验货流程。 */
	async function openCopyMerged(item: UTSJSONObject): Promise<void> { await openCopySheet(item, 2) }
	/** 加载复制选项并初始化复制弹层状态。 */
	async function openCopySheet(item: UTSJSONObject, mode: number): Promise<void> {
		try {
			await Promise.all([loadInspectTypeOptions(), loadTemplateOptions()])
			copyTarget.value = item; copyMode.value = mode; copyCreated.value = false; copiedPlanId.value = ''
			const currentType = (getItemInspectType(item) ?? '').toString()
			copyInspectType.value = inspectTypeOptions.value.some((option: UTSJSONObject): boolean => (option['value'] ?? '').toString() === currentType) ? currentType : (inspectTypeOptions.value[0]?.['value'] ?? '').toString()
			const sourcePlan = (item['plan'] as UTSJSONObject | null) ?? item
			const existingTemplateId = (sourcePlan['templateId'] ?? item['templateId'] ?? '').toString()
			setCopyTemplate(templateOptions.value.find((option: UTSJSONObject): boolean => (option['id'] ?? '').toString() === existingTemplateId) ?? { id: existingTemplateId, name: (sourcePlan['templateName'] ?? item['templateName'] ?? '').toString() })
			copyMergedItems.value = []
			showCopySheet.value = true
			if (mode === 2) loadCopyMergedItems(item)
		} catch (error) { uni.showToast({ title: (error?.message ?? t('加载复制选项失败')).toString(), icon: 'none' }) }
	}
	/** 查询复制合并验货的成员；失败时保留当前卡片供用户确认。 */
	async function loadCopyMergedItems(item: UTSJSONObject): Promise<void> {
		const mergedParentPlanId = (getItemParentPlanId(item) ?? '').toString()
		const parentPlanId = mergedParentPlanId !== '' ? mergedParentPlanId : (getPlanOperationId(item) ?? '').toString()
		copyMergedLoading.value = true
		try {
			const response = await planApi.searchPlans({ parentPlanId }, 1, searchPageSize)
			const members = (response?.records as UTSJSONObject[] | null) ?? []
			copyMergedItems.value = members.length > 0 ? members : [item]
		} catch (error) { copyMergedItems.value = [item]; uni.showToast({ title: (error?.message ?? t('加载合并验货成员失败')).toString(), icon: 'none' }) }
		finally { copyMergedLoading.value = false }
	}
	/** 更新复制流程选择的验货类型。 */
	function setCopyInspectType(option: UTSJSONObject): void { copyInspectType.value = (option['value'] ?? '').toString() }
	/** 更新复制流程选择的清单模板。 */
	function setCopyTemplate(option: UTSJSONObject): void { copyTemplateId.value = (option['id'] ?? '').toString(); copyTemplateName.value = (option['name'] ?? '').toString() }
	/** 调用复制接口并解析新计划或合并组中的可下载计划 ID。 */
	async function confirmCopy(): Promise<void> {
		if (operationSubmitting.value) return
		const parentPlanId = (getItemParentPlanId(copyTarget.value) ?? '').toString()
		const sourcePlanId = copyMode.value === 2 && parentPlanId !== '' ? parentPlanId : (getPlanOperationId(copyTarget.value) ?? '').toString()
		if (sourcePlanId === '' || copyInspectType.value === '' || copyTemplateId.value === '') return
		operationSubmitting.value = true
		try {
			const response = await planOperationService.copyPlan(sourcePlanId, { inspectType: copyInspectType.value, copyFlag: copyMode.value, templateId: copyTemplateId.value, templateName: copyTemplateName.value })
			copiedPlanId.value = (extractCopiedPlanId(response) ?? '').toString()
			if (copyMode.value === 2 && copiedPlanId.value === '') {
				const mergedParentPlanId = (response?.parentPlanId ?? '').toString()
				if (mergedParentPlanId !== '') { const rows = await planApi.searchPlans({ parentPlanId: mergedParentPlanId }, 1, searchPageSize); copiedPlanId.value = (getPlanOperationId(rows?.records?.[0] ?? {}) ?? '').toString() }
			}
			if (copiedPlanId.value === '') throw new Error('复制成功但未返回新计划ID')
			copyCreated.value = true; uni.showToast({ title: t('复制验货成功'), icon: 'success' })
		} catch (error) { uni.showToast({ title: (error?.message ?? t('复制验货失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 下载复制成功的新计划并立即刷新本地列表覆盖。 */
	async function downloadCopiedPlan(): Promise<void> {
		if (copiedPlanId.value === '' || operationSubmitting.value) return
		operationSubmitting.value = true
		try { await planOperationService.downloadToLocal(copiedPlanId.value, { templateId: copyTemplateId.value, templateName: copyTemplateName.value }, [], []); await refreshLocalOverlay(); showCopySheet.value = false; uni.showToast({ title: t('已下载到本地'), icon: 'success' }) }
		catch (error) { uni.showToast({ title: (error?.message ?? t('下载失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 关闭复制弹层并清理复制结果状态。 */
	function closeCopySheet(): void { showCopySheet.value = false; copyCreated.value = false; copiedPlanId.value = ''; copyMergedItems.value = [] }

	/** 使用原生确认框询问是否释放当前任务；重置会删除云端报告。 */
	function confirmReleaseAction(reset: boolean): Promise<boolean> {
		return new Promise<boolean>((resolve) => { uni.showModal({ title: t(reset ? '重置验货任务' : '解锁验货任务'), content: t(reset ? '您确定需要重置该验货任务？' : '当前验货会恢复到已定计划状态。请确认需要解锁该任务？'), success: (result) => resolve(result.confirm === true), fail: () => resolve(false) }) })
	}
	/** 经用户确认释放合并组，清理本地成员并同步搜索卡片锁状态。 */
	async function handleRelease(item: UTSJSONObject, reset: boolean): Promise<void> {
		if (operationSubmitting.value || !await confirmReleaseAction(reset)) return
		operationSubmitting.value = true
		try {
			const response = reset ? await planOperationService.resetPlan(item) : await planOperationService.unlockPlan(item)
			results.value = markReleasedGroupPlans(results.value, response?.removedIds, response?.parentPlanId) as UTSJSONObject[]
			mergeSelectedItems.value = markReleasedGroupPlans(mergeSelectedItems.value, response?.removedIds, response?.parentPlanId) as UTSJSONObject[]
			await loadLocalPlans()
			uni.showToast({ title: t(reset ? '重置成功' : '解锁成功'), icon: 'success' })
		} catch (error) { uni.showToast({ title: (error?.message ?? t(reset ? '重置失败' : '解锁失败')).toString(), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 解锁当前卡片及其合并组成员。 */
	async function handleUnlock(item: UTSJSONObject): Promise<void> { await handleRelease(item, false) }
	/** 重置当前卡片及其合并组成员。 */
	async function handleReset(item: UTSJSONObject): Promise<void> { await handleRelease(item, true) }

	/** 卡片下载或本地状态变化后重新加载本地记录并覆盖当前结果。 */
	async function handleCardRefresh(): Promise<void> { await refreshLocalOverlay() }
	/** 返回上一页。 */
	function goBack(): void { uni.navigateBack() }
	/** 初始化搜索页运行时、本地数据和自动扫码请求。 */
	async function initializeSearchPage(): Promise<void> { await initializeRuntime(); await loadLocalPlans(); if (autoScanRequested.value) scanBarcode() }
	/** 读取列表页传入的自动扫码参数。 */
	function handleSearchPageLoad(options: OnLoadOptions): void { autoScanRequested.value = (options['autoScan'] ?? '') === '1' }

	onLoad(handleSearchPageLoad)
	onMounted(initializeSearchPage)
</script>

<style>
	.page { flex: 1; background-color: #f5f5f5; }
	.sticky-top-area { background-color: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); }
	.header, .result-toolbar, .result-toolbar-left, .supplier-row, .pagination-actions { flex-direction: row; align-items: center; }
	.header { padding: 24rpx 32rpx; }
	.back-btn { width: 76rpx; height: 76rpx; color: #03ae4f; font-size: 48rpx; text-align: center; line-height: 76rpx; }
	.search-input { flex: 1; height: 84rpx; padding: 0 32rpx; border-radius: 42rpx; background-color: #f5f5f5; font-size: 30rpx; color: #0f172a; }
	.scan-icon { width: 76rpx; margin-left: 20rpx; align-items: center; justify-content: center; }
	.search-button-container { padding: 12rpx 32rpx 24rpx; }
	.search-btn { height: 88rpx; color: #ffffff; background-color: #00b050; border-radius: 44rpx; font-size: 30rpx; font-weight: 600; }
	.result-toolbar { padding: 16rpx 32rpx 24rpx; border-top-width: 2rpx; border-top-color: #f1f5f9; background-color: #ffffff; }
	.result-toolbar-left { flex: 1; }
	.result-title { color: #1e293b; font-size: 30rpx; font-weight: 700; }
	.result-divider { flex: 1; height: 2rpx; margin-left: 20rpx; background-color: #cbd5e1; }
	.toolbar-btn { min-width: 128rpx; height: 64rpx; margin-left: 16rpx; padding: 0 24rpx; flex-direction: row; align-items: center; justify-content: center; border-width: 2rpx; border-style: solid; border-color: #d1d5db; border-radius: 16rpx; background-color: #ffffff; }
	.toolbar-btn-text { color: #0f172a; font-size: 26rpx; font-weight: 600; text-align: center; }
	.merge-action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 1100; flex-direction: row; padding: 20rpx 28rpx 40rpx; border-top-width: 2rpx; border-top-color: #e5e7eb; background-color: #ffffff; }
	.merge-action-btn { height: 88rpx; border-radius: 20rpx; font-size: 30rpx; font-weight: 600; }
	.merge-action-btn.cancel { width: 200rpx; margin-right: 20rpx; border-width: 2rpx; border-color: #e5e7eb; color: #334155; background-color: #ffffff; }
	.merge-action-btn.confirm { flex: 1; color: #ffffff; background-color: #03ae4f; }
	.merge-action-btn.confirm.disabled { background-color: #9ca3af; }
	.fab { position: fixed; right: 20px; bottom: 40px; width: 60px; height: 60px; border-radius: 30px; align-items: center; justify-content: center; background-color: #05b552; box-shadow: 0 8px 16px rgba(5, 181, 82, 0.32); z-index: 1200; }
	.content { flex: 1; padding: 28rpx 32rpx; }
	.loading, .empty { align-items: center; padding: 100rpx 40rpx; color: #666666; }
	.empty-icon { font-size: 80rpx; }
	.empty-text { margin-top: 24rpx; color: #64748b; font-size: 28rpx; text-align: center; }
	.results { padding-bottom: 24rpx; }
	.plan-group { margin-bottom: 28rpx; border-radius: 32rpx; overflow: hidden; background-color: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05); }
	.order-header { padding: 20rpx 28rpx; background-color: #f5f5f5; flex-direction: row; align-items: center; justify-content: space-between; }
	.group-select-all { width: 56rpx; height: 56rpx; border-width: 2rpx; border-color: #cbd5e1; border-radius: 14rpx; background-color: #ffffff; align-items: center; justify-content: center; box-shadow: 0 3rpx 8rpx rgba(15, 23, 42, 0.08); }
	.group-select-all.selected { border-color: #22c55e; background-color: #ecfdf5; }
	.group-select-all.disabled { border-color: #94a3b8; background-color: #cbd5e1; }
	.group-checkbox { width: 36rpx; height: 36rpx; border-width: 2rpx; border-style: solid; border-color: #94a3b8; border-radius: 6rpx; background-color: #ffffff; align-items: center; justify-content: center; }
	.group-checkbox.checked { border-color: #1a5f3f; background-color: #1a5f3f; }
	.group-check-mark { color: #ffffff; font-size: 24rpx; font-weight: 700; line-height: 28rpx; }
	.group-disabled-mark { color: #475569; font-size: 36rpx; font-weight: 700; line-height: 42rpx; }
	.order-no { color: #0f172a; font-size: 36rpx; font-weight: 600; }
	.supplier-row { justify-content: space-between; padding: 20rpx 28rpx 4rpx; background-color: #ffffff; }
	.supplier-name, .order-date { color: #64748b; font-size: 24rpx; }
	.order-date { color: #94a3b8; }
	.hints { padding: 48rpx 8rpx; }
	.hint-title { color: #1e293b; font-size: 32rpx; font-weight: 600; }
	.hint-list { margin-top: 24rpx; padding: 32rpx; border-radius: 32rpx; background-color: #ffffff; }
	.hint-item { margin-top: 16rpx; color: #64748b; font-size: 28rpx; }
	.search-pagination-bar { padding: 24rpx 0 12rpx; }
	.pagination-info { color: #64748b; font-size: 24rpx; text-align: center; }
	.pagination-actions { margin-top: 20rpx; }
	.page-nav-btn, .load-more-btn { flex: 1; height: 80rpx; margin: 0 8rpx; border-radius: 24rpx; font-size: 28rpx; }
	.page-nav-btn { color: #ffffff; background-color: #00b050; }
	.load-more-btn { color: #94a3b8; background-color: #e2e8f0; }
	.content-space { height: 36rpx; }
	.content-space.merge-space { height: 180rpx; }
</style>
