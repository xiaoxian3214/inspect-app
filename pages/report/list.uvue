	.load-more-btn { color: #ffffff; background-color: #16a34a; border-radius: 12px; font-size: 14px; }
	.pagination-info { margin-top: 10px; color: #64748b; font-size: 12px; text-align: center; }
	.pagination-actions { flex-direction: row; margin-top: 10px; }
	.page-nav-btn { flex: 1; height: 40px; line-height: 40px; margin: 0 4px; color: #ffffff; background-color: #16a34a; border-radius: 12px; font-size: 14px; }
	.content-space { height: 100px; }
	.fab { position: fixed; right: 20px; bottom: 40px; width: 60px; height: 60px; border-radius: 30px; align-items: center; justify-content: center; background-color: #05b552; box-shadow: 0 8px 16px rgba(5, 181, 82, 0.32); z-index: 1200; }
