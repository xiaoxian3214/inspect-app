<template>
	<view class="page">
		<view class="header">
			<TopSafeArea background-color="#03ae4f" />
			<view class="top">
				<view class="top-icon-button" @click="showUserMenu">
					<AppIcon type="bars" :size="24" color="#ffffff" />
				</view>
				<text class="title">{{ translateText('验货') }}</text>
				<OfflineSyncStatus
					class="sync-entry"
					:is-online="online"
					:is-syncing="isSyncingData"
						:pending-count="pendingSyncCount"
						:failed-count="failedSyncCount"
						:queue-items="pendingSyncItems"
				/>
			</view>
			<view class="status-tabs">
				<view
					v-for="tab in tabs"
					:key="tab.key"
					class="status-tab"
					:class="{ active: activeTab === tab.key }"
					@click="switchTab(tab.key)"
				>
					<text class="tab-icon">{{ tab.icon }}</text>
					<text class="tab-text">{{ translateText(tab.label) }}</text>
					<text v-if="counts[tab.key] > 0" class="tab-badge">{{ counts[tab.key] }}</text>
					<view v-if="activeTab === tab.key" class="tab-indicator"></view>
				</view>
			</view>
		</view>
		<scroll-view
			class="content"
			direction="vertical"
		>
			<view v-if="activeTab === 'local'" class="group-list">
				<view v-if="loading && localPlanRows.length === 0" class="loading">
					<text class="loading-icon">⟳</text>
					<text>{{ translateText('读取本地数据中...') }}</text>
				</view>
				<view v-else-if="localPlanRows.length === 0" class="tip-card">
					<view class="tip-title">{{ translateText(errorMessage !== '' ? '读取本地数据失败' : '暂无本地下载数据') }}</view>
					<view class="tip-sub">{{ translateText(errorMessage !== '' ? errorMessage : '下载的验货计划、报告、检查项与疵点会关联保存到本机 SQLite。') }}</view>
					<button class="retry-btn" @click="refreshLocalList">{{ translateText('重新读取') }}</button>
				</view>
				<view v-else>
					<view v-if="errorMessage !== ''" class="inline-notice">{{ translateText(errorMessage) }}</view>
					<view class="inline-notice">{{ translateText('本机 SQLite · 验货计划表 · 共 {count} 条（包含所有状态）', { count: localPlanRows.length }) }}</view>
					<button class="local-refresh-btn" @click="refreshLocalList">{{ translateText('重新读取本地数据') }}</button>
					<LocalReportRecord v-for="row in localPlanRows" :key="row.planId" :row="row" />
				</view>
			</view>
			<view v-else-if="loading && groups.length === 0" class="loading">
				<text class="loading-icon">⟳</text>
				<text>{{ translateText('加载中...') }}</text>
			</view>

			<view v-else-if="groups.length === 0" class="tip-card">
				<view class="tip-title">{{ translateText(emptyTitle) }}</view>
				<view class="tip-sub">{{ translateText(emptySubtitle) }}</view>
				<button v-if="errorMessage !== ''" class="retry-btn" @click="refreshList">{{ translateText('重新加载') }}</button>
			</view>

			<view v-else class="group-list">
				<view v-if="errorMessage !== ''" class="inline-notice">{{ translateText(errorMessage) }}</view>
				<view v-for="group in groups" :key="group.groupKey" class="plan-group">
					<view class="order-header">
						<text class="order-no">{{ group.clientOrderNo }}</text>
						<view v-if="mergeMode" class="group-select-all" :class="{ selected: isGroupAllSelected(group), disabled: !canGroupSelectAll(group) }" @click.stop="toggleGroupSelectAll(group)">
							<view v-if="!canGroupSelectAll(group)" class="group-disabled-mark">—</view>
							<view v-else class="group-checkbox" :class="{ checked: isGroupAllSelected(group) }">
								<text v-if="isGroupAllSelected(group)" class="group-check-mark">✓</text>
							</view>
						</view>
					</view>
					<view class="supplier-row">
						<text class="supplier-name">{{ group.supplierName }}</text>
						<text class="order-date">{{ formatDate(group.orderDate as string) }}</text>
					</view>
					<InspectionPlanCard
						v-for="item in (group.items as UTSJSONObject[])"
						:key="getPlanUniqueId(item)"
						:item="item"
						:show-download="true"
						:current-user-id="currentUserId"
						:status-key="activeTab"
						:is-local-downloaded="isStoredLocally(item)"
						:use-internal-actions="true"
						:manage-actions-in-card="true"
						:use-internal-card-click="true"
						:show-action-split="isSplitAvailable(item)"
						:selection-mode="mergeMode"
						:selection-checked="isMergeChecked(item)"
						:selection-disabled="mergeMode && !isMergeSelectableItem(item)"
						@merge-toggle="toggleMergeSelect"
						@action-split="openSplitPreview"
						@released="handleCardReleased"
						@request-refresh="refreshLocalList"
					/>
				</view>
			</view>

			<view v-if="activeTab !== 'local' && !loading" class="pagination-bar">
				<button class="load-more-btn" :disabled="loadingMore" @click="loadMore">
					{{ translateText(loadingMore ? '加载中...' : '加载更多') }}
				</button>
				<view v-if="shouldShowPagination" class="pagination-info">
					{{ translateText('第 {page} / {pages} 页，共 {total} 条', { page: currentPage, pages: totalPages, total }) }}
				</view>
				<view v-if="shouldShowPagination" class="pagination-actions">
					<button class="page-nav-btn" :disabled="loadingMore || currentPage <= 1" @click="loadPrevPage">{{ translateText('上一页') }}</button>
					<button class="page-nav-btn" :disabled="loadingMore || currentPage >= totalPages" @click="loadNextPage">{{ translateText('下一页') }}</button>
				</view>
			</view>
			<view class="content-space"></view>
		</scroll-view>
		<view v-if="mergeMode" class="merge-action-bar">
			<button class="merge-action-btn cancel" @click="cancelMergeMode">{{ translateText('取消') }}</button>
			<button class="merge-action-btn confirm" :class="{ disabled: mergeSelectedItems.length < 2 || operationSubmitting }" :disabled="mergeSelectedItems.length < 2 || operationSubmitting" @click="openMergeConfirm">{{ translateText('合并验货') }}（{{ mergeSelectedItems.length }}）</button>
		</view>

		<view v-if="fabActions.length > 0 && !mergeMode" class="fab" @click="showActionMenu">
			<AppIcon :type="activeTab === 'report' ? 'search' : 'plus'" :size="32" color="#ffffff" />
		</view>

		<UserInfoDrawer
			:visible="showUserDrawer"
			:user-name="displayName"
			:user-id="currentUserId !== '' ? currentUserId : '-'"
			:email="userEmail !== '' ? userEmail : '-'"
			:locale="currentLanguage"
			:locales="supportedLocales"
			:invite-generating="inviteGenerating"
			:clearing-local-cache="isClearingLocalCache"
			@close="closeUserDrawer"
			@change-language="setLanguage"
			@invite-vendor="handleInviteVendor"
			@open-custom-camera="handleOpenCustomCamera"
			@view-local-data="handleViewLocalData"
			@clear-cache="handleClearLocalCache"
			@check-for-updates="handleCheckForUpdates"
			@logout="handleLogout"
		/>

		<BottomActionSheet
			:visible="showMenu"
			:actions="fabActions"
			:show-icons="true"
			@select="handleFabAction"
			@cancel="hideActionMenu"
		/>
		<MergePlanSheet
			:visible="showMergeSheet"
			:stage="mergeSheetStage"
			:inspect-type-options="inspectTypeOptions"
			:selected-inspect-type="mergeInspectType"
			:selected-items="mergeSelectedItems"
			:templates="templateOptions"
			:selected-template-id="mergeTemplateId"
			:merged-plan-id="mergedPlanId"
			:submitting="operationSubmitting"
			@close="closeMergeSheet"
			@update-inspect-type="setMergeInspectType"
			@start-selection="startMergeSelection"
			@update-template="setMergeTemplate"
			@confirm-merge="confirmMerge"
			@download="downloadMergedPlan"
		/>
		<SplitPlanSheet
			:visible="showSplitSheet"
			:preview-items="splitPreviewItems"
			:result-items="splitResultItems"
			:downloaded-ids="splitDownloadedIds"
			:submitting="operationSubmitting"
			@close="closeSplitSheet"
			@confirm="confirmSplit"
			@download="downloadSplitItem"
		/>
	</view>
</template>

<script setup lang="uts">
	import { computed, reactive, ref } from 'vue'
	import BottomActionSheet from '../../components/common/BottomActionSheet.uvue'
	import MergePlanSheet from '../../components/search/MergePlanSheet.uvue'
	import SplitPlanSheet from '../../components/search/SplitPlanSheet.uvue'
	import TopSafeArea from '../../components/common/TopSafeArea.uvue'
	import { openUrlInSystemBrowser } from '@/domain/openUrlInSystemBrowser.uts'
	import InspectionPlanCard from '../../components/inspection/InspectionPlanCard.uvue'
	import LocalReportRecord from '../../components/inspection/LocalReportRecord.uvue'
	import UserInfoDrawer from '../../components/inspection/UserInfoDrawer.uvue'
	import AppIcon from '../../components/icons/AppIcon.uvue'
	import OfflineSyncStatus from '../../components/sync/OfflineSyncStatus.uvue'
	import { applyLocale, t } from '../../i18n/index.uts'
	import { createAppUpdateService } from '../../services/appUpdateService.uts'
	import { API_BASE_URL } from '../../config/appConfig.uts'

	/** 为 Android 原生模板提供可调用的翻译方法，保留占位符参数。 */
	function translateText(key: string, params: UTSJSONObject = {}): string { return t(key, params) }
	import { buildFabActions } from '../../domain/listActionViewModel.uts'
	import { filterReleasedPlans, getPlanUniqueId, groupPlans, isPlanInTab, mergePlansLocalFirst } from '../../domain/planViewModel.uts'
	import { buildSplitPreview, getMergeGroupTargets, getMergedPlanId, getItemInspectType, getItemParentPlanId, getPlanOperationId, isBaseMergeEligible, isMergeSelectable, isSplitAvailable, markMergedSourcePlans, markSplitSourcePlans } from '../../domain/searchViewModel.uts'
	import {
		getCurrentSession,
		getAppSetting,
			getOfflineSyncOverview,
			initializeRuntime,
			inviteApi,
				isNetworkOnline,
				logout,
				planApi,
				planListService,
				planOperationService,
			reportRepository,
			setAppSetting,
			syncOfflineDataAutomatically
		} from '../../runtime/appRuntime.uts'

	/** 列表状态页签的固定字段，模板和脚本都按静态字段访问而不是动态属性。 */
	type TabItem = { key: string, label: string, icon: string }

	const pageSize: number = 100
	const tabs: TabItem[] = [
		{ key: 'planned', label: '已定计划', icon: 'Ⅱ' },
		{ key: 'progress', label: '进行中', icon: '▶' },
		{ key: 'report', label: '报告', icon: '✓' },
		// { key: 'local', label: '本地下载', icon: '↓' }
	]

	const activeTab = ref<string>('planned')
	const localPlans = ref<UTSJSONObject[]>([])
	const localPlanRows = ref<UTSJSONObject[]>([])
	/** 远程页签缓存按页签键保存计划卡片数组，空数组显式标注元素类型。 */
	const remoteListMap = reactive({ planned: [] as UTSJSONObject[], progress: [] as UTSJSONObject[], report: [] as UTSJSONObject[] })
	const pageMap = reactive({ planned: 0, progress: 0, report: 0 })
	const totalMap = reactive({ planned: 0, progress: 0, report: 0 })
	const loading = ref<boolean>(false)
	const loadingMore = ref<boolean>(false)
	const isSyncingData = ref<boolean>(false)
	const failedSyncCount = ref<number>(0)
	const online = ref<boolean>(true)
	const errorMessage = ref<string>('')
	const showMenu = ref<boolean>(false)
	const showUserDrawer = ref<boolean>(false)
	const displayName = ref<string>('验货员')
	const userCode = ref<string>('')
	const userEmail = ref<string>('')
	const currentUserId = ref<string>('')
	const supportedLocales: string[] = ['zh', 'en', 'vi']
	const currentLanguage = ref<string>('zh')
	const inviteGenerating = ref<boolean>(false)
	const isClearingLocalCache = ref<boolean>(false)
	const isUpdatingApp = ref<boolean>(false)
	const appUpdateService = createAppUpdateService({ baseUrl: API_BASE_URL })
	const localTotal = ref<number>(0)
	const pendingSyncCount = ref<number>(0)
	const pendingSyncItems = ref<UTSJSONObject[]>([])
	const latestDownloadedAt = ref<string>('')
	const inspectTypeOptions = ref<UTSJSONObject[]>([])
	const templateOptions = ref<UTSJSONObject[]>([])
	const mergeMode = ref<boolean>(false)
	const showMergeSheet = ref<boolean>(false)
	const mergeSheetStage = ref<string>('type')
	const mergeInspectType = ref<string>('')
	const mergeSelectedItems = ref<UTSJSONObject[]>([])
	const mergeTemplateId = ref<string>('')
	const mergeTemplateName = ref<string>('')
	const mergedPlanId = ref<string>('')
	const showSplitSheet = ref<boolean>(false)
	const splitTargetPlanId = ref<string>('')
	const splitPreviewItems = ref<UTSJSONObject[]>([])
	const splitResultItems = ref<UTSJSONObject[]>([])
	const splitDownloadedIds = ref<string[]>([])
	const operationSubmitting = ref<boolean>(false)

	/**
	 * 使用 H5 的本地优先规则合并当前页签的本地摘要和远程缓存。
	 */
	const visiblePlans = computed((): UTSJSONObject[] => (mergePlansLocalFirst(
		localPlans.value,
		remoteListMap[activeTab.value] ?? []
	) as UTSJSONObject[]).filter((item: UTSJSONObject): boolean => isPlanInTab(item, activeTab.value)))

	/**
	 * 按订单号分组当前可见计划，供列表模板直接渲染。
	 */
	const groups = computed((): UTSJSONObject[] => groupPlans(visiblePlans.value) as UTSJSONObject[])

	/** 仅根据 SQLite 已读取的计划摘要判断卡片是否存在本地缓存。 */
	function isStoredLocally(item: UTSJSONObject): boolean {
		const planId = String(getPlanUniqueId(item) ?? '').trim()
		return planId !== '' && localPlans.value.some((plan: UTSJSONObject): boolean => String(getPlanUniqueId(plan) ?? '').trim() === planId)
	}

	/**
	 * 合并状态页签的本地和远程数量，并单独统计 SQLite 中的全部验货计划行。
	 */
	const counts = computed((): UTSJSONObject => {
		const result: UTSJSONObject = { planned: 0, progress: 0, report: 0, local: localPlanRows.value.length }
		for (const tab of tabs) {
			if (tab.key === 'local') continue
			const merged = mergePlansLocalFirst(localPlans.value, remoteListMap[tab.key] ?? []) as UTSJSONObject[]
			const visibleCount = merged.filter((item: UTSJSONObject): boolean => isPlanInTab(item, tab.key)).length
			result[tab.key] = Math.max(visibleCount, parseInt(String(totalMap[tab.key] ?? 0)))
		}
		return result
	})

	/**
	 * 返回当前页签已加载的远程页码，尚未加载时按第一页展示。
	 */
	const currentPage = computed((): number => parseInt(String(pageMap[activeTab.value] ?? 1)))

	/**
	 * 返回当前页签本地可见数量与远程接口总数的较大值。
	 */
	const total = computed((): number => Math.max(visiblePlans.value.length, parseInt(String(totalMap[activeTab.value] ?? 0))))

	/**
	 * 判断当前页签是否已经加载过云端列表。
	 */
	const hasRemoteLoaded = computed((): boolean => parseInt(String(pageMap[activeTab.value] ?? 0)) > 0)

	/**
	 * 计算当前远程结果对应的总页数。
	 */
	const totalPages = computed((): number => Math.max(1, Math.ceil(total.value / pageSize)))

	/**
	 * 判断是否需要展示上一页和下一页操作。
	 */
	const shouldShowPagination = computed((): boolean => total.value > pageSize)

	/**
	 * 根据当前页签返回空状态标题。
	 */
	const emptyTitle = computed((): string => {
		if (activeTab.value === 'progress') return '暂无进行中的验货'
		if (activeTab.value === 'report') return '暂无验货报告'
		return '暂无已定计划'
	})

	/**
	 * 根据联网状态和当前页签返回空状态说明。
	 */
	const emptySubtitle = computed((): string => {
		if (!online.value) return '当前离线，仅展示本机已缓存验货数据。'
		if (activeTab.value === 'progress') return '从已定计划开始验货后，会自动进入进行中列表。'
		if (activeTab.value === 'report') return '完成并保存的报告会显示在这里。'
		return '点击右下角按钮开始查询和下载验货计划。'
	})

	/**
	 * 按 H5 页签规则生成右下角浮动菜单操作。
	 */
	const fabActions = computed((): UTSJSONObject[] => buildFabActions(activeTab.value) as UTSJSONObject[])

	onLoad((options) => {
		const requestedTab = String(options?.tab ?? '')
		if (tabs.some((tab: TabItem): boolean => tab.key === requestedTab)) activeTab.value = requestedTab
	})

	/** 进入列表时先展示本地数据，再在后台同步完成后刷新一次状态。 */
	async function refreshListWithAutomaticSync(): Promise<void> {
		try {
			await initializeRuntime()
			currentLanguage.value = String(getAppSetting('qcm_language') ?? 'zh')
			applyLocale(currentLanguage.value)
			const automaticTask = syncOfflineDataAutomatically()
			await refreshLocalList()
			await automaticTask
			await refreshLocalList()
		} catch (error) { errorMessage.value = error?.message ?? t('SQLite 初始化失败，请重试') }
	}

	onShow(refreshListWithAutomaticSync)

	/**
	 * 将 ISO 时间格式化为列表抽屉使用的分钟精度文本。
	 */
	function formatDateTime(value: string): string {
		const text = String(value ?? '')
		if (text.length < 16) return text
		return text.substring(0, 16).replace('T', ' ')
	}

	/**
	 * 将日期值格式化为年月日。
	 */
	function formatDate(value: string): string {
		const text = String(value ?? '')
		return text.length >= 10 ? text.substring(0, 10) : text
	}

	/**
	 * 重新统计用户、本地计划和待同步数据概览。
	 */
	async function refreshOverview(): Promise<void> {
		const session = getCurrentSession()
		displayName.value = String((session?.realName || session?.userName) ?? '验货员')
		userCode.value = String((session?.userName || session?.userId) ?? '')
		userEmail.value = String(session?.email ?? '')
		currentUserId.value = String(session?.userId ?? '')
		const overview = await planListService.getOverview()
		const syncOverview = await getOfflineSyncOverview()
		localTotal.value = parseInt(String(overview?.total ?? 0))
		pendingSyncCount.value = parseInt(String(syncOverview?.pendingCount ?? 0))
		failedSyncCount.value = parseInt(String(syncOverview?.failedCount ?? 0))
		const queueItems = syncOverview?.queueItems
		pendingSyncItems.value = Array.isArray(queueItems) ? queueItems as UTSJSONObject[] : []
		latestDownloadedAt.value = formatDateTime(String(overview?.latestDownloadedAt ?? ''))
	}

	/**
	 * 对远程单页结果按计划 ID 去重，保持 H5 首次出现顺序。
	 * records 为接口返回的计划 JSON 行数组，逐行按对象读取，避免动态元素类型。
	 */
	function normalizeRemoteRecords(records: UTSJSONObject[]): UTSJSONObject[] {
		const source: UTSJSONObject[] = Array.isArray(records) ? records : []
		const normalized: UTSJSONObject[] = [] as UTSJSONObject[]
		const seenIds = new Set<string>()
		for (const item of source) {
			const planId = String(getPlanUniqueId(item) ?? '').trim()
			if (planId !== '' && seenIds.has(planId)) continue
			if (planId !== '') seenIds.add(planId)
			normalized.push(item as UTSJSONObject)
		}
		return normalized
	}

	/**
	 * 从本地数据库读取计划摘要与计划表原始行，不清除远程页签缓存。
	 */
	async function loadLocalPlanSummaries(): Promise<void> {
		localPlans.value = ((await planListService.listPlanSummaries()) ?? []) as UTSJSONObject[]
		localPlanRows.value = ((await reportRepository.listStoredInspectionPlanRows()) ?? []) as UTSJSONObject[]
	}

	/**
	 * 加载指定页数据；加载更多可仅显示按钮状态，远程失败时保留本地列表。
	 */
	async function loadPage(page: number, options: UTSJSONObject = {}): Promise<void> {
		const shouldFetchRemote = options?.remote === true
		const appendMessage = options?.appendMessage === true
		const useLoadingMore = options?.loadingMore === true || (page !== 1 && groups.value.length > 0)
		if (useLoadingMore) loadingMore.value = true
		else loading.value = true
		if (!appendMessage) errorMessage.value = ''

		try {
			await initializeRuntime()
			online.value = await isNetworkOnline()
			const session = getCurrentSession()
			await loadLocalPlanSummaries()
			if (shouldFetchRemote) {
				try {
					if (!online.value) throw new Error('当前离线，保留已加载列表和本地数据')
					const result = await planListService.loadRemotePage({
						tabKey: activeTab.value,
						inspectorId: session?.userId ?? '',
						page,
						pageSize
					})
					const remoteRecords = result?.records
					remoteListMap[activeTab.value] = normalizeRemoteRecords(Array.isArray(remoteRecords) ? remoteRecords as UTSJSONObject[] : [])
					pageMap[activeTab.value] = page
					totalMap[activeTab.value] = parseInt(String(result?.total ?? 0))
				} catch (error) {
					errorMessage.value = error?.message ?? t('云端列表加载失败，已保留当前列表和本地数据')
				}
			}
			await refreshOverview()
		} catch (error) {
			errorMessage.value = error?.message ?? t('列表加载失败')
			await refreshOverview()
		} finally {
			loading.value = false
			loadingMore.value = false
		}
	}

	/**
	 * 只从本地数据库重新加载当前页签。
	 */
	async function refreshLocalList(): Promise<void> {
		const showLoading = activeTab.value === 'local' ? localPlanRows.value.length === 0 : groups.value.length === 0
		if (showLoading) loading.value = true
		errorMessage.value = ''
		try {
			await initializeRuntime()
			online.value = await isNetworkOnline()
			await loadLocalPlanSummaries()
			await refreshOverview()
		} catch (error) {
			errorMessage.value = error?.message ?? t('本地列表加载失败')
		} finally {
			loading.value = false
		}
	}

	/** 接收卡片释放结果，立即移除本地、远程页签缓存和合并多选中的计划。 */
	function handleCardReleased(payload: UTSJSONObject | null): void {
		const removedIds = payload?.removedIds ?? []
		const parentPlanId = String(payload?.parentPlanId ?? '')
		localPlans.value = filterReleasedPlans(localPlans.value, removedIds, parentPlanId) as UTSJSONObject[]
		mergeSelectedItems.value = filterReleasedPlans(mergeSelectedItems.value, removedIds, parentPlanId) as UTSJSONObject[]
		for (const tab of tabs) {
			if (tab.key === 'local') continue
			remoteListMap[tab.key] = filterReleasedPlans(remoteListMap[tab.key], removedIds, parentPlanId)
		}
	}

	/**
	 * 手动刷新状态页签的云端列表；本地下载页签仅重新读取 SQLite。
	 */
	async function refreshList(): Promise<void> {
		if (activeTab.value === 'local') {
			await refreshLocalList()
			return
		}
		await loadPage(1, { remote: true, appendMessage: false })
	}

	/**
	 * 同步本地脏报告；防止重复点击启动并发或循环同步。
	 */
	async function syncData(): Promise<void> {
		if (isSyncingData.value) return
		await initializeRuntime()
		online.value = await isNetworkOnline()
		await refreshOverview()

		if (!online.value) {
			uni.showToast({ title: t('当前无网络，暂无法同步'), icon: 'none' })
			return
		}
		isSyncingData.value = true
		failedSyncCount.value = 0
		try {
			const result = await syncOfflineDataAutomatically()
			const resultFailedCount = parseInt(String(result?.failedCount ?? 0)) + parseInt(String(result?.failedPhotoCount ?? 0))
			await refreshLocalList()
			failedSyncCount.value = Math.max(failedSyncCount.value, resultFailedCount)
			if (failedSyncCount.value > 0) {
				uni.showToast({
					title: t('已同步 {synced} 条，失败 {failed} 项', { synced: parseInt(String(result?.syncedCount ?? 0)), failed: failedSyncCount.value }),
					icon: 'none'
				})
				return
			}
			const totalCount = parseInt(String(result?.syncedCount ?? 0)) + parseInt(String(result?.uploadedPhotoCount ?? 0))
			uni.showToast({ title: totalCount > 0 ? t('同步成功，共 {count} 项', { count: totalCount }) : t('本地数据已是最新'), icon: totalCount > 0 ? 'success' : 'none' })
		} catch (error) {
			failedSyncCount.value = Math.max(1, pendingSyncCount.value)
			uni.showToast({ title: error?.message ?? t('同步失败'), icon: 'none' })
		} finally {
			isSyncingData.value = false
			await refreshOverview()
		}
	}

	/** 切换状态页签时复用已加载的本地摘要与远程缓存。 */
	async function switchTab(tabKey: string): Promise<void> {
		if (activeTab.value === tabKey) return
		if (mergeMode.value) cancelMergeMode()
		activeTab.value = tabKey
	}

	/**
	 * 与 H5 一致重新请求远程第一页，并只显示加载更多按钮的 loading 状态。
	 */
	async function loadMore(): Promise<void> {
		if (loadingMore.value) return
		await loadPage(1, { remote: true, appendMessage: true, loadingMore: true })
	}

	/**
	 * 加载远程上一页。
	 */
	async function loadPrevPage(): Promise<void> {
		if (!hasRemoteLoaded.value || currentPage.value <= 1) return
		await loadPage(currentPage.value - 1, { remote: true, appendMessage: true })
	}

	/**
	 * 加载远程下一页。
	 */
	async function loadNextPage(): Promise<void> {
		if (!hasRemoteLoaded.value || currentPage.value >= totalPages.value) return
		await loadPage(currentPage.value + 1, { remote: true, appendMessage: true })
	}

	/**
	 * 打开用户信息抽屉。
	 */
	function showUserMenu(): void {
		showUserDrawer.value = true
	}

	/**
	 * 关闭用户信息抽屉。
	 */
	function closeUserDrawer(): void {
		showUserDrawer.value = false
	}

	/**
	 * 保存 H5 同源语言代码并让后续接口请求立即使用该语言。
	 */
	async function setLanguage(languageCode: string): Promise<void> {
		const normalizedLanguage = supportedLocales.includes(String(languageCode)) ? String(languageCode) : 'zh'
		try {
			await setAppSetting('qcm_language', normalizedLanguage)
			currentLanguage.value = normalizedLanguage
			applyLocale(normalizedLanguage)
			uni.showToast({ title: t('已切换语言：{language}', { language: normalizedLanguage }), icon: 'none' })
		} catch (error) { uni.showToast({ title: error?.message ?? t('语言保存失败'), icon: 'none' }) }
	}

	/**
	 * 生成供应商邀请链接并复制到系统剪贴板。
	 */
	async function handleInviteVendor(): Promise<void> {
		if (inviteGenerating.value) return
		inviteGenerating.value = true
		try {
			const response = await inviteApi.generateVendorInviteLink()
			const inviteLink = String(response?.inviteLink ?? '').trim()
			if (inviteLink === '') throw new Error('邀请链接为空')
			uni.setClipboardData({ data: inviteLink })
			closeUserDrawer()
			uni.showToast({ title: t('邀请链接已复制'), icon: 'success' })
		} catch (error) {
			uni.showToast({ title: error?.message ?? t('生成邀请链接失败'), icon: 'none' })
		} finally {
			inviteGenerating.value = false
		}
	}

	/**
	 * 关闭用户抽屉并跳转到自定义拍照页面，供离线验货现场独立拍摄使用。
	 */
	/** 关闭用户抽屉并跳转到自定义拍照页面。 */
	/** 关闭用户抽屉并跳转到自定义拍照页面（对标 takePhoto.nvue 单拍模式）。 */
	function handleOpenCustomCamera(): void {
		closeUserDrawer()
		uni.navigateTo({ url: '/pages/report/simple-camera' })
	}
	/** 示例入口只接收自定义拍照的本地路径；没有验货计划 ID 时不能把它当作已上传报告照片。 */
	function setImage(result: UTSJSONObject): void {
		const path = String(result?.path ?? '').trim()
		if (path !== '') console.log('[list] custom camera local photo:', path)
	}

	// 暴露 setImage 供自定义拍照页面通过 getCurrentPages + $vm.setImage 回传结果
	defineExpose({ setImage })

	/**
	 * 展示本地计划、待同步数量和最近更新时间摘要。
	 */
	async function handleViewLocalData(): Promise<void> {
		uni.navigateTo({ url: '/pages/debug/database' })
	}

	/**
	 * 二次确认后清空全部本地验货缓存并刷新列表。
	 */
	/**
	 * 使用原生确认框返回布尔结果，供危险操作串联多次确认。
	 */
	function showDrawerConfirm(options: UTSJSONObject): Promise<boolean> {
		return new Promise<boolean>((resolve) => {
			uni.showModal({
				title: t(String(options?.title ?? '提示')),
				content: t(String(options?.content ?? '')),
				confirmText: t(String(options?.confirmText ?? '确定')),
				cancelText: t(String(options?.cancelText ?? '取消')),
				confirmColor: String(options?.confirmColor ?? '#ef4444'),
				success: (result) => resolve(result.confirm === true),
				fail: () => resolve(false)
			})
		})
	}

	/**
	 * 按 H5 流程执行两次确认后清空全部本地验货缓存。
	 */
	async function handleClearLocalCache(): Promise<void> {
		if (isClearingLocalCache.value) return
		closeUserDrawer()
		const firstConfirmed = await showDrawerConfirm({
			title: t('清除本地缓存'),
			content: t('该操作会删除当前设备上的全部离线验货数据，且不可恢复，是否继续？'),
			confirmText: '继续',
			cancelText: '取消'
		})
		if (!firstConfirmed) return
		const secondConfirmed = await showDrawerConfirm({
			title: t('再次确认'),
			content: t('请再次确认：确定清除全部本地缓存数据？'),
			confirmText: '确认清除',
			cancelText: '返回'
		})
		if (!secondConfirmed) return
		isClearingLocalCache.value = true
		try {
			await reportRepository.clearPlans()
			localPlans.value = [] as UTSJSONObject[]
			for (const tab of tabs) {
				remoteListMap[tab.key] = [] as UTSJSONObject[]
				pageMap[tab.key] = 0
				totalMap[tab.key] = 0
			}
			await refreshLocalList()
			uni.showToast({ title: t('本地缓存已清除'), icon: 'success' })
		} catch (error) {
			uni.showToast({ title: error?.message ?? t('清理本地缓存失败'), icon: 'none' })
		} finally {
			isClearingLocalCache.value = false
		}
	}

	/**
	 * 打开与当前页签匹配的浮动操作菜单。
	 */
	function showActionMenu(): void {
		if (fabActions.value.length === 0) return
		showMenu.value = true
	}

	/**
	 * 关闭右下角浮动操作菜单。
	 */
	function hideActionMenu(): void {
		showMenu.value = false
	}

	/**
	 * 根据 H5 菜单操作键执行对应导航或功能提示。
	 */
	function handleFabAction(action: UTSJSONObject): void {
		hideActionMenu()
		const actionKey = String(action?.key ?? '')
		if (actionKey === 'scan') {
			goScanSearch()
			return
		}
		if (actionKey === 'search') {
			goSearch()
			return
		}
		if (actionKey === 'merge') {
			openMergeFlow()
			return
		}
		if (actionKey === 'quick') showQuickInspectionTip()
	}

	/**
	 * 跳转搜索页并请求页面自动打开扫码入口。
	 */
	function goScanSearch(): void {
		uni.navigateTo({ url: '/pages/report/search?autoScan=1' })
	}

	/**
	 * 跳转到验货计划搜索页。
	 */
	function goSearch(): void {
		hideActionMenu()
		closeUserDrawer()
		uni.navigateTo({ url: '/pages/report/search' })
	}

	/** 懒加载验货类型字典，接口失败时使用当前已定计划中的类型兜底。 */
	async function loadInspectTypeOptions(): Promise<void> {
		if (inspectTypeOptions.value.length > 0) return
		try {
			inspectTypeOptions.value = ((await planApi.getInspectTypeDict()) ?? []) as UTSJSONObject[]
		} catch (error) {
			const values = Array.from(new Set<string>(visiblePlans.value.map((item: UTSJSONObject): string => String(getItemInspectType(item))).filter((value: string): boolean => value !== ''))) as string[]
			inspectTypeOptions.value = values.map((value: string, index: number): UTSJSONObject => ({ value, label: value, sortOrder: index + 1 }))
		}
	}

	/** 懒加载合并计划下载时可选的清单模板。 */
	async function loadTemplateOptions(): Promise<void> {
		if (templateOptions.value.length > 0) return
		templateOptions.value = ((await planApi.getPlanTemplates()) ?? []) as UTSJSONObject[]
	}

	/** 从 FAB 菜单打开 H5 同款验货类型选择弹层。 */
	async function openMergeFlow(): Promise<void> {
		try {
			if (!(await isNetworkOnline())) throw new Error('合并验货需要联网，请连接网络后重试')
			await loadInspectTypeOptions()
			if (mergeInspectType.value === '' && inspectTypeOptions.value.length > 0) mergeInspectType.value = String(inspectTypeOptions.value[inspectTypeOptions.value.length - 1]?.value ?? '')
			mergeSheetStage.value = 'type'
			showMergeSheet.value = true
		} catch (error) { uni.showToast({ title: error?.message ?? t('加载验货类型失败'), icon: 'none' }) }
	}

	/** 更新合并流程选择的验货类型。 */
	function setMergeInspectType(value: string): void { mergeInspectType.value = String(value ?? '') }
	/** 关闭合并弹层但保留当前卡片多选状态。 */
	function closeMergeSheet(): void { showMergeSheet.value = false }
	/** 进入合并卡片多选模式并清空上一次结果。 */
	function startMergeSelection(): void { if (mergeInspectType.value !== '') { mergeSelectedItems.value = [] as UTSJSONObject[]; mergedPlanId.value = ''; mergeMode.value = true; showMergeSheet.value = false } }
	/** 返回当前合并选择中的首条计划作为后续兼容性锚点。 */
	function getMergeAnchorItem(): UTSJSONObject | null { return mergeSelectedItems.value.length > 0 ? mergeSelectedItems.value[0] : null }
	/** 判断当前计划是否已经加入合并选择。 */
	function isMergeChecked(item: UTSJSONObject): boolean { const id = String(getPlanOperationId(item)); return mergeSelectedItems.value.some((selected: UTSJSONObject): boolean => String(getPlanOperationId(selected)) === id) }
	/** 判断计划是否满足当前验货类型和首条计划的 H5 合并规则。 */
	function isMergeSelectableItem(item: UTSJSONObject): boolean { return isMergeChecked(item) || isMergeSelectable(item, mergeInspectType.value, getMergeAnchorItem()) }
	/** 按 H5 规则获取订单组可全选的同工厂、同货类、同类型计划。 */
	function getGroupTargetItems(group: UTSJSONObject): UTSJSONObject[] { return (getMergeGroupTargets(group, mergeInspectType.value, mergeSelectedItems.value) ?? []) as UTSJSONObject[] }
	/** 判断订单组内是否存在可合并的计划。 */
	function canGroupSelectAll(group: UTSJSONObject): boolean { return getGroupTargetItems(group).length > 0 }
	/** 判断订单组当前兼容计划是否已全部选中。 */
	function isGroupAllSelected(group: UTSJSONObject): boolean {
		const targets = getGroupTargetItems(group)
		return targets.length > 0 && targets.every((item: UTSJSONObject): boolean => isMergeChecked(item))
	}
	/** 切换订单组兼容计划的全选状态，保留其他订单组已选计划。 */
	function toggleGroupSelectAll(group: UTSJSONObject): void {
		if (!mergeMode.value) return
		const targets = getGroupTargetItems(group)
		if (targets.length === 0) return
		const targetIds = new Set<string>(targets.map((item: UTSJSONObject): string => String(getPlanOperationId(item))))
		if (isGroupAllSelected(group)) {
			mergeSelectedItems.value = mergeSelectedItems.value.filter((item: UTSJSONObject): boolean => !targetIds.has(String(getPlanOperationId(item))))
			return
		}
		const selectedIds = new Set<string>(mergeSelectedItems.value.map((item: UTSJSONObject): string => String(getPlanOperationId(item))))
		mergeSelectedItems.value = [...mergeSelectedItems.value, ...targets.filter((item: UTSJSONObject): boolean => !selectedIds.has(String(getPlanOperationId(item))))]
	}
	/** 按 H5 合并资格规则添加或移除当前计划。 */
	function toggleMergeSelect(item: UTSJSONObject): void {
		const planId = String(getPlanOperationId(item))
		if (planId === '') { uni.showToast({ title: t('计划ID缺失，无法选择'), icon: 'none' }); return }
		if (isMergeChecked(item)) { mergeSelectedItems.value = mergeSelectedItems.value.filter((selected: UTSJSONObject): boolean => String(getPlanOperationId(selected)) !== planId); return }
		if (!isBaseMergeEligible(item, mergeInspectType.value)) { uni.showToast({ title: t('仅支持未下载、已定计划且未合并的同类型任务'), icon: 'none' }); return }
		if (!isMergeSelectableItem(item)) { uni.showToast({ title: t('需与首条计划保持同工厂、同货类、同验货类型'), icon: 'none' }); return }
		mergeSelectedItems.value = [...mergeSelectedItems.value, item]
	}
	/** 退出合并模式并清空类型、选择、模板和远程结果。 */
	function cancelMergeMode(): void { mergeMode.value = false; showMergeSheet.value = false; mergeSelectedItems.value = [] as UTSJSONObject[]; mergedPlanId.value = ''; mergeTemplateId.value = ''; mergeTemplateName.value = '' }
	/** 加载清单模板并打开已选计划确认弹层。 */
	async function openMergeConfirm(): Promise<void> {
		if (mergeSelectedItems.value.length < 2) return
		try { await loadTemplateOptions(); if (mergeTemplateId.value === '' && templateOptions.value.length > 0) setMergeTemplate(templateOptions.value[0]); mergeSheetStage.value = 'confirm'; showMergeSheet.value = true }
		catch (error) { uni.showToast({ title: error?.message ?? t('加载清单失败'), icon: 'none' }) }
	}
	/** 更新合并计划下载使用的清单模板。 */
	function setMergeTemplate(option: UTSJSONObject): void { mergeTemplateId.value = String(option?.id ?? ''); mergeTemplateName.value = String(option?.name ?? '') }
	/** 再次校验全部计划后调用在线合并接口。 */
	async function confirmMerge(): Promise<void> {
		if (operationSubmitting.value || mergeSelectedItems.value.length < 2) return
		const anchor = mergeSelectedItems.value[0]
		if (!mergeSelectedItems.value.every((item: UTSJSONObject): boolean => isMergeSelectable(item, mergeInspectType.value, anchor))) { uni.showToast({ title: t('存在不满足合并条件的任务'), icon: 'none' }); return }
		const sourcePlanIds = mergeSelectedItems.value.map((item: UTSJSONObject): string => String(getPlanOperationId(item)))
		operationSubmitting.value = true
		try {
			const response = await planOperationService.mergePlans(sourcePlanIds)
			mergedPlanId.value = String(getMergedPlanId(response))
			if (mergedPlanId.value === '') throw new Error('合并成功但未返回计划ID')
			localPlans.value = markMergedSourcePlans(localPlans.value, sourcePlanIds, mergedPlanId.value) as UTSJSONObject[]
			for (const tab of tabs) {
				if (tab.key === 'local') continue
				remoteListMap[tab.key] = markMergedSourcePlans(remoteListMap[tab.key], sourcePlanIds, mergedPlanId.value)
			}
			uni.showToast({ title: t('合并成功'), icon: 'success' })
		} catch (error) { uni.showToast({ title: error?.message ?? t('合并失败'), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}
	/** 下载合并生成的新计划到离线数据库，并刷新列表回显。 */
	async function downloadMergedPlan(): Promise<void> {
		if (operationSubmitting.value) return
		if (mergedPlanId.value === '') { uni.showToast({ title: t('缺少合并后计划ID，无法下载验货'), icon: 'none' }); return }
		if (mergeTemplateId.value === '') { uni.showToast({ title: t('请选择清单'), icon: 'none' }); return }
		operationSubmitting.value = true
		try {
			await planOperationService.downloadToLocal(mergedPlanId.value, { templateId: mergeTemplateId.value, templateName: mergeTemplateName.value }, [], mergeSelectedItems.value)
			await refreshLocalList()
			cancelMergeMode()
			await refreshList()
			uni.showToast({ title: t('已下载到本地'), icon: 'success' })
		} catch (error) { uni.showToast({ title: error?.message ?? t('下载失败'), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}

	/** 查询合并父计划成员并打开拆分预览，优先保留本地完整记录。 */
	async function openSplitPreview(item: UTSJSONObject): Promise<void> {
		if (!isSplitAvailable(item) || operationSubmitting.value) return
		if (!(await isNetworkOnline())) { uni.showToast({ title: t('拆分验货需要联网，请连接网络后重试'), icon: 'none' }); return }
		const planId = String(getPlanOperationId(item))
		if (planId === '') { uni.showToast({ title: t('计划ID缺失，无法拆分'), icon: 'none' }); return }
		const mergedParentPlanId = String(getItemParentPlanId(item))
		const parentPlanId = mergedParentPlanId !== '' ? mergedParentPlanId : planId
		operationSubmitting.value = true
		try {
			const response = await planApi.searchPlans({ parentPlanId }, 1, pageSize)
			const candidates = [...((response?.records ?? []) as UTSJSONObject[])]
			for (const tab of tabs) {
				if (tab.key !== 'local') candidates.push(...(remoteListMap[tab.key] as UTSJSONObject[]))
			}
			splitPreviewItems.value = buildSplitPreview(candidates, localPlans.value, parentPlanId) as UTSJSONObject[]
			if (splitPreviewItems.value.length === 0) splitPreviewItems.value = [item]
			splitTargetPlanId.value = planId
			splitResultItems.value = [] as UTSJSONObject[]
			splitDownloadedIds.value = [] as string[]
			showSplitSheet.value = true
		} catch (error) { uni.showToast({ title: error?.message ?? t('加载拆分预览失败'), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}

	/** 向云端拆分合并组并同步列表标记，结果弹层支持逐条下载。 */
	async function confirmSplit(): Promise<void> {
		if (splitTargetPlanId.value === '' || operationSubmitting.value) return
		if (!(await isNetworkOnline())) { uni.showToast({ title: t('拆分验货需要联网，请连接网络后重试'), icon: 'none' }); return }
		operationSubmitting.value = true
		try {
			await planOperationService.splitPlan(splitTargetPlanId.value)
			const sourceIds = splitPreviewItems.value.map((item: UTSJSONObject): string => String(getPlanOperationId(item)))
			splitResultItems.value = markSplitSourcePlans(splitPreviewItems.value, sourceIds) as UTSJSONObject[]
			localPlans.value = markSplitSourcePlans(localPlans.value, sourceIds) as UTSJSONObject[]
			for (const tab of tabs) {
				if (tab.key !== 'local') remoteListMap[tab.key] = markSplitSourcePlans(remoteListMap[tab.key], sourceIds)
			}
			uni.showToast({ title: t('拆分验货成功'), icon: 'success' })
		} catch (error) { uni.showToast({ title: error?.message ?? t('拆分失败'), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}

	/** 下载一条已拆分计划并刷新 SQLite 下载状态。 */
	async function downloadSplitItem(item: UTSJSONObject): Promise<void> {
		const planId = String(getPlanOperationId(item))
		if (planId === '' || operationSubmitting.value) return
		if (!(await isNetworkOnline())) { uni.showToast({ title: t('下载验货需要联网，请连接网络后重试'), icon: 'none' }); return }
		operationSubmitting.value = true
		try {
			const plan = item?.plan ?? item
			await planOperationService.downloadToLocal(planId, { templateId: plan?.templateId ?? item?.templateId ?? '', templateName: plan?.templateName ?? item?.templateName ?? '' }, [], [item])
			splitDownloadedIds.value = [...splitDownloadedIds.value, planId]
			await refreshLocalList()
			uni.showToast({ title: t('下载验货成功'), icon: 'success' })
		} catch (error) { uni.showToast({ title: error?.message ?? t('下载失败'), icon: 'none' }) }
		finally { operationSubmitting.value = false }
	}

	/** 关闭拆分弹层并清理上次预览及下载状态。 */
	function closeSplitSheet(): void {
		if (operationSubmitting.value) return
		showSplitSheet.value = false
		splitTargetPlanId.value = ''
		splitPreviewItems.value = [] as UTSJSONObject[]
		splitResultItems.value = [] as UTSJSONObject[]
		splitDownloadedIds.value = [] as string[]
	}

	/**
	 * 提示快速验货入口已按 H5 保留。
	 */
	function showQuickInspectionTip(): void {
		uni.showToast({ title: t('创建快速验货功能待接入'), icon: 'none' })
	}

	/** 将版本接口返回的 HTTPS APK 地址交给 Android 系统浏览器下载；调起失败时明确提示。 */
	function openUpdateDownloadPage(downloadUrl: string): void {
		// #ifdef APP-ANDROID
		if (openUrlInSystemBrowser(downloadUrl)) return
		uni.showToast({ title: t('唤起浏览器失败'), icon: 'none' })
		// #endif
	}

	/** 用户主动从信息抽屉检查 Android 包版本；检查失败给出反馈，不触发登录或离线同步。 */
	async function handleCheckForUpdates(): Promise<void> {
		if (isUpdatingApp.value) return
		closeUserDrawer()
		// #ifndef APP-ANDROID
		uni.showToast({ title: t('仅支持 Android 安装包更新'), icon: 'none' })
		return
		// #endif
		// #ifdef APP-ANDROID
		isUpdatingApp.value = true
		try {
			const versionCode = parseInt(uni.getAppBaseInfo().appVersionCode ?? '')
			const update = await appUpdateService.check(versionCode, currentLanguage.value)
			if (update == null) {
				uni.showToast({ title: t('当前已是最新版本'), icon: 'none' })
				return
			}
			uni.showModal({
				title: t('发现新版本 v{version}', { version: update.versionName }),
				content: update.updateNotes !== '' ? update.updateNotes : t('有新版本可用'),
				showCancel: !update.forceUpdate,
				cancelText: t('稍后再说'),
				confirmText: t('立即更新'),
				success: (result) => { if (result.confirm) openUpdateDownloadPage(update.downloadUrl) }
			})
		} catch (error) {
			console.warn('Android 检查更新失败:', error)
			const reason = (error?.message ?? '').toString().trim()
			uni.showModal({ title: t('检查更新失败'), content: reason !== '' ? reason : t('检查更新失败，请稍后重试'), showCancel: false })
		} finally {
			isUpdatingApp.value = false
		}
		// #endif
	}

	/**
	 * 清理本地会话并返回登录页。
	 */
	async function handleLogout(): Promise<void> {
		try {
			await logout()
		} catch (error) {
			console.warn('退出登录时清理本地会话失败:', error)
		}
		uni.reLaunch({ url: '/pages/login/login' })
	}
</script>

<style>
	.page { flex: 1; background-color: #f5f5f5; }
	.header { background-color: #03ae4f; color: #ffffff; padding: 10px 18px 0; box-shadow: 0 2px 8px rgba(3, 174, 79, 0.16); }
	.top { height: 48px; flex-direction: row; align-items: center; justify-content: space-between; }
	.top-icon-button { width: 40px; height: 40px; align-items: center; justify-content: center; }
	.title { color: #ffffff; font-size: 20px; font-weight: 600; }
	.sync-entry { width: 40px; align-items: flex-end; }
	.status-tabs { flex-direction: row; margin-top: 8px; }
	.status-tab { position: relative; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 10px 0 11px; opacity: 0.9; }
	.status-tab.active { opacity: 1; }
	.tab-indicator { position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; background-color: #ffffff; }
