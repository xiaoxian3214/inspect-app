<template>
	<view class="camera-page">
		<xview-camera-view ref="nativeCameraRef" class="camera-preview" :facing="devicePosition" :flash="flashMode" :photo-format="photoFormat" :resolution="photoResolution" :grid="gridMode" :save-to-album="saveToAlbum" @onCameraOpened="handleCameraReady" @onCameraClosed="handleCameraStopped" @onPictureTaken="handleNativePhoto" @onVideoTakenStart="handleVideoStarted" @onVideoTakenEnd="handleNativeVideo" @onCameraTakenError="handleCameraError" @onCameraError="handleCameraError" />
		<view class="camera-overlay">
			<TopSafeArea background-color="rgba(0,0,0,0.72)" />
			<view class="camera-header">
				<view class="header-action" @click="cancelCapture"><AppIcon type="close" :size="24" color="#ffffff" /></view>
				<text class="camera-title">{{ t('连续拍照') }}</text>
				<view class="header-action" @click="toggleSettings"><AppIcon type="gear" :size="22" color="#ffffff" /></view>
			</view>
			<view v-if="!cameraReady" class="camera-state">
				<view v-if="cameraErrorMessage === ''" class="camera-loading-dot"></view>
				<text class="camera-state-title">{{ t(cameraErrorMessage === '' ? '相机启动中...' : '相机无法启动') }}</text>
				<text v-if="cameraErrorMessage !== ''" class="camera-state-message">{{ t(cameraErrorMessage) }}</text>
			</view>
			<view v-if="videoRecording" class="recording-indicator">
				<view class="recording-dot"></view>
				<text class="recording-text">{{ formatVideoDurationLabel(videoElapsedSeconds) }} / {{ formatVideoDurationLabel(MAX_VIDEO_DURATION_SECONDS) }}</text>
			</view>
			<view v-if="showSettings" class="camera-settings" @click.stop="() => {}">
				<scroll-view class="settings-scroll" :scroll-y="true">
					<view class="settings-group">
						<text class="settings-label">{{ t('闪光灯') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: flashMode === 'off' }" @click="applyFlash('off')">{{ t('关闭') }}</text>
							<text class="settings-option" :class="{ active: flashMode === 'on' }" @click="applyFlash('on')">{{ t('开启') }}</text>
							<text class="settings-option" :class="{ active: flashMode === 'auto' }" @click="applyFlash('auto')">{{ t('自动') }}</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('网格') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: gridMode === 'off' }" @click="applyGrid('off')">{{ t('关闭') }}</text>
							<text class="settings-option" :class="{ active: gridMode === 'draw_3X3' }" @click="applyGrid('draw_3X3')">3x3</text>
							<text class="settings-option" :class="{ active: gridMode === 'draw_4x4' }" @click="applyGrid('draw_4x4')">4x4</text>
							<text class="settings-option" :class="{ active: gridMode === 'draw_phi' }" @click="applyGrid('draw_phi')">{{ t('黄金') }}</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('分辨率') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: photoResolution === 'low' }" @click="applyResolution('low')">{{ t('低') }}</text>
							<text class="settings-option" :class="{ active: photoResolution === 'medium' }" @click="applyResolution('medium')">{{ t('中') }}</text>
							<text class="settings-option" :class="{ active: photoResolution === 'high' }" @click="applyResolution('high')">{{ t('高') }}</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('缩放') }}</text>
						<view class="settings-options">
							<text class="settings-option" @click="applyZoom('ultraWide')">{{ t('超广角') }}</text>
							<text class="settings-option" @click="applyZoom('reset')">1.0x</text>
							<text class="settings-option" @click="applyZoom('in')">{{ t('放大') }}</text>
							<text class="settings-option" @click="applyZoom('out')">{{ t('缩小') }}</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('HDR') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: hdrMode === 'off' }" @click="applyHdr('off')">{{ t('关闭') }}</text>
							<text class="settings-option" :class="{ active: hdrMode === 'on' }" @click="applyHdr('on')">{{ t('开启') }}</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('白平衡') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: whiteBalanceMode === 'auto' }" @click="applyWhiteBalance('auto')">{{ t('自动') }}</text>
							<text class="settings-option" :class="{ active: whiteBalanceMode === 'incandescent' }" @click="applyWhiteBalance('incandescent')">{{ t('白炽') }}</text>
							<text class="settings-option" :class="{ active: whiteBalanceMode === 'fluorescent' }" @click="applyWhiteBalance('fluorescent')">{{ t('荧光') }}</text>
							<text class="settings-option" :class="{ active: whiteBalanceMode === 'daylight' }" @click="applyWhiteBalance('daylight')">{{ t('日光') }}</text>
							<text class="settings-option" :class="{ active: whiteBalanceMode === 'cloudy' }" @click="applyWhiteBalance('cloudy')">{{ t('多云') }}</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('照片格式') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: photoFormat === 'jpg' }" @click="applyPhotoFormat('jpg')">JPG</text>
							<text class="settings-option" :class="{ active: photoFormat === 'jpeg' }" @click="applyPhotoFormat('jpeg')">JPEG</text>
						</view>
					</view>
					<view class="settings-group">
						<text class="settings-label">{{ t('保存到相册') }}</text>
						<view class="settings-options">
							<text class="settings-option" :class="{ active: saveToAlbum }" @click="applySaveToAlbum(true)">{{ t('是') }}</text>
							<text class="settings-option" :class="{ active: !saveToAlbum }" @click="applySaveToAlbum(false)">{{ t('否') }}</text>
						</view>
					</view>
				</scroll-view>
			</view>
			<view class="camera-spacer"></view>
			<view class="capture-panel" :style="{ paddingBottom: safeBottomPaddingPx(22) }">
				<scroll-view v-if="capturedPaths.length > 0" class="capture-strip" :scroll-x="true" :show-scrollbar="false">
					<view class="capture-strip-row">
						<view v-for="(path, index) in capturedPaths" :key="path" class="capture-thumb-wrap">
							<image v-if="capturedMediaKinds[index] !== 'video'" class="capture-thumb" :style="getThumbnailImageStyle(index)" :src="path" mode="aspectFill" />
							<view v-else class="capture-thumb capture-thumb-video">
								<view class="thumb-video-triangle"></view>
								<text class="thumb-video-duration">{{ getCaptureDurationLabel(index) }}</text>
							</view>
							<view class="capture-remove" @click="removeCapture(index)"><AppIcon type="close" :size="11" color="#ffffff" /></view>
						</view>
					</view>
				</scroll-view>
				<view class="mode-switch">
					<view class="mode-option" :class="{ active: captureMode === 'photo' }" @click="switchCaptureMode('photo')"><text class="mode-option-text">{{ t('拍照') }}</text></view>
					<view class="mode-option" :class="{ active: captureMode === 'video' }" @click="switchCaptureMode('video')"><text class="mode-option-text">{{ t('录像') }}</text></view>
				</view>
				<view class="capture-toolbar">
					<view class="toolbar-action" @click="chooseMediaFromAlbum"><AppIcon type="plus" :size="25" color="#ffffff" /><text>{{ t('相册') }}</text></view>
					<view class="shutter-wrap" :class="{ disabled: shutterDisabled, recording: videoRecording }" @click="handleShutterPress"><view class="shutter-button" :class="{ recording: videoRecording }"></view></view>
					<view class="toolbar-action" @click="switchCamera"><AppIcon type="camera" :size="25" color="#ffffff" /><text>{{ t('翻转') }}</text></view>
				</view>
				<view class="capture-footer">
					<text class="capture-count">{{ t('已收集 {count} 个媒体 · 剩余 {remaining} 个', { count: capturedPaths.length, remaining: remainingCount }) }}</text>
					<view class="confirm-button" :class="{ disabled: capturedPaths.length === 0 }" @click="confirmCapture"><text>{{ t('使用媒体') }}</text></view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { safeBottomPaddingPx } from '../../domain/nativeLayout.uts'
	import { t } from '../../i18n/index.uts'
	import { computed, ref } from 'vue'
	import { onHide, onLoad, onShow, onUnload } from '@dcloudio/uni-app'
	import TopSafeArea from '../../components/common/TopSafeArea.uvue'
	import AppIcon from '../../components/icons/AppIcon.uvue'
	import { appendCapturePaths, buildCameraCaptureEventName } from '../../domain/cameraCapture.uts'
	import { MAX_VIDEO_DURATION_SECONDS, validateVideoDuration, validateVideoSize } from '../../domain/photoUploadPolicy.uts'
	import { resolveMediaPreviewRotation, resolveMediaPreviewRotationDelta } from '../../domain/imageOrientation.uts'

	const requestId = ref('')
	const maxCount = ref(30)
	const capturedPaths = ref([])
	const capturedRotations = ref([])
	const capturedMediaKinds = ref([])
	const capturedDurations = ref([])
	const captureMode = ref('photo')
	const videoRecording = ref(false)
	const videoElapsedSeconds = ref(0)
	const devicePosition = ref('back')
	const flashMode = ref('off')
	const showSettings = ref(false)
	const gridMode = ref('off')
	const photoResolution = ref('high')
	const photoFormat = ref('jpg')
	const hdrMode = ref('off')
	const whiteBalanceMode = ref('auto')
	const saveToAlbum = ref(false)
	const capturing = ref(false)
	const cameraReady = ref(false)
	const cameraErrorMessage = ref('')
	const thumbnailRotation = ref(0)
	const cameraActive = ref(true)
	const nativeCameraRef = ref<ComponentPublicInstance | null>(null)
	let pendingCaptureRotation = 0
	let videoTimerId: number | null = null
	let resultSent = false
	let orientationTrackingStarted = false
	let currentZoomLevel = 1.0

	/** 返回当前仍可拍摄或选择的媒体数量。 */
	const remainingCount = computed(() => Math.max(0, maxCount.value - capturedPaths.value.length))
	/** 判断当前快门是否应禁用：录像中可随时停止，拍照中需避免连点。 */
	const shutterDisabled = computed(() => {
		if (videoRecording.value) return false
		if (!cameraReady.value || remainingCount.value <= 0) return true
		return captureMode.value === 'photo' && capturing.value
	})
	/** 返回指定照片相对其拍摄姿态需要旋转的原生样式。 */
	function getThumbnailImageStyle(index) {
		const captureRotation = parseInt(String(capturedRotations.value[index] ?? 0))
		const rotationDelta = resolveMediaPreviewRotationDelta(thumbnailRotation.value, captureRotation)
		return { transform: `rotate(${rotationDelta}deg)` }
	}
	/** 将视频秒数格式化为 mm:ss 展示标签。 */
	function formatVideoDurationLabel(totalSeconds) {
		const safeSeconds = Math.max(0, Math.round(parseInt(String(totalSeconds ?? 0))))
		const minutes = Math.floor(safeSeconds / 60)
		const seconds = safeSeconds % 60
		return `${minutes < 10 ? '0' + minutes : minutes}:${seconds < 10 ? '0' + seconds : seconds}`
	}
	/** 返回连拍列表中指定位置视频的时长角标文本。 */
	function getCaptureDurationLabel(index) {
		return formatVideoDurationLabel(capturedDurations.value[index] ?? 0)
	}
	/** 追加媒体路径并记录每个媒体加入时的姿态、类型与视频时长，已有媒体保留原始信息。 */
	function appendCapturedMedia(paths: string[], captureRotation: number = thumbnailRotation.value, mediaKind: string = 'image', durationSeconds: number = 0) {
		const currentPaths = [...capturedPaths.value]
		const currentRotations = [...capturedRotations.value]
		const currentKinds = [...capturedMediaKinds.value]
		const currentDurations = [...capturedDurations.value]
		const nextPaths = appendCapturePaths(currentPaths, paths, maxCount.value)
		const nextRotations = []
		const nextKinds = []
		const nextDurations = []
		nextPaths.forEach((path) => {
			const existingIndex = currentPaths.indexOf(path)
			nextRotations.push(existingIndex >= 0 ? parseInt(String(currentRotations[existingIndex] ?? 0)) : parseInt(String(captureRotation ?? 0)))
			nextKinds.push(existingIndex >= 0 ? currentKinds[existingIndex] : (mediaKind === 'video' ? 'video' : 'image'))
			nextDurations.push(existingIndex >= 0 ? parseInt(String(currentDurations[existingIndex] ?? 0)) : parseInt(String(durationSeconds ?? 0)))
		})
		capturedPaths.value = nextPaths
		capturedRotations.value = nextRotations
		capturedMediaKinds.value = nextKinds
		capturedDurations.value = nextDurations
	}

	/** 根据加速度计的重力方向更新底部照片需要保持正向的旋转角度。 */
	function accelerometerListener(result) {
		thumbnailRotation.value = resolveMediaPreviewRotation(result?.x, result?.y, thumbnailRotation.value)
	}
	/** 页面显示时启动高频姿态监听，使缩略图能及时跟随横竖屏方向变化。 */
	function startThumbnailOrientationTracking() {
		if (orientationTrackingStarted) return
		orientationTrackingStarted = true
		uni.onAccelerometerChange(accelerometerListener)
		uni.startAccelerometer({
			interval: 'ui',
			fail: () => { orientationTrackingStarted = false; uni.offAccelerometerChange(accelerometerListener) }
		})
	}
	/** 页面隐藏或销毁时停止姿态监听，避免相机退出后继续占用传感器。 */
	function stopThumbnailOrientationTracking() {
		if (!orientationTrackingStarted) return
		orientationTrackingStarted = false
		uni.offAccelerometerChange(accelerometerListener)
		uni.stopAccelerometer({})
	}
	/** 停止录像倒计时定时器，避免录像结束后仍持续走秒。 */
	function stopRecordingTimer() {
		if (videoTimerId == null) return
		clearInterval(videoTimerId)
		videoTimerId = null
	}

	/** 解析相机请求参数并限制单次最大媒体数量。 */
	function handlePageLoad(options) {
		requestId.value = decodeURIComponent(String(options?.requestId ?? '')).trim()
		maxCount.value = Math.max(1, Math.min(60, parseInt(String(options?.maxCount ?? 30))))
	}
	/** CameraX 或 AVCaptureSession 完成初始化后开放拍摄按钮。 */
	function handleCameraReady() { cameraReady.value = true; cameraErrorMessage.value = '' }
	/** 原生相机停止后关闭拍照状态；若页面已经重新显示则忽略旧会话的延迟停止事件。 */
	function handleCameraStopped() { if (cameraActive.value) return; cameraReady.value = false; capturing.value = false }
	/** 接收原生相机写入完成的 JPEG 路径，并按按下快门时的姿态追加到媒体库。 */
	function handleNativePhoto(event) {
		const tempPath = String(event?.detail?.path ?? '').trim()
		const captureRotation = pendingCaptureRotation
		if (tempPath === '') { capturing.value = false; uni.showToast({ title: t('拍照结果为空，请重试'), icon: 'none' }); return }
		appendCapturedMedia([tempPath], captureRotation)
		capturing.value = false
	}
	/** 调用 CameraX 或 AVCapturePhotoOutput 拍摄一张照片，并记录按下快门时的设备姿态。 */
	function takePhoto() {
		if (!cameraReady.value || nativeCameraRef.value == null) { uni.showToast({ title: t(cameraErrorMessage.value ?? '相机仍在启动，请稍候'), icon: 'none' }); return }
		if (capturing.value || remainingCount.value <= 0) return
		pendingCaptureRotation = thumbnailRotation.value
		capturing.value = true
		nativeCameraRef.value?.$callMethod('takePhoto')
	}
	/** 调用原生录像输出开始录制视频，实际开始时机由 videorecordingstarted 事件确认。 */
	function startVideoRecording() {
		if (!cameraReady.value || nativeCameraRef.value == null) { uni.showToast({ title: t(cameraErrorMessage.value ?? '相机仍在启动，请稍候'), icon: 'none' }); return }
		if (videoRecording.value || remainingCount.value <= 0) return
		pendingCaptureRotation = thumbnailRotation.value
		nativeCameraRef.value?.$callMethod('startVideo', MAX_VIDEO_DURATION_SECONDS * 1000)
	}
	/** 停止原生录像并等待 videocaptured 事件回传本地视频路径。 */
	function stopVideoRecording() {
		if (!videoRecording.value) return
		nativeCameraRef.value?.$callMethod('stopVideo')
	}
	/** 从系统相册补充选择图片，并立即追加临时路径到缩略图列表。 */
	function chooseFromAlbum() {
		if (remainingCount.value <= 0) return
		const selectionRotation = thumbnailRotation.value
		uni.chooseImage({
			count: remainingCount.value,
			sizeType: ['compressed'],
			sourceType: ['album'],
			success: (result) => { appendCapturedMedia(result?.tempFilePaths ?? [], selectionRotation) }
		})
	}
	/** 从系统相册选择单个视频，校验 60 秒与 200MB 上限后按视频类型追加。 */
	function chooseVideoFromAlbum() {
		if (remainingCount.value <= 0) return
		const selectionRotation = thumbnailRotation.value
		uni.chooseVideo({
			sourceType: ['album'],
			compressed: false,
			maxDuration: MAX_VIDEO_DURATION_SECONDS,
			success: (result) => {
				const videoPath = String(result?.tempFilePath ?? '').trim()
				if (videoPath === '') return
				const durationSeconds = Math.round(parseInt(String(result?.duration ?? 0)))
				const durationCheck = validateVideoDuration(durationSeconds)
				if (!durationCheck.valid) { uni.showToast({ title: durationCheck.message, icon: 'none' }); return }
				const sizeMb = parseInt(String(result?.size ?? 0)) / (1024 * 1024)
				const sizeCheck = validateVideoSize(sizeMb)
				if (!sizeCheck.valid) { uni.showToast({ title: sizeCheck.message, icon: 'none' }); return }
				appendCapturedMedia([videoPath], selectionRotation, 'video', durationSeconds)
			}
		})
	}
	/** 原生录像正式开始后启动秒级倒计时，并在达到 60 秒上限时自动停止。 */
	function handleVideoStarted() {
		videoRecording.value = true
		videoElapsedSeconds.value = 0
		stopRecordingTimer()
		videoTimerId = setInterval(() => {
			videoElapsedSeconds.value += 1
			if (videoElapsedSeconds.value >= MAX_VIDEO_DURATION_SECONDS) {
				stopVideoRecording()
			}
		}, 1000)
	}
	/** 接收原生录像完成的本地 MP4 路径，并以停止时刻的走秒作为时长追加到媒体库。 */
	function handleNativeVideo(event) {
		const videoPath = String(event?.detail?.path ?? '').trim()
		const recordedSeconds = Math.max(1, videoElapsedSeconds.value)
		stopRecordingTimer()
		videoRecording.value = false
		videoElapsedSeconds.value = 0
		if (videoPath === '') { uni.showToast({ title: t('录像结果为空，请重试'), icon: 'none' }); return }
		appendCapturedMedia([videoPath], pendingCaptureRotation, 'video', recordedSeconds)
	}
	/** 根据当前模式分发快门行为：录像中停止，录像模式开始录像，拍照模式拍照片。 */
	function handleShutterPress() {
		if (videoRecording.value) { stopVideoRecording(); return }
		if (shutterDisabled.value) return
		if (captureMode.value === 'video') startVideoRecording()
		else takePhoto()
	}
	/** 切换拍照或录像模式；录像进行中禁止切换避免中断会话。 */
	function switchCaptureMode(mode) {
		if (videoRecording.value || capturing.value) return
		captureMode.value = mode === 'video' ? 'video' : 'photo'
	}
	/** 按当前模式从系统相册选择图片或视频。 */
	function chooseMediaFromAlbum() {
		if (captureMode.value === 'video') chooseVideoFromAlbum()
		else chooseFromAlbum()
	}
	/** 从当前尚未确认的连拍缩略图列表中删除指定媒体。 */
	function removeCapture(index) {
		const paths = [...capturedPaths.value]
		const rotations = [...capturedRotations.value]
		const kinds = [...capturedMediaKinds.value]
		const durations = [...capturedDurations.value]
		paths.splice(index, 1)
		rotations.splice(index, 1)
		kinds.splice(index, 1)
		durations.splice(index, 1)
		capturedPaths.value = paths
		capturedRotations.value = rotations
		capturedMediaKinds.value = kinds
		capturedDurations.value = durations
	}
	/** 取消拍摄时丢弃尚未交付给详情页的临时媒体。 */
	function cleanupCapturedFiles() { capturedPaths.value = []; capturedRotations.value = []; capturedMediaKinds.value = []; capturedDurations.value = [] }
	/** 在后置和前置镜头之间切换并要求原生组件重新绑定当前镜头；录像中禁止切换。 */
	function switchCamera() { if (videoRecording.value) return; devicePosition.value = devicePosition.value === 'back' ? 'front' : 'back'; nativeCameraRef.value?.$callMethod('setFacing', devicePosition.value) }
	/** 循环切换关闭、开启和自动闪光模式，并立即同步到原生拍照输出；录像中禁止切换。 */
	function applyFlash(mode: string) { if (videoRecording.value) return; flashMode.value = mode; nativeCameraRef.value?.$callMethod('setFlash', mode) }
	/** 切换设置面板显示/隐藏。 */
	function toggleSettings() { showSettings.value = !showSettings.value }
	/** 应用网格覆盖模式（off / draw_3X3 / draw_4x4 / draw_phi）。 */
	function applyGrid(mode: string) { gridMode.value = mode; nativeCameraRef.value?.$callMethod('setGrid', mode, '#a0a0a0') }
	/** 应用照片分辨率（low / medium / high）。 */
	function applyResolution(resolution: string) { photoResolution.value = resolution; nativeCameraRef.value?.$callMethod('setResolution', resolution) }
	/** 控制数字变焦或超广角切换。 */
	function applyZoom(action: string) {
		if (action === 'ultraWide') { nativeCameraRef.value?.$callMethod('switchUltraWide') }
		else if (action === 'reset') { currentZoomLevel = 1.0; nativeCameraRef.value?.$callMethod('resetZoom') }
		else if (action === 'in') { currentZoomLevel = Math.min(5.0, currentZoomLevel + 0.3); nativeCameraRef.value?.$callMethod('setLinearZoom', currentZoomLevel) }
		else if (action === 'out') { currentZoomLevel = Math.max(0.5, currentZoomLevel - 0.3); nativeCameraRef.value?.$callMethod('setLinearZoom', currentZoomLevel) }
	}
	/** 切换 HDR 开关。 */
	function applyHdr(mode: string) { hdrMode.value = mode; nativeCameraRef.value?.$callMethod('setHdr', mode) }
	/** 切换白平衡模式。 */
	function applyWhiteBalance(mode: string) { whiteBalanceMode.value = mode; nativeCameraRef.value?.$callMethod('setWhiteBalance', mode) }
	/** 设置照片输出格式（jpg / jpeg）。 */
	function applyPhotoFormat(format: string) { photoFormat.value = format; nativeCameraRef.value?.$callMethod('setPhotoFormat', format) }
	/** 控制是否将拍摄结果同时保存到系统相册。 */
	function applySaveToAlbum(save: boolean) { saveToAlbum.value = save; nativeCameraRef.value?.$callMethod('setSaveToAlbum', save) }
	/** 将已确认的全部本地媒体（含类型与视频时长）返回详情页并关闭相机。 */
	function confirmCapture() {
		if (capturedPaths.value.length === 0 || resultSent) return
		resultSent = true
		const items = capturedPaths.value.map((path, index) => ({
			path: path,
			mediaKind: capturedMediaKinds.value[index] === 'video' ? 'video' : 'image',
			durationSeconds: parseInt(String(capturedDurations.value[index] ?? 0))
		}))
		uni.$emit(buildCameraCaptureEventName(requestId.value), { items, cancelled: false })
		uni.navigateBack()
	}
	/** 取消相机并向调用页面返回空结果。 */
	function cancelCapture() {
		if (!resultSent) {
			resultSent = true
			cleanupCapturedFiles()
			uni.$emit(buildCameraCaptureEventName(requestId.value), { items: [], cancelled: true })
		}
		uni.navigateBack()
	}
	/** 展示原生相机错误并终止当前拍摄状态。 */
	function handleCameraError(error) { cameraReady.value = false; capturing.value = false; videoRecording.value = false; stopRecordingTimer(); cameraErrorMessage.value = (error?.detail?.message || error?.detail?.errMsg || error?.errMsg) ?? '无法使用相机，请检查系统相机权限'; uni.showToast({ title: t(cameraErrorMessage.value), icon: 'none' }) }
	/** 页面显示时恢复姿态监听并启动原生相机会话。 */
	function handlePageShow() { cameraActive.value = true; nativeCameraRef.value?.$callMethod('reopen'); startThumbnailOrientationTracking() }
	/** 页面隐藏时停止姿态监听和原生会话，避免后台继续占用摄像头。 */
	function handlePageHide() { cameraActive.value = false; nativeCameraRef.value?.$callMethod('close'); videoRecording.value = false; stopRecordingTimer(); stopThumbnailOrientationTracking() }
	/** 页面被系统返回键关闭时补发取消结果，避免调用页等待未完成。 */
	function handlePageUnload() {
		cameraActive.value = false
		videoRecording.value = false
		stopRecordingTimer()
		stopThumbnailOrientationTracking()
		if (resultSent) return
		resultSent = true
		cleanupCapturedFiles()
		uni.$emit(buildCameraCaptureEventName(requestId.value), { items: [], cancelled: true })
	}

	onLoad(handlePageLoad)
	onShow(handlePageShow)
	onHide(handlePageHide)
	onUnload(handlePageUnload)
</script>

<style>
	.camera-page { flex: 1; background-color: #000000; }
	.camera-preview { position: absolute; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; }
	.camera-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
	.camera-header { height: 94rpx; padding: 0 28rpx; flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0.72); }
	.camera-state { position: absolute; left: 48rpx; right: 48rpx; top: 32%; padding: 34rpx 28rpx; border-radius: 22rpx; align-items: center; background-color: rgba(15, 23, 42, 0.84); }
	.camera-loading-dot { width: 24rpx; height: 24rpx; margin-bottom: 18rpx; border-radius: 12rpx; background-color: #ffffff; opacity: 0.82; }
	.camera-state-title { color: #ffffff; font-size: 28rpx; font-weight: 600; text-align: center; }
	.camera-state-message { margin-top: 12rpx; color: rgba(255, 255, 255, 0.78); font-size: 22rpx; line-height: 32rpx; text-align: center; }
	.recording-indicator { position: absolute; top: 130rpx; left: 0; right: 0; flex-direction: row; align-items: center; justify-content: center; }
	.recording-dot { width: 16rpx; height: 16rpx; margin-right: 12rpx; border-radius: 8rpx; background-color: #ef4444; }
	.recording-text { color: #ffffff; font-size: 26rpx; font-weight: 600; }
	.header-action { width: 120rpx; height: 72rpx; align-items: center; justify-content: center; }
	.header-action-text { color: #ffffff; font-size: 22rpx; }
	.camera-title { flex: 1; color: #ffffff; font-size: 30rpx; font-weight: 600; text-align: center; }
	.camera-spacer { flex: 1; }
	.capture-panel { padding: 18rpx 22rpx 22rpx; background-color: rgba(0, 0, 0, 0.78); }
	.capture-strip { width: 100%; height: 138rpx; margin-bottom: 12rpx; }
	.capture-strip-row { height: 138rpx; flex-direction: row; align-items: center; }
	.capture-thumb-wrap { position: relative; width: 118rpx; height: 118rpx; margin-right: 14rpx; overflow: hidden; border-width: 2rpx; border-color: rgba(255, 255, 255, 0.35); border-radius: 14rpx; }
	.capture-thumb { width: 118rpx; height: 118rpx; transition-property: transform; transition-duration: 180ms; }
	.capture-thumb-video { align-items: center; justify-content: center; background-color: #0f172a; }
	.thumb-video-triangle { width: 0; height: 0; border-style: solid; border-left-width: 22rpx; border-top-width: 13rpx; border-bottom-width: 13rpx; border-right-width: 0; border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-left-color: #ffffff; }
	.thumb-video-duration { position: absolute; bottom: 6rpx; right: 8rpx; color: #ffffff; font-size: 18rpx; }
	.capture-remove { position: absolute; top: 5rpx; right: 5rpx; width: 32rpx; height: 32rpx; border-radius: 16rpx; align-items: center; justify-content: center; background-color: rgba(15, 23, 42, 0.8); }
	.mode-switch { margin-bottom: 6rpx; flex-direction: row; align-items: center; justify-content: center; }
	.mode-option { min-width: 128rpx; height: 56rpx; margin: 0 10rpx; padding: 0 22rpx; border-radius: 28rpx; align-items: center; justify-content: center; background-color: rgba(255, 255, 255, 0.14); }
	.mode-option.active { background-color: rgba(255, 255, 255, 0.9); }
	.mode-option-text { color: #ffffff; font-size: 24rpx; }
	.mode-option-text { color: #ffffff; font-size: 24rpx; font-weight: 600; }
	.capture-toolbar { height: 138rpx; flex-direction: row; align-items: center; justify-content: space-around; }
	.toolbar-action { width: 150rpx; align-items: center; justify-content: center; }
	.toolbar-action { width: 150rpx; align-items: center; justify-content: center; color: #ffffff; font-size: 21rpx; }
	.shutter-wrap { width: 116rpx; height: 116rpx; border-width: 6rpx; border-color: #ffffff; border-radius: 58rpx; align-items: center; justify-content: center; }
	.shutter-wrap.disabled { opacity: 0.45; }
	.shutter-wrap.recording { border-color: #ef4444; }
	.shutter-button { width: 88rpx; height: 88rpx; border-radius: 44rpx; background-color: #ffffff; }
	.shutter-button.recording { width: 60rpx; height: 60rpx; border-radius: 12rpx; background-color: #ef4444; }
	.capture-footer { margin-top: 8rpx; flex-direction: row; align-items: center; justify-content: space-between; }
	.capture-count { color: rgba(255, 255, 255, 0.78); font-size: 21rpx; }
	.confirm-button { min-width: 190rpx; height: 70rpx; padding: 0 24rpx; border-radius: 35rpx; align-items: center; justify-content: center; background-color: #03ae4f; }
	.confirm-button.disabled { opacity: 0.45; }
	.camera-settings { position: absolute; left: 0; right: 0; top: 94rpx; bottom: 0; z-index: 60; background-color: rgba(0, 0, 0, 0.88); }
	.settings-scroll { padding: 20rpx 28rpx; }
	.settings-group { margin-bottom: 22rpx; }
	.settings-label { color: #94a3b8; font-size: 22rpx; margin-bottom: 10rpx; }
	.settings-options { flex-direction: row; flex-wrap: wrap; }
	.settings-option { padding: 10rpx 24rpx; margin: 6rpx 10rpx 6rpx 0; border-radius: 22rpx; color: #cbd5e1; font-size: 23rpx; background-color: rgba(255, 255, 255, 0.1); }
	.settings-option.active { color: #ffffff; background-color: #03ae4f; }
	.confirm-button { min-width: 190rpx; height: 70rpx; padding: 0 24rpx; border-radius: 35rpx; align-items: center; justify-content: center; color: #ffffff; font-size: 25rpx; font-weight: 600; background-color: #03ae4f; }
</style>
