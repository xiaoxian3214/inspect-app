<template>
	<view class="page">
		<TopSafeArea background-color="#ffffff" />
		<view class="nav-row">
			<text class="nav-action" @click="goBack">←</text>
			<text class="nav-title">lime-sqlite 测试</text>
			<text class="nav-placeholder">·</text>
		</view>

		<scroll-view class="content" direction="vertical">
			<view class="card">
				<text class="card-title">数据库状态</text>
				<text class="status" :class="opened ? 'status-open' : 'status-closed'">{{ opened ? '已打开' : '未打开' }}</text>
				<text class="meta">名称：{{ DATABASE_NAME }}</text>
				<text class="meta">路径：{{ databasePath }}</text>
			</view>

			<view class="card">
				<text class="card-title">测试写入</text>
				<input v-model="inputValue" class="input" placeholder="输入一条测试内容" />
				<view class="button-grid">
					<text class="button primary" @click="openTestDatabase">打开并建表</text>
					<text class="button" @click="insertTestRow">插入数据</text>
					<text class="button" @click="queryTestRows">查询数据</text>
					<text class="button danger" @click="clearTestRows">清空数据</text>
					<text class="button" @click="closeTestDatabase">关闭数据库</text>
				</view>
			</view>

			<view class="card">
				<text class="card-title">查询结果（{{ rows.length }} 行）</text>
				<text v-if="rows.length === 0" class="empty">暂无数据，请先打开数据库并插入测试行。</text>
				<view v-for="(row, index) in rows" :key="(row?.id ?? index).toString()" class="row-item">
					<text class="row-index">#{{ index + 1 }}</text>
					<text class="row-json">{{ formatRow(row) }}</text>
				</view>
			</view>

			<view class="card log-card">
				<text class="card-title log-card-title">最近操作</text>
				<text class="log-text">{{ logMessage }}</text>
			</view>
			<view class="bottom-space"></view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import TopSafeArea from '../../components/common/TopSafeArea.uvue'
	import { openDatabase, closeDatabase, executeSql, selectSql, getDatabasePath } from '@/uni_modules/lime-sqlite'

	const DATABASE_NAME = 'qcm_lime_sqlite_test'
	const opened = ref(false)
	const inputValue = ref('测试数据')
	const rows = ref([])
	const databasePath = ref((getDatabasePath(DATABASE_NAME) ?? '暂未返回路径').toString())
	const logMessage = ref('等待操作')

	/** 将用户输入转义成安全的 SQLite 文本字面量内容。 */
	function escapeSqlText(value) { return (value ?? '').toString().replace(/'/g, "''") }

	/** 记录插件操作结果，并同步向开发者控制台输出详细信息。 */
	function recordLog(action, detail) {
		logMessage.value = `${action}：${(detail ?? '成功').toString()}`
		console.log(`[lime-sqlite test] ${action}`, detail)
	}

	/** 打开测试数据库并创建独立测试表，不修改业务数据库数据。 */
	function openTestDatabase() {
		openDatabase({
			name: DATABASE_NAME,
			success: (result) => {
				opened.value = true
				databasePath.value = (getDatabasePath(DATABASE_NAME) ?? databasePath.value).toString()
				executeSql({
					name: DATABASE_NAME,
					sql: ['CREATE TABLE IF NOT EXISTS plugin_test (id INTEGER PRIMARY KEY AUTOINCREMENT, content TEXT NOT NULL, createdAt TEXT NOT NULL)'],
					success: (createResult) => recordLog('打开并建表', JSON.stringify(createResult)),
					fail: (error) => recordLog('建表失败', error?.errMsg)
				})
			},
			fail: (error) => recordLog('打开失败', error?.errMsg)
		})
	}

	/** 查询测试表的全部数据，并按最新插入顺序展示插件返回结果。 */
	function queryTestRows() {
		if (!opened.value) { recordLog('查询失败', '请先打开数据库'); return }
		selectSql({
			name: DATABASE_NAME,
			sql: ['SELECT id, content, createdAt FROM plugin_test ORDER BY id DESC'],
			success: (result) => {
				rows.value = Array.isArray(result?.result) ? result.result : (Array.isArray(result?.data) ? result.data : [])
				recordLog('查询成功', `返回 ${rows.value.length} 行`)
			},
			fail: (error) => recordLog('查询失败', error?.errMsg)
		})
	}

	/** 向测试表插入一条带时间戳的数据，数据库未打开时给出明确提示。 */
	function insertTestRow() {
		if (!opened.value) { recordLog('插入失败', '请先打开数据库'); return }
		const content = escapeSqlText(inputValue.value.trim() ?? '测试数据')
		const createdAt = escapeSqlText(new Date().toISOString())
		executeSql({
			name: DATABASE_NAME,
			sql: [`INSERT INTO plugin_test (content, createdAt) VALUES ('${content}', '${createdAt}')`],
			success: (result) => { recordLog('插入成功', JSON.stringify(result)); queryTestRows() },
			fail: (error) => recordLog('插入失败', error?.errMsg)
		})
	}

	/** 删除测试表全部记录，只影响本测试页使用的 plugin_test 表。 */
	function clearTestRows() {
		if (!opened.value) { recordLog('清空失败', '请先打开数据库'); return }
		executeSql({
			name: DATABASE_NAME,
			sql: ['DELETE FROM plugin_test'],
			success: (result) => { rows.value = []; recordLog('清空成功', JSON.stringify(result)) },
			fail: (error) => recordLog('清空失败', error?.errMsg)
		})
	}

	/** 关闭测试数据库连接并保留磁盘文件，方便重新打开验证持久化。 */
	function closeTestDatabase() {
		closeDatabase({
			name: DATABASE_NAME,
			success: (result) => { opened.value = false; recordLog('关闭成功', JSON.stringify(result)) },
			fail: (error) => recordLog('关闭失败', error?.errMsg)
		})
	}

	/** 将插件返回的数据库行格式化成便于查看的 JSON。 */
	function formatRow(row) { try { return JSON.stringify(row, null, 2) } catch (_) { return (row ?? '').toString() } }

	/** 返回上一页面。 */
	function goBack() { uni.navigateBack() }
</script>

<style>
	.page { flex: 1; background-color: #f4f6fa; }
	.nav-row { height: 92rpx; padding: 0 24rpx; flex-direction: row; align-items: center; justify-content: space-between; background-color: #ffffff; border-bottom-width: 1rpx; border-bottom-color: #e5e7eb; }
	.nav-action, .nav-placeholder { width: 80rpx; color: #172033; font-size: 38rpx; }
	.nav-placeholder { color: transparent; }
	.nav-title { color: #172033; font-size: 31rpx; font-weight: 700; }
	.content { flex: 1; padding: 22rpx; }
	.card { margin-bottom: 20rpx; padding: 24rpx; border-radius: 20rpx; background-color: #ffffff; }
	.card-title { margin-bottom: 18rpx; color: #172033; font-size: 28rpx; font-weight: 700; }
	.status { align-self: flex-start; margin-bottom: 14rpx; padding: 8rpx 16rpx; border-radius: 18rpx; font-size: 22rpx; }
	.status-open { color: #15803d; background-color: #dcfce7; }
	.status-closed { color: #b45309; background-color: #fef3c7; }
	.meta { margin-top: 8rpx; color: #64748b; font-size: 22rpx; line-height: 1.5; }
	.input { height: 84rpx; padding: 0 20rpx; border-width: 1rpx; border-color: #cbd5e1; border-radius: 14rpx; background-color: #f8fafc; font-size: 25rpx; }
	.button-grid { margin-top: 18rpx; flex-direction: row; flex-wrap: wrap; }
	.button { margin: 0 14rpx 14rpx 0; padding: 16rpx 22rpx; border-radius: 14rpx; color: #334155; background-color: #e2e8f0; font-size: 23rpx; }
	.button.primary { color: #ffffff; background-color: #03a84e; }
	.button.danger { color: #b91c1c; background-color: #fee2e2; }
	.empty { color: #94a3b8; font-size: 23rpx; }
	.row-item { margin-top: 14rpx; padding: 18rpx; border-radius: 14rpx; background-color: #f8fafc; }
	.row-index { color: #03a84e; font-size: 21rpx; font-weight: 700; }
	.row-json { margin-top: 8rpx; color: #334155; font-size: 21rpx; line-height: 1.45; font-family: monospace; }
	.log-card { background-color: #172033; }
	.log-card-title { color: #ffffff; }
	.log-text { color: #cbd5e1; font-size: 22rpx; line-height: 1.5; }
	.bottom-space { height: 50rpx; }
</style>
